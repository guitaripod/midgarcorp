  "metrics": [
    {
      "id": "wau",
      "title": "Weekly active installs",
      "unit": "installs",
      "caveat": "Counts installs, not people. Each install reports once per week, so a week still running is a partial count."
    },
    {
      "id": "mau",
      "title": "Monthly active installs",
      "unit": "installs",
      "caveat": "Counts installs, not people. A month still running is a partial count."
    },
    {
      "id": "new_installs",
      "title": "New installs",
      "unit": "installs",
      "caveat": "Only installs that ran a version with usage counts and left them on. App Store downloads are a separate number."
    },
    {
      "id": "purchases",
      "title": "Purchases",
      "unit": "purchases",
      "caveat": "Production purchases as Apple reported them to Midgar's ledger."
    },
    {
      "id": "refunds",
      "title": "Refunds",
      "unit": "refunds",
      "caveat": "The week Apple told Midgar about the refund, not the week of the purchase."
    },
    {
      "id": "ai_requests",
      "title": "AI requests",
      "unit": "requests",
      "caveat": "Chat requests only; image generations are not counted here."
    },
    {
      "id": "active_subscriptions",
      "title": "Active subscriptions",
      "unit": "subscriptions",
      "caveat": "Counted from the transactions the ledger has; a subscription bought before the ledger existed counts from its first renewal."
    },
    {
      "id": "retention_w1",
      "title": "Week-1 retention",
      "unit": "share",
      "caveat": "The latest cohort has no week 1 yet."
    },
    {
      "id": "retention_w4",
      "title": "Week-4 retention",
      "unit": "share",
      "caveat": "Cohorts younger than four weeks have no value."
    }
  ]
}
