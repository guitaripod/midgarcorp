<script>
  import { eqPath, EQ_START, clampGain, gainAt } from '../../lib/eq-curve';

  /// Lets a reader drag the curve the way Flaccy's Simple equalizer does: each point moves up and
  /// down in whole decibels between −12 and +12, by pointer or by arrow keys.
  function startEqualizer(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>('svg');
    const line = root.querySelector<SVGPathElement>('[data-eq-line]');
    const area = root.querySelector<SVGPathElement>('[data-eq-area]');
    const reset = root.querySelector<HTMLButtonElement>('[data-eq-reset]');
    const caption = root.querySelector<HTMLElement>('[data-eq-caption]');
    const points = Array.from(root.querySelectorAll<SVGCircleElement>('[data-eq-point]'));
    if (!svg || !line || !area || !reset || !points.length) return;

    const gains = [...EQ_START];
    let dragging: number | null = null;

    const render = () => {
      line.setAttribute('d', eqPath(gains, false));
      area.setAttribute('d', eqPath(gains, true));
      points.forEach((point, i) => {
        point.setAttribute('cy', String(210 - gains[i] * 15));
        point.setAttribute('aria-valuenow', String(gains[i]));
        point.setAttribute('aria-valuetext', `${gains[i] > 0 ? '+' : ''}${gains[i]} dB`);
      });
      reset.hidden = gains.every((g, i) => g === EQ_START[i]);
    };

    const toGain = (event: PointerEvent) => {
      const box = svg.getBoundingClientRect();
      const y = ((event.clientY - box.top) / box.height) * 420;
      return gainAt(y);
    };

    points.forEach((point, i) => {
      point.setAttribute('tabindex', '0');
      point.addEventListener('pointerdown', (event) => {
        dragging = i;
        point.setPointerCapture(event.pointerId);
        point.classList.add('is-active');
      });
      point.addEventListener('pointermove', (event) => {
        if (dragging !== i) return;
        gains[i] = toGain(event);
        render();
      });
      const release = () => {
        dragging = null;
        point.classList.remove('is-active');
      };
      point.addEventListener('pointerup', release);
      point.addEventListener('pointercancel', release);
      point.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowUp' ? 1 : event.key === 'ArrowDown' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        gains[i] = clampGain(gains[i] + step);
        render();
      });
    });

    reset.addEventListener('click', () => {
      gains.splice(0, gains.length, ...EQ_START);
      render();
    });
    if (caption) {
      caption.textContent =
        'A bass lift like the one on Flaccy’s Equalizer screen. Drag a point, or focus it and use the arrow keys.';
    }
    root.classList.add('is-live');
    render();
  }

  /// Walks the demo lyrics a line at a time, the current line filling as it is sung, unless the
  /// reader prefers less motion.
  function startKaraoke(list: HTMLElement) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const lines = Array.from(list.querySelectorAll<HTMLElement>('li'));
    let index = lines.findIndex((l) => l.classList.contains('now'));
    window.setInterval(() => {
      lines[index]?.classList.remove('now');
      lines[index]?.removeAttribute('aria-current');
      index = (index + 1) % lines.length;
      lines[index].classList.add('now');
      lines[index].setAttribute('aria-current', 'true');
    }, 3600);
  }

  document.querySelectorAll<HTMLElement>('[data-eq]').forEach(startEqualizer);
  document.querySelectorAll<HTMLElement>('[data-karaoke]').forEach(startKaraoke);
</script>

