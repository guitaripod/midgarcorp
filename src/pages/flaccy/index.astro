---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppStoreBadge from '@components/landing/AppStoreBadge.astro';
import FaqAccordion from '@components/landing/FaqAccordion.astro';
import AppIcon from '@components/landing/AppIcon.astro';
import HeroRating from '@components/landing/HeroRating.astro';
import { landingApps, screenshotUrl, type LandingApp } from '@data/landing';
import screenshotVariants from '@data/screenshot-variants.json';
import { siblingApps } from '@utils/sibling-apps';
import { appPageJsonLd } from '@utils/structured-data';
import { markdownPath } from '@utils/llms';
import { privacyUrlFor, supportPath } from '../../utils/app-links';
import { duoCombo } from '@data/duo';
import { eqPath, EQ_BANDS, EQ_START } from '../../lib/eq-curve';

export const prerender = true;

const app = landingApps.find((a) => a.slug === 'flaccy') as LandingApp;
const c = app.content;
const accent = c.accentColor || app.primaryColor;

const OG_REV = '13';
const ogImage = `/og/flaccy.png?v=${OG_REV}`;

const variants = screenshotVariants as Record<string, number[]>;

/// A figure of the page: a capture of Flaccy's seeded demo library (Meridian Wolde, Parallax
/// Hours, never a real artist), device-framed by the frames CLI, or a Flaccy for Linux window.
const figure = (src: string, w: number, h: number) => {
  const srcset = [
    ...(variants[src] ?? []).map(
      (wide) => `${screenshotUrl(src.replace(/\.webp$/, `@${wide}.webp`))} ${wide}w`
    ),
    `${screenshotUrl(src)} ${w}w`,
  ].join(', ');
  return { src: screenshotUrl(src), srcset, w, h };
};
const phone = (name: string) => figure(`/screenshots/flaccy/web-phone-${name}.webp`, 735, 1500);
const linux = (index: number) => figure(`/screenshots/flaccy/linux-${index}.webp`, 1920, 1080);
const themePhone = (name: string) =>
  figure(`/screenshots/flaccy/web-phone-theme-${name}.webp`, 735, 1523);

const shots = {
  nowPlaying: phone('now-playing'),
  album: phone('album'),
  lyrics: phone('lyrics'),
  share: phone('lyric-share'),
  year: phone('year'),
  recap: phone('recap'),
  linuxLibrary: linux(1),
};

/// The formats a track can wear, the way Flaccy badges them on every album and song.
/// The themes shown in the Themes scene: Albums on iPhone under each, in the layout the theme
/// itself picks. Flaccy's own theme is every other picture on the page.
const themes = [
  {
    id: 'phosphor',
    name: 'Phosphor',
    line: 'Green on black, monospaced, square covers, a list.',
    alt: 'Albums in Flaccy under the Phosphor theme: a list in green monospaced type on black, with square covers',
  },
  {
    id: 'liner-notes',
    name: 'Liner Notes',
    line: 'Paper and serif titles, like the sleeve it came in.',
    alt: 'Albums in Flaccy under the Liner Notes theme: a list with serif titles on a paper-colored page',
  },
  {
    id: 'hi-fi',
    name: 'Hi-Fi',
    line: 'Warm amber and covers cut round, like records.',
    alt: 'Albums in Flaccy under the Hi-Fi theme: a grid of round covers on a warm dark background with an amber accent',
  },
  {
    id: 'gallery',
    name: 'Gallery',
    line: 'A wall of covers and nothing else.',
    alt: 'Albums in Flaccy under the Gallery theme: a wall of square covers edge to edge with no titles',
  },
  {
    id: 'marquee',
    name: 'Marquee',
    line: 'One cover at a time, under stage light.',
    alt: 'Albums in Flaccy under the Marquee theme: a carousel with one large cover in the middle and the next beside it',
  },
].map((theme) => ({ ...theme, shot: themePhone(theme.id) }));

const formats = [
  { codec: 'AAC', depth: '16', rate: '44.1', note: 'lossy, from a store or a rip', level: 1 },
  { codec: 'FLAC', depth: '16', rate: '44.1', note: 'CD quality, bit for bit', level: 2 },
  { codec: 'FLAC', depth: '24', rate: '96', note: 'Hi-Res, as mastered', level: 3 },
];

/// The demo song's synced lyrics as Flaccy's seeded library sings them (Slow Machine by the
/// fictional Meridian Wolde), with the line the page starts on.
const lyrics = [
  'We are the miles we never squandered',
  'The long road learning how to hold me',
  'Slow machine, keep the light on',
  'Slow machine, don’t let go',
  'Every ending is a corner',
  'Every corner, somewhere warmer',
];
const LYRIC_START = 2;

const asks = ['Rainy Sunday morning, calm, about 40 minutes', 'Upbeat, for a 30 minute run'];

const versionLabel = app.version ? `Version ${app.version}` : null;

/// Whether the App Store's live version is 2.0 or later. The page reads the version from the store facts the site
/// refreshes, so what speaks of 2.0 appears by itself once 2.0 is out and never before.
const isTwo = Number.parseInt((app.version ?? '').split('.')[0] ?? '', 10) >= 2;

/// The question 2.0 adds to the page's own, after the equalizer's.
const themesQuestion = {
  q: 'Can I change how Flaccy looks?',
  a: 'Yes. Settings, Appearance has six themes (Flaccy, Phosphor, Marquee, Gallery, Liner Notes and Hi-Fi), each with its own colors, type, cover shape and Albums layout: grid, wall, list or carousel. You can set the cover shape, corners and font yourself over any theme, and copy a theme to change it: a theme is a folder holding one text file. Themes work on iPhone, iPad, Mac and Linux, and Apple Watch follows your iPhone.',
};
const faq = isTwo ? [...c.faq.slice(0, 2), themesQuestion, ...c.faq.slice(2)] : c.faq;

/// What 2.0 brought, in the words of its release notes.
const twoPoints = [
  {
    title: 'Themes',
    text: 'Six looks change the type, the cover shapes and the layout as well as the colors, with four ways to see your albums: a grid, a wall of covers, a list or a carousel.',
  },
  {
    title: 'Clean Library',
    text: 'One switch lists every song once, wherever its copies live: on your device, on a server or under another artist credit on the same album.',
  },
  {
    title: 'Playlists, remastered',
    text: 'A playlist updates as it changes, sorts six ways, undoes a drag or a removal and suggests songs from your own library that fit.',
  },
  {
    title: 'Your server, in step',
    text: 'Songs you hold and your server holds become one, downloads can be AAC to save room, and an Offline chip keeps what plays with no server in reach.',
  },
  {
    title: 'iPad, closer to hand',
    text: 'Lyrics and the queue stay inside the Now Playing column so the library is still there to browse, and the controls sit where your thumbs are.',
  },
];
const requires = 'iOS 18.6, macOS 26 or watchOS 11';
const privacyUrl = privacyUrlFor(app.slug);
const macUrl = c.macAppStoreUrl;
const duo = duoCombo('flaccy');

const showsRating = app.ratingCount >= 5;
const jsonLd = appPageJsonLd(app, { ratingShown: showsRating });
const siblings = siblingApps(landingApps, 'flaccy');
---

<BaseLayout
  title={c.seoTitle}
  description={c.metaDescription}
  image={ogImage}
  markdown={markdownPath(app.slug)}
  appStoreId={app.trackId > 0 ? app.trackId : undefined}
>
  <div class="fl" style={`--accent:${accent}`}>
    <nav
      aria-label="Breadcrumb"
      class="hidden pt-8 text-xs text-paper-faint dark:text-term-faint sm:block"
    >
      <ol class="flex flex-wrap items-center gap-1.5 font-mono">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/apps/" class="hover:text-paper-green dark:hover:text-term-green">apps</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">flaccy</li>
      </ol>
    </nav>

    <section class="hero bleed" aria-labelledby="app-name">
      <div class="rings" aria-hidden="true">
        {Array.from({ length: 9 }, (_, i) => <span style={`--i:${i}`} />)}
      </div>
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="hero-app">
            {
              app.iconLocal && (
                <AppIcon
                  src={app.iconLocal}
                  width={56}
                  height={56}
                  displayWidths={[48, 56]}
                  priority
                  class="hero-icon h-12 w-12 rounded-[0.9rem] object-cover sm:h-14 sm:w-14"
                />
              )
            }
            <h1 id="app-name">Flaccy</h1>
            <span>Lossless FLAC Player</span>
          </div>
          {isTwo && <p class="kicker edition">New · Flaccy 2.0</p>}
          <p class="display hero-title">Hear what you <span class="glow">own.</span></p>
          <p class="hero-sub">
            Flaccy plays the music you own at full quality, FLAC, ALAC, WAV, AIFF, MP3 and AAC, with
            a real equalizer, gapless playback, synced lyrics you can share as a video and Last.fm
            scrobbling. No account, no ads, and your files never leave your device.
          </p>
          <div class="hero-actions">
            <AppStoreBadge href={app.appStoreUrl} platform="ios" />
            {macUrl && <AppStoreBadge href={macUrl} platform="mac" />}
            <a href="#linux" class="ghost-btn">Free on Linux</a>
          </div>
          {
            showsRating && (
              <p class="hero-rating-row">
                <HeroRating rating={app.rating} count={app.ratingCount} />
              </p>
            )
          }
          <p class="hero-note">
            <span class="badge">FLAC · 24/96</span>
            iPhone, iPad, Apple Watch and Mac with one purchase, and free for 7 days from the first time
            you play your own music.
          </p>
        </div>
        <img
          class="hero-phone"
          src={shots.nowPlaying.src}
          srcset={shots.nowPlaying.srcset}
          sizes="(min-width: 1024px) clamp(300px, 17vw, 560px), 64vw"
          width={shots.nowPlaying.w}
          height={shots.nowPlaying.h}
          alt="Now Playing in Flaccy on iPhone: Slow Machine by Meridian Wolde, FLAC 24/96, over concentric rings of artwork"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </section>

    {
      isTwo && (
        <section class="band two" aria-labelledby="two-title">
          <p class="kicker-band">New in 2.0</p>
          <h2 id="two-title" class="display band-title">
            The whole player, grown up.
          </h2>
          <ul class="two-points">
            {twoPoints.map((point) => (
              <li>
                <h3>{point.title}</h3>
                <p>{point.text}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="scene formats bleed" aria-labelledby="formats-title">
      <div class="scene-inner formats-grid">
        <div>
          <h2 id="formats-title" class="display scene-title">
            See exactly what you’re <span class="glow">hearing.</span>
          </h2>
          <p class="scene-lede">
            Every album and track wears its codec, bit depth and sample rate, and a Lossless filter
            shows what is worth a good pair of headphones. Gapless playback honours your albums,
            exact to the sample for lossless files, with a queue that survives relaunches.
          </p>
          <ul class="formats-list">
            {
              formats.map((f) => (
                <li style={`--level:${f.level}`}>
                  <span class="format-codec">{f.codec}</span>
                  <span class="format-spec">
                    {f.depth}
                    <small>bit</small> / {f.rate}
                    <small>kHz</small>
                  </span>
                  <span class="format-bar" aria-hidden="true">
                    <span />
                  </span>
                  <span class="format-note">{f.note}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <img
          class="scene-phone"
          src={shots.album.src}
          srcset={shots.album.srcset}
          sizes="(min-width: 1024px) clamp(280px, 15vw, 500px), 64vw"
          width={shots.album.w}
          height={shots.album.h}
          alt="Parallax Hours by Meridian Wolde in Flaccy: FLAC 24/96 on the album and on every track"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <section class="scene eq bleed" aria-labelledby="eq-title">
      <div class="scene-inner eq-grid">
        <div class="eq-text">
          <p class="kicker kicker-teal">Equalizer</p>
          <h2 id="eq-title" class="display scene-title">
            Make it sound like <span class="glow glow-teal">yours.</span>
          </h2>
          <p class="scene-lede">
            Drag the curve and hear it change, or switch to Advanced for up to ten bands with bells,
            shelves, filters and adjustable Q. Sixteen presets and your own, AutoEq and Equalizer
            APO profiles for your headphones, and a setting for every output: AirPods, a wired DAC,
            the speaker.
          </p>
          <p class="eq-fine">
            Automatic headroom keeps boosts from clipping, Hold to compare is level-matched so
            louder never wins, and off or flat, the signal passes through untouched.
          </p>
        </div>
        <figure class="eq-panel" data-eq>
          <div class="eq-head">
            <span class="eq-title">Equalizer</span>
            <span class="eq-status">Processing · 32-bit float</span>
            <button type="button" class="eq-reset" data-eq-reset hidden>Reset</button>
          </div>
          <svg
            class="eq-svg"
            viewBox="0 0 1000 420"
            role="group"
            aria-label="An equalizer curve with ten bands from 32 Hz to 16 kHz"
          >
            <defs>
              <linearGradient id="eq-fill" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#2dd4bf" stop-opacity="0.38"></stop>
                <stop offset="1" stop-color="#2dd4bf" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            {
              [-12, -6, 0, 6, 12].map((db) => (
                <g class="eq-grid-line">
                  <line x1="60" x2="980" y1={210 - db * 15} y2={210 - db * 15} />
                  <text x="44" y={214 - db * 15}>
                    {db > 0 ? `+${db}` : db}
                  </text>
                </g>
              ))
            }
            <path class="eq-area" data-eq-area d={eqPath(EQ_START, true)}></path>
            <path class="eq-line" data-eq-line d={eqPath(EQ_START, false)}></path>
            {
              EQ_BANDS.map((band, i) => (
                <g class="eq-band">
                  <text class="eq-freq" x={band.x} y="408">
                    {band.label}
                  </text>
                  <circle
                    class="eq-point"
                    data-eq-point={i}
                    cx={band.x}
                    cy={210 - EQ_START[i] * 15}
                    r="13"
                    tabindex="-1"
                    role="slider"
                    aria-label={`${band.label} Hz`}
                    aria-valuemin="-12"
                    aria-valuemax="12"
                    aria-valuenow={EQ_START[i]}
                    aria-valuetext={`${EQ_START[i] > 0 ? '+' : ''}${EQ_START[i]} dB`}
                  />
                </g>
              ))
            }
          </svg>
          <figcaption data-eq-caption>
            A bass lift like the one on Flaccy’s Equalizer screen. Drag a point to shape it.
          </figcaption>
        </figure>
        <div class="describe">
          <p class="kicker kicker-teal">
            {isTwo ? 'Describe the Sound' : 'New in 1.19 · Describe the Sound'}
          </p>
          <p class="ask" aria-hidden="true">Warmer, with softer cymbals</p>
          <p>
            Or say how you want your music to sound, and Flaccy shapes the curve for what you are
            listening on, whether headphones, a speaker or a car. You hear it before anything is
            saved, every band says what it is for, and another sentence changes it.
          </p>
        </div>
      </div>
    </section>

    {
      isTwo && (
        <section id="themes" class="scene themes bleed" aria-labelledby="themes-title">
          <div class="scene-inner">
            <div class="themes-head">
              <p class="kicker kicker-violet">Themes</p>
              <h2 id="themes-title" class="display scene-title">
                Make it look like <span class="glow">yours.</span>
              </h2>
              <p class="scene-lede">
                Six themes come with Flaccy, and each one changes the type, the shapes and the
                layout, not only the colors. See your albums as a grid, a wall of covers, a list or
                a carousel, on iPhone, iPad, Mac and Linux, with your Apple Watch following your
                iPhone.
              </p>
              <p class="themes-fine">
                A theme is a folder holding one text file. Copy any of the six, change a line, and
                it is yours; your own cover shape, corners and font sit over whichever theme is on.
              </p>
            </div>
            <ul class="theme-strip">
              {themes.map((theme) => (
                <li>
                  <img
                    class="theme-phone"
                    src={theme.shot.src}
                    srcset={theme.shot.srcset}
                    sizes="(min-width: 1024px) min(17vw, 300px), 60vw"
                    width={theme.shot.w}
                    height={theme.shot.h}
                    alt={theme.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <h3>{theme.name}</h3>
                  <p>{theme.line}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <section class="scene lyrics bleed" aria-labelledby="lyrics-title">
      <div class="scene-inner lyrics-grid">
        <div class="lyrics-text">
          <h2 id="lyrics-title" class="display scene-title">
            Lyrics that follow <span class="glow glow-rose">every word.</span>
          </h2>
          <p class="scene-lede">
            Synced lyrics fill in word by word when a song has word timing. Tap any line to jump
            right there, and nudge the timing when a song runs off.
          </p>
          <ol class="karaoke" aria-label="Synced lyrics of the demo song Slow Machine" data-karaoke>
            {
              lyrics.map((line, i) => (
                <li
                  class:list={{ now: i === LYRIC_START }}
                  aria-current={i === LYRIC_START ? 'true' : undefined}
                >
                  {line}
                </li>
              ))
            }
          </ol>
          <p class="share-copy">
            <strong>Share Lyrics.</strong> Pick the lines you love and Flaccy makes a short video of
            them over the song itself, in four looks and four formats for Stories, posts and more.
          </p>
        </div>
        <div class="lyrics-phones">
          <img
            src={shots.lyrics.src}
            srcset={shots.lyrics.srcset}
            sizes="(min-width: 1024px) clamp(220px, 12vw, 400px), 42vw"
            width={shots.lyrics.w}
            height={shots.lyrics.h}
            alt="Synced lyrics of Slow Machine in Flaccy, the current line lit"
            loading="lazy"
            decoding="async"
          />
          <img
            src={shots.share.src}
            srcset={shots.share.srcset}
            sizes="(min-width: 1024px) clamp(220px, 12vw, 400px), 42vw"
            width={shots.share.w}
            height={shots.share.h}
            alt="Share Lyrics in Flaccy: a Story card of one line with templates, formats and colours to choose"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="band playlist" aria-labelledby="playlist-title">
      <div class="playlist-head">
        <p class="kicker-band">{isTwo ? 'Make a Playlist' : 'New in 1.19 · Make a Playlist'}</p>
        <h2 id="playlist-title" class="display band-title">Say what you want to hear.</h2>
        <div class="asks" aria-hidden="true">
          {asks.map((a) => <p class="ask ask-band">{a}</p>)}
        </div>
      </div>
      <div class="playlist-copy">
        <p>
          Flaccy makes a playlist from the music you own. It finds the artists that fit, chooses the
          songs, keeps to the length you asked for and never plays one artist three times in a row.
          Play it at once, save it as an ordinary playlist, or tap Change It and say what should be
          different.
        </p>
        <p class="aside">
          It is under the add button in Library, and in the sidebar on iPad. Your words and a
          summary of your library, your artists with their genres and years and up to 300 songs’
          titles, albums and lengths, go to Flaccy’s AI to choose them; your music itself never
          leaves your device. Making playlists is included in the trial and in Lifetime.
        </p>
      </div>
    </section>

    <section class="feature" aria-labelledby="year-title">
      <div class="feature-text">
        <h2 id="year-title" class="display feature-title">Every play counted, even offline.</h2>
        <p>
          Sign in with Last.fm and every play is scrobbled, with automatic retry once you are back
          online. Listening charts, artist bios and a wantlist for the records you are hunting sit
          beside your library.
        </p>
        <p>
          Year in Music turns your listening into story cards and a poster of your year, ready to
          share.
        </p>
      </div>
      <div class="feature-pair">
        <img
          src={shots.recap.src}
          srcset={shots.recap.srcset}
          sizes="(min-width: 768px) clamp(220px, 12vw, 400px), 42vw"
          width={shots.recap.w}
          height={shots.recap.h}
          alt="Recap in Flaccy: plays and minutes, top artists and top albums"
          loading="lazy"
          decoding="async"
        />
        <img
          src={shots.year.src}
          srcset={shots.year.srcset}
          sizes="(min-width: 768px) clamp(220px, 12vw, 400px), 42vw"
          width={shots.year.w}
          height={shots.year.h}
          alt="Year in Music 2026 in Flaccy: top artist, top track, minutes listened and tracks played"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <section id="linux" class="scene everywhere bleed" aria-labelledby="everywhere-title">
      <div class="scene-inner">
        <div class="everywhere-head">
          <h2 id="everywhere-title" class="display scene-title">
            Every screen you <span class="glow">listen on.</span>
          </h2>
          <dl class="platforms">
            <div>
              <dt>iPad</dt>
              <dd>
                A sidebar for your library and every playlist, Now Playing and Up Next in a column
                beside it, keyboard shortcuts and drag and drop.
              </dd>
            </div>
            <div>
              <dt>Mac</dt>
              <dd>
                A native app that watches your music folder, a menu bar player and your media keys.
                The same purchase as iPhone.
              </dd>
            </div>
            <div>
              <dt>Apple Watch</dt>
              <dd>
                A standalone player: sync albums and play them offline with gapless playback and
                AirPods controls, no iPhone needed.
              </dd>
            </div>
            <div>
              <dt>Linux</dt>
              <dd>
                A free, open source GTK4 app with gapless playback, MPRIS media keys, scrobbling,
                synced lyrics and the full equalizer.
              </dd>
            </div>
          </dl>
        </div>
        <figure class="linux-shot">
          <img
            src={shots.linuxLibrary.src}
            srcset={shots.linuxLibrary.srcset}
            sizes="(min-width: 1280px) 76vw, 100vw"
            width={shots.linuxLibrary.w}
            height={shots.linuxLibrary.h}
            alt="Flaccy for Linux: the album grid of the library with Made for You mixes above it and the player bar below"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Flaccy for Linux, in the library.</figcaption>
        </figure>
        {
          duo && (
            <figure class="duo">
              <img
                src={duo.src}
                srcset={duo.srcset}
                sizes="(min-width: 1024px) min(40vw, 960px), 100vw"
                width={duo.w}
                height={duo.h}
                alt="Flaccy on iPhone Duo: open, the cover on one page and synced lyrics on the other; closed, the album library on the outer display"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                Open, the cover on one page and the lyrics on the other; closed, your whole library.
              </figcaption>
            </figure>
          )
        }
        <div class="install">
          <p class="install-label">Install Flaccy for Linux</p>
          <pre><code><span class="prompt">$</span> cargo install flaccy</code></pre>
          <p class="install-alt">
            Or <code>yay -S flaccy-bin</code> on Arch. Your own server too: Flaccy plays from Navidrome,
            <a href="/flaccy/server/">Flaccy Server</a> or any OpenSubsonic server over your home network
            or Tailscale.
          </p>
        </div>
      </div>
    </section>

    {
      c.pricing && (
        <section class="band" aria-labelledby="pricing-title">
          <h2 id="pricing-title" class="display band-title">
            {c.pricing.heading}
          </h2>
          <div class="plans">
