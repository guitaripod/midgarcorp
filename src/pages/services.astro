---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerTimeline from '@components/CareerTimeline.astro';

const title = 'Engineering Services | guitaripod';
const description =
  'Independent software engineer. Six years shipping production iOS, full-stack, and AI across wearable health, cybersecurity, AI, creator economy, and software consulting. Available for new engagements.';

const capabilities = [
  {
    glyph: '[01]',
    name: 'Native iOS & SDK',
    summary:
      'Swift, SwiftUI, UIKit, AVFoundation, HealthKit, Live Activities, Widgets. SDK architecture for consumer and enterprise.',
    bullets: [
      'Greenfield apps & SDK modularization',
      'System-level architecture & migrations',
      'App Store rollout & release discipline',
    ],
  },
  {
    glyph: '[02]',
    name: 'AI integration',
    summary:
      'Multi-provider LLM abstractions, agentic workers, on-device ML, MCP servers, and production AI pipelines.',
    bullets: [
      '6+ frontier model vendors integrated',
      'Headless Claude Code in Docker',
      'Per-workload model selection',
    ],
  },
  {
    glyph: '[03]',
    name: 'Backend & infrastructure',
    summary:
      'Python/FastAPI, Go, Rust, TypeScript. Supabase / Postgres, GCP Cloud Run, Docker, GitHub Actions, Xcode Cloud.',
    bullets: [
      'API design & realtime systems',
      'Cost-optimization & observability',
      'CI/CD pipelines end-to-end',
    ],
  },
];

const consultingFeatures = [
  'System design & architecture review',
  'Code review & optimization',
  'AI integration strategy',
];

const dedicatedFeatures = [
  'Full-time, sole or shared focus',
  'Direct Slack / async communication',
  'Seamless team & toolchain integration',
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="relative pt-12 sm:pt-20 pb-12">
    <div class="max-w-3xl">
      <p class="prompt-line mb-4">man guitaripod</p>

      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-bold mb-5 leading-[1.05] tracking-tight text-paper-text dark:text-term-text"
      >
        Engineer who <span class="phosphor">ships systems</span>, not just code.
      </h1>

      <p class="text-base sm:text-lg text-paper-muted dark:text-term-muted mb-4 leading-relaxed">
        Six years shipping production iOS, full-stack, and AI across wearable health, cybersecurity,
        AI, creator economy, and software consulting. End-to-end engagements, ground-up
        architecture, or embedded on your team.
      </p>

      <p
        class="inline-flex items-center gap-2 text-xs text-paper-greendim dark:text-term-greendim mb-8"
      >
        <span class="relative flex w-1.5 h-1.5">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-paper-green dark:bg-term-green opacity-75"
          ></span>
          <span
            class="relative inline-flex rounded-full h-1.5 w-1.5 bg-paper-green dark:bg-term-green"
          ></span>
        </span>
        STATUS: available — open to new engagements
      </p>

      <div class="flex flex-wrap gap-3">
        <a
          href="#book"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-sm font-bold hover:opacity-90 transition-opacity"
        >
          ./schedule-call
        </a>
        <a
          href="#engagements"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-paper-border2 dark:border-term-border2 text-paper-text dark:text-term-text rounded-sm text-sm font-semibold hover:border-paper-green dark:hover:border-term-green hover:text-paper-green dark:hover:text-term-green transition-colors"
        >
          ./selected-engagements
        </a>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="capabilities" class="mb-16 scroll-mt-20">
    <div class="mb-6">
      <p class="prompt-line mb-3">ls ~/capabilities --long</p>
      <h2 class="text-xl sm:text-2xl font-bold text-paper-text dark:text-term-text mb-2">
        What I do
      </h2>
      <p class="text-sm text-paper-muted dark:text-term-muted max-w-2xl">
        End-to-end engineering across the stack. Deep expertise on native platforms, AI integration,
        and production backends.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-4 sm:gap-5">
      {
        capabilities.map((capability) => (
          <div class="term-frame term-frame-hover p-5 sm:p-6">
            <p class="text-sm font-bold text-paper-green dark:text-term-green mb-3">
              {capability.glyph}
            </p>
            <h3 class="text-base font-bold mb-2 text-paper-text dark:text-term-text">
              {capability.name}
            </h3>
            <p class="text-sm text-paper-muted dark:text-term-muted mb-4 leading-relaxed">
              {capability.summary}
            </p>
            <ul class="text-xs text-paper-faint dark:text-term-faint space-y-1.5">
              {capability.bullets.map((bullet) => (
                <li class="flex gap-2">
                  <span class="text-paper-greendim dark:text-term-greendim" aria-hidden="true">
                    ▸
                  </span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Selected Engagements -->
  <section id="engagements" class="mb-16 scroll-mt-20">
    <div class="mb-6">
      <p class="prompt-line mb-3">git log --employers --stat</p>
      <h2 class="text-xl sm:text-2xl font-bold text-paper-text dark:text-term-text mb-2">
        Selected engagements
      </h2>
      <p class="text-sm text-paper-muted dark:text-term-muted max-w-2xl">
        Six years of engineering services shipped to category-leading consumer products. Tap any
        engagement to expand.
      </p>
    </div>

    <CareerTimeline />
  </section>

  <!-- Engagement Options -->
  <section id="pricing" class="mb-16 scroll-mt-20">
    <div class="mb-6">
      <p class="prompt-line mb-3">cat ./rates</p>
      <h2 class="text-xl sm:text-2xl font-bold text-paper-text dark:text-term-text mb-2">
        Engagement options
      </h2>
      <p class="text-sm text-paper-muted dark:text-term-muted max-w-2xl">
        Two ways to work together. Project-based quotes on request.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-4 sm:gap-6 max-w-4xl">
      <div class="term-frame term-frame-hover p-6">
        <h3 class="text-lg font-bold mb-2 text-paper-text dark:text-term-text">
          Consulting & Advisory
        </h3>
        <p class="text-sm text-paper-muted dark:text-term-muted mb-5 leading-relaxed">
          Architecture reviews, technical strategy, and expert guidance.
        </p>
        <div class="mb-5 flex items-baseline gap-1">
          <span class="text-3xl font-bold text-paper-amber dark:text-term-amber">€200</span>
          <span class="text-sm text-paper-faint dark:text-term-faint">/ hour</span>
        </div>
        <ul class="space-y-2.5 mb-6 text-sm text-paper-text dark:text-term-text">
          {
            consultingFeatures.map((feature) => (
              <li class="flex gap-2">
                <span class="text-paper-green dark:text-term-green" aria-hidden="true">
                  ✓
                </span>
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
        <a
          href="#book"
          class="block w-full py-2.5 px-4 text-center text-sm border border-paper-border2 dark:border-term-border2 text-paper-text dark:text-term-text rounded-sm font-semibold hover:border-paper-green dark:hover:border-term-green hover:text-paper-green dark:hover:text-term-green transition-colors"
        >
          Schedule a call
        </a>
      </div>

      <div class="term-frame term-frame-hover p-6 relative">
        <span
          class="absolute top-0 right-0 px-2.5 py-1 text-xs font-bold bg-paper-amber dark:bg-term-amber text-paper-bg dark:text-term-bg rounded-none"
        >
          ★ preferred
        </span>
        <h3 class="text-lg font-bold mb-2 text-paper-text dark:text-term-text">
          Dedicated Engagement
        </h3>
        <p class="text-sm text-paper-muted dark:text-term-muted mb-5 leading-relaxed">
          Embedded engineer, full-time on your team.
        </p>
        <div class="mb-5 flex items-baseline gap-1">
          <span class="text-3xl font-bold text-paper-amber dark:text-term-amber">€35,000+</span>
          <span class="text-sm text-paper-faint dark:text-term-faint">/ month</span>
        </div>
        <ul class="space-y-2.5 mb-6 text-sm text-paper-text dark:text-term-text">
          {
            dedicatedFeatures.map((feature) => (
              <li class="flex gap-2">
                <span class="text-paper-green dark:text-term-green" aria-hidden="true">
                  ✓
                </span>
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
        <a
          href="#book"
          class="block w-full py-2.5 px-4 text-center text-sm bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm font-bold hover:opacity-90 transition-opacity"
        >
          Discuss engagement
        </a>
      </div>
    </div>

    <p class="text-sm text-paper-faint dark:text-term-faint mt-8">
      Have a specific project? <a
        href="mailto:problemsolvertm@gmail.com"
        class="text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors"
        >Request a custom quote</a
      >
    </p>
  </section>

  <!-- Booking -->
  <section id="book" class="mb-16 scroll-mt-20">
    <div class="mb-6">
      <p class="prompt-line mb-3">cal --book 20min</p>
      <h2 class="text-xl sm:text-2xl font-bold text-paper-text dark:text-term-text mb-2">
        Let's talk
      </h2>
      <p class="text-sm text-paper-muted dark:text-term-muted max-w-2xl">
        Free 20-minute call to discuss your project and whether we're a fit.
      </p>
    </div>

    <div class="term-frame overflow-hidden max-w-4xl">
      <div id="cal-embed"></div>
    </div>

    <script>
      (function (C, A, L) {
        let p = function (a, ar) {
          a.q.push(ar);
        };
        let d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement('script')).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              typeof namespace === 'string' ? (cal.ns[namespace] = api) && p(api, ar) : p(cal, ar);
              return;
            }
            p(cal, ar);
          };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');
      Cal('init', { origin: 'https://cal.com' });
      Cal('inline', {
        elementOrSelector: '#cal-embed',
        calLink: 'midgarcorp/20min',
        layout: 'month_view',
      });
      const calTheme = () =>
        document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      Cal('ui', {
        theme: calTheme(),
        styles: { branding: { brandColor: '#3fb950' } },
        hideEventTypeDetails: false,
        layout: 'month_view',
      });
      new MutationObserver(() => {
        Cal('ui', { theme: calTheme() });
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    </script>

    <p class="text-sm text-paper-faint dark:text-term-faint mt-6">
      Prefer email? <a
        href="mailto:problemsolvertm@gmail.com"
        class="text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors"
        >problemsolvertm@gmail.com</a
      >
    </p>
  </section>

  <style>
    #cal-embed {
      min-height: 600px;
    }
  </style>
</BaseLayout>
