---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const pageTitle = 'Engineering Services | Marcus Ziadé';
const pageDescription =
  'Software engineer and ML integration specialist. Currently engaged with Fortune 500 clients building SDK integrations and on-device ML solutions.';
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="relative max-w-6xl mx-auto px-4 py-12 sm:py-16">
      <div class="max-w-4xl mx-auto text-center">
        <span
          class="inline-flex items-center px-3 py-1 text-xs font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-800 dark:text-amber-200 rounded-full mb-4"
        >
          Limited Availability — Engaged Through Q1 2026
        </span>

        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4 leading-tight"
        >
          Software Engineer &
          <span
            class="bg-gradient-to-r from-blue-600 to-purple-600 dark:from-blue-400 dark:to-purple-400 bg-clip-text text-transparent"
          >
            ML Specialist</span
          >
        </h1>

        <p
          class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed max-w-2xl mx-auto"
        >
          Native apps, ML integration, and scalable systems. Currently building SDK integrations for
          a Fortune 500 security company.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="#book"
            class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition-all duration-200"
          >
            Schedule Consultation
            <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href="#services"
            class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 dark:border-gray-600 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
          >
            View Services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="py-12 bg-gray-50 dark:bg-gray-900/50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold mb-2">What I Do</h2>
        <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
          End-to-end engineering across the stack, with deep expertise in native platforms and ML.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <div
          class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow"
        >
          <div
            class="w-10 h-10 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-blue-600 dark:text-blue-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Native & SDK Development</h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-3">
            iOS (Swift), Android (Kotlin), and cross-platform SDKs for consumer and enterprise.
          </p>
          <ul class="text-xs text-gray-500 dark:text-gray-400 space-y-1">
            <li>• SDK architecture & integration</li>
            <li>• App Store optimization</li>
            <li>• Performance profiling</li>
          </ul>
        </div>

        <div
          class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg hover:shadow-xl transition-shadow"
        >
          <div
            class="w-10 h-10 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-6 h-6 text-purple-600 dark:text-purple-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
