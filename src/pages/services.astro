---
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerTimeline from '@components/CareerTimeline.astro';

const title = 'Engineering Services | Marcus Ziadé';
const description =
  'Independent software engineer. Six years shipping production iOS, full-stack, and AI across wearable health, cybersecurity, AI, creator economy, and software consulting. Available for new engagements.';
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="relative max-w-5xl mx-auto px-4 py-14 sm:py-20">
      <div class="text-center">
        <span
          class="inline-flex items-center gap-2 px-3 py-1 text-xs font-semibold bg-green-50 dark:bg-green-500/10 text-green-700 dark:text-green-300 rounded-full mb-5 ring-1 ring-inset ring-green-600/20 dark:ring-green-400/30"
        >
          <span class="relative flex w-1.5 h-1.5">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-green-500"></span>
          </span>
          Available — Open to new engagements
        </span>

        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-bold text-gray-900 dark:text-white mb-5 leading-[1.05] tracking-tight"
        >
          Engineer who
          <span class="gradient-text">ships systems</span>, not just code.
        </h1>

        <p
          class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed max-w-2xl mx-auto"
        >
          Six years shipping production iOS, full-stack, and AI across wearable health,
          cybersecurity, AI, creator economy, and software consulting. End-to-end engagements,
          ground-up architecture, or embedded on your team.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="#book"
            class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition-colors"
          >
            Schedule a Call
            <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href="#engagements"
            class="inline-flex items-center justify-center px-6 py-3 border border-gray-300 dark:border-gray-600 rounded-lg font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
          >
            See Selected Engagements
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section id="capabilities" class="py-14 bg-gray-50 dark:bg-gray-900/50 scroll-mt-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold mb-2 text-gray-900 dark:text-gray-100">
          What I do
        </h2>
        <p class="text-gray-600 dark:text-gray-300">
          End-to-end engineering across the stack. Deep expertise on native platforms, AI
          integration, and production backends.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <div
          class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 transition-colors"
        >
          <div
            class="w-10 h-10 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5 text-blue-600 dark:text-blue-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-bold mb-2 text-gray-900 dark:text-gray-100">
            Native iOS & SDK
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-3 leading-relaxed">
            Swift, SwiftUI, UIKit, AVFoundation, HealthKit, Live Activities, Widgets. SDK
            architecture for consumer and enterprise.
          </p>
          <ul class="text-xs text-gray-500 dark:text-gray-400 space-y-1">
            <li>• Greenfield apps & SDK modularization</li>
            <li>• System-level architecture & migrations</li>
            <li>• App Store rollout & release discipline</li>
          </ul>
        </div>

        <div
          class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 transition-colors"
        >
          <div
            class="w-10 h-10 bg-purple-100 dark:bg-purple-900/30 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5 text-purple-600 dark:text-purple-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-bold mb-2 text-gray-900 dark:text-gray-100">AI integration</h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-3 leading-relaxed">
            Multi-provider LLM abstractions, agentic workers, on-device ML, MCP servers, and
            production AI pipelines.
          </p>
          <ul class="text-xs text-gray-500 dark:text-gray-400 space-y-1">
            <li>• 6+ frontier model vendors integrated</li>
            <li>• Headless Claude Code in Docker</li>
            <li>• Per-workload model selection</li>
          </ul>
        </div>

        <div
          class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 transition-colors"
        >
          <div
            class="w-10 h-10 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5 text-green-600 dark:text-green-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-base font-bold mb-2 text-gray-900 dark:text-gray-100">
            Backend & infrastructure
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-3 leading-relaxed">
            Python/FastAPI, Go, Rust, TypeScript. Supabase / Postgres, GCP Cloud Run, Docker, GitHub
            Actions, Xcode Cloud.
          </p>
          <ul class="text-xs text-gray-500 dark:text-gray-400 space-y-1">
            <li>• API design & realtime systems</li>
            <li>• Cost-optimization & observability</li>
            <li>• CI/CD pipelines end-to-end</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Engagements -->
  <section id="engagements" class="py-14 bg-white dark:bg-transparent scroll-mt-20">
    <div class="max-w-5xl mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold mb-2 text-gray-900 dark:text-gray-100">
          Selected engagements
        </h2>
        <p class="text-gray-600 dark:text-gray-300">
          Six years of engineering services shipped to category-leading consumer products. Tap any
          engagement to expand.
        </p>
      </div>

      <CareerTimeline />
    </div>
  </section>

  <!-- Engagement Options -->
  <section id="pricing" class="py-14 bg-gray-50 dark:bg-gray-900/50 scroll-mt-20">
    <div class="max-w-4xl mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold mb-2 text-gray-900 dark:text-gray-100">
          Engagement options
        </h2>
        <p class="text-gray-600 dark:text-gray-300">
          Two ways to work together. Project-based quotes on request.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div
          class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden"
        >
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 text-gray-900 dark:text-gray-100">
              Consulting & Advisory
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-5 leading-relaxed">
              Architecture reviews, technical strategy, and expert guidance.
            </p>
            <div class="mb-5 flex items-baseline gap-1">
              <span class="text-3xl font-bold text-gray-900 dark:text-gray-100">€200</span>
              <span class="text-sm text-gray-500 dark:text-gray-400">/ hour</span>
            </div>
            <ul class="space-y-2.5 mb-6 text-sm text-gray-700 dark:text-gray-300">
              <li class="flex items-start gap-2">
                <svg
                  class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>System design & architecture review</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Code review & optimization</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>AI integration strategy</span>
              </li>
            </ul>
            <a
              href="#book"
              class="block w-full py-2.5 px-4 text-center text-sm bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors"
            >
              Schedule a call
            </a>
          </div>
        </div>

        <div
          class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border-2 border-blue-500 overflow-hidden relative"
        >
          <div
            class="absolute top-0 right-0 bg-blue-500 text-white px-3 py-0.5 text-xs font-semibold rounded-bl-lg"
          >
            Preferred
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2 text-gray-900 dark:text-gray-100">
              Dedicated Engagement
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-5 leading-relaxed">
              Embedded engineer, full-time on your team.
            </p>
            <div class="mb-5 flex items-baseline gap-1">
              <span class="text-3xl font-bold text-gray-900 dark:text-gray-100">€35,000+</span>
              <span class="text-sm text-gray-500 dark:text-gray-400">/ month</span>
            </div>
            <ul class="space-y-2.5 mb-6 text-sm text-gray-700 dark:text-gray-300">
              <li class="flex items-start gap-2">
                <svg
                  class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Full-time, sole or shared focus</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Direct Slack / async communication</span>
              </li>
              <li class="flex items-start gap-2">
                <svg
                  class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Seamless team & toolchain integration</span>
              </li>
            </ul>
            <a
              href="#book"
              class="block w-full py-2.5 px-4 text-center text-sm bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition-colors"
            >
              Discuss engagement
            </a>
          </div>
        </div>
      </div>

      <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-8">
        Have a specific project? <a
          href="mailto:problemsolvertm@gmail.com"
          class="text-blue-600 dark:text-blue-400 hover:underline">Request a custom quote</a
        >
      </p>
    </div>
  </section>

  <!-- Booking -->
  <section id="book" class="py-14 bg-white dark:bg-transparent scroll-mt-20">
    <div class="max-w-4xl mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold mb-2 text-gray-900 dark:text-gray-100">
          Let's talk
        </h2>
        <p class="text-gray-600 dark:text-gray-300">
          Free 20-minute call to discuss your project and whether we're a fit.
        </p>
      </div>

      <div
        class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden"
      >
        <div id="cal-embed"></div>
      </div>

      <script>
        (function (C, A, L) {
          let p = function (a, ar) {
            a.q.push(ar);
          };
          let d = C.document;
          C.Cal =
            C.Cal ||
            function () {
              let cal = C.Cal;
              let ar = arguments;
              if (!cal.loaded) {
                cal.ns = {};
                cal.q = cal.q || [];
                d.head.appendChild(d.createElement('script')).src = A;
                cal.loaded = true;
              }
              if (ar[0] === L) {
                const api = function () {
                  p(api, arguments);
                };
                const namespace = ar[1];
                api.q = api.q || [];
                typeof namespace === 'string'
                  ? (cal.ns[namespace] = api) && p(api, ar)
                  : p(cal, ar);
                return;
              }
              p(cal, ar);
            };
        })(window, 'https://app.cal.com/embed/embed.js', 'init');
        Cal('init', { origin: 'https://cal.com' });
        Cal('inline', {
          elementOrSelector: '#cal-embed',
          calLink: 'midgarcorp/20min',
          layout: 'month_view',
        });
        Cal('ui', {
          theme: 'light',
          styles: { branding: { brandColor: '#2563eb' } },
          hideEventTypeDetails: false,
          layout: 'month_view',
        });
      </script>

      <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-6">
        Prefer email? <a
          href="mailto:problemsolvertm@gmail.com"
          class="text-blue-600 dark:text-blue-400 hover:underline">problemsolvertm@gmail.com</a
        >
      </p>
    </div>
  </section>

  <style>
    #cal-embed {
      min-height: 600px;
    }

    html.dark #cal-embed {
      filter: invert(0.9) hue-rotate(180deg);
    }
  </style>
</BaseLayout>
