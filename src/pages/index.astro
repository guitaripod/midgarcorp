---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppCard from '@components/AppCard.astro';
import OpenSourceCard from '@components/OpenSourceCard.astro';
import CLIAppCard from '@components/CLIAppCard.astro';
import MatrixRain from '@components/MatrixRain.astro';
import { getCollection } from 'astro:content';
import { calculateReadingTime } from '@utils/reading-time';
import appsData from '../data/apps.json';
import openSourceData from '../data/opensource.json';
import careerData from '../data/career.json';
import { landingApps } from '@data/landing';

const landingByTrack = new Map(landingApps.map((a) => [String(a.trackId), a]));
const trackIdFor = (appStoreUrl: string): string | undefined => appStoreUrl.match(/id(\d+)/)?.[1];
const landingHrefFor = (appStoreUrl: string): string | undefined => {
  const la = landingByTrack.get(trackIdFor(appStoreUrl) ?? '');
  return la ? `/${la.slug}` : undefined;
};
const cardApp = (app: (typeof appsData.apps)[number]) => {
  const la = landingByTrack.get(trackIdFor(app.appStoreUrl) ?? '');
  return la ? { ...app, price: la.price } : app;
};

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const postsWithReadingTime = posts.map((post) => ({
  ...post,
  readingTime: calculateReadingTime(post.body),
}));

const featuredApps = [...appsData.apps]
  .sort((a, b) => new Date(b.releaseDate).getTime() - new Date(a.releaseDate).getTime())
  .slice(0, 2);

const cliTools = openSourceData.projects
  .filter((project) => project.category === 'CLI Tools')
  .sort((a, b) => b.stars - a.stars);
const featuredCLIPicks = ['flyr', 'unrager'];
const featuredCLITools = [
  ...featuredCLIPicks.map((id) => cliTools.find((tool) => tool.id === id)).filter(Boolean),
  ...cliTools.filter((tool) => !featuredCLIPicks.includes(tool.id)),
].slice(0, 2);

const featuredCLIIds = new Set(featuredCLITools.map((tool) => tool.id));
const featuredOpenSource = openSourceData.projects
  .filter((project) => !featuredCLIIds.has(project.id))
  .slice(0, 6);

const totalStars = openSourceData.projects.reduce((sum, project) => sum + project.stars, 0);
const stats = [
  { key: 'years_shipping', value: String(careerData.summary.yearsActive) },
  { key: 'production_commits', value: careerData.summary.totalCommits },
  { key: 'lines_shipped', value: careerData.summary.totalLocLabel },
  { key: 'apps_live', value: String(appsData.apps.length) },
  { key: 'oss_projects', value: String(openSourceData.projects.length) },
  { key: 'github_stars', value: String(totalStars) },
];

const engagements = careerData.entries.slice(0, 3);
---

<BaseLayout
  title="Midgar Corp — guitaripod"
  description={`Independent engineer. Six years shipping production iOS, backend, and AI for category-leading consumer products. ${appsData.apps.length} apps live on the App Store, ${openSourceData.projects.length} open-source projects.`}
>
  <!-- Hero -->
  <section class="relative pt-12 sm:pt-20 pb-12 overflow-hidden">
    <MatrixRain />
    <div class="relative max-w-3xl">
      <p class="prompt-line mb-4">whoami</p>

      <h1
        class="text-4xl sm:text-6xl md:text-7xl font-bold mb-6 leading-[1.05] tracking-tight text-paper-text dark:text-term-text"
      >
        Engineer who<br />
        <span class="phosphor cursor-blink">ships.</span>
      </h1>

      <p
        class="text-base sm:text-lg text-paper-muted dark:text-term-muted mb-4 leading-relaxed max-w-2xl"
      >
        <span class="text-paper-text dark:text-term-text font-semibold">guitaripod</span> — six years
        shipping production iOS, backend, and AI for category-leading consumer products. Now building
        my own: {appsData.apps.length} apps live on the App Store, {openSourceData.projects.length} open-source
        projects.
      </p>

      <p
        class="inline-flex items-center gap-2 text-xs text-paper-greendim dark:text-term-greendim mb-8"
      >
        <span class="relative flex w-1.5 h-1.5">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-paper-green dark:bg-term-green opacity-75"
          ></span>
          <span
            class="relative inline-flex rounded-full h-1.5 w-1.5 bg-paper-green dark:bg-term-green"
          ></span>
        </span>
        STATUS: available — open to new engagements
      </p>

      <div class="flex flex-wrap gap-3">
        <a
          href="/services"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-sm font-bold hover:opacity-90 transition-opacity"
        >
          ./work-with-me
        </a>
        <a
          href="/apps"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-paper-border2 dark:border-term-border2 text-paper-text dark:text-term-text rounded-sm text-sm font-semibold hover:border-paper-green dark:hover:border-term-green hover:text-paper-green dark:hover:text-term-green transition-colors"
        >
          ./see-the-work
        </a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="mb-16">
    <div class="term-frame p-5 sm:p-6">
      <p class="prompt-line mb-4">midgar --stats</p>
      <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-4">
        {
          stats.map((stat) => (
            <div>
              <dd class="text-2xl sm:text-3xl font-bold tracking-tight text-paper-text dark:text-term-text">
                {stat.value}
              </dd>
              <dt class="text-xs text-paper-muted dark:text-term-muted mt-1">{stat.key}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Selected Engagements -->
  <section class="mb-16">
    <a href="/services#engagements" class="group block term-frame term-frame-hover p-5 sm:p-6">
      <div class="flex items-center justify-between mb-5">
        <p class="prompt-line">git log --employers --oneline</p>
        <span
          class="text-xs text-paper-greendim dark:text-term-greendim opacity-70 group-hover:opacity-100 transition-opacity"
        >
          full timeline →
        </span>
      </div>

      <ul class="space-y-3">
        {
          engagements.map((entry) => (
            <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 text-sm">
              <span class="text-paper-amber dark:text-term-amber whitespace-nowrap sm:w-44 shrink-0">
                {entry.dateRange.replace(' — ', '→')}
              </span>
              <span class="text-paper-text dark:text-term-text font-semibold">
                {entry.headline}
              </span>
              <span class="text-paper-muted dark:text-term-muted">{entry.role}</span>
            </li>
          ))
        }
      </ul>

      <p class="mt-5 text-sm text-paper-muted dark:text-term-muted leading-relaxed">
        From a multi-billion-dollar wearable health platform to a NASDAQ-listed cybersecurity
        company to an AI-native health startup — engineering services shipped to category-leading
        consumer products.
      </p>
    </a>
  </section>

  <!-- Featured Apps -->
  <section class="mb-16">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-paper-text dark:text-term-text">
        <span class="text-paper-green dark:text-term-green">~/apps</span> · latest releases
      </h2>
      <a
        href="/apps"
        class="text-sm text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors"
      >
        ls apps/ →
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      {
        featuredApps.map((app) => (
          <AppCard app={cardApp(app)} landingHref={landingHrefFor(app.appStoreUrl)} />
        ))
      }
    </div>
  </section>

  <!-- CLI Tools -->
  <section class="mb-16">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-paper-text dark:text-term-text">
        <span class="text-paper-green dark:text-term-green">~/cli</span> · tools for the terminal
      </h2>
      <a
        href="/cli-tools"
        class="text-sm text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors"
      >
        ls cli/ →
      </a>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {featuredCLITools.map((tool) => <CLIAppCard project={tool} />)}
    </div>
  </section>

  <!-- Open Source -->
  <section class="mb-16">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-paper-text dark:text-term-text">
        <span class="text-paper-green dark:text-term-green">~/oss</span> · open source
      </h2>
      <a
        href="/opensource"
        class="text-sm text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors"
      >
        ls oss/ →
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {featuredOpenSource.map((project) => <OpenSourceCard project={project} />)}
    </div>
  </section>

  <!-- Recent Posts -->
  <section class="mb-16">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-paper-text dark:text-term-text">
        <span class="text-paper-green dark:text-term-green">~/blog</span> · recent writing
      </h2>
      <a
        href="/archive"
        class="text-sm text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors"
      >
        ls blog/ →
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
      {
        postsWithReadingTime.map((post) => {
          const formattedDate = post.data.pubDate.toISOString().slice(0, 10);

          return (
            <article class="group term-frame term-frame-hover p-4 sm:p-5">
              <a href={`/blog/${post.slug}`} class="block">
                <h3 class="text-base sm:text-lg font-semibold text-paper-text dark:text-term-text group-hover:text-paper-green dark:group-hover:text-term-green transition-colors mb-2">
                  {post.data.title}
                </h3>
                <p class="text-sm text-paper-muted dark:text-term-muted mb-3 line-clamp-2 font-sans">
                  {post.data.description}
                </p>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-paper-faint dark:text-term-faint">
                  <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                  <span>{post.readingTime} min</span>
                  {post.data.tags.length > 0 && (
                    <span class="flex flex-wrap gap-2">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <span class="text-paper-greendim dark:text-term-greendim">#{tag}</span>
                      ))}
                    </span>
                  )}
                </div>
              </a>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
