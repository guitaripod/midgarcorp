---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppCard from '@components/AppCard.astro';
import OpenSourceCard from '@components/OpenSourceCard.astro';
import CLIAppCard from '@components/CLIAppCard.astro';
import { getCollection } from 'astro:content';
import { calculateReadingTime } from '@utils/reading-time';
import appsData from '../data/apps.json';
import openSourceData from '../data/opensource.json';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

// Add reading time to posts
const postsWithReadingTime = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await post.render();
    const readingTime = calculateReadingTime(post.body);
    return { ...post, readingTime };
  })
);

// Get featured apps (App of the Dead and PixiePocket)
const featuredAppIds = ['app-of-the-dead-afterlife', 'pixiepocket'];
const featuredApps = featuredAppIds
  .map((id) => appsData.apps.find((app) => app.id === id))
  .filter(Boolean);

// Get all CLI tools
const allCLITools = openSourceData.projects
  .filter((project) => project.category === 'CLI Tools')
  .sort((a, b) => {
    // Sort by updatedAt date first (most recent first)
    const dateA = a.updatedAt ? new Date(a.updatedAt).getTime() : 0;
    const dateB = b.updatedAt ? new Date(b.updatedAt).getTime() : 0;
    return dateB - dateA;
  });

// Add weavex manually
const weavex = {
  id: 'weavex',
  name: 'Weavex',
  description:
    'Autonomous AI research agent powered by local LLMs. Watch as your model searches the web, reasons through queries, and synthesizes intelligent answers with citations.',
  language: 'Rust',
  platforms: ['macOS', 'Linux', 'Windows'],
  stars: 0,
  githubUrl: 'https://github.com/guitaripod/weavex',
  category: 'CLI Tools',
  highlights: ['AI Agent', 'Web Search', 'Local LLMs'],
  topics: ['cli', 'rust', 'ai', 'ollama', 'agent', 'search'],
  commitCount: 0,
};

// Add nasa-rs manually since it's not in the JSON data
const nasars = {
  id: 'nasa-rs',
  name: 'nasa-rs',
  description:
    'Comprehensive CLI tool for accessing NASA APIs - APOD, Mars rovers, asteroids, and more.',
  language: 'Rust',
  platforms: ['macOS', 'Linux', 'Windows'],
  stars: 0,
  githubUrl: 'https://github.com/guitaripod/nasa-rs',
  category: 'CLI Tools',
  highlights: ['NASA APIs', 'Space data', 'Astronomy'],
  topics: ['cli', 'rust', 'nasa', 'space', 'astronomy'],
  commitCount: 0,
};

// Feature Weavex and nasa-rs
const featuredCLITools = [];
featuredCLITools.push(weavex);
featuredCLITools.push(nasars);

// If we don't have both, fill with other CLI tools
if (featuredCLITools.length < 2) {
  const otherTools = allCLITools.filter((tool) => tool.name.toLowerCase() !== 'weavex');
  featuredCLITools.push(...otherTools.slice(0, 2 - featuredCLITools.length));
}

// Calculate stats
const totalPosts = (await getCollection('blog')).filter((post) => !post.data.draft).length;
const totalApps = appsData.apps.length;
const technologies = ['Swift', 'SwiftUI', 'UIKit', 'Go', 'TypeScript', 'Docker'];

// Social links
const socialLinks = [{ name: 'GitHub', url: 'https://github.com/guitaripod', icon: 'github' }];
---

<BaseLayout
  title="Midgar Corp — Marcus Ziadé"
  description="Independent engineer. Six years shipping production iOS, backend, and AI across category-leading consumer products. Plus a stable of native apps, open-source projects, and CLI tools."
>
  <!-- Hero -->
  <section class="pt-10 sm:pt-16 pb-10">
    <div class="text-center max-w-3xl mx-auto">
      <span
        class="inline-flex items-center gap-2 px-3 py-1 text-xs font-semibold bg-green-50 dark:bg-green-500/10 text-green-700 dark:text-green-300 rounded-full mb-6 ring-1 ring-inset ring-green-600/20 dark:ring-green-400/30"
      >
        <span class="relative flex w-1.5 h-1.5">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
          ></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-green-500"></span>
        </span>
        Available — Open to new engagements
      </span>

      <h1
        class="text-5xl sm:text-6xl md:text-7xl font-bold text-gray-900 dark:text-white mb-6 leading-[1] tracking-tight"
      >
        Engineer who
        <span class="gradient-text">ships</span>.
      </h1>

      <p
        class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 mb-8 leading-relaxed max-w-2xl mx-auto"
      >
        Six years shipping production iOS, backend, and AI to category-leading consumer products.
        Plus a stable of native apps, {openSourceData.projects.length}+ open-source projects, and
        CLI tools.
      </p>

      <div class="flex flex-wrap gap-3 justify-center">
        <a
          href="/services#engagements"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition-colors"
        >
          Selected engagements
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <a
          href="/services#book"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-300 dark:border-gray-600 hover:border-gray-400 dark:hover:border-gray-500 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-semibold transition-colors"
        >
          Schedule a call
        </a>
      </div>
    </div>
  </section>

  <!-- Selected Engagements teaser -->
  <section class="mb-16">
    <a href="/services#engagements" class="group block">
      <div
        class="relative bg-white dark:bg-gray-800/40 rounded-xl p-6 sm:p-8 border border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-blue-500/60 transition-colors"
      >
        <div class="flex items-center justify-between mb-5">
          <h2
            class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-[0.18em]"
          >
            Selected Engagements
          </h2>
          <span
            class="text-xs text-blue-600 dark:text-blue-400 inline-flex items-center gap-1 font-medium opacity-70 group-hover:opacity-100 transition-opacity"
          >
            Full timeline
            <svg
              class="w-3.5 h-3.5 transform transition-transform group-hover:translate-x-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
              ></path>
            </svg>
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
          <div>
            <p
              class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-50 tracking-tight"
            >
              6
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider mt-1">
              years shipping
            </p>
          </div>
          <div>
            <p
              class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-50 tracking-tight"
            >
              6,000+
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider mt-1">
              commits
            </p>
          </div>
          <div>
            <p
              class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-50 tracking-tight"
            >
              ~790k
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider mt-1">
              lines shipped
            </p>
          </div>
          <div>
            <p
              class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-50 tracking-tight"
            >
              5
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider mt-1">
              industries
            </p>
          </div>
        </div>

        <p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 leading-relaxed mb-5">
          From a multi-billion-dollar wearable health platform to a NASDAQ-listed cybersecurity
          company to an AI-native health & wellness startup — six years of engineering services
          shipped to category-leading consumer products.
        </p>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs sm:text-sm">
          <span
            class="inline-flex items-center gap-1.5 text-gray-700 dark:text-gray-300 font-medium"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-violet-500"></span> AI · Health
          </span>
          <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">·</span>
          <span
            class="inline-flex items-center gap-1.5 text-gray-700 dark:text-gray-300 font-medium"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span> Cybersecurity
          </span>
          <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">·</span>
          <span
            class="inline-flex items-center gap-1.5 text-gray-700 dark:text-gray-300 font-medium"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Wearable health
          </span>
          <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">·</span>
          <span
            class="inline-flex items-center gap-1.5 text-gray-700 dark:text-gray-300 font-medium"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Software consulting
          </span>
          <span class="text-gray-300 dark:text-gray-700" aria-hidden="true">·</span>
          <span
            class="inline-flex items-center gap-1.5 text-gray-700 dark:text-gray-300 font-medium"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-fuchsia-500"></span> Creator economy
          </span>
        </div>
      </div>
    </a>
  </section>

  <!-- Featured Apps Section -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Featured Apps</h2>
      <a
        href="/apps"
        class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
      >
        View all apps
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      {featuredApps.map((app) => <AppCard app={app} />)}
    </div>
  </section>

  <!-- CLI Tools Section -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100">CLI Tools</h2>
      <a
        href="/cli-tools"
        class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
      >
        View more CLI tools
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {featuredCLITools.map((tool) => <CLIAppCard project={tool} />)}
    </div>
  </section>

  <!-- Open Source Section -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Open Source</h2>
      <a
        href="/opensource"
        class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
      >
        View all projects
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        openSourceData.projects
          .filter((project) => project.stars >= 4)
          .slice(0, 6)
          .map((project) => <OpenSourceCard project={project} />)
      }
    </div>
  </section>

  <!-- Recent Posts Section with Enhancements -->
  <section class="mb-16">
    <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8">Recent Posts</h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {
        postsWithReadingTime.map((post) => {
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });

          return (
            <article class="group bg-white dark:bg-gray-800 rounded-xl p-4 sm:p-6 border border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 transition-all duration-300 hover:shadow-lg">
              <a href={`/blog/${post.slug}`} class="block">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <h3 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2">
                      {post.data.title}
                    </h3>
                    <p class="text-gray-600 dark:text-gray-300 mb-3 line-clamp-2">
                      {post.data.description}
                    </p>
                    <div class="flex flex-wrap items-center gap-2 sm:gap-4 text-xs sm:text-sm text-gray-500 dark:text-gray-500">
                      <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                      <span class="flex items-center gap-1">
                        <svg
                          class="w-3.5 h-3.5 sm:w-4 sm:h-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                          />
                        </svg>
                        {post.readingTime} min read
                      </span>
                      {post.data.tags.length > 0 && (
                        <div class="flex flex-wrap gap-1 sm:gap-2">
                          {post.data.tags.slice(0, 3).map((tag) => (
                            <span class="text-blue-600 dark:text-blue-400">#{tag}</span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                  {post.data.image && (
                    <img
                      src={post.data.image}
                      alt=""
                      class="w-full sm:w-20 h-48 sm:h-20 rounded-lg object-cover flex-shrink-0"
                      loading="lazy"
                    />
                  )}
                </div>
              </a>
            </article>
          );
        })
      }
    </div>

    {
      postsWithReadingTime.length === 0 && (
        <p class="text-gray-600 dark:text-gray-400 text-center py-8">
          No posts yet. Check back soon!
        </p>
      )
    }

    {
      postsWithReadingTime.length === 4 && (
        <div class="mt-12 text-center">
          <a
            href="/archive"
            class="inline-flex items-center gap-2 px-6 py-3 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
          >
            View all posts
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.5s ease-out;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
