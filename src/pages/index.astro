---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppCard from '@components/AppCard.astro';
import OpenSourceCard from '@components/OpenSourceCard.astro';
import CLIAppCard from '@components/CLIAppCard.astro';
import { getCollection } from 'astro:content';
import { calculateReadingTime } from '@utils/reading-time';
import appsData from '../data/apps.json';
import openSourceData from '../data/opensource.json';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

// Add reading time to posts
const postsWithReadingTime = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await post.render();
    const readingTime = calculateReadingTime(post.body);
    return { ...post, readingTime };
  })
);

// Get featured apps (App of the Dead and PixiePocket)
const featuredAppIds = ['app-of-the-dead-afterlife', 'pixiepocket'];
const featuredApps = featuredAppIds
  .map((id) => appsData.apps.find((app) => app.id === id))
  .filter(Boolean);

// Get all CLI tools
const allCLITools = openSourceData.projects
  .filter((project) => project.category === 'CLI Tools')
  .sort((a, b) => {
    // Sort by updatedAt date first (most recent first)
    const dateA = a.updatedAt ? new Date(a.updatedAt).getTime() : 0;
    const dateB = b.updatedAt ? new Date(b.updatedAt).getTime() : 0;
    return dateB - dateA;
  });

// Add weavex manually
const weavex = {
  id: 'weavex',
  name: 'Weavex',
  description:
    'Autonomous AI research agent powered by local LLMs. Watch as your model searches the web, reasons through queries, and synthesizes intelligent answers with citations.',
  language: 'Rust',
  platforms: ['macOS', 'Linux', 'Windows'],
  stars: 0,
  githubUrl: 'https://github.com/guitaripod/weavex',
  category: 'CLI Tools',
  highlights: ['AI Agent', 'Web Search', 'Local LLMs'],
  topics: ['cli', 'rust', 'ai', 'ollama', 'agent', 'search'],
  commitCount: 0,
};

// Add nasa-rs manually since it's not in the JSON data
const nasars = {
  id: 'nasa-rs',
  name: 'nasa-rs',
  description:
    'Comprehensive CLI tool for accessing NASA APIs - APOD, Mars rovers, asteroids, and more.',
  language: 'Rust',
  platforms: ['macOS', 'Linux', 'Windows'],
  stars: 0,
  githubUrl: 'https://github.com/guitaripod/nasa-rs',
  category: 'CLI Tools',
  highlights: ['NASA APIs', 'Space data', 'Astronomy'],
  topics: ['cli', 'rust', 'nasa', 'space', 'astronomy'],
  commitCount: 0,
};

// Feature Weavex and nasa-rs
const featuredCLITools = [];
featuredCLITools.push(weavex);
featuredCLITools.push(nasars);

// If we don't have both, fill with other CLI tools
if (featuredCLITools.length < 2) {
  const otherTools = allCLITools.filter((tool) => tool.name.toLowerCase() !== 'weavex');
  featuredCLITools.push(...otherTools.slice(0, 2 - featuredCLITools.length));
}

// Calculate stats
const totalPosts = (await getCollection('blog')).filter((post) => !post.data.draft).length;
const totalApps = appsData.apps.length;
const technologies = ['Swift', 'SwiftUI', 'UIKit', 'Go', 'TypeScript', 'Docker'];

// Social links
const socialLinks = [{ name: 'GitHub', url: 'https://github.com/guitaripod', icon: 'github' }];
---

<BaseLayout
  title="Compiled Thoughts"
  description="Engineer who ships across iOS, macOS, tvOS, web, and Linux. Currently building open source tools and apps that solve real problems."
>
  <!-- Compact Hero Section -->
  <section class="mb-12 pt-8">
    <div class="text-center">
      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 mb-6">
        Engineer who ships across iOS, macOS, tvOS, web, and Linux.
      </p>
      
      <!-- Quick Stats -->
      <div class="flex justify-center gap-8 mb-6 text-sm">
        <div class="flex items-center gap-2">
          <span class="text-2xl font-bold text-gray-900 dark:text-gray-100">{totalApps}</span>
          <span class="text-gray-600 dark:text-gray-400">Apps</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-2xl font-bold text-gray-900 dark:text-gray-100">{openSourceData.projects.length}+</span>
          <span class="text-gray-600 dark:text-gray-400">Open Source</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-2xl font-bold text-gray-900 dark:text-gray-100">{totalPosts}</span>
          <span class="text-gray-600 dark:text-gray-400">Articles</span>
        </div>
      </div>

      <!-- Compact CTAs -->
      <div class="flex gap-3 justify-center flex-wrap">
        <a
          href="/apps"
          class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700 transition-all duration-200"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
            ></path>
          </svg>
          View Apps
        </a>
        <a
          href="/opensource"
          class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-medium hover:border-gray-400 dark:hover:border-gray-500 transition-all duration-200"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          Open Source
        </a>
        <a
          href="/archive"
          class="inline-flex items-center gap-2 px-4 py-2 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg text-sm font-medium hover:bg-gray-800 dark:hover:bg-gray-100 transition-all duration-200"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path>
          </svg>
          Blog
        </a>
        <a
          href="/services"
          class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700 transition-all duration-200"
        >
          <span class="w-1.5 h-1.5 bg-white rounded-full animate-pulse"></span>
          Services
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Apps Section -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Featured Apps</h2>
      <a
        href="/apps"
        class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
      >
        View all apps
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      {featuredApps.map((app) => <AppCard app={app} />)}
    </div>
  </section>

  <!-- CLI Tools Section -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100">CLI Tools</h2>
      <a
        href="/cli-tools"
        class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
      >
        View more CLI tools
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {featuredCLITools.map((tool) => <CLIAppCard project={tool} />)}
    </div>
  </section>

  <!-- Open Source Section -->
  <section class="mb-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Open Source</h2>
      <a
        href="/opensource"
        class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
      >
        View all projects
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        openSourceData.projects
          .filter((project) => project.stars >= 4)
          .slice(0, 6)
          .map((project) => <OpenSourceCard project={project} />)
      }
    </div>
  </section>

  <!-- Recent Posts Section with Enhancements -->
  <section class="mb-16">
    <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8">Recent Posts</h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {
        postsWithReadingTime.map((post) => {
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });

          return (
            <article class="group bg-white dark:bg-gray-800 rounded-xl p-4 sm:p-6 border border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 transition-all duration-300 hover:shadow-lg">
              <a href={`/blog/${post.slug}`} class="block">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <h3 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2">
                      {post.data.title}
                    </h3>
                    <p class="text-gray-600 dark:text-gray-300 mb-3 line-clamp-2">
                      {post.data.description}
                    </p>
                    <div class="flex flex-wrap items-center gap-2 sm:gap-4 text-xs sm:text-sm text-gray-500 dark:text-gray-500">
                      <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                      <span class="flex items-center gap-1">
                        <svg
                          class="w-3.5 h-3.5 sm:w-4 sm:h-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                          />
                        </svg>
                        {post.readingTime} min read
                      </span>
                      {post.data.tags.length > 0 && (
                        <div class="flex flex-wrap gap-1 sm:gap-2">
                          {post.data.tags.slice(0, 3).map((tag) => (
                            <span class="text-blue-600 dark:text-blue-400">#{tag}</span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                  {post.data.image && (
                    <img
                      src={post.data.image}
                      alt=""
                      class="w-full sm:w-20 h-48 sm:h-20 rounded-lg object-cover flex-shrink-0"
                      loading="lazy"
                    />
                  )}
                </div>
              </a>
            </article>
          );
        })
      }
    </div>

    {
      postsWithReadingTime.length === 0 && (
        <p class="text-gray-600 dark:text-gray-400 text-center py-8">
          No posts yet. Check back soon!
        </p>
      )
    }

    {
      postsWithReadingTime.length === 4 && (
        <div class="mt-12 text-center">
          <a
            href="/archive"
            class="inline-flex items-center gap-2 px-6 py-3 bg-gray-200 dark:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
          >
            View all posts
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        </div>
      )
    }
  </section>

  <!-- About Section -->
  <section class="mb-16 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-950 -mx-4 px-4 py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center">About</h2>
      
      <div class="prose prose-lg dark:prose-invert mx-auto mb-12">
        <p class="text-gray-600 dark:text-gray-300 text-center">
          Currently building open source tools and apps that solve real problems. 
          Focused on creating developer tools, CLI utilities, and native Apple platform apps.
        </p>
      </div>

      <!-- Background Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <div class="bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm rounded-lg p-6 border border-gray-200 dark:border-gray-700">
          <h3 class="text-sm font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wide mb-3">
            Previously
          </h3>
          <p class="text-gray-700 dark:text-gray-300">
            Built iOS features and developer tooling at Oura. Shipped health insights to millions of users worldwide.
          </p>
        </div>
        <div class="bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm rounded-lg p-6 border border-gray-200 dark:border-gray-700">
          <h3 class="text-sm font-semibold text-gray-600 dark:text-gray-300 uppercase tracking-wide mb-3">
            Currently
          </h3>
          <p class="text-gray-700 dark:text-gray-300">
            Shipping my own apps and contributing to open source. Building developer tools that improve workflows.
          </p>
        </div>
      </div>

      <!-- Services CTA -->
      <div class="mt-12 mx-auto max-w-xl">
        <a href="/services" class="group block">
          <div class="relative bg-gradient-to-r from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900 rounded-xl p-6 border border-gray-200 dark:border-gray-700 transition-all duration-300 hover:shadow-lg hover:border-blue-500 dark:hover:border-blue-400">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
                Engineering Services
              </h3>
              <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-800 dark:text-green-300 rounded-full">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full mr-1.5 animate-pulse"></span>
                Available
              </span>
            </div>
            
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-4 leading-relaxed text-left">
              Full-stack developer specializing in native mobile apps, ML integration, and scalable systems. Let's build something great together.
            </p>
            
            <div class="flex items-center justify-between">
              <div class="flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors">
                Learn More
                <svg class="ml-1.5 w-4 h-4 transform transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
              </div>
              <div class="flex gap-3">
                <span class="text-xs text-gray-500 dark:text-gray-400">100+ projects</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.5s ease-out;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
