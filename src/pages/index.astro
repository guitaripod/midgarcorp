---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppCard from '@components/AppCard.astro';
import OpenSourceCard from '@components/OpenSourceCard.astro';
import LinuxShowcaseCard from '@components/LinuxShowcaseCard.astro';
import MatrixRain from '@components/MatrixRain.astro';
import ActivityBoard from '@components/ActivityBoard.astro';
import CardGrid from '@components/CardGrid.astro';
import SectionHead from '@components/SectionHead.astro';
import { getCollection } from 'astro:content';
import { calculateReadingTime } from '@utils/reading-time';
import appsData from '../data/apps.json';
import careerData from '../data/career.json';
import { appEntries } from '@data/apps';
import { LINUX_NOW, LINUX_SHOWCASE, linuxApps, linuxStats } from '@data/linux';
import { landingSlugs } from '@data/landing';
import { ossProjects, ossStats } from '@data/oss';
import activity from '../data/github-activity.json';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const postsWithReadingTime = posts.map((post) => ({
  ...post,
  readingTime: calculateReadingTime(post.body),
}));

const featuredApps = appEntries.filter((entry) => entry.shots.length > 0).slice(0, 3);
const featuredAppSlugs = new Set(featuredApps.map((entry) => entry.slug));

const featuredLinux = linuxApps
  .filter((app) => app.id in LINUX_SHOWCASE && !featuredAppSlugs.has(app.id))
  .slice(0, 3);

const shownIds = new Set([...featuredAppSlugs, ...featuredLinux.map((app) => app.id)]);
const featuredOpenSource = ossProjects
  .filter((project) => !shownIds.has(project.id.toLowerCase()))
  .slice(0, 6);

const languageCount = ossStats.languages.length;
const stats = [
  { key: 'apps_live', value: String(appsData.apps.length) },
  { key: 'oss_repos', value: String(ossStats.repos) },
  { key: 'commits', value: ossStats.commits.toLocaleString('en-US') },
  { key: 'releases_cut', value: ossStats.releases.toLocaleString('en-US') },
  { key: 'contributions_365d', value: activity.totals.contributionsYear.toLocaleString('en-US') },
  { key: 'languages', value: String(languageCount) },
];

const engagements = careerData.entries.slice(0, 3);
---

<BaseLayout
  width="wide"
  title="Midgar Corp — guitaripod"
  description={`Independent engineer. Seven years shipping production iOS, backend, and AI for category-leading consumer products. ${appsData.apps.length} apps live on the App Store, ${ossStats.repos} open-source projects with ${ossStats.commits.toLocaleString('en-US')} commits.`}
>
  <!-- Hero: live GitHub activity board -->
  <section class="relative pt-10 sm:pt-14 pb-10">
    <MatrixRain />
    <div class="relative">
      <p class="prompt-line mb-1">whoami</p>
      <p class="text-xs text-paper-muted dark:text-term-muted mb-8 leading-relaxed">
        <span class="text-paper-text dark:text-term-text font-semibold">guitaripod</span> · independent
        engineer · Linux · Apple · web · terminal ·
        <a
          href="#whoami"
          class="text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors whitespace-nowrap underline decoration-dotted underline-offset-2"
          >about ↓</a
        > ·
        <a
          href="/services"
          class="text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors whitespace-nowrap underline decoration-dotted underline-offset-2"
          >hire →</a
        >
      </p>
      <ActivityBoard />
    </div>
  </section>

  <div class="flow">
    <!-- Who -->
    <section id="whoami" class="scroll-mt-20">
      <div
        class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 border-t border-paper-border dark:border-term-border pt-8"
      >
        <div class="max-w-2xl">
          <p class="prompt-line mb-3">whoami --long</p>
          <h2
            class="text-2xl sm:text-4xl font-bold tracking-tight leading-tight text-paper-text dark:text-term-text mb-3"
          >
            Engineer who <span class="phosphor">ships.</span>
          </h2>
          <p class="text-sm sm:text-base text-paper-muted dark:text-term-muted leading-relaxed">
            Seven years shipping production software for category-leading consumer products. Now
            building my own, for Linux, Apple, the web and the terminal.
          </p>
        </div>

        <div class="flex flex-col items-start lg:items-end gap-4 flex-shrink-0">
          <p
            class="inline-flex items-center gap-2 text-xs text-paper-greendim dark:text-term-greendim"
          >
            <span class="relative flex w-1.5 h-1.5">
              <span
                class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-paper-green dark:bg-term-green opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-1.5 w-1.5 bg-paper-green dark:bg-term-green"
              ></span>
            </span>
            STATUS: available — open to new engagements
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/services"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-sm font-bold hover:opacity-90 transition-opacity"
            >
              ./work-with-me
            </a>
            <a
              href="/apps"
              class="inline-flex items-center gap-2 px-5 py-2.5 border border-paper-border2 dark:border-term-border2 text-paper-text dark:text-term-text rounded-sm text-sm font-semibold hover:border-paper-green dark:hover:border-term-green hover:text-paper-green dark:hover:text-term-green transition-colors"
            >
              ./see-the-work
            </a>
          </div>
        </div>
      </div>

      <div class="term-frame p-5 sm:p-6 mt-10">
        <p class="prompt-line mb-4">midgar --stats</p>
        <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-4">
          {
            stats.map((stat) => (
              <div class="flex flex-col-reverse justify-end">
                <dt class="text-xs text-paper-muted dark:text-term-muted mt-1">{stat.key}</dt>
                <dd class="text-2xl sm:text-3xl font-bold tracking-tight text-paper-text dark:text-term-text">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- Selected Engagements -->
    <section>
      <a href="/services#engagements" class="group block term-frame term-frame-hover p-5 sm:p-6">
        <div class="flex items-center justify-between mb-5">
          <p class="prompt-line">git log --employers --oneline</p>
          <span class="text-xs text-paper-greendim dark:text-term-greendim"> full timeline → </span>
        </div>

        <ul class="space-y-3">
          {
            engagements.map((entry) => (
              <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 text-sm">
                <span class="text-paper-amber dark:text-term-amber whitespace-nowrap sm:w-44 shrink-0">
                  {entry.dateRange.replace(' — ', '→')}
                </span>
                <span class="text-paper-text dark:text-term-text font-semibold">
                  {entry.headline}
                </span>
                <span class="text-paper-muted dark:text-term-muted">{entry.role}</span>
              </li>
            ))
          }
        </ul>

        <p class="mt-5 text-sm text-paper-muted dark:text-term-muted leading-relaxed">
          From a multi-billion-dollar wearable health platform to a NASDAQ-listed cybersecurity
          company to an AI-native health startup — engineering services shipped to category-leading
          consumer products.
        </p>
      </a>
    </section>

    <!-- Featured Apps -->
    <section class="defer-paint">
      <SectionHead path="~/apps" href="/apps" cta="ls apps/">most worked-on</SectionHead>
      <CardGrid md={1} lg={3}>
        {
          featuredApps.map((entry) => (
            <AppCard
              app={entry.app}
              landingHref={entry.landingHref}
              openSource={entry.openSource}
              githubUrl={entry.githubUrl}
              shots={entry.shots}
              device={entry.device}
              commits={entry.work?.commitCount}
              version={entry.version}
            />
          ))
        }
      </CardGrid>
    </section>

    <!-- Linux Apps -->
    <section class="defer-paint">
      <SectionHead path="~/linux" href="/linux" cta="ls linux/">
        apps &amp; tools ·
        <span class="text-paper-amber dark:text-term-amber"
          >{linuxStats.commitCount.toLocaleString('en-US')} commits</span
        >
      </SectionHead>
      <CardGrid md={1} lg={3}>
        {featuredLinux.map((app) => <LinuxShowcaseCard app={app} now={LINUX_NOW} />)}
      </CardGrid>
    </section>

    <!-- Open Source -->
    <section class="defer-paint">
      <SectionHead path="~/oss" href="/opensource" cta="ls oss/">open source, by work</SectionHead>
      <CardGrid md={2} lg={3}>
        {
          featuredOpenSource.map((project) => (
            <OpenSourceCard
              project={project}
              landingSlug={landingSlugs.includes(project.id) ? project.id : undefined}
            />
          ))
        }
      </CardGrid>
    </section>

    <!-- Recent Posts -->
    <section class="defer-paint">
      <SectionHead path="~/blog" href="/archive" cta="ls blog/">recent writing</SectionHead>

      <CardGrid md={2} lg={2}>
        {
          postsWithReadingTime.map((post) => {
            const formattedDate = post.data.pubDate.toISOString().slice(0, 10);

            return (
              <article class="group term-frame term-frame-hover p-4 sm:p-5">
                <a href={`/blog/${post.slug}`} class="block">
                  <h3 class="text-base sm:text-lg font-semibold text-paper-text dark:text-term-text group-hover:text-paper-green dark:group-hover:text-term-green transition-colors mb-2">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-paper-muted dark:text-term-muted mb-3 line-clamp-2 font-sans">
                    {post.data.description}
                  </p>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-paper-faint dark:text-term-faint">
                    <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                    <span>{post.readingTime} min</span>
                    {post.data.tags.length > 0 && (
                      <span class="flex flex-wrap gap-2">
                        {post.data.tags.slice(0, 3).map((tag) => (
                          <span class="text-paper-greendim dark:text-term-greendim">#{tag}</span>
                        ))}
                      </span>
                    )}
                  </div>
                </a>
              </article>
            );
          })
        }
      </CardGrid>
    </section>
  </div>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
