---
import BaseLayout from '@layouts/BaseLayout.astro';
import OpenSourceCard from '@components/OpenSourceCard.astro';
import openSourceData from '../data/opensource.json';
import { landingSlugs } from '@data/landing';

const projects = openSourceData.projects;
const totalStars = projects.reduce((sum, project) => sum + project.stars, 0);

const pageTitle = 'Open Source | guitaripod';
const pageDescription = `${projects.length} shipped open-source projects — AI agents, CLI tools, Swift packages, SDKs, and apps in Swift, Rust, Go, and TypeScript.`;

const byStars = (a: (typeof projects)[number], b: (typeof projects)[number]) => b.stars - a.stars;

const namedCategories = [
  { category: 'AI & Agents', command: 'ls oss/ai-agents' },
  { category: 'CLI Tools', command: 'ls oss/cli-tools' },
  { category: 'Swift Packages', command: 'ls oss/swift-packages' },
  { category: 'Apps', command: 'ls oss/apps' },
  { category: 'SDKs & Libraries', command: 'ls oss/sdks' },
];

const namedSet = new Set(namedCategories.map((entry) => entry.category));

const sections = [
  ...namedCategories.map((entry) => ({
    title: entry.category,
    command: entry.command,
    projects: projects.filter((project) => project.category === entry.category).sort(byStars),
  })),
  {
    title: 'Misc',
    command: 'ls oss/misc',
    projects: projects.filter((project) => !namedSet.has(project.category)).sort(byStars),
  },
].filter((section) => section.projects.length > 0);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <header class="pt-10 sm:pt-14 mb-10 sm:mb-14">
    <p class="prompt-line mb-4">gh repo list guitaripod --limit 100</p>
    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4 text-paper-text dark:text-term-text"
    >
      Open Source
    </h1>
    <p class="text-base sm:text-lg text-paper-muted dark:text-term-muted max-w-2xl">
      {projects.length} shipped projects · {totalStars} stars · Swift, Rust, Go, TypeScript
    </p>
  </header>

  <section class="mb-12 sm:mb-16">
    <div class="term-frame p-4 sm:p-6">
      <p class="prompt-line mb-4">git log --author=guitaripod --since=1.year --oneline</p>
      <img
        src="https://ghchart.rshah.org/00cc44/guitaripod"
        alt="guitaripod's GitHub contribution graph"
        class="w-full"
        loading="lazy"
        onerror="this.closest('section').style.display='none'"
      />
    </div>
  </section>

  {
    sections.map((section) => (
      <section class="mb-12 sm:mb-16">
        <div class="flex items-baseline justify-between gap-4 mb-6">
          <p class="prompt-line">{section.command}</p>
          <span class="text-xs text-paper-faint dark:text-term-faint whitespace-nowrap">
            {section.projects.length} repos
          </span>
        </div>
        <h2 class="sr-only">{section.title}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
          {section.projects.map((project) => (
            <OpenSourceCard
              project={project}
              landingSlug={landingSlugs.includes(project.id) ? project.id : undefined}
            />
          ))}
        </div>
      </section>
    ))
  }

  <section class="mt-12 sm:mt-16">
    <div class="term-frame p-6 sm:p-8">
      <p class="prompt-line mb-4">cat CONTRIBUTING.md</p>
      <h3 class="text-xl sm:text-2xl font-bold mb-3 text-paper-text dark:text-term-text">
        Built to be used, not admired.
      </h3>
      <p class="text-sm sm:text-base text-paper-muted dark:text-term-muted mb-6 max-w-2xl">
        Every repo here exists because I hit a real problem shipping production software. If one
        saves you time, star it — and if it breaks, file an issue. I read them.
      </p>
      <a
        href="https://github.com/guitaripod?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-sm font-bold hover:opacity-90 transition-opacity"
      >
        gh browse guitaripod ↗
      </a>
    </div>
  </section>
</BaseLayout>
