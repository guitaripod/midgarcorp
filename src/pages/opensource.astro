---
import BaseLayout from '@layouts/BaseLayout.astro';
import OpenSourceCard from '@components/OpenSourceCard.astro';
import OssLeader from '@components/OssLeader.astro';
import OssRow from '@components/OssRow.astro';
import PageSection from '@components/PageSection.astro';
import ShareBar from '@components/ShareBar.astro';
import StatCell from '@components/StatCell.astro';
import { landingSlugs } from '@data/landing';
import { OSS_LEADERS, OSS_NOW, ossProjects, ossSections, ossStats } from '@data/oss';
import { languageColor } from '../lib/work';

const now = OSS_NOW;
const leaders = ossProjects.slice(0, OSS_LEADERS);
const mostShipped = [...ossProjects].sort(
  (a, b) => (b.releaseCount ?? 0) - (a.releaseCount ?? 0)
)[0];
const shippers = ossProjects.filter((project) => (project.releaseCount ?? 0) > 0).length;
const languages = ossStats.languages
  .map((language) => ({
    label: language,
    count: ossProjects.filter((project) => project.language === language).length,
  }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 6)
  .map((entry) => ({
    ...entry,
    fraction: entry.count / ossProjects.length,
    color: languageColor(entry.label),
  }));

const pageTitle = 'Open Source | guitaripod';
const pageDescription = `${ossStats.repos} shipped open-source projects with ${ossStats.commits.toLocaleString('en-US')} commits and ${ossStats.releases} releases — apps, AI agents, Linux tools, CLIs and Swift packages, ordered by the work behind them.`;

const plural = (count: number, noun: string): string => `${count} ${noun}${count === 1 ? '' : 's'}`;
---

<BaseLayout title={pageTitle} description={pageDescription} image="/og/opensource.png">
  <header class="pt-10 sm:pt-14 mb-8 sm:mb-10">
    <p class="prompt-line mb-4">gh repo list guitaripod --limit 100</p>
    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4 text-paper-text dark:text-term-text"
    >
      Open <span class="phosphor">Source</span>
    </h1>
    <p class="text-base sm:text-lg text-paper-muted dark:text-term-muted max-w-3xl leading-relaxed">
      {ossStats.repos} shipped projects with {ossStats.commits.toLocaleString('en-US')} commits and {
        ossStats.releases
      } tagged releases. Ordered by the work behind each one, not by stars.
    </p>
  </header>

  <section class="mb-12 sm:mb-16">
    <div class="term-frame p-5 sm:p-6">
      <p class="prompt-line mb-5">oss --stats</p>
      <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-7">
        <StatCell label="repos_shipped" value={ossStats.repos}>
          <p class="text-[11px] text-paper-muted dark:text-term-muted">
            <span class="text-paper-green dark:text-term-green">{shippers}</span> cut at least one release
          </p>
        </StatCell>
        <StatCell label="commits" value={ossStats.commits.toLocaleString('en-US')}>
          <p class="text-[11px] text-paper-muted dark:text-term-muted">
            most work:
            <a
              href={`#${leaders[0].id}`}
              class="text-paper-text dark:text-term-text hover:text-paper-green dark:hover:text-term-green transition-colors underline decoration-dotted underline-offset-2"
            >
              {leaders[0].name}
            </a>
            <span class="text-paper-green dark:text-term-green">
              {` ${(leaders[0].commitCount ?? 0).toLocaleString('en-US')}`}
            </span>
          </p>
        </StatCell>
        <StatCell label="releases_cut" value={ossStats.releases}>
          <p class="text-[11px] text-paper-muted dark:text-term-muted">
            most shipped:
            <a
              href={`#${mostShipped.id}`}
              class="text-paper-text dark:text-term-text hover:text-paper-green dark:hover:text-term-green transition-colors underline decoration-dotted underline-offset-2"
            >
              {mostShipped.name}
            </a>
          </p>
        </StatCell>
        <StatCell label="languages" value={ossStats.languages.length}>
          <ShareBar
            items={languages}
            summary={languages.map((l) => `${l.count} ${l.label}`).join(', ')}
          />
        </StatCell>
      </dl>
    </div>
  </section>

  <PageSection
    command={`sort --by=work | head -${leaders.length}`}
    title="Most work"
    blurb="Commits and releases decide the order."
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
      {
        leaders.map((project, index) => (
          <OssLeader
            project={project}
            rank={index + 1}
            now={now}
            landingSlug={landingSlugs.includes(project.id) ? project.id : undefined}
          />
        ))
      }
    </div>
  </PageSection>

  {
    ossSections.map((section) => (
      <PageSection
        id={section.command.replace('ls oss/', '')}
        command={section.command}
        title={section.title}
        blurb={section.blurb}
        aside={`${plural(section.totals.repos, 'repo')} · ${plural(section.totals.commits, 'commit')} · ${plural(section.totals.releases, 'release')}`}
      >
        <div class="space-y-6">
          {section.featured.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
              {section.featured.map((project) => (
                <OpenSourceCard
                  project={project}
                  landingSlug={landingSlugs.includes(project.id) ? project.id : undefined}
                />
              ))}
            </div>
          )}
          {section.compact.length > 0 && (
            <details open={section.compact.length <= 4} class="group/compact">
              <summary class="term-label mb-3 cursor-pointer select-none hover:text-paper-green dark:hover:text-term-green transition-colors">
                smaller and older · {section.compact.length}
              </summary>
              <ul class="term-frame px-4 sm:px-5">
                {section.compact.map((project) => (
                  <OssRow project={project} now={now} />
                ))}
              </ul>
            </details>
          )}
        </div>
      </PageSection>
    ))
  }

  <section class="mb-12 sm:mb-16">
    <div class="term-frame p-4 sm:p-6">
      <p class="prompt-line mb-4">git log --author=guitaripod --since=1.year --oneline</p>
      <img
        src="https://ghchart.rshah.org/00cc44/guitaripod"
        alt="guitaripod's GitHub contribution graph"
        class="w-full"
        loading="lazy"
        onerror="this.closest('section').style.display='none'"
      />
    </div>
  </section>

  <section class="mt-12 sm:mt-16">
    <div class="term-frame p-6 sm:p-8">
      <p class="prompt-line mb-4">cat CONTRIBUTING.md</p>
      <h3 class="text-xl sm:text-2xl font-bold mb-3 text-paper-text dark:text-term-text">
        Built to be used, not admired.
      </h3>
      <p class="text-sm sm:text-base text-paper-muted dark:text-term-muted mb-6 max-w-2xl">
        Every repo here exists because I hit a real problem shipping production software. If one
        saves you time, star it — and if it breaks, file an issue. I read them.
      </p>
      <a
        href="https://github.com/guitaripod?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-sm font-bold hover:opacity-90 transition-opacity"
      >
        gh browse guitaripod ↗
      </a>
    </div>
  </section>
</BaseLayout>
