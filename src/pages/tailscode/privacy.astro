---
import BaseLayout from '@layouts/BaseLayout.astro';

const accent = '#546BFF';
const seoTitle = 'Tailscode Privacy Policy';
const metaDescription =
  'Your chats, code and files never reach us. App Store builds keep a random Midgar ID and report purchases; Linux and direct Mac builds create no Midgar ID.';

type Section = {
  title: string;
  paragraphs?: string[];
  items?: string[];
};

const collected = [
  {
    type: 'User ID',
    detail: 'Linked to you · App Functionality',
    body: 'The Midgar ID: a random identifier with no name, email address or other detail about you. It is sent to api.midgarcorp.cc as a sign-in token for the purchase ledger and for the Your Midgar card in Settings, and it travels with each purchase as Apple’s app account token.',
  },
  {
    type: 'Device ID',
    detail: 'Linked to you · App Functionality',
    body: 'The App Attest key: Apple’s per-app, per-device key, which proves a request comes from a genuine copy of Tailscode. It is stored with the Midgar ID when the ID is created or joined, together with its public key, Apple’s receipt for it where Apple gives one, and the times it was created and last used. Tailscode reads no advertising identifier and no vendor identifier.',
  },
  {
    type: 'Purchase History',
    detail: 'Linked to you · App Functionality',
    body: 'The signed App Store transactions for Pro and for the tips, reported to the Midgar ledger at api.midgarcorp.cc together with your Midgar ID. For tips, the ledger also passes these transactions to Midgar’s intelligence service (see Purchases). Apple’s own server notifications for Tailscode reach the same ledger. There is no RevenueCat or other purchase SDK in the app.',
  },
  {
    type: 'Product Interaction',
    detail: 'Not linked to you · Analytics',
    body: 'Anonymous counts from MidgarKit: the Your Midgar and More Apps screens opened, which app tiles were shown and tapped, which other app’s page was opened or loaded from the portal, whether the App Store page of another app was shown as an overlay, that the app was active on each day, week and month (once each per install), the ISO week the app was installed in, that the Pro screen was shown and where it was opened from, and a purchase event with the product id. They are sent to api.midgarcorp.cc with no Midgar ID, no device id and nothing else that identifies you, and our server stores only a running total per day, event, app, platform, app version range, install week and the event’s own dimension.',
  },
];

const sections: Section[] = [
  {
    title: 'Who we are',
    paragraphs: [
      'Tailscode is published by Midgar Oy, a company in Finland, which is the controller of the information described on this page. You can reach us at marcus@midgarcorp.cc.',
    ],
  },
  {
    title: 'What we never collect',
    paragraphs: [
      'Your conversations, prompts, answers, diffs, code and files travel directly between your device and the machines you run, over your own WireGuard-encrypted Tailscale network. They never reach us, and we run no server that sits between you and your machines.',
    ],
    items: [
      'No chats, prompts, code, files, pictures or clips.',
      'No server addresses, passwords or API keys: they stay in the Keychain on your device and are sent only to the servers you configure.',
      'No location, contacts, browsing or search history, health data or financial information.',
      'No diagnostics from the app: the log and Apple’s MetricKit reports stay on your device. Apple may give us anonymous crash and usage reports, but only if you opt in to sharing with developers (see Diagnostics below). The app contains no third-party analytics or crash-reporting software.',
    ],
  },
  {
    title: 'No tracking, no advertising',
    paragraphs: [
      'Nothing Tailscode collects is used to track you, to show advertising or to build a profile of you, and nothing is sold or shared with a data broker. The app does not ask for tracking permission, its privacy manifest declares no tracking and no tracking domains, and it has no advertising.',
    ],
  },
  {
    title: 'Which copies collect',
    paragraphs: [
      'The App Store apps, the iPhone and iPad app and the Mac App Store app (and their TestFlight builds), create the Midgar ID, the App Attest key and the purchase reports above, because they sell Pro and the tips. The widget and the notification extensions hold no Midgar ID and send nothing.',
      'The Linux app collects nothing for Midgar. The direct Mac build, which is not on the App Store, sells nothing, creates no Midgar ID and sends no usage counts, but its More Apps card downloads the app list once a day (see Your Midgar and More Apps).',
    ],
  },
  {
    title: 'The Midgar ID and App Attest',
    paragraphs: [
      'The first time an App Store copy starts, it asks our server at api.midgarcorp.cc for a Midgar ID: a random identifier, and a random secret that proves the ID is yours. The server keeps the ID, a hash of the secret and the date it was created. The app keeps the ID and the secret in your iCloud Keychain, so the same ID follows you across your own devices and across Midgar’s other apps.',
      'When the ID is created or joined, the app asks Apple’s App Attest service to confirm that the request comes from a genuine copy of Tailscode. We receive Apple’s attestation and keep the key’s id and public key, Apple’s receipt for the key where Apple gives one, the app’s bundle identifier, the key’s signature counter and the times the key was created and last used. The key also signs later requests, such as refreshing your sign-in. Where App Attest is not available, or fails for any reason other than Apple’s service being unreachable, the ID is created without it; if Apple’s service cannot be reached, the app tries again later. The ID is never sent with your conversations, code or files.',
    ],
  },
  {
    title: 'Purchases',
    paragraphs: [
      'Pro and the tips are bought through Apple In-App Purchase. Apple handles payment and billing, and we never receive your card details or your Apple Account details. When you buy or restore, the app sends the Midgar ledger the signed transaction record Apple has already issued (which product, the price, the dates, whether it was refunded, the order identifiers and your App Store country) together with your Midgar ID. The ledger keeps these records so that Pro is recognised on your iPhone, iPad and Mac, and so that Midgar can keep its financial records for as long as the law requires.',
      'For a tip, the ledger also passes the transaction’s identifiers, product, dates, environment and your Midgar ID to Midgar’s intelligence service, which keeps the credit wallets of Midgar’s apps. That happens for a tip bought in the last 24 hours when the app reports it, and for each tip purchase and refund that Apple reports. Pro is not passed on.',
      'If our servers cannot be reached, StoreKit alone decides, so a purchase still completes and Pro still unlocks.',
    ],
  },
  {
    title: 'Your Midgar and More Apps',
    paragraphs: [
      'Settings has a screen that shows what you own in Midgar’s other apps and suggests our other apps. Opening it downloads the app list from a catalogue service we run on Cloudflare, and the artwork and current prices from Apple’s servers; your device’s region setting is sent so prices are right for that region. The Midgar ID is sent as a sign-in token only with requests to the purchase ledger (reporting purchases and listing what you own) and the identity request that lists which Midgar apps you use.',
      'The More Apps card in Settings, and the card in the Mac app’s General preferences, also download the app list once a day, when the card is shown. Those requests carry no Midgar ID. As with any web request, the servers see your IP address.',
      'The App Store apps also report which tiles were shown and tapped, as the anonymous counts described above. That report carries no identifier of you, your device or your Midgar ID; the only identifiers on the request are the app’s own id and a random id made for that one request. On iPhone and iPad, opening another app’s page from the portal also gives Apple a campaign token that names Tailscode and the place you opened it from, and Midgar’s provider token, so that installs from the portal can be credited. Like any web service, Cloudflare may keep standard request logs, such as your IP address, for a limited time. We use them for nothing else.',
      'Midgar may publish aggregate statistics built from anonymous counts, such as weekly active installs, which never identify a person.',
    ],
  },
  {
    title: 'Your servers and your network',
    paragraphs: [
      'Server passwords are stored in the Keychain and sent only to the servers you configure. The optional Tailscale API token, used for server discovery, is stored in the Keychain and sent only to api.tailscale.com to list your own devices.',
      'Your agent still talks to its own model provider the way it always did; that part is between you and them. If you enter your own keys to read usage or quota from Ollama or DeepSeek, or to use Google’s services, the app calls those providers directly from your device. We do not see those requests or the keys. If you use Game Center trophies, Apple keeps them under Apple’s policy.',
    ],
  },
  {
    title: 'Push notifications and Live Activities',
    paragraphs: [
      'Live Activity push tokens are sent only to the server that runs the conversation, and only claude-bridge uses them. If that server holds an Apple push key, it sends Lock Screen updates through Apple’s push notification service (APNs). The updates carry the conversation’s title, its phase, a status line that can name the tool now running, the tool count, the start and end times, the card’s state name and, once the turn has settled, the number of background tasks still running. Nothing about this passes through Midgar.',
      'The app also registers its APNs device token and your notification rules with each of your claude-bridge servers, so they can send alerts. When a turn ends while the app is closed, the alert comes from your own server: as an APNs push if it holds an Apple push key, or from a background request that the app leaves waiting on your server over your tailnet. Midgar is not involved in either.',
    ],
  },
  {
    title: 'Diagnostics',
    paragraphs: [
      'A diagnostic log file, tailscode.log, stays on your device. On iPhone and iPad, Apple’s MetricKit gives the app daily performance reports and crash, hang and disk-write reports. The app writes a summary of them into that log and keeps the full diagnostic files in the app’s Logs folder, on your device. Nothing from MetricKit is sent to us or to anyone else by the app. The log leaves only if you export it, share it or mail the diagnostic summary yourself. Read it first: nothing is sent unless you send it. If you have chosen in iOS to share analytics with app developers, Apple may give us anonymous crash and usage reports, which contain nothing we can link to you.',
    ],
  },
  {
    title: 'How long we keep data',
    items: [
      'Your conversations, code and files: not kept by us at all. They live on your machines and in your device’s own storage.',
      'The Midgar ID record and its App Attest key details at Midgar: until you ask us to delete them. A Midgar ID that never had an App Attest key is deleted automatically after 30 days, unless it has an active session or is linked to an Apple account. Any credit wallet it holds is not erased by that and stays unreachable on Midgar’s servers.',
      'Purchase records at Midgar: kept on record for Midgar’s accounting, with the Midgar ID they were made with, as described under Deleting your data.',
      'Purchase records at Apple: kept under Apple’s policies.',
      'The anonymous More Apps and purchase counts: kept as running totals, as long as they are useful for measuring our own promotion. They are not linked to you, so they cannot be deleted per person.',
    ],
  },
  {
    title: 'Deleting your data',
    paragraphs: [
      'Delete the app to remove the files it keeps on that device. iOS keeps Keychain items when the app is deleted, so the sign-in session (a refresh token and the App Attest key id) and any server passwords or API keys you entered stay in the device’s Keychain. The Midgar ID itself is kept in your iCloud Keychain, so it can outlive the app. To have your Midgar ID erased from our server, email marcus@midgarcorp.cc, tell us the app and the approximate date of your first purchase, and we will help you do it. We then delete the Midgar ID record with its App Attest key details and sessions, erase the credit wallet the ID holds, and remove the ledger’s claims that tie the ID to its purchases. Purchase records that Midgar keeps for accounting stay on record with the Midgar ID they were made with, but that ID is retired and is no longer tied to any account, so nothing links them to an active account. We cannot change Apple’s own records, and we cannot refund a purchase: do that through Apple.',
    ],
  },
  {
    title: 'Your rights',
    paragraphs: [
      'Where privacy law, such as the GDPR, gives you rights to access, correct, erase, restrict or move information about you, or to object to its use, contact us and we will help. We process the Midgar ID, the App Attest key details and the purchase records to provide, account for and support the purchases you make and to recognise Pro on your devices, and the anonymous counts in our legitimate interest in measuring our own promotion. Processing takes place in the European Union and the United States, by Cloudflare as our hosting provider. You may complain to your local data protection authority; in Finland that is the Office of the Data Protection Ombudsman (tietosuoja.fi).',
    ],
  },
  {
    title: 'Children',
    paragraphs: [
      'Tailscode is a tool for developers and is not directed at children. We do not knowingly collect personal information from anyone, including children.',
    ],
  },
];
---

<BaseLayout title={seoTitle} description={metaDescription}>
  <div style={`--accent:${accent}`}>
    <nav aria-label="Breadcrumb" class="pt-8 text-xs text-paper-faint dark:text-term-faint">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/tailscode/" class="hover:text-paper-green dark:hover:text-term-green">
            tailscode
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">privacy</li>
      </ol>
    </nav>

    <header class="py-10 sm:py-14">
      <p class="prompt-line mb-5">cat tailscode/PRIVACY.md</p>
      <h1
        class="mb-3 text-3xl font-bold tracking-tight text-paper-text dark:text-term-text sm:text-4xl"
      >
        Tailscode Privacy Policy
      </h1>
      <p class="text-xs text-paper-faint dark:text-term-faint">Last updated: 9 November 2026</p>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-paper-muted dark:text-term-muted">
        The short version: <span class="font-semibold text-paper-text dark:text-term-text"
          >your chats, prompts, code and files never reach us.</span
        > They travel between your device and machines you own. The App Store apps keep one random Midgar
        ID, report your purchases and send anonymous More Apps counts. Nothing is used for tracking,
        and the Linux app and the direct Mac build create no Midgar ID and send no usage counts.
      </p>
    </header>

    <section class="border-t border-paper-border pb-4 pt-10 dark:border-term-border">
      <div class="max-w-3xl">
        <h2 class="accent-text mb-2 text-xs font-bold uppercase tracking-[0.16em]">
          What the App Store apps collect
        </h2>
        <p class="mb-5 text-sm leading-relaxed text-paper-muted dark:text-term-muted">
          This is everything, row for row, as declared in the app’s privacy manifest and on its App
          Store privacy label. Each item goes to api.midgarcorp.cc, Midgar’s own service, or to
          Apple. Nothing goes to an advertiser or to a third-party analytics company.
        </p>
        <div class="grid gap-5">
          {
            collected.map((row) => (
              <div class="term-frame p-5 sm:p-6">
                <h3 class="mb-1 text-sm font-bold text-paper-text dark:text-term-text">
                  {row.type}
                </h3>
                <p class="accent-text mb-2 text-[11px] font-semibold uppercase tracking-[0.12em]">
                  {row.detail}
                </p>
                <p class="text-sm leading-relaxed text-paper-muted dark:text-term-muted">
                  {row.body}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="pb-12 pt-5">
      <div class="grid max-w-3xl gap-5">
        {
          sections.map((s) => (
            <div class="term-frame p-5 sm:p-6">
              <h2 class="accent-text mb-2 text-xs font-bold uppercase tracking-[0.16em]">
                {s.title}
              </h2>
              {s.paragraphs?.map((p) => (
                <p class="mb-3 text-sm leading-relaxed text-paper-muted last:mb-0 dark:text-term-muted">
                  {p}
                </p>
              ))}
              {s.items && (
                <ul class="list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-paper-muted dark:text-term-muted">
                  {s.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section class="border-t border-paper-border py-10 dark:border-term-border">
      <div class="term-frame max-w-3xl p-5 sm:p-6">
        <h2 class="accent-text mb-2 text-xs font-bold uppercase tracking-[0.16em]">
          Questions &amp; changes
        </h2>
        <p class="text-sm leading-relaxed text-paper-muted dark:text-term-muted">
          Questions about this policy? Email
          <a
            href="mailto:marcus@midgarcorp.cc"
            class="text-paper-green underline decoration-dotted underline-offset-2 dark:text-term-green"
            >marcus@midgarcorp.cc</a
          >. If this policy changes we will publish the new version here with a new date, and
          mention material changes in the app’s release notes.
        </p>
      </div>
      <p class="mt-8 text-xs text-paper-faint dark:text-term-faint">
        <a href="/tailscode/" class="hover:text-paper-green dark:hover:text-term-green"
          >← back to Tailscode</a
        >
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .accent-text {
    color: color-mix(in srgb, var(--accent), #000 42%);
  }
  :global(.dark) .accent-text {
    color: var(--accent);
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 45%, transparent);
  }
</style>
