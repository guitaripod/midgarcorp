---
import BaseLayout from '@layouts/BaseLayout.astro';

const accent = '#546BFF';
const seoTitle = 'Tailscode Support';
const metaDescription =
  'Get help with Tailscode — the native iOS remote for Claude Code and opencode. Open a GitHub issue, email the developer, or follow the setup guides for claude-bridge, opencode, and Tailscale.';

const guides = [
  {
    name: 'Tailscode README',
    href: 'https://github.com/guitaripod/Tailscode',
    blurb: 'The app itself — setup, architecture, and building from source.',
  },
  {
    name: 'claude-bridge',
    href: 'https://github.com/guitaripod/claude-bridge',
    blurb: 'The open-source companion server that connects Tailscode to Claude Code.',
  },
  {
    name: 'opencode',
    href: 'https://opencode.ai',
    blurb: 'Run opencode serve and connect Tailscode directly to it.',
  },
  {
    name: 'Tailscale',
    href: 'https://tailscale.com',
    blurb: 'The network layer — install it on your phone and your machines, free for personal use.',
  },
];

const questions = [
  {
    q: 'Can I try the app before setting anything up?',
    a: 'Yes. Tap “Try the demo” on the first screen — sample servers with realistic sessions let you explore the full app, no tailnet or server needed.',
  },
  {
    q: 'What do I need to use it for real?',
    a: 'A machine on your Tailscale network running an agent server: opencode serve, or claude-bridge in front of Claude Code. Both are open source and take minutes to set up.',
  },
  {
    q: 'Which devices does it run on?',
    a: 'Tailscode runs on iPhone and iPad and requires iOS 18 or later.',
  },
];
---

<BaseLayout title={seoTitle} description={metaDescription}>
  <div style={`--accent:${accent}`}>
    <nav aria-label="Breadcrumb" class="pt-8 text-xs text-paper-faint dark:text-term-faint">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/tailscode" class="hover:text-paper-green dark:hover:text-term-green">
            tailscode
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">support</li>
      </ol>
    </nav>

    <header class="py-10 sm:py-14">
      <p class="prompt-line mb-5">tailscode --help</p>
      <h1
        class="mb-3 text-3xl font-bold tracking-tight text-paper-text dark:text-term-text sm:text-4xl"
      >
        Tailscode Support
      </h1>
      <p class="max-w-2xl text-base leading-relaxed text-paper-muted dark:text-term-muted">
        Stuck, found a bug, or have an idea? The fastest way to reach me is a GitHub issue —
        Tailscode is open source, and issues are triaged directly by the developer.
      </p>
    </header>

    <section class="border-t border-paper-border pb-12 pt-10 dark:border-term-border">
      <div class="grid max-w-3xl gap-5">
        <div class="term-frame p-5 sm:p-6">
          <h2 class="accent-text mb-2 text-xs font-bold uppercase tracking-[0.16em]">
            Fastest: open an issue
          </h2>
          <p class="mb-4 text-sm leading-relaxed text-paper-muted dark:text-term-muted">
            Bug reports, feature requests, and setup problems all belong on the issue tracker.
            Include your iOS version and which agent server you use (opencode or claude-bridge).
          </p>
          <a
            href="https://github.com/guitaripod/Tailscode/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="accent-btn inline-flex items-center gap-2 rounded-sm border px-4 py-2.5 text-sm font-semibold transition-colors"
          >
            <img src="/icons/github.svg" alt="" width="18" height="18" class="dark:invert" />
            github.com/guitaripod/Tailscode/issues ↗
          </a>
        </div>

        <div class="term-frame p-5 sm:p-6">
          <h2 class="accent-text mb-2 text-xs font-bold uppercase tracking-[0.16em]">Email</h2>
          <p class="text-sm leading-relaxed text-paper-muted dark:text-term-muted">
            Prefer email? Write to
            <a
              href="mailto:guitaripod@gmail.com"
              class="text-paper-green underline decoration-dotted underline-offset-2 dark:text-term-green"
              >guitaripod@gmail.com</a
            >.
          </p>
        </div>

        <div class="term-frame p-5 sm:p-6">
          <h2 class="accent-text mb-3 text-xs font-bold uppercase tracking-[0.16em]">
            Setup guides
          </h2>
          <ul class="grid gap-3">
            {
              guides.map((g) => (
                <li class="text-sm leading-relaxed">
                  <a
                    href={g.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-semibold text-paper-green hover:underline dark:text-term-green"
                  >
                    {g.name} ↗
                  </a>
                  <span class="text-paper-muted dark:text-term-muted"> — {g.blurb}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="term-frame p-5 sm:p-6">
          <h2 class="accent-text mb-3 text-xs font-bold uppercase tracking-[0.16em]">
            Common questions
          </h2>
          <dl class="grid gap-4">
            {
              questions.map((item) => (
                <div>
                  <dt class="mb-1 text-sm font-bold text-paper-text dark:text-term-text">
                    {item.q}
                  </dt>
                  <dd class="text-sm leading-relaxed text-paper-muted dark:text-term-muted">
                    {item.a}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <p class="mt-8 text-xs text-paper-faint dark:text-term-faint">
        <a href="/tailscode" class="hover:text-paper-green dark:hover:text-term-green"
          >← back to Tailscode</a
        >
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .accent-text {
    color: color-mix(in srgb, var(--accent), #000 42%);
  }
  :global(.dark) .accent-text {
    color: var(--accent);
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .accent-btn {
    color: color-mix(in srgb, var(--accent), #000 34%);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  :global(.dark) .accent-btn {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .accent-btn:hover {
    background-color: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
  }
</style>
