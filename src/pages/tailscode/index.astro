  <div
    id="shot-lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Screenshot at full resolution"
  >
    <img id="shot-lightbox-img" src="" alt="" draggable="false" />
    <button
      type="button"
      data-lightbox-close
      aria-label="Close"
      class="fixed right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-black/60 text-xl text-white/80 transition-colors hover:text-white"
    >
      ✕
    </button>
    <button
      type="button"
      data-lightbox-prev
      aria-label="Previous screenshot"
      class="fixed left-3 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-xl text-white/80 transition-colors hover:text-white sm:flex"
    >
      ‹
    </button>
    <button
      type="button"
      data-lightbox-next
      aria-label="Next screenshot"
      class="fixed right-3 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-xl text-white/80 transition-colors hover:text-white sm:flex"
    >
      ›
    </button>
  </div>

  <script>
    const box = document.getElementById('shot-lightbox') as HTMLDivElement;
    const view = document.getElementById('shot-lightbox-img') as HTMLImageElement;
    let rail: HTMLImageElement[] = [];
    let at = -1;

    const visible = () =>
      Array.from(document.querySelectorAll<HTMLImageElement>('img[data-full]')).filter(
        (img) => img.offsetParent !== null
      );

    const show = (index: number) => {
      at = (index + rail.length) % rail.length;
      const source = rail[at];
      view.src = source.dataset.full ?? source.src;
      view.alt = source.alt;
      view.classList.remove('zoomed');
    };

    const open = (source: HTMLImageElement) => {
      rail = visible();
      box.classList.remove('hidden');
      box.classList.add('flex');
      document.documentElement.style.overflow = 'hidden';
      show(rail.indexOf(source));
    };

    const close = () => {
      box.classList.add('hidden');
      box.classList.remove('flex');
      document.documentElement.style.overflow = '';
      view.src = '';
      at = -1;
    };

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target instanceof HTMLImageElement && target.dataset.full && !box.contains(target)) {
        open(target);
        return;
      }
      if (box.classList.contains('hidden')) return;
      if (target === view) {
        view.classList.toggle('zoomed');
        return;
      }
      if (target.closest('[data-lightbox-prev]')) show(at - 1);
      else if (target.closest('[data-lightbox-next]')) show(at + 1);
      else if (target === box || target.closest('[data-lightbox-close]')) close();
    });

    document.addEventListener('keydown', (event) => {
      if (box.classList.contains('hidden')) return;
      if (event.key === 'Escape') close();
      else if (event.key === 'ArrowLeft') show(at - 1);
      else if (event.key === 'ArrowRight') show(at + 1);
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
