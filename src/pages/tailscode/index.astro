    >
      ‹
    </button>
    <button
      type="button"
      data-lightbox-next
      aria-label="Next screenshot"
      class="fixed right-3 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-xl text-white/80 transition-colors hover:text-white sm:flex"
    >
