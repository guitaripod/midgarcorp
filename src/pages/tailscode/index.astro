  <script>
    const box = document.getElementById('shot-lightbox') as HTMLDivElement;
    const view = document.getElementById('shot-lightbox-img') as HTMLImageElement;
    let rail: HTMLImageElement[] = [];
    let at = -1;

    const visible = () =>
      Array.from(document.querySelectorAll<HTMLImageElement>('img[data-full]')).filter(
        (img) => img.offsetParent !== null
      );

    const show = (index: number) => {
      at = (index + rail.length) % rail.length;
      const source = rail[at];
      view.src = source.dataset.full ?? source.src;
      view.alt = source.alt;
      view.classList.remove('zoomed');
    };

    const open = (source: HTMLImageElement) => {
      rail = visible();
      box.classList.remove('hidden');
      box.classList.add('flex');
      document.documentElement.style.overflow = 'hidden';
      show(rail.indexOf(source));
    };

    const close = () => {
      box.classList.add('hidden');
      box.classList.remove('flex');
      document.documentElement.style.overflow = '';
      view.src = '';
      at = -1;
    };

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target instanceof HTMLImageElement && target.dataset.full && !box.contains(target)) {
        open(target);
        return;
      }
      if (box.classList.contains('hidden')) return;
      if (target === view) {
        view.classList.toggle('zoomed');
        return;
      }
      if (target.closest('[data-lightbox-prev]')) show(at - 1);
      else if (target.closest('[data-lightbox-next]')) show(at + 1);
      else if (target === box || target.closest('[data-lightbox-close]')) close();
    });

    document.addEventListener('keydown', (event) => {
      if (box.classList.contains('hidden')) return;
      if (event.key === 'Escape') close();
      else if (event.key === 'ArrowLeft') show(at - 1);
      else if (event.key === 'ArrowRight') show(at + 1);
    });
  </script>

