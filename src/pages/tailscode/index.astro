  .ts .trust-grid {
    display: grid;
    gap: 1.8rem;
    align-items: center;
    margin-bottom: 2rem;
  }

  @media (min-width: 1024px) {
    .ts .trust-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: 3.5rem;
    }
  }

  .ts .tailnet {
    display: block;
    width: 100%;
    height: auto;
    font-family: 'Space Grotesk', system-ui, sans-serif;
  }

  .ts .tailnet .node {
