    color: var(--c);
    margin: 0 0 0.9rem;
  }

  .ts .kicker .beta {
    margin-left: 0.5rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid color-mix(in srgb, var(--c) 55%, transparent);
