      left: 50%;
      width: min(100vw - 3rem, 86rem);
      aspect-ratio: 8400 / 4660;
      margin: 2.6rem 0 3.4rem;
      transform: translateX(-50%);
    }

    .ts .lineup figure {
      position: absolute;
    }

    .ts .lineup figcaption {
      display: none;
    }

    .ts .lineup-desk {
      left: 3.9%;
      top: 0;
      width: 49.7%;
    }

    .ts .lineup-mac {
      left: 52.9%;
      top: 36%;
      width: 43%;
    }

    .ts .lineup-pad {
      left: 2.4%;
      top: 53%;
      width: 31.6%;
    }

    .ts .lineup-phone {
      left: 36.8%;
      top: 49%;
      width: 12.5%;
    }
  }

  .ts .tty-row {
    align-items: start;
  }

  .ts .tty {
    padding: 1rem 1.15rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 0.9rem;
    background: #05070c;
    color: #dfe5ee;
    overflow-x: auto;
    box-shadow: 0 24px 44px -24px rgb(0 0 0 / 0.6);
  }

  .ts .tty-caption {
    margin: 0 0 0.7rem;
    font-size: 0.74rem;
    color: #8590a3;
  }

  .ts .tty-lines {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(0.62rem, 1.35vw, 0.82rem);
    line-height: 1.55;
  }

  .ts .tty-lines > div {
    white-space: pre;
  }

  .ts .tty-prompt {
    color: #56b3ff;
    font-weight: 700;
  }

  .ts .tty-green {
    color: #5fe08a;
  }

  .ts .tty-red {
    color: #ff4a45;
  }

  .ts .tty-gold {
    color: #ffd23f;
  }

  .ts .tty-dim {
    color: #5d6779;
  }

  .ts .tty-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
