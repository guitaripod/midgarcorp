    font-size: 0.62rem;
    letter-spacing: 0.14em;
  }

  .ts .blade {
    display: block;
    width: min(9rem, 42%);
    height: 3px;
    margin: 1.15rem 0 1.5rem;
    border-radius: 2px;
    background: var(--c);
    transform-origin: left center;
  }

  html.dark .ts .blade {
    background: linear-gradient(90deg, #fff 0%, var(--c) 22%);
    box-shadow:
      0 0 6px var(--c),
      0 0 18px color-mix(in srgb, var(--c) 70%, transparent),
      0 0 44px color-mix(in srgb, var(--c) 35%, transparent);
  }

  .ts.ignites .blade {
    transform: scaleX(0);
    transition: transform 0.75s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ts.ignites .blade.is-lit {
    transform: scaleX(1);
  }

  .ts .blade.mini {
    width: 2.6rem;
    margin: 0;
    transform: none;
  }

  .ts .lead {
    max-width: 44rem;
    margin: 0 0 1.6rem;
    font-size: 1.1rem;
    line-height: 1.62;
    color: var(--dim);
  }

  .ts .fine {
    max-width: 46rem;
    margin: 1.2rem 0 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--dim);
  }

  .ts .fine a {
    color: var(--blue);
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }

  .ts .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }

  .ts .hero {
    position: relative;
    isolation: isolate;
    margin-top: 1rem;
    padding: clamp(2.2rem, 5vw, 4.5rem) 0 clamp(2.8rem, 6vw, 5.5rem);
    overflow: hidden;
    background: linear-gradient(180deg, #f7ecd9 0%, var(--canvas) 70%);
  }

  html.dark .ts .hero {
    background:
      radial-gradient(55% 60% at 84% 6%, rgb(42 91 208 / 0.2), transparent 70%),
      radial-gradient(45% 55% at 6% 100%, rgb(86 179 255 / 0.07), transparent 70%),
      linear-gradient(180deg, #070a12 0%, var(--canvas) 100%);
  }

  .ts .hero-inner {
    display: grid;
    gap: 2.6rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .ts .hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  .ts .hero-app {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.4rem;
  }

  .ts .hero-app h1 {
    margin: 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .ts .hero-app span {
    font-size: 0.95rem;
    color: var(--dim);
  }

  .ts .hero-icon {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.95rem;
    object-fit: cover;
    box-shadow: 0 14px 40px -12px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .ts .edition {
    margin-bottom: 0.7rem;
    color: var(--gold);
  }

  .ts .edition a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ts .hero-title {
    font-size: clamp(2.6rem, 5.2vw, 4.3rem);
    line-height: 0.98;
    margin-bottom: 1.4rem;
  }

  .ts .hero-sub {
    max-width: 36rem;
    margin: 0 0 1.4rem;
    font-size: 1.12rem;
    line-height: 1.62;
    color: var(--dim);
  }

  .ts .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .ts .chips a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--green) 45%, transparent);
    border-radius: 999px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--green);
    transition: background-color 0.2s;
  }

  .ts .chips a:hover {
    background: color-mix(in srgb, var(--green) 12%, transparent);
  }

  .ts .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .ts .ghost-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid color-mix(in srgb, var(--blue) 50%, transparent);
    border-radius: 0.65rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--blue);
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .ts .ghost-btn:hover {
    background: color-mix(in srgb, var(--blue) 12%, transparent);
    border-color: var(--blue);
  }

  .ts .hero-note {
    margin: 0.9rem 0 0;
    font-size: 0.8rem;
    color: var(--dim);
  }

  .ts .hero-rating {
    margin: 0.8rem 0 0;
    font-size: 0.9rem;
  }

  .ts .stage {
    position: relative;
    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
    aspect-ratio: 100 / 66;
  }

  .ts .stage img {
    position: absolute;
    height: auto;
    filter: drop-shadow(0 26px 34px rgb(0 0 0 / 0.42));
  }

  html:not(.dark) .ts .stage img {
    filter: drop-shadow(0 22px 26px rgb(74 52 24 / 0.3));
  }

  .ts .stage-mac {
    top: 0;
    right: 0;
    width: 94%;
  }

  .ts .stage-phone {
    left: 0;
    bottom: 0;
    width: 25%;
  }

  @media (min-width: 1024px) {
    .ts .stage {
      width: min(132%, calc(100% + (100vw - min(100vw - 2rem, 72rem)) / 2 - 0.5rem));
      max-width: none;
    }
  }

  .ts .scene {
    padding: clamp(3rem, 5.5vw, 4.6rem) 0;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 4.5rem;
  }

  .ts .scene.bleed {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 0;
  }

  .ts .sub {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(2.6rem, 5vw, 3.6rem);
    border-top: 1px dashed var(--rule);
    scroll-margin-top: 4.5rem;
  }

  .ts .split {
    display: grid;
    gap: 2.6rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .ts .split {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 4rem;
    }

    .ts .split.flip > :first-child {
      order: 2;
    }

    .ts .split.flip {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }
  }

  .ts .points {
    display: grid;
    gap: 0.8rem;
    max-width: 46rem;
    margin: 0 0 2.2rem;
    padding: 0;
    list-style: none;
  }

  .ts .points li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 0.98rem;
    line-height: 1.58;
    color: var(--text);
  }

  .ts .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.7rem;
    height: 2px;
    border-radius: 2px;
    background: var(--c);
  }

  html.dark .ts .points li::before {
    box-shadow: 0 0 8px var(--c);
  }

  @media (min-width: 900px) {
    .ts .points.cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem 3rem;
      max-width: none;
    }
  }

  .ts .cards {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .ts .cards,
    .ts .cards.two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ts .cards.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ts .cards li {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--raised) 78%, transparent);
  }

  .ts .cards h3 {
    margin: 0 0 0.4rem;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .ts .cards p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--dim);
  }

  .ts .cards .stack {
    margin-bottom: 0.5rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--c);
  }

  .ts .clients {
    margin-top: 2.4rem;
  }

  .ts .steps {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ts .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--raised) 78%, transparent);
  }

  .ts .step-n {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c);
  }

  .ts .steps h3 {
    margin: 0 0 0.35rem;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 1.02rem;
    font-weight: 700;
  }

  .ts .steps p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.58;
    color: var(--dim);
  }

  .ts figure {
    margin: 0;
  }

  .ts figcaption {
    margin-top: 0.8rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--dim);
  }

  .ts figcaption strong {
    display: block;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--c);
  }

  .ts .device img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 26px rgb(0 0 0 / 0.36));
  }

  html:not(.dark) .ts .device img,
  html:not(.dark) .ts .wide img {
    filter: drop-shadow(0 16px 22px rgb(74 52 24 / 0.26));
  }

  .ts .device-phone.solo {
    width: min(70%, 19rem);
    margin-inline: auto;
  }

  .ts .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem;
    width: min(100%, 34rem);
    margin-inline: auto;
  }

  .ts .rail {
    display: flex;
    gap: 1.2rem;
    margin-inline: -1rem;
    padding: 0 1rem 0.8rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .ts .rail::-webkit-scrollbar {
    display: none;
  }

  .ts .rail > figure {
    flex: 0 0 62%;
    max-width: 16rem;
    scroll-snap-align: center;
  }

  @media (min-width: 768px) {
    .ts .rail {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }

    .ts .rail > figure {
      max-width: none;
    }
  }

  @media (min-width: 768px) {
    .ts .rail.rail-3 {
      grid-template-columns: repeat(3, minmax(0, 16.5rem));
      justify-content: center;
      gap: 3rem;
    }
  }

  .ts .twin {
    display: grid;
    gap: 2.4rem;
    margin-bottom: 1rem;
  }

  .ts .twin > div {
    scroll-margin-top: 4.5rem;
  }

  @media (min-width: 900px) {
    .ts .twin {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem;
    }
  }

  .ts .wide {
    max-width: 60rem;
    margin: 2.6rem auto 0;
  }

  .ts .wide.full,
  .ts .duo-wide .wide {
    max-width: none;
  }

  .ts .wide img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 24px 34px rgb(0 0 0 / 0.4));
  }

