---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppStoreBadge from '@components/landing/AppStoreBadge.astro';
import StarRating from '@components/landing/StarRating.astro';
import FeatureGrid from '@components/landing/FeatureGrid.astro';
import FaqAccordion from '@components/landing/FaqAccordion.astro';
import PricingTable from '@components/landing/PricingTable.astro';
import AppIcon from '@components/landing/AppIcon.astro';
import SectionHead from '@components/landing/SectionHead.astro';
import ShotFigure from '@components/landing/ShotFigure.astro';
import { landingApps, screenshotUrl, type LandingApp } from '@data/landing';

export const prerender = true;

const app = landingApps.find((a) => a.slug === 'tailscode') as LandingApp;
const c = app.content;
const accent = c.accentColor || app.primaryColor;
const githubUrl = app.githubUrl;
const releaseUrl = app.latestReleaseUrl ?? app.githubUrl;

const site = 'https://midgarcorp.cc';
const canonical = `${site}/tailscode/`;
const OG_REV = '8';
const ogImage = `/og/tailscode.png?v=${OG_REV}`;

const subtitle = app.name.includes(':')
  ? app.name.split(':').slice(1).join(':').trim()
  : (app.category ?? '');

const abs = (p?: string | null) => (p ? (p.startsWith('http') ? p : site + p) : undefined);

const shotBase = '/screenshots/tailscode';
const shot = (name: string) => `${shotBase}/${name}.webp`;

/// A screen in both of its faces; a pair whose faces are the same file renders one image.
const faces = (dark: string, light: string, w: number, h: number) => ({
  dark: shot(dark),
  light: shot(light),
  w,
  h,
});

/// The Studio figures, one entry per shot; a pair whose faces are the same file renders one image.
const STUDIO = {
  mac: faces('mac-dark-studio', 'mac-light-studio', 1920, 1200),
  phonePainting: faces('suomi-dark-13', 'suomi-light-13', 1320, 2868),
  phoneFinished: faces('suomi-dark-14', 'suomi-light-14', 1320, 2868),
  linux: faces('desk-dark-studio', 'desk-light-studio', 1920, 1080),
  videoPhone: faces('suomi-dark-15', 'suomi-light-15', 1320, 2868),
  videoMac: faces('mac-dark-video', 'mac-dark-video', 1920, 1200),
};

/// Where the rebuilt Studio can be had today. It is the one place the page names a release,
/// so it is the one line to change when the Apple builds carry it.
const studioAvailability =
  'The rebuilt Studio is in the Linux 1.72 release and in builds from source, not yet in the App Store builds.';

const hero = faces('desk-dark-chat', 'desk-light-chat', 1920, 1080);
const heroCaption =
  'The Linux desk in the Suomi theme. Flip this page’s theme: every screenshot follows.';
const syncBoth = faces('sync-03-both', 'sync-03-both', 1920, 1080);

/// The phone rail: the demo wearing Suomi, by file number. The Studio shots are in their own section.
const phonePicks = [1, 2, 3, 4, 7, 8, 9, 12];
const phoneCaptions = c.screenshotCaptions?.iphone ?? [];
const phoneShots = phonePicks.map((n, i) => ({
  ...faces(
    `suomi-dark-${String(n).padStart(2, '0')}`,
    `suomi-light-${String(n).padStart(2, '0')}`,
    1320,
    2868
  ),
  caption: phoneCaptions[i] ?? '',
}));

const ipadCaptions = c.screenshotCaptions?.ipad ?? [];
const ipadShots = (app.screenshots.ipad ?? []).map((s, i) => ({
  src: s.src,
  w: s.w,
  h: s.h,
  caption: ipadCaptions[i] ?? s.label,
}));

const deskCaptions = c.screenshotCaptions?.desktop ?? [];
const deskShots = [
  {
    ...faces('desk-dark-split', 'desk-light-split', 1920, 1080),
    client: 'Linux',
    caption: deskCaptions[0] ?? '',
  },
  {
    ...faces('mac-dark-chat', 'mac-dark-chat', 1920, 1200),
    client: 'Mac',
    caption: deskCaptions[1] ?? '',
  },
];

const studioBullets = [
  'The machine’s own sketch fills the stage while it paints, when it sends one, and a progress line runs along the stage’s foot.',
  'On the phone, under a finished picture: Save, Share, Copy, Again, Edit this. Animate this waits in its menu.',
  'The shelf is the machine’s own output folder, newest first, with the words, seed and steps read back from the files.',
  'Enhance has a language model of yours write the paragraph; Continue it picks up where a finished clip ends.',
];

const section = 'border-t border-paper-border py-8 dark:border-term-border sm:py-9';

/// A row of figures that scrolls sideways on a phone and lays out as a grid from `sm` up.
const rail =
  'no-scrollbar -mx-4 flex snap-x snap-mandatory items-start gap-4 overflow-x-auto px-4 pb-3 sm:mx-0 sm:grid sm:overflow-visible sm:px-0 sm:pb-0';
const railItem = 'shrink-0 snap-center';

const operatingSystem = 'iOS, iPadOS, Linux, macOS';
const priceNumeric = app.price === 'Free' ? '0' : app.price.replace('$', '');

const allShots = Object.values(app.screenshots)
  .flat()
  .map((s) => abs(screenshotUrl(s.src)));

const downloadOffer = {
  '@type': 'Offer',
  name: `${app.shortName} download`,
  price: priceNumeric,
  priceCurrency: 'USD',
  url: app.appStoreUrl,
  availability: 'https://schema.org/InStock',
};
const premiumOffers = (c.pricing?.tiers ?? [])
  .filter((tier) => typeof tier.amount === 'number')
  .map((tier) => ({
    '@type': 'Offer',
    name: `${c.pricing!.premium.title} — ${tier.name}`,
    price: String(tier.amount),
    priceCurrency: 'USD',
    url: app.appStoreUrl,
    availability: 'https://schema.org/InStock',
    category: 'InAppPurchase',
    ...(tier.period
      ? { eligibleDuration: { '@type': 'QuantitativeValue', value: tier.period } }
      : {}),
  }));

const softwareApp = {
  '@type': 'SoftwareApplication',
  name: app.name,
  operatingSystem,
  applicationCategory: app.category,
  description: c.metaDescription,
  url: canonical,
  installUrl: app.appStoreUrl,
  image: abs(app.iconLocal),
  screenshot: allShots,
  offers: premiumOffers.length ? [downloadOffer, ...premiumOffers] : downloadOffer,
  author: { '@type': 'Organization', name: 'Midgar Oy', url: site },
  publisher: { '@type': 'Organization', name: 'Midgar Oy', url: site },
  ...(app.version ? { softwareVersion: app.version } : {}),
  ...(app.releaseDate ? { datePublished: app.releaseDate } : {}),
  ...(app.ratingCount > 0
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: app.rating,
          ratingCount: app.ratingCount,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
  isAccessibleForFree: true,
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  codeRepository: githubUrl,
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'Apps', item: `${site}/apps` },
    { '@type': 'ListItem', position: 3, name: app.shortName, item: canonical },
  ],
};
const faqPage = {
  '@type': 'FAQPage',
  mainEntity: c.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [softwareApp, breadcrumb, faqPage],
};

const siblings = landingApps
  .filter((a) => a.slug !== 'tailscode')
  .sort((a, b) => new Date(b.releaseDate ?? 0).getTime() - new Date(a.releaseDate ?? 0).getTime())
  .slice(0, 6);

const clients = [
  {
    name: 'iPhone & iPad',
    stack: 'UIKit · universal · Live Activities',
    note: 'The pocket remote: send, steer, approve, and watch the turn finish on your Lock Screen. On iPad it becomes a workspace — sidebar, chat list and conversation side by side, windows in Stage Manager, a hardware keyboard.',
  },
  {
    name: 'Linux',
    stack: 'GTK4 · libadwaita · tiling splits',
    note: 'A full desk: split panes, an embedded terminal, web and video panes, a global quick-ask key.',
  },
  {
    name: 'Mac',
    stack: 'AppKit · Liquid Glass · macOS 26',
    note: 'The same desk with Apple materials: split panes, the analytics, the git surface, and a global quick-ask key — on the App Store, and it updates itself from it.',
  },
];
---

<BaseLayout title={c.seoTitle} description={c.metaDescription} image={ogImage}>
  <div style={`--accent:${accent}`}>
    <!-- Breadcrumb -->
    <nav
      aria-label="Breadcrumb"
      class="hidden pt-8 text-xs text-paper-faint dark:text-term-faint sm:block"
    >
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/apps" class="hover:text-paper-green dark:hover:text-term-green">apps</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">tailscode</li>
      </ol>
    </nav>

    <!-- Hero -->
    <header
      class="flex flex-col gap-10 py-8 sm:py-6 lg:grid lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:gap-x-12"
    >
      <div>
        <p class="prompt-line mb-5 hidden sm:block">tailscode --everywhere</p>

        <div class="mb-5 flex items-center gap-4">
          {
            app.iconLocal && (
              <AppIcon
                src={app.iconLocal}
                width={72}
                height={72}
                displayWidths={[64, 72]}
                priority
                class="hero-icon h-16 w-16 rounded-[1.1rem] border border-paper-border object-cover dark:border-term-border sm:h-[72px] sm:w-[72px]"
              />
            )
          }
          <div class="min-w-0">
            <p
              class="text-2xl font-bold tracking-tight text-paper-text dark:text-term-text sm:text-3xl"
            >
              {app.shortName}
            </p>
            {subtitle && <p class="text-sm text-paper-muted dark:text-term-muted">{subtitle}</p>}
          </div>
        </div>

        <h1
          class="mb-4 text-3xl font-bold leading-tight tracking-tight text-paper-text dark:text-term-text sm:text-4xl"
        >
          {c.heroHeadline}
        </h1>
        <p
          class="mb-6 max-w-xl text-base leading-relaxed text-paper-muted dark:text-term-muted sm:text-lg"
        >
          {c.heroSubhead}
        </p>

        <div class="mb-7 flex flex-wrap items-center gap-3">
          <AppStoreBadge href={app.appStoreUrl} platform="ios" />
          <a
            href="https://aur.archlinux.org/packages/tailscode"
            target="_blank"
            rel="noopener noreferrer"
            class="accent-btn inline-flex items-center gap-2 rounded-sm border px-4 py-2.5 text-sm font-semibold transition-colors"
          >
            Linux — AUR ↗
          </a>
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="accent-btn inline-flex items-center gap-2 rounded-sm border px-4 py-2.5 text-sm font-semibold transition-colors"
          >
            <img src="/icons/github.svg" alt="" width="18" height="18" class="dark:invert" />
            View on GitHub
          </a>
          <a
            href="#sync"
            class="accent-btn inline-flex items-center gap-2 rounded-sm border px-4 py-2.5 text-sm font-semibold transition-colors"
          >
            See it sync ↓
          </a>
        </div>

        <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <span
            class="inline-flex items-center gap-1.5 rounded-sm border border-paper-green/40 px-2 py-0.5 text-xs font-semibold text-paper-green dark:border-term-green/40 dark:text-term-green"
          >
            Open source
          </span>
          <StarRating rating={app.rating} count={app.ratingCount} releaseDate={app.releaseDate} />
          <span class="font-semibold text-paper-amber dark:text-term-amber">
            {app.license ?? 'GPL-3.0'}
          </span>
          <span class="hidden flex-wrap gap-1.5 sm:flex">
            {
              ['iPhone', 'iPad', 'Linux', 'Mac'].map((p) => (
                <span class="rounded-sm border border-paper-border px-1.5 py-0.5 text-xs text-paper-faint dark:border-term-border dark:text-term-faint">
                  {p}
                </span>
              ))
            }
          </span>
        </div>

        <ul class="grid gap-2">
          {
            c.highlights.map((h) => (
              <li class="flex items-start gap-2 text-sm text-paper-text dark:text-term-text">
                <span class="accent-text mt-0.5 shrink-0" aria-hidden="true">
                  ▸
                </span>
                <span>{h}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <ShotFigure
        dark={hero.dark}
        light={hero.light}
        w={hero.w}
        h={hero.h}
        alt="Tailscode for Linux in the Suomi theme: a conversation in the compact chat"
        sizes="(min-width: 1024px) 560px, 100vw"
        variant="hero"
        priority
        class="mx-auto w-full max-w-[560px] lg:max-w-none"
      >
        {heroCaption}
      </ShotFigure>
    </header>

    <section id="sync" class={section}>
      <div class="grid items-center gap-x-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <SectionHead
            prompt="tailscode sync --watch"
            title="One session, two machines, zero relays"
          >
            One real <span class="font-semibold text-paper-text dark:text-term-text">ultracode</span
            > turn, captured on both machines at once. A prompt leaves the iPhone, reaches a claude-bridge
            server over the tailnet, and the session is already live in the Linux sidebar. Both composers
            burn the rainbow while it runs, and both show the same answer when it settles. No relay sees
            a byte.
          </SectionHead>
        </div>
        <ShotFigure
          dark={syncBoth.dark}
          w={syncBoth.w}
          h={syncBoth.h}
          alt="Both machines side by side with the same settled answer, the turn priced in the phone's chrome"
          sizes="(min-width: 1152px) 704px, 100vw"
          class="lg:col-span-8"
        >
          <span class="accent-text mr-1 font-semibold">One answer, two screens</span> — the turn settles
          on both machines at once, priced in the phone's chrome.
        </ShotFigure>
      </div>
    </section>

    <section id="studio" class={section}>
      <div class="mb-6 grid items-start gap-x-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SectionHead
            prompt="tailscode studio --on arch"
            title="A picture is something you ask for in words"
          >
            Describe it and your own machine paints it: ComfyUI behind Tailscale, Qwen-Image for
            quality, FLUX.2 Klein for speed. A clip is the same sentence with a longer verb,
            rendered by LTX from words or from a first frame. Nothing leaves your tailnet.
          </SectionHead>
        </div>
        <div class="lg:col-span-7 lg:pt-9">
          <ul class="mb-3 grid gap-2">
            {
              studioBullets.map((b) => (
                <li class="flex items-start gap-2 text-sm text-paper-text dark:text-term-text">
                  <span class="accent-text mt-0.5 shrink-0" aria-hidden="true">
                    ▸
                  </span>
                  <span>{b}</span>
                </li>
              ))
            }
          </ul>
          <p class="text-xs text-paper-faint dark:text-term-faint">{studioAvailability}</p>
        </div>
      </div>

      <div class="grid gap-4">
        <ShotFigure
          dark={STUDIO.mac.dark}
          light={STUDIO.mac.light}
          w={STUDIO.mac.w}
          h={STUDIO.mac.h}
          alt="The Studio on the Mac: a finished picture on the stage with its verbs under it, the machine's shelf at the right and the brief docked below"
          sizes="(min-width: 1024px) 880px, 100vw"
          class="lg:mx-auto lg:max-w-[880px]"
        >
          <span class="accent-text mr-1 font-semibold">Mac</span> — Image and video are one window: a
          lane switch, the stage, the machine's shelf and the brief docked under it.
        </ShotFigure>

        <div class={`${rail} lg:grid-cols-12`}>
          <ShotFigure
            dark={STUDIO.phonePainting.dark}
            light={STUDIO.phonePainting.light}
            w={STUDIO.phonePainting.w}
            h={STUDIO.phonePainting.h}
            alt="The Studio on iPhone while a picture is painting"
            sizes="(min-width: 1024px) 175px, 170px"
            variant="phone"
            class={`${railItem} w-[170px] lg:w-auto lg:col-span-2`}
          >
            <span class="accent-text mr-1 font-semibold">iPhone</span> — painting: the sketch on the
            stage.
          </ShotFigure>
          <ShotFigure
            dark={STUDIO.phoneFinished.dark}
            light={STUDIO.phoneFinished.light}
            w={STUDIO.phoneFinished.w}
            h={STUDIO.phoneFinished.h}
            alt="The Studio on iPhone with a finished picture and its verbs"
            sizes="(min-width: 1024px) 175px, 170px"
            variant="phone"
            class={`${railItem} w-[170px] lg:w-auto lg:col-span-2`}
          >
            <span class="accent-text mr-1 font-semibold">iPhone</span> — done: the verbs sit under the
            picture.
          </ShotFigure>
          <ShotFigure
            dark={STUDIO.linux.dark}
            light={STUDIO.linux.light}
            w={STUDIO.linux.w}
            h={STUDIO.linux.h}
            alt="The Studio on Linux: a finished picture with its verbs under it, the machine pill above and the shelf rail at the right"
            sizes="(min-width: 1024px) 720px, 80vw"
            class={`${railItem} w-[80vw] lg:w-auto lg:col-span-8 lg:self-center`}
          >
            <span class="accent-text mr-1 font-semibold">Linux</span> — the same brief, stage and shelf,
            with the machine named above.
          </ShotFigure>
          <ShotFigure
            dark={STUDIO.videoPhone.dark}
            light={STUDIO.videoPhone.light}
            w={STUDIO.videoPhone.w}
            h={STUDIO.videoPhone.h}
            alt="The video screen on iPhone: the second pass of a render with the sketch on the stage"
            sizes="(min-width: 1024px) 175px, 170px"
            variant="phone"
            class={`${railItem} w-[170px] lg:col-span-2 lg:col-start-3 lg:w-auto`}
          >
            <span class="accent-text mr-1 font-semibold">iPhone</span> — a clip is a screen of its own,
            with its sketch too.
          </ShotFigure>
          <ShotFigure
            dark={STUDIO.videoMac.dark}
            light={STUDIO.videoMac.light}
            w={STUDIO.videoMac.w}
            h={STUDIO.videoMac.h}
            alt="The Video lane of the Studio on the Mac: a staged demo clip on the stage, the clip shelf at the right"
            sizes="(min-width: 1024px) 544px, 80vw"
            class={`${railItem} w-[80vw] lg:w-auto lg:col-span-6 lg:self-center`}
          >
            <span class="accent-text mr-1 font-semibold">Mac</span> — the Video lane, in the same window
            as Image.
          </ShotFigure>
        </div>
      </div>
    </section>

    <section id="screenshots" class={section}>
      <SectionHead prompt="ls ~/tailscode/iphone" title="The pocket client, screen by screen">
        Every frame is the built-in demo wearing Suomi: what you see before wiring a single server.
        Scroll the rail; flip the site theme to see the other face.
      </SectionHead>
      <div class="no-scrollbar -mx-4 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-3">
        {
          phoneShots.map((s, i) => (
            <ShotFigure
              dark={s.dark}
              light={s.light}
              w={s.w}
              h={s.h}
              alt={`Tailscode on iPhone: ${s.caption}`}
              sizes="260px"
              variant="phone"
              class="w-[210px] shrink-0 snap-center sm:w-[260px]"
            >
              <span class="accent-text mr-1 font-semibold">{String(i + 1).padStart(2, '0')}</span>
              {s.caption}
            </ShotFigure>
          ))
        }
      </div>
    </section>

    <section id="desks" class={section}>
      <SectionHead prompt="ls ~/tailscode/ipad" title="A workspace, not a stretched phone">
        On iPad the sidebar holds places, chat scopes and servers, the chat list sits beside it and
        the conversation fills the rest. Narrow the window and it becomes the phone's app without
        closing the chat you were in; a chat opens in its own window for Stage Manager, and a
        hardware keyboard drives it all.
      </SectionHead>
      <div class={`${rail} mb-6 sm:grid-cols-2 sm:items-stretch`}>
        {
          ipadShots.map((s, i) => (
            <ShotFigure
              dark={s.src}
              w={s.w}
              h={s.h}
              alt={`Tailscode on iPad: ${s.caption}`}
              sizes="(min-width: 1152px) 536px, (min-width: 640px) 50vw, 86vw"
              variant="ipad"
              class={`${railItem} w-[86vw] sm:w-auto`}
            >
              <span class="accent-text mr-1 font-semibold">{String(i + 1).padStart(2, '0')}</span>
              {s.caption}
            </ShotFigure>
          ))
        }
      </div>

      <p class="prompt-line mb-2">ls ~/tailscode/desktop</p>
      <h3 class="mb-3 text-2xl font-bold tracking-tight text-paper-text dark:text-term-text">
        Three desks, one shared core
      </h3>
      <p class="mb-6 max-w-2xl text-sm leading-relaxed text-paper-muted dark:text-term-muted">
        The Linux client is native GTK4, the Mac client native AppKit, the phone programmatic UIKit.
        All three render the same toolkit-free core, and a parity registry refuses to compile a
        client that hasn't answered for a capability the others have.
      </p>
      <div class={`${rail} mb-3 sm:grid-cols-3`}>
        {
          clients.map((cl) => (
            <div class={`${railItem} term-frame w-[80vw] p-4 sm:w-auto`}>
              <p class="mb-1 text-sm font-bold text-paper-text dark:text-term-text">{cl.name}</p>
              <p class="term-label accent-text mb-2">{cl.stack}</p>
              <p class="text-xs leading-relaxed text-paper-muted dark:text-term-muted">{cl.note}</p>
            </div>
          ))
        }
      </div>
      <div class={`${rail} sm:grid-cols-2 sm:items-stretch`}>
        {
          deskShots.map((s) => (
            <ShotFigure
              dark={s.dark}
              light={s.light}
              w={s.w}
              h={s.h}
              alt={`Tailscode for ${s.client}: ${s.caption}`}
              sizes="(min-width: 1152px) 536px, (min-width: 640px) 50vw, 86vw"
              class={`${railItem} w-[86vw] sm:w-auto`}
            >
              {s.caption}
            </ShotFigure>
          ))
        }
      </div>
    </section>

    <section id="features" class={section}>
      <SectionHead prompt="tailscode --features" title={`What ${app.shortName} does`} />
      <FeatureGrid features={c.features} accent={accent} compact />
    </section>

    {
      c.pricing && (
        <section id="pricing" class={section}>
          <SectionHead prompt="tailscode --pricing" title={c.pricing.heading} />
          <PricingTable pricing={c.pricing} accent={accent} />
        </section>
      )
    }

    <section class={section}>
      <SectionHead prompt="man tailscode" title={`How ${app.shortName} works`} />
      <ol class={`${rail} sm:grid-cols-3`}>
        {
          c.howItWorks.map((step, i) => (
            <li class={`${railItem} term-frame w-[80vw] p-5 sm:w-auto`}>
              <p class="term-label accent-text mb-2">{String(i + 1).padStart(2, '0')}</p>
              <p class="mb-1.5 text-sm font-bold text-paper-text dark:text-term-text">
                {step.step}
              </p>
              <p class="text-xs leading-relaxed text-paper-muted dark:text-term-muted">
                {step.body}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="faq" class={section}>
