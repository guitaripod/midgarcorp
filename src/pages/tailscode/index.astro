  html:not(.dark) .ts .lineup img {
    filter: drop-shadow(0 18px 22px rgb(74 52 24 / 0.28));
  }

  .ts .lineup figcaption {
    text-align: center;
  }

  .ts .lineup figcaption strong {
    display: inline;
    margin-right: 0.35rem;
  }

  .ts .lineup-desk,
  .ts .lineup-mac {
    grid-column: span 2;
  }

  .ts .lineup-phone {
    width: 46%;
    justify-self: center;
  }

  @media (min-width: 900px) {
    .ts .lineup {
      display: block;
