---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppStoreBadge from '@components/landing/AppStoreBadge.astro';
import StarRating from '@components/landing/StarRating.astro';
import FeatureGrid from '@components/landing/FeatureGrid.astro';
import FaqAccordion from '@components/landing/FaqAccordion.astro';
import PricingTable from '@components/landing/PricingTable.astro';
import AppIcon from '@components/landing/AppIcon.astro';
import RimFigure from '@components/landing/RimFigure.astro';
import DuoCombo from '@components/landing/DuoCombo.astro';
import { landingApps, screenshotUrl, type LandingApp } from '@data/landing';
import figureFacts from '@data/tailscode-figures.json';
import { siblingApps } from '@utils/sibling-apps';
import { appPageJsonLd } from '@utils/structured-data';
import { markdownPath } from '@utils/llms';

export const prerender = true;

const app = landingApps.find((a) => a.slug === 'tailscode') as LandingApp;
const c = app.content;
const accent = c.accentColor || app.primaryColor;
const githubUrl = app.githubUrl;
const releaseUrl = app.latestReleaseUrl ?? app.githubUrl;
const macStoreUrl = c.macAppStoreUrl ?? app.appStoreUrl;
const aurUrl = 'https://aur.archlinux.org/packages/tailscode';

const OG_REV = '13';
const ogImage = `/og/tailscode.png?v=${OG_REV}`;

const subtitle = app.name.includes(':')
  ? app.name.split(':').slice(1).join(':').trim()
  : (app.category ?? '');

/// Whether the App Store's live version is 2.0 or later. The page reads the version from the store
/// facts the site refreshes, so what speaks of 2.0 appears by itself once 2.0 is out and never before.
const isTwo = Number.parseInt((app.version ?? '').split('.')[0] ?? '', 10) >= 2;

/// The store's header line, with its last word apart so the page can light it.
const headlineBreak = c.heroHeadline.lastIndexOf(' ');
const headlineLead = c.heroHeadline.slice(0, headlineBreak);
const headlineLit = c.heroHeadline.slice(headlineBreak + 1);

const shotBase = '/screenshots/tailscode';

type FigureFact = { w: number; h: number; day?: boolean; full?: boolean };
const facts = figureFacts as Record<string, FigureFact>;

/// A picture of the app in Outer Rim by its name in `tailscode-figures.json`: the night face, the
/// day face when it was photographed too, and the full-size master a desk shot opens to.
const fig = (name: string) => {
  const fact = facts[name];
  if (!fact) throw new Error(`tailscode-figures.json has no figure named ${name}`);
  const night = `${shotBase}/or-n-${name}.webp`;
  const day = fact.day ? `${shotBase}/or-d-${name}.webp` : night;
  const full = fact.full ? `${shotBase}/full/or-n-${name}.webp` : undefined;
  const fullDay = fact.full && fact.day ? `${shotBase}/full/or-d-${name}.webp` : full;
  return { night, day, w: fact.w, h: fact.h, full, fullDay };
};

const splitCaption = (text: string) => {
  const at = text.indexOf(' — ');
  return at < 0 ? { head: text, body: '' } : { head: text.slice(0, at), body: text.slice(at + 3) };
};

/// The store's ten iPhone panels, in the store's order; each section of the story picks its own by role.
const phoneRoles = [
  'agents',
  'wall',
  'models',
  'peek',
  'setup',
  'steer',
  'gpu',
  'carry',
  'party',
  'costs',
];
const phoneCaptions = c.screenshotCaptions?.iphone ?? [];
const phoneShots = Object.fromEntries(
  phoneRoles.map((role, i) => [
    role,
    { ...fig(`phone-${role}`), ...splitCaption(phoneCaptions[i] ?? '') },
  ])
);
const phonesFor = (...roles: string[]) => roles.map((role) => phoneShots[role]);

/// A seeded scatter of stars, so every build draws the same sky: mostly dust, a few near ones.
const sky = (seed: number, count: number) => {
  let state = seed;
  const next = () => {
    state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
    return state / 4294967296;
  };
  return Array.from({ length: count }, () => {
    const near = next() > 0.9;
    return {
      x: (next() * 1600).toFixed(1),
      y: (next() * 900).toFixed(1),
      r: (near ? 1.1 + next() * 0.9 : 0.4 + next() * 0.6).toFixed(2),
      o: (near ? 0.6 + next() * 0.3 : 0.15 + next() * 0.45).toFixed(2),
      tint: next() > 0.84 ? '#fff1d6' : next() > 0.7 ? '#bcd4ff' : '#dfe8ff',
    };
  });
};
const heroSky = sky(0x0b17, 150);
const terminalSky = sky(0x5ec7, 120);
const closingSky = sky(0xfa12, 90);

/// The five signals of Outer Rim, as the theme itself reads them.
const blades = [
  { name: 'Blue', tone: 'blue', means: 'motion: a turn that is working' },
  { name: 'Gold', tone: 'gold', means: 'the one that asks to be read' },
  { name: 'Green', tone: 'green', means: 'what the agent touched' },
  { name: 'Red', tone: 'red', means: 'failure, and the line a diff took out' },
  { name: 'Violet', tone: 'violet', means: 'the rare standing mark' },
];

const agentsBullets = [
  'Home is one ranked board: a sentence that says who needs you and what is working, then the chats waiting on you, working, pinned and recent.',
  'The Agents board shows what needs you, what is working, what runs in the background and what finished in the last hour, with approve and answer on each card.',
  'Watch turns it into a full-screen wall of every agent. Peek at any agent without opening its chat: its step, its last moves, its context.',
  'The hour shows, lane by lane, what each agent did while you were away.',
];

const mastersPoints = [
  {
    head: 'A role that stays',
    body: 'Give a machine a standing role: a charter, the skills it adopts and a notebook it keeps. iPadOS, Server, Releases: whatever you would hand to a specialist.',
  },
  {
    head: 'Every task starts briefed',
    body: 'A task is a fresh session that begins with the charter, the notebook and the last journal entries, so it never works from a conversation that has gone stale.',
  },
  {
    head: 'It ends in a debrief',
    body: 'What it learned comes back as notebook changes you accept or skip. Nothing is remembered that you did not approve.',
  },
  {
    head: 'Guards and a bench it proves',
    body: 'Checks run on the machine’s own clock and stay quiet while they pass; a guard that starts failing is news. The bench says which devices are really there.',
  },
];
const mastersAvailability = 'Masters is in beta and needs claude-bridge 1.38 or later.';

const modelsBullets = [
  'Whatever your agent can run, from cloud models to a local model served by Ollama or llama.cpp on your own machine, picked per chat with its reasoning effort.',
  'Carry a conversation to another model: the next one gets a short brief of the chat and picks up the thread.',
  'A party of six favourite models and their effort levels, one tap or one swipe of the model pill away.',
];

/// What Hermes and the schedules ask of the machine.
const agentsAvailability =
  'Hermes and ACP agents need claude-bridge 1.17 or later; schedules run on claude-bridge 1.17 or omp-bridge 0.10.';

const anyAgentBullets = [
  'Hermes, Gemini CLI, Codex, goose, Kimi, Qwen Code, Copilot and the rest of the ACP registry, through the claude-bridge already on your machine. Nothing new to install, pair or open.',
  'Ready means it answered: the machine opens a real session in each agent before calling it ready, and says in its own words what is missing when it is not.',
  'No model of its own? Give it one tap of the GPU you already run: llama-swap, ollama, LM Studio and vLLM are found and offered first. Keys stay on the machine.',
];

const laterBullets = [
  'Hold Send and pick a time, or say it: weekdays 7:30, every 2 hours, fri 17:00. The date it means is shown before anything is saved.',
  'The machine asks, whether or not your phone or computer is on, with any agent and model.',
  'Repeats keep one conversation that remembers, and stay quiet when nothing changed. A failure always speaks.',
];

const lockBullets = [
  'A Live Activity on your Lock Screen for a running turn, wherever it was started, one for each with Pro: drawn like its tile on the Agents wall, with its plan, latest steps and model.',
  'Notifications say what happened: how long it took, what it changed and the first of what it said. Reply from the Lock Screen to start the next turn.',
  'An approval shows the exact command and asks for Face ID or your passcode; a question shows its options as buttons. Tap and you land in the exact chat.',
  'When the app is closed, iOS holds the wait and the notification still fires, straight over your tailnet.',
  'While a Mac or Linux Tailscode sees you at the computer, the phone stays quiet and tells you what is still unread once you leave. A notice goes away once its chat is read anywhere.',
];

const transcriptBullets = [
  'Megatron folds a turn’s thinking and tool runs into one head you open to read, search and replay every step.',
  'The agent’s own account sits beside the steps: what it said, its plan, the work between, and the result it can honestly claim.',
  'Diffs, commands and their real output inline; syntax-highlighted code with byte-exact copy.',
  'Queue the next message while a turn runs, edit it before it goes, or stop the turn on the server.',
  'Send screenshots and photos; the pictures the agent shows you gather in one strip under its turn and open from where they sit.',
];

const terminalPoints = [
  {
    head: 'The shell is the machine’s',
    body: 'The bridge holds your login shell, so it outlasts the app: close the window, come back, and the shell is where you left it with its recent output.',
  },
  {
    head: 'One engine, drawn natively',
    body: 'The same terminal engine, libghostty-vt, on every client, drawn by Metal on Apple devices and by GTK on Linux. No web view.',
  },
  {
    head: 'The keys glass leaves out',
    body: 'Escape, tab, control and the arrows ride above the iPhone keyboard, so vim and a pager work from the couch.',
  },
  {
    head: 'cd aims the next split',
    body: 'On the desktops a new split opens its chat in the folder the shell is standing in.',
  },
];
const terminalAvailability = 'The terminal needs claude-bridge 1.38 or omp-bridge 0.19.';

/// What the demo machine's shell shows once the three commands have run, as the screenshots show it.
const tty = [
  [{ t: 'pulse-ios ❯', k: 'prompt' }, { t: ' git status' }],
  [{ t: 'On branch ' }, { t: 'fix/reconnect-flake', k: 'green' }],
  [{ t: 'Changes not staged for commit:' }],
  [{ t: '        modified:   Sources/Pulse/Socket/Reconnect.swift', k: 'red' }],
  [{ t: '        modified:   Tests/PulseTests/ReconnectTests.swift', k: 'red' }],
  [{ t: 'pulse-ios ❯', k: 'prompt' }, { t: ' swift test' }],
  [{ t: 'Building for debugging...', k: 'dim' }],
  [{ t: '✔', k: 'green' }, { t: ' Suite ReconnectTests passed after 0.412 seconds.' }],
  [{ t: '✔', k: 'green' }, { t: ' Test run with 148 tests passed after 2.031 seconds.' }],
  [{ t: 'pulse-ios ❯', k: 'prompt' }, { t: ' git log --oneline -3' }],
  [{ t: '4c1d9aa', k: 'gold' }, { t: ' Wait for the server’s close frame before reconnecting' }],
  [{ t: '9e02b7f', k: 'gold' }, { t: ' Add a jittered backoff to the socket' }],
  [{ t: '51aa3c0', k: 'gold' }, { t: ' Split the socket’s states into their own type' }],
];

const moneyBullets = [
  'Every conversation priced, every month totalled across your machines, by model, project and tool.',
  'Plan limits and quotas per provider and account, with the pace and turns left, on Home and in widgets: walls first.',
  'Always marked an estimate: a subscription bills a flat fee, so the figure is API-equivalent value, never a bill.',
];

const studioBullets = [
  'The machine’s own sketch fills the stage while it paints, when it sends one, and a progress line runs along the stage’s foot.',
  'The shelf is the machine’s own output folder, newest first, with the words, seed and steps read back from the files.',
  'Enhance has a language model of yours write the paragraph; an edit can work from several pictures at once; Continue it picks up where a finished clip ends.',
];

const checks = [
  {
    cmd: 'tailscale status',
    note: 'lists the nodes involved: your phone and your machine, both yours.',
  },
  {
    cmd: 'tailscale ping <machine>',
    note: 'says whether the path is direct or goes through one of Tailscale’s own DERP relays.',
  },
  {
    cmd: 'git clone ' + (githubUrl ?? '').replace('https://', ''),
    note: 'the app, the engine and both bridges are GPL-3.0. Read what it sends.',
  },
];

const clients = [
  {
    name: 'iPhone & iPad',
    stack: 'UIKit · universal · Live Activities',
    note: 'The pocket remote: send, steer, approve, and watch the turn finish on your Lock Screen. On iPad it becomes a workspace: sidebar, chat list and conversation side by side, windows in Stage Manager, a hardware keyboard.',
  },
  {
    name: 'Mac',
    stack: 'AppKit · Liquid Glass · macOS 26',
    note: 'The same desk with Apple materials: the Agents window and wall, split panes, the terminal, the analytics, the git surface, and a global quick-ask key. On the Mac App Store under the same purchase as the iPhone app.',
  },
  {
    name: 'Linux',
    stack: 'GTK4 · libadwaita · tiling splits',
    note: 'A full desk: split panes, the terminal, web and video panes, a global quick-ask key. In the AUR and on GitHub.',
  },
];

const showsRating = app.ratingCount >= 5;
const jsonLd = appPageJsonLd(app, { ratingShown: showsRating });

const siblings = siblingApps(landingApps, 'tailscode');
---

<BaseLayout
  title={c.seoTitle}
  description={c.metaDescription}
  image={ogImage}
  markdown={markdownPath(app.slug)}
  appStoreId={app.trackId > 0 ? app.trackId : undefined}
>
  <div class="ts" style={`--accent:${accent}`}>
    <nav aria-label="Breadcrumb" class="crumbs">
      <ol>
        <li><a href="/">home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/apps/">apps</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">tailscode</li>
      </ol>
    </nav>

    <header class="hero bleed">
      <svg
        class="sky rim-night"
        viewBox="0 0 1600 900"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        {heroSky.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill={s.tint} opacity={s.o} />)}
      </svg>
      <svg
        class="sky rim-day"
        viewBox="0 0 1600 900"
        preserveAspectRatio="xMidYMax slice"
        aria-hidden="true"
      >
        <defs>
          <radialGradient id="sun-high">
            <stop offset="0" stop-color="#fffaf0"></stop>
            <stop offset="0.55" stop-color="#ffe9bd"></stop>
            <stop offset="1" stop-color="#ffe9bd" stop-opacity="0"></stop>
          </radialGradient>
          <radialGradient id="sun-low">
            <stop offset="0" stop-color="#ffc7a3"></stop>
            <stop offset="0.6" stop-color="#f29a72"></stop>
            <stop offset="1" stop-color="#f29a72" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <circle cx="1210" cy="250" r="150" fill="url(#sun-high)"></circle>
        <circle cx="1390" cy="610" r="92" fill="url(#sun-low)"></circle>
        <path d="M0 900 V760 Q260 650 560 742 T1120 716 T1600 760 V900 Z" fill="#e9d6b6"></path>
        <path d="M0 900 V822 Q340 742 720 818 T1600 800 V900 Z" fill="#dfc9a4"></path>
      </svg>

      <div class="hero-inner">
        <div class="hero-copy">
          <div class="hero-app">
            {
              app.iconLocal && (
                <AppIcon
                  src={app.iconLocal}
                  width={56}
                  height={56}
                  displayWidths={[48, 56]}
                  priority
                  class="hero-icon"
                />
              )
            }
            <h1 id="app-name">{app.shortName}</h1>
            {subtitle && <span>{subtitle}</span>}
          </div>
          {
            isTwo && (
              <p class="kicker edition">
                <a href="#masters">New · Tailscode 2.0: Masters →</a>
              </p>
            )
          }
          <p class="display hero-title">
            {headlineLead}
            <span class="lit" style="--c:var(--gold)">{headlineLit}</span>
          </p>
          <p class="hero-sub">{c.heroSubhead}</p>

          <ul class="chips" aria-label="What Tailscode does not have">
            {
              ['No relay', 'No sign-in', 'No tracking', 'GPL-3.0'].map((fact) => (
                <li>
                  <a href="#trust">
                    <span aria-hidden="true">✓</span>
                    {fact}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="hero-actions">
            <AppStoreBadge href={app.appStoreUrl} platform="ios" />
            <AppStoreBadge href={macStoreUrl} platform="mac" />
            <a href={aurUrl} target="_blank" rel="noopener noreferrer" class="ghost-btn"
              >Linux: AUR ↗</a
            >
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="ghost-btn"
              >GitHub ↗</a
            >
          </div>
          <p class="hero-note">
            iPhone, iPad and Mac share one purchase on the App Store · Free, Pro is $14.99 once
          </p>
          {
            showsRating && (
              <p class="hero-rating">
                <StarRating
                  rating={app.rating}
                  count={app.ratingCount}
                  releaseDate={app.releaseDate}
                />
              </p>
            )
          }
        </div>

        <div class="stage">
          <RimFigure
            {...fig('mac-terminal')}
            alt="Tailscode on a MacBook Pro in the Outer Rim theme: a chat stopped at an approval, with the machine's own shell in a terminal pane under the transcript"
            sizes="(min-width: 1024px) 46vw, 92vw"
            priority
            class="stage-mac"
          />
          <RimFigure
            {...fig('phone-approval')}
            alt="Tailscode on iPhone in the Outer Rim theme: a chat stopped at an approval, the edit it wants to make shown as a diff, with Allow once, Always and Deny under it"
            sizes="(min-width: 1024px) 15vw, 30vw"
            priority
            class="stage-phone"
          />
        </div>
      </div>
    </header>

    <section id="setup" class="scene" style="--c:var(--green)">
      <div class="split">
        <div>
          <p class="kicker">Set up</p>
          <h2 class="display">One line. <span class="lit">Then scan.</span></h2>
          <span class="blade" aria-hidden="true"></span>
          <p class="lead">
            For Claude Code, one line on the computer you code on installs the bridge and ends with
            a QR code. Scan it, confirm, and the app has your machine. Three steps, each one checked
            by the app as you go.
          </p>
          <ol class="steps">
            {
              c.howItWorks.map((step, i) => (
                <li>
                  <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{step.step}</h3>
                    <p>{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <figure class="device device-phone solo">
          <RimFigure
            {...phoneShots.setup}
            alt="Tailscode on iPhone: set-up, the bridge's one-line installer and the QR code to scan, with the tailnet already checked"
            sizes="(min-width: 1024px) 300px, 60vw"
          />
          <figcaption>
            <strong>{phoneShots.setup.head}</strong>
            {phoneShots.setup.body}
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="agents" class="scene" style="--c:var(--blue)">
      <p class="kicker">Agents</p>
      <h2 class="display">Every agent at <span class="lit">a glance.</span></h2>
      <span class="blade" aria-hidden="true"></span>
      <p class="lead">
        One screen answers who needs you, what is working and what finished, across every machine
        you connect. Approve and answer on the card; open the chat only when you want to.
      </p>
      <ul class="points">
        {agentsBullets.map((b) => <li>{b}</li>)}
      </ul>
      <div class="rail rail-4">
        {
          phonesFor('agents', 'wall', 'peek').map((s) => (
            <figure class="device device-phone">
              <RimFigure
                {...s}
                alt={`Tailscode on iPhone: ${s.head}. ${s.body}`}
                sizes="(min-width: 1024px) 260px, 60vw"
              />
              <figcaption>
                <strong>{s.head}</strong>
                {s.body}
              </figcaption>
            </figure>
          ))
        }
        <figure class="device device-phone">
          <RimFigure
            {...fig('phone-home')}
            alt="Tailscode on iPhone: Home, one sentence that says who needs you and what is working, with the chats under it"
            sizes="(min-width: 1024px) 260px, 60vw"
          />
          <figcaption>
            <strong>Home is one board</strong>
            who needs you, what is working, then your chats.
          </figcaption>
        </figure>
      </div>
      <figure class="wide">
        <RimFigure
          {...fig('pad-wall')}
          alt="Tailscode on iPad: the wall, every agent and helper full screen with what each is changing, and the last hour's lane across the foot"
          sizes="(min-width: 1152px) 960px, 96vw"
        />
        <figcaption>
          <strong>The wall, on iPad</strong>
          every agent and helper full screen, the last hour’s lane across the foot.
        </figcaption>
      </figure>
    </section>

    <section id="masters" class="scene" style="--c:var(--violet)">
      <div class="split">
        <div>
          <p class="kicker">Masters <span class="beta">beta</span></p>
          <h2 class="display">Give a machine <span class="lit">a standing role.</span></h2>
          <span class="blade" aria-hidden="true"></span>
          <p class="lead">
            A master is a specialist that lives on your machine. It keeps a charter and a notebook,
            starts every task briefed with both, and hands back a debrief you approve before
            anything is remembered.
          </p>
          <ul class="cards">
            {
              mastersPoints.map((p) => (
                <li>
                  <h3>{p.head}</h3>
                  <p>{p.body}</p>
                </li>
              ))
            }
          </ul>
          <p class="fine">{mastersAvailability}</p>
        </div>
        <div class="pair">
          <figure class="device device-phone">
            <RimFigure
              {...fig('phone-master')}
              alt="Tailscode on iPhone: a master's page, its charter, its bench of devices and its guards with their last results"
              sizes="(min-width: 1024px) 240px, 44vw"
            />
            <figcaption>
              <strong>Its page</strong>
              the role, the bench it proves and its guards.
            </figcaption>
          </figure>
          <figure class="device device-phone">
            <RimFigure
              {...fig('phone-debrief')}
              alt="Tailscode on iPhone: a task's debrief, the notebook changes it proposes with Add, Retire and Skip on each"
              sizes="(min-width: 1024px) 240px, 44vw"
            />
            <figcaption>
              <strong>The debrief</strong>
              each notebook change is yours to accept or skip.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="models" class="scene" style="--c:var(--blue)">
      <p class="kicker">Models</p>
      <h2 class="display">Any model, even <span class="lit">your own GPU.</span></h2>
      <span class="blade" aria-hidden="true"></span>
      <p class="lead">
        Your agents run on your own computers, so the model is yours to choose: a cloud model, or
        one served from the graphics card in the machine across the room.
      </p>
      <ul class="points">
        {modelsBullets.map((b) => <li>{b}</li>)}
      </ul>
      <div class="rail rail-4">
        {
          phonesFor('models', 'carry', 'party', 'gpu').map((s) => (
            <figure class="device device-phone">
              <RimFigure
                {...s}
                alt={`Tailscode on iPhone: ${s.head}. ${s.body}`}
                sizes="(min-width: 1024px) 260px, 60vw"
              />
              <figcaption>
                <strong>{s.head}</strong>
                {s.body}
              </figcaption>
            </figure>
          ))
        }
      </div>

      <div class="sub">
        <div class="twin">
          <div id="any-agent">
            <h3 class="display small">Hermes, and any agent. Nothing new to install.</h3>
            <p class="lead">
              Hermes and every other agent that speaks the Agent Client Protocol run on the machine
              you already connected. The bridge finds them, proves each with a real session, and
              puts them in the model pill.
            </p>
            <ul class="points">
              {anyAgentBullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
          <div id="schedules">
            <h3 class="display small">Your machine asks. Every morning.</h3>
            <p class="lead">
              Schedules live on the machine, not the phone, so a question asked every weekday at
              7:30 is asked at 7:30 whether or not anything of yours is awake.
            </p>
            <ul class="points">
              {laterBullets.map((b) => <li>{b}</li>)}
