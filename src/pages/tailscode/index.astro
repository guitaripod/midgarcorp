---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppStoreBadge from '@components/landing/AppStoreBadge.astro';
import StarRating from '@components/landing/StarRating.astro';
import FeatureGrid from '@components/landing/FeatureGrid.astro';
import FaqAccordion from '@components/landing/FaqAccordion.astro';
import PricingTable from '@components/landing/PricingTable.astro';
import AppIcon from '@components/landing/AppIcon.astro';
import SectionHead from '@components/landing/SectionHead.astro';
import ShotFigure from '@components/landing/ShotFigure.astro';
import { landingApps, screenshotUrl, type LandingApp } from '@data/landing';

export const prerender = true;

const app = landingApps.find((a) => a.slug === 'tailscode') as LandingApp;
const c = app.content;
const accent = c.accentColor || app.primaryColor;
const githubUrl = app.githubUrl;
const releaseUrl = app.latestReleaseUrl ?? app.githubUrl;
const macStoreUrl = c.macAppStoreUrl ?? app.appStoreUrl;
const aurUrl = 'https://aur.archlinux.org/packages/tailscode';

const site = 'https://midgarcorp.cc';
const canonical = `${site}/tailscode/`;
const OG_REV = '9';
const ogImage = `/og/tailscode.png?v=${OG_REV}`;

const subtitle = app.name.includes(':')
  ? app.name.split(':').slice(1).join(':').trim()
  : (app.category ?? '');

const abs = (p?: string | null) => (p ? (p.startsWith('http') ? p : site + p) : undefined);

const shotBase = '/screenshots/tailscode';
const shot = (name: string) => `${shotBase}/${name}.webp`;

/// A screen in both of its faces; a pair whose faces are the same file renders one image.
const faces = (dark: string, light: string, w: number, h: number) => ({
  dark: shot(dark),
  light: shot(light),
  w,
  h,
});

/// An iPhone screen of the demo world. One face: the phone shots are the app's own System theme.
const phone = (role: string) => ({
  ...faces(`phone-${role}`, `phone-${role}`, 1320, 2868),
});

/// The Studio figures, one entry per shot; a pair whose faces are the same file renders one image.
const STUDIO = {
  mac: faces('mac-dark-studio', 'mac-light-studio', 1920, 1200),
  phoneFinished: faces('suomi-dark-14', 'suomi-light-14', 1320, 2868),
};

/// The one line that names a release: FLUX 3 Klein and the live preview ship in 1.78, so it says where
/// they are today. Delete it once App Review has cleared the Apple builds.
const studioAvailability =
  'FLUX 3 Klein, editing from several pictures and the live preview arrive with 1.78: on Linux today, on the iPhone and the Mac when App Review clears it.';

const hero = {
  desk: faces('desk-dark-chat', 'desk-light-chat', 1920, 1080),
  phone: phone('lock'),
};
const syncBoth = faces('sync-03-both', 'sync-03-both', 1920, 1080);

const splitCaption = (text: string) => {
  const at = text.indexOf(' — ');
  return at < 0 ? { head: text, body: '' } : { head: text.slice(0, at), body: text.slice(at + 3) };
};

/// The phone rail, in the store set's order. The costs and limits screens live in the money section.
const phoneRoles = ['approval', 'board', 'diff', 'question', 'effort', 'delegate'];
const phoneCaptions = c.screenshotCaptions?.iphone ?? [];
const phoneShots = phoneRoles.map((role, i) => ({
  ...phone(role),
  ...splitCaption(phoneCaptions[i] ?? ''),
}));

const ipadCaptions = c.screenshotCaptions?.ipad ?? [];
const ipadShots = (app.screenshots.ipad ?? []).map((s, i) => ({
  src: s.src,
  w: s.w,
  h: s.h,
  caption: ipadCaptions[i] ?? s.label,
}));

const deskCaptions = c.screenshotCaptions?.desktop ?? [];
const deskShots = [
  {
    ...faces('desk-dark-split', 'desk-light-split', 1920, 1080),
    client: 'Linux',
    caption: deskCaptions[0] ?? '',
    wide: true,
  },
  {
    ...faces('mac-dark-chat', 'mac-dark-chat', 1920, 825),
    client: 'Mac',
    caption: deskCaptions[1] ?? '',
    wide: false,
  },
  {
    ...faces('mac-dark-split', 'mac-dark-split', 1920, 825),
    client: 'Mac',
    caption: deskCaptions[2] ?? '',
    wide: false,
  },
];

const studioBullets = [
  'The machine’s own sketch fills the stage while it paints, when it sends one, and a progress line runs along the stage’s foot.',
  'The shelf is the machine’s own output folder, newest first, with the words, seed and steps read back from the files.',
  'Enhance has a language model of yours write the paragraph; an edit can work from several pictures at once; Continue it picks up where a finished clip ends.',
];

const lockBullets = [
  'One Live Activity per conversation: what the agent is doing, for how long, and how many tools it has run.',
  'An approval request alerts you. A finished turn lingers with its outcome, then leaves on its own.',
  'Tap it and you land in the exact chat, with the Allow, Always and Deny buttons under the edit.',
  'When the app is closed, iOS holds the wait and the notification still fires, straight over your tailnet.',
];

const moneyBullets = [
  'Every conversation priced, every month totalled across your machines, by model, project and tool.',
  'Each provider’s tightest window and its reset clock, on Home and in a widget: walls first.',
  'Always marked an estimate: a subscription bills a flat fee, so the figure is API-equivalent value, never a bill.',
];

const checks = [
  {
    cmd: 'tailscale status',
    note: 'lists the nodes involved: your phone and your machine, both yours.',
  },
  {
    cmd: 'tailscale ping <machine>',
    note: 'says whether the path is direct or goes through one of Tailscale’s own DERP relays.',
  },
  {
    cmd: 'git clone ' + (githubUrl ?? '').replace('https://', ''),
    note: 'the app, the engine and both bridges are GPL-3.0. Read what it sends.',
  },
];

const section = 'border-t border-paper-border py-8 dark:border-term-border sm:py-9';

/// A row of figures that scrolls sideways on a phone and lays out as a grid from `sm` up.
const rail =
  'no-scrollbar -mx-4 flex snap-x snap-mandatory items-start gap-4 overflow-x-auto px-4 pb-3 sm:mx-0 sm:grid sm:overflow-visible sm:px-0 sm:pb-0';
const railItem = 'shrink-0 snap-center';
const btn =
  'accent-btn inline-flex items-center gap-2 rounded-sm border px-4 py-2.5 text-sm font-semibold transition-colors';

const operatingSystem = 'iOS, iPadOS, Linux, macOS';
const priceNumeric = app.price === 'Free' ? '0' : app.price.replace('$', '');

const allShots = Object.values(app.screenshots)
  .flat()
  .map((s) => abs(screenshotUrl(s.src)));

const downloadOffer = {
  '@type': 'Offer',
  name: `${app.shortName} download`,
  price: priceNumeric,
  priceCurrency: 'USD',
  url: app.appStoreUrl,
  availability: 'https://schema.org/InStock',
};
const premiumOffers = (c.pricing?.tiers ?? [])
  .filter((tier) => typeof tier.amount === 'number')
  .map((tier) => ({
    '@type': 'Offer',
    name: `${c.pricing!.premium.title} — ${tier.name}`,
    price: String(tier.amount),
    priceCurrency: 'USD',
    url: app.appStoreUrl,
    availability: 'https://schema.org/InStock',
    category: 'InAppPurchase',
    ...(tier.period
      ? { eligibleDuration: { '@type': 'QuantitativeValue', value: tier.period } }
      : {}),
  }));

const softwareApp = {
  '@type': 'SoftwareApplication',
  name: app.name,
  alternateName: 'Tailscode',
  operatingSystem,
  applicationCategory: 'DeveloperApplication',
  description: c.metaDescription,
  url: canonical,
  installUrl: app.appStoreUrl,
  downloadUrl: app.appStoreUrl,
  image: abs(app.iconLocal),
  screenshot: allShots,
  offers: premiumOffers.length ? [downloadOffer, ...premiumOffers] : downloadOffer,
  author: { '@type': 'Organization', name: 'Midgar Oy', url: site },
  publisher: { '@type': 'Organization', name: 'Midgar Oy', url: site },
  ...(app.releaseDate ? { datePublished: app.releaseDate } : {}),
  ...(app.ratingCount > 0
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: app.rating,
          ratingCount: app.ratingCount,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
  isAccessibleForFree: true,
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  codeRepository: githubUrl,
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'Apps', item: `${site}/apps` },
    { '@type': 'ListItem', position: 3, name: app.shortName, item: canonical },
  ],
};
const faqPage = {
  '@type': 'FAQPage',
  mainEntity: c.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [softwareApp, breadcrumb, faqPage],
};

const siblings = landingApps
  .filter((a) => a.slug !== 'tailscode')
  .sort((a, b) => new Date(b.releaseDate ?? 0).getTime() - new Date(a.releaseDate ?? 0).getTime())
  .slice(0, 6);

const clients = [
  {
    name: 'iPhone & iPad',
    stack: 'UIKit · universal · Live Activities',
    note: 'The pocket remote: send, steer, approve, and watch the turn finish on your Lock Screen. On iPad it becomes a workspace — sidebar, chat list and conversation side by side, windows in Stage Manager, a hardware keyboard.',
  },
  {
    name: 'Mac',
    stack: 'AppKit · Liquid Glass · macOS 26',
    note: 'The same desk with Apple materials: split panes, the analytics, the git surface, and a global quick-ask key. On the Mac App Store under the same purchase as the iPhone app.',
  },
  {
    name: 'Linux',
    stack: 'GTK4 · libadwaita · tiling splits',
    note: 'A full desk: split panes, an embedded terminal, web and video panes, a global quick-ask key. In the AUR and on GitHub.',
  },
];
---

<BaseLayout title={c.seoTitle} description={c.metaDescription} image={ogImage}>
  <div style={`--accent:${accent}`}>
    <nav
      aria-label="Breadcrumb"
      class="hidden pt-8 text-xs text-paper-faint dark:text-term-faint sm:block"
    >
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/apps" class="hover:text-paper-green dark:hover:text-term-green">apps</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">tailscode</li>
      </ol>
    </nav>

    <header
      class="flex flex-col gap-8 py-6 sm:py-6 lg:grid lg:grid-cols-[0.92fr_1.08fr] lg:items-center lg:gap-x-12"
    >
      <div>
        <div class="mb-5 flex items-center gap-4">
          {
            app.iconLocal && (
              <AppIcon
                src={app.iconLocal}
                width={72}
                height={72}
                displayWidths={[64, 72]}
                priority
                class="hero-icon h-14 w-14 rounded-[1.1rem] border border-paper-border object-cover dark:border-term-border sm:h-[72px] sm:w-[72px]"
              />
            )
          }
          <div class="min-w-0">
            <p
              class="text-xl font-bold tracking-tight text-paper-text dark:text-term-text sm:text-3xl"
            >
              {app.shortName}
            </p>
            {subtitle && <p class="text-sm text-paper-muted dark:text-term-muted">{subtitle}</p>}
          </div>
        </div>

        <h1
          class="mb-4 text-[1.85rem] font-bold leading-tight tracking-tight text-paper-text dark:text-term-text sm:text-4xl"
        >
          {c.heroHeadline}
        </h1>
        <p
          class="mb-6 max-w-xl text-base leading-relaxed text-paper-muted dark:text-term-muted sm:text-lg"
        >
          {c.heroSubhead}
        </p>

        <ul class="mb-6 flex flex-wrap gap-2" aria-label="What Tailscode does not have">
          {
            ['No relay', 'No account', 'No analytics', 'GPL-3.0'].map((fact) => (
              <li>
                <a
                  href="#trust"
                  class="inline-flex items-center gap-1 rounded-sm border border-paper-green/40 px-2 py-1 text-[11px] font-semibold sm:gap-1.5 sm:px-2.5 sm:text-xs text-paper-green transition-colors hover:bg-paper-green/10 dark:border-term-green/40 dark:text-term-green dark:hover:bg-term-green/10"
                >
                  <span aria-hidden="true">✓</span>
                  {fact}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mb-3 flex flex-wrap items-center gap-3">
          <AppStoreBadge href={app.appStoreUrl} platform="ios" />
          <a href={aurUrl} target="_blank" rel="noopener noreferrer" class={btn}>Linux: AUR ↗</a>
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class={btn}>
            <img src="/icons/github.svg" alt="" width="18" height="18" class="dark:invert" />
            GitHub
          </a>
        </div>
        <p class="mb-6 text-xs text-paper-faint dark:text-term-faint">
          iPhone, iPad and Mac share one purchase on the App Store ·
          <a
            href={macStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-dotted underline-offset-2 hover:text-paper-green dark:hover:text-term-green"
            >Mac App Store ↗</a
          >
          · Free, Pro is $14.99 once
        </p>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          {
            app.ratingCount >= 5 && (
              <StarRating
                rating={app.rating}
                count={app.ratingCount}
                releaseDate={app.releaseDate}
              />
            )
          }
          <span class="hidden flex-wrap gap-1.5 sm:flex">
            {
              ['iPhone', 'iPad', 'Mac', 'Linux'].map((p) => (
                <span class="rounded-sm border border-paper-border px-1.5 py-0.5 text-xs text-paper-faint dark:border-term-border dark:text-term-faint">
                  {p}
                </span>
              ))
            }
          </span>
        </div>
      </div>

      <div class="relative mx-auto aspect-[100/71] w-full max-w-[600px] lg:max-w-none">
        <ShotFigure
          dark={hero.desk.dark}
          light={hero.desk.light}
          w={hero.desk.w}
          h={hero.desk.h}
          alt="Tailscode for Linux: a conversation in the compact chat, with the sidebar of every machine's chats"
          sizes="(min-width: 1024px) 600px, 92vw"
          variant="hero"
          priority
          class="absolute right-0 top-[12%] w-[86%]"
        />
        <ShotFigure
          dark={hero.phone.dark}
          w={hero.phone.w}
          h={hero.phone.h}
          alt="The iPhone Lock Screen with a Tailscode Live Activity: Dark mode for the settings screen, awaiting your approval"
          sizes="(min-width: 1024px) 200px, 30vw"
          variant="phone"
          priority
          class="absolute bottom-0 left-0 w-[32%] shadow-2xl"
        />
      </div>
    </header>

    <section id="lockscreen" class={section}>
      <div class="grid items-start gap-x-10 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-5 lg:pt-10">
          <SectionHead prompt="tailscode --lock-screen" title="Send. Pocket it. Get pinged.">
            Your agent is working on a machine across the room, or across the country. The turn
            lives on your Lock Screen the whole time, and the moment it needs you it says so.
          </SectionHead>
          <ul class="grid gap-2.5">
            {
              lockBullets.map((b) => (
                <li class="flex items-start gap-2 text-sm text-paper-text dark:text-term-text">
                  <span class="accent-text mt-0.5 shrink-0" aria-hidden="true">
                    ▸
                  </span>
                  <span>{b}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex items-start justify-center gap-4 sm:gap-6 lg:col-span-7">
          <figure class="w-[46%] max-w-[300px] shrink-0">
            <div
              class="overflow-hidden rounded-[1.4rem] border border-paper-border bg-black dark:border-term-border"
            >
              <video
                id="promo-video"
                class="block w-full"
                width="608"
                height="1080"
                poster={`${shot('promo-poster')}?v=9`}
                muted
                loop
                playsinline
                controls
                preload="none"
                aria-label="Thirty seconds of Tailscode: a Live Activity on the Lock Screen, an approval, a question, the board across two machines, a diff, the month in numbers and the tailnet"
              >
                <source src="/video/tailscode-promo.mp4?v=1" type="video/mp4" />
                <source src="/video/tailscode-promo.webm?v=1" type="video/webm" />
              </video>
            </div>
            <figcaption
              class="mt-2.5 px-1 text-xs leading-relaxed text-paper-muted dark:text-term-muted"
            >
              <span class="accent-text mr-1 font-semibold">29 s</span> — no narration: ping, approve,
              answer, board, diff, cost, tailnet.
            </figcaption>
          </figure>
          <ShotFigure
            dark={phoneShots[0].dark}
            w={phoneShots[0].w}
            h={phoneShots[0].h}
            alt="Tailscode on iPhone: the chat the notification opens, with Allow once, Always and Deny under the edit"
            sizes="(min-width: 1024px) 280px, 46vw"
            variant="phone"
            class="mt-10 w-[46%] max-w-[300px] shrink-0 sm:mt-16"
          >
            <span class="accent-text mr-1 font-semibold">Tap</span> — and the agent waits on you, right
            under the edit.
          </ShotFigure>
        </div>
      </div>
    </section>

    <section id="trust" class={section}>
      <div class="grid items-center gap-x-10 gap-y-8 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SectionHead prompt="tailscode --trust" title="Nothing leaves your tailnet">
            Your phone talks to your machine, and nothing else is in the picture. Three facts you
            can check, and a licence that lets you.
          </SectionHead>
          <ul
            class="mb-6 grid grid-cols-3 gap-px overflow-hidden rounded-sm border border-paper-border bg-paper-border text-center dark:border-term-border dark:bg-term-border"
          >
            {
              [
                ['No relay', 'no Tailscode server sits between you and the machine'],
                ['No account', 'nothing to sign up for, nothing to leak'],
                ['No analytics', 'zero collected data types in the privacy manifest'],
              ].map(([head, body]) => (
                <li class="bg-paper-panel px-3 py-4 dark:bg-term-panel">
                  <p class="accent-text text-sm font-bold">{head}</p>
                  <p class="mt-1.5 text-xs leading-relaxed text-paper-muted dark:text-term-muted">
                    {body}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="term-frame p-4 sm:p-6 lg:col-span-7">
          <svg
            viewBox="0 0 760 270"
            role="img"
            aria-labelledby="tailnet-title tailnet-desc"
            class="hidden h-auto w-full text-paper-muted dark:text-term-muted sm:block"
            xmlns="http://www.w3.org/2000/svg"
          >
            <title id="tailnet-title">Two devices of yours joined by your tailnet</title>
            <desc id="tailnet-desc">
              Tailscode on your iPhone, iPad, Mac or Linux desk connects directly to the machine
              running your agent through your own Tailscale network. A dashed box labelled Tailscode
              cloud is struck out: there is no such server.
            </desc>
            <g
              class="fill-paper-panel stroke-paper-border2 dark:fill-term-panel dark:stroke-term-border2"
              stroke-width="1.5"
            >
              <rect x="16" y="96" width="210" height="104" rx="3"></rect>
              <rect x="534" y="96" width="210" height="104" rx="3"></rect>
            </g>
            <g
              class="fill-paper-text font-bold dark:fill-term-text"
              font-size="15"
              text-anchor="middle"
            >
              <text x="121" y="136">Tailscode</text>
              <text x="639" y="136">Your machine</text>
            </g>
            <g fill="currentColor" font-size="11.5" text-anchor="middle">
              <text x="121" y="160">iPhone · iPad · Mac · Linux</text>
              <text x="121" y="180">the app, GPL-3.0</text>
              <text x="639" y="160">claude-bridge · omp-bridge</text>
              <text x="639" y="180">opencode · your agent</text>
            </g>
            <line
              x1="226"
              y1="148"
              x2="534"
              y2="148"
              stroke-width="3"
              stroke-linecap="round"
              class="stroke-paper-green dark:stroke-term-green"></line>
            <circle cx="226" cy="148" r="5" class="fill-paper-green dark:fill-term-green"></circle>
            <circle cx="534" cy="148" r="5" class="fill-paper-green dark:fill-term-green"></circle>
            <g
              class="fill-paper-green font-bold dark:fill-term-green"
              font-size="13"
              text-anchor="middle"
            >
              <text x="380" y="132">your tailnet</text>
            </g>
            <g fill="currentColor" font-size="11" text-anchor="middle">
              <text x="380" y="172">WireGuard-encrypted</text>
              <text x="380" y="188">device-authenticated</text>
            </g>
            <g
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-dasharray="5 5"
              opacity="0.75"
            >
              <rect x="290" y="14" width="180" height="52" rx="3"></rect>
            </g>
            <text
              x="380"
              y="45"
              fill="currentColor"
              font-size="12"
              text-anchor="middle"
              opacity="0.8"
            >
              Tailscode cloud
            </text>
            <line
              x1="290"
              y1="66"
              x2="470"
              y2="14"
              stroke-width="2.5"
              stroke-linecap="round"
              class="stroke-paper-red dark:stroke-term-red"></line>
            <text x="380" y="86" fill="currentColor" font-size="11" text-anchor="middle">
              there isn't one
            </text>
            <g fill="currentColor" font-size="11.5" text-anchor="middle">
              <text x="380" y="238">The path is phone to machine. Tailscode adds no hop.</text>
            </g>
          </svg>

          <svg
            viewBox="0 0 320 440"
            role="img"
            aria-label="Two devices of yours joined by your tailnet; a struck-out Tailscode cloud box: there is no such server"
            class="mx-auto block h-auto w-full max-w-[340px] text-paper-muted dark:text-term-muted sm:hidden"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g
              class="fill-paper-panel stroke-paper-border2 dark:fill-term-panel dark:stroke-term-border2"
              stroke-width="1.5"
            >
              <rect x="40" y="12" width="240" height="96" rx="3"></rect>
              <rect x="40" y="272" width="240" height="96" rx="3"></rect>
            </g>
            <g
              class="fill-paper-text font-bold dark:fill-term-text"
              font-size="16"
              text-anchor="middle"
            >
              <text x="160" y="48">Tailscode</text>
              <text x="160" y="308">Your machine</text>
            </g>
            <g fill="currentColor" font-size="12.5" text-anchor="middle">
              <text x="160" y="72">iPhone · iPad · Mac · Linux</text>
              <text x="160" y="92">the app, GPL-3.0</text>
              <text x="160" y="332">claude-bridge · omp-bridge</text>
              <text x="160" y="352">opencode · your agent</text>
            </g>
            <line
              x1="160"
              y1="108"
              x2="160"
              y2="272"
              stroke-width="3"
              stroke-linecap="round"
              class="stroke-paper-green dark:stroke-term-green"></line>
            <circle cx="160" cy="108" r="5" class="fill-paper-green dark:fill-term-green"></circle>
