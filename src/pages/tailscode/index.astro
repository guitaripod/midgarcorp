    border: 1px solid var(--rule);
    border-radius: 0.7rem;
  }

  .ts img[data-full] {
    cursor: zoom-in;
  }

  .ts .duo-wide {
    display: grid;
    gap: 0 2rem;
  }

  @media (min-width: 900px) {
    .ts .duo-wide {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: end;
    }
  }

  .ts .terminal {
    background: linear-gradient(180deg, var(--raised), var(--canvas));
  }

  html.dark .ts .terminal {
    background:
      radial-gradient(50% 45% at 50% 0%, rgb(95 224 138 / 0.08), transparent 70%),
      linear-gradient(180deg, #03050a 0%, #070b12 100%);
  }

  .ts .lineup {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
