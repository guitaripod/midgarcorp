<script>
  interface Round {
    answer: string;
    name: string;
    capital: string;
    cue: string;
    note: string;
    options: string[];
  }

  const NAMES: Record<string, string> = {
    MDA: 'Moldova',
    ROU: 'Romania',
    AND: 'Andorra',
    TCD: 'Chad',
    BEL: 'Belgium',
    IDN: 'Indonesia',
    MCO: 'Monaco',
    POL: 'Poland',
    IRL: 'Ireland',
    CIV: 'Ivory Coast',
    ITA: 'Italy',
    NOR: 'Norway',
    ISL: 'Iceland',
    DNK: 'Denmark',
    SGP: 'Singapore',
    MEX: 'Mexico',
    FIN: 'Finland',
  };

  /// How long a right answer stays on screen before the next flag comes.
  const AUTO_ADVANCE_MS = 1800;

  /// Plays the page's quiz the way the app's pick-the-flag questions go: four tiles, one answer,
  /// the right flag and what to look for after a pick, then the next flag.
  function startQuiz(root: HTMLElement) {
    const data = root.querySelector<HTMLScriptElement>('[data-quiz-rounds]');
    const rounds: Round[] = data ? JSON.parse(data.textContent || '[]') : [];
    const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('.quiz-tile'));
    const prefixEl = root.querySelector<HTMLElement>('[data-quiz-prefix]');
    const nameEl = root.querySelector<HTMLElement>('[data-quiz-name]');
    const suffixEl = root.querySelector<HTMLElement>('[data-quiz-suffix]');
    const countEl = root.querySelector<HTMLElement>('[data-quiz-count]');
    const resultEl = root.querySelector<HTMLElement>('[data-quiz-result]');
    const next = root.querySelector<HTMLButtonElement>('[data-quiz-next]');
    root.querySelector('[data-quiz-static]')?.remove();
    if (!rounds.length || !prefixEl || !nameEl || !suffixEl || !countEl || !resultEl || !next) {
      return;
    }

    let index = 0;
    let score = 0;
    let finished = false;
    let timer: number | undefined;

    const show = () => {
      window.clearTimeout(timer);
      const round = rounds[index];
      finished = false;
      prefixEl.textContent = 'Pick the flag of ';
      nameEl.textContent = round.name;
      suffixEl.textContent = '';
      countEl.textContent = `Flag ${index + 1} of ${rounds.length}`;
      resultEl.replaceChildren();
      const hadFocus =
        root.contains(document.activeElement) && document.activeElement !== document.body;
      next.hidden = true;
      tiles.forEach((tile, i) => {
        const code = round.options[i];
        tile.dataset.code = code;
        tile.disabled = false;
        tile.classList.remove('is-right', 'is-wrong', 'is-dim');
        const img = tile.querySelector('img');
        if (img) img.src = `/screenshots/masterofflags/flags/${code.toLowerCase()}.webp`;
        const label = tile.querySelector('.quiz-label');
        if (label) label.textContent = '';
      });
      if (hadFocus) tiles[0]?.focus({ preventScroll: true });
    };

    const advance = () => {
      window.clearTimeout(timer);
      if (index === rounds.length - 1) {
        finish();
        return;
      }
      index += 1;
      show();
    };

    const answer = (picked: HTMLButtonElement) => {
      const round = rounds[index];
      const right = picked.dataset.code === round.answer;
      if (right) score += 1;
      tiles.forEach((tile) => {
        tile.disabled = true;
        const code = tile.dataset.code || '';
        const label = tile.querySelector('.quiz-label');
        if (label) label.textContent = NAMES[code] ?? '';
        if (code === round.answer) tile.classList.add('is-right');
        else if (tile === picked) tile.classList.add('is-wrong');
        else tile.classList.add('is-dim');
      });
      const verdict = document.createElement('p');
      verdict.className = right ? 'verdict verdict-right' : 'verdict verdict-wrong';
      verdict.textContent = right
        ? 'Right.'
        : `Not quite. That one is ${NAMES[picked.dataset.code || ''] ?? 'another flag'}.`;
      const learn = document.createElement('p');
      learn.className = 'learn';
      const strong = document.createElement('strong');
      strong.textContent = round.name;
      learn.append(strong, ` · Capital ${round.capital}. ${round.cue} ${round.note}`);
      resultEl.replaceChildren(verdict, learn);
      next.textContent = index === rounds.length - 1 ? 'See your score' : 'Next flag';
      next.hidden = false;
      next.focus({ preventScroll: true });
      if (right) timer = window.setTimeout(advance, AUTO_ADVANCE_MS);
    };

    const finish = () => {
      finished = true;
      countEl.textContent = 'Round over';
      prefixEl.textContent = 'You named ';
      nameEl.textContent = `${score} of ${rounds.length}`;
      suffixEl.textContent = ' look-alikes.';
      tiles.forEach((tile) => {
        tile.disabled = true;
        tile.classList.add('is-dim');
      });
      const done = document.createElement('p');
      done.className = 'learn';
      done.textContent =
        'The app has all 250 countries on a globe you paint as you learn, capitals in every region, a Daily Challenge and Similar Flags drills for exactly these.';
      resultEl.replaceChildren(done);
      next.textContent = 'Play again';
      next.hidden = false;
      next.focus({ preventScroll: true });
    };

    tiles.forEach((tile) => tile.addEventListener('click', () => answer(tile)));
    next.addEventListener('click', () => {
      if (finished) {
        index = 0;
        score = 0;
        show();
        return;
      }
      advance();
    });
    show();
  }

  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach(startQuiz);

  /// Plays the App Store preview while it is on screen and pauses it when it is not; a reader who
  /// prefers less motion gets the poster and the player's own controls instead.
  function startPreview(video: HTMLVideoElement) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.controls = true;
      return;
    }
    const watcher = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => (video.controls = true));
        else video.pause();
      },
      { threshold: 0.35 }
    );
    watcher.observe(video);
  }

  document.querySelectorAll<HTMLVideoElement>('[data-preview]').forEach(startPreview);
</script>

