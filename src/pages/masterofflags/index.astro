---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppStoreBadge from '@components/landing/AppStoreBadge.astro';
import FaqAccordion from '@components/landing/FaqAccordion.astro';
import AppIcon from '@components/landing/AppIcon.astro';
import HeroRating from '@components/landing/HeroRating.astro';
import { landingApps, screenshotUrl, type LandingApp } from '@data/landing';
import screenshotVariants from '@data/screenshot-variants.json';
import { siblingApps } from '@utils/sibling-apps';
import { appPageJsonLd } from '@utils/structured-data';
import { markdownPath } from '@utils/llms';
import { privacyUrlFor, supportPath } from '../../utils/app-links';

export const prerender = true;

const app = landingApps.find((a) => a.slug === 'masterofflags') as LandingApp;
const c = app.content;
const accent = c.accentColor || app.primaryColor;

const OG_REV = '14';
const ogImage = `/og/masterofflags.png?v=${OG_REV}`;

const variants = screenshotVariants as Record<string, number[]>;

/// A figure of the page from Master of Flags 5.0's App Store set: the framed device lifted off its
/// store slide along the bezel the frames CLI drew, or an Apple TV capture as it was shot.
const figure = (name: string, w: number, h: number) => {
  const src = `/screenshots/masterofflags/web-${name}.webp`;
  const srcset = [
    ...(variants[src] ?? []).map(
      (wide) => `${screenshotUrl(src.replace(/\.webp$/, `@${wide}.webp`))} ${wide}w`
    ),
    `${screenshotUrl(src)} ${w}w`,
  ].join(', ');
  return { src: screenshotUrl(src), srcset, w, h };
};
const phone = (name: string) => figure(`phone-${name}`, 735, 1520);
const pad = (name: string) => figure(`ipad-${name}`, 1150, 1500);
const tv = (name: string) => figure(`tv-${name}`, 1920, 1080);

const heroArt = figure('hero-globe', 2880, 1620);
const preview = {
  src: screenshotUrl('/screenshots/masterofflags/web-preview.mp4'),
  poster: figure('preview-poster', 735, 1500),
};
const shots = {
  locate: phone('locate'),
  card: phone('card'),
  cards: phone('cards'),
  expeditions: phone('expeditions'),
  you: phone('you'),
  daily: phone('daily'),
  looks: phone('looks'),
  tvQuestion: tv('atlas-question'),
  tvCouch: tv('couch-play'),
  pad: pad('atlas'),
};

const flag = (code: string) => `/screenshots/masterofflags/flags/${code.toLowerCase()}.webp`;

/// The rounds of the quiz on this page, look-alike flags from the app's own data: the capital,
/// the flag cue and the look-alike note are the words Master of Flags shows after an answer.
const rounds = [
  {
    answer: 'MDA',
    name: 'Moldova',
    capital: 'Chișinău',
    cue: 'Three equal vertical bands of Prussian blue, chrome yellow and vermilion red.',
    note: 'Romania has the same blue, yellow and red bands, and no coat of arms.',
    options: ['ROU', 'MDA', 'AND', 'TCD'],
  },
  {
    answer: 'TCD',
    name: 'Chad',
    capital: 'N’Djamena',
    cue: 'Three equal vertical bands of blue, gold and red.',
    note: 'Romania has the same bands; its blue is slightly lighter.',
    options: ['AND', 'TCD', 'BEL', 'ROU'],
  },
  {
    answer: 'IDN',
    name: 'Indonesia',
    capital: 'Jakarta',
    cue: 'Two equal horizontal bands of red over white.',
    note: 'Monaco is the same red over white in a squarer shape; Poland is white over red.',
    options: ['POL', 'MCO', 'SGP', 'IDN'],
  },
  {
    answer: 'IRL',
    name: 'Ireland',
    capital: 'Dublin',
    cue: 'Three equal vertical bands of green, white and orange.',
    note: 'Ivory Coast reverses the colours: orange, white, green. Italy ends in red, not orange.',
    options: ['CIV', 'IRL', 'ITA', 'MEX'],
  },
  {
    answer: 'NOR',
    name: 'Norway',
    capital: 'Oslo',
    cue: 'Red with a blue cross outlined in white that reaches the edges.',
    note: 'Iceland reverses the colours: a blue field with a red cross edged in white.',
    options: ['ISL', 'FIN', 'NOR', 'DNK'],
  },
];
const first = rounds[0];

/// The four stamps every country's card can earn, and the tier a card reaches with each count.
const stamps = [
  { name: 'Flag', body: 'name the flag' },
  { name: 'Name', body: 'pick the flag for a name' },
  { name: 'Capital', body: 'match the capital' },
  { name: 'Place', body: 'find it on the globe' },
];
const tiers = ['Bronze', 'Silver', 'Gold', 'Holographic'];

/// Explorer ranks, set by lifetime points, from the first to the last.
const ranks = [
  'Cadet',
  'Scout',
  'Navigator',
  'Pathfinder',
  'Cartographer',
  'Voyager',
  'Ambassador',
  'Grand Master of Flags',
];

/// Look-alike pairs Similar Flags drills, with the note the app shows for each.
const pairs = [
  {
    a: { code: 'TCD', name: 'Chad' },
    b: { code: 'ROU', name: 'Romania' },
    note: 'Romania’s blue is slightly lighter.',
  },
  {
    a: { code: 'IDN', name: 'Indonesia' },
    b: { code: 'MCO', name: 'Monaco' },
    note: 'Monaco’s flag is a squarer shape.',
  },
  {
    a: { code: 'IRL', name: 'Ireland' },
    b: { code: 'CIV', name: 'Ivory Coast' },
    note: 'The same three bands, colours reversed.',
  },
  {
    a: { code: 'AUS', name: 'Australia' },
    b: { code: 'NZL', name: 'New Zealand' },
    note: 'New Zealand’s four stars are red.',
  },
];

const versionLabel = app.version ? `Version ${app.version}` : null;
const requires = 'iOS 18, macOS 26, tvOS 18 or watchOS 11';
const privacyUrl = privacyUrlFor(app.slug);

const showsRating = app.ratingCount >= 5;
const jsonLd = appPageJsonLd(app, { ratingShown: showsRating });
const siblings = siblingApps(landingApps, 'masterofflags');
---

<BaseLayout
  title={c.seoTitle}
  description={c.metaDescription}
  image={ogImage}
  markdown={markdownPath(app.slug)}
  appStoreId={app.trackId > 0 ? app.trackId : undefined}
>
  <div class="mof" style={`--accent:${accent}`}>
    <nav
      aria-label="Breadcrumb"
      class="hidden pt-8 text-xs text-paper-faint dark:text-term-faint sm:block"
    >
      <ol class="flex flex-wrap items-center gap-1.5 font-mono">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/apps/" class="hover:text-paper-green dark:hover:text-term-green">apps</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">masterofflags</li>
      </ol>
    </nav>

    <section class="hero bleed" aria-labelledby="app-name">
      <img
        class="hero-art"
        src={heroArt.src}
        srcset={heroArt.srcset}
        sizes="100vw"
        width={heroArt.w}
        height={heroArt.h}
        alt=""
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="hero-app">
          {
            app.iconLocal && (
              <AppIcon
                src={app.iconLocal}
                width={56}
                height={56}
                displayWidths={[48, 56]}
                priority
                class="hero-icon h-12 w-12 rounded-[0.9rem] object-cover sm:h-14 sm:w-14"
              />
            )
          }
          <h1 id="app-name">Master of Flags</h1>
          <span>World Quiz</span>
        </div>
        <p class="kicker">New in 5.0 · The Atlas</p>
        <p class="display hero-title">Paint the world with every flag you <em>learn.</em></p>
        <p class="hero-sub">
          A flag and capitals quiz played on a 3D globe that becomes yours: every country you get
          right is painted with its flag. No ads, no subscription, no account. Free on iPhone, iPad,
          Mac, Apple TV and Apple Watch.
        </p>
        <div class="hero-actions">
          <AppStoreBadge href={app.appStoreUrl} platform="ios" />
          <a href="#play" class="ghost-btn">Play a round here</a>
        </div>
        <div class="hero-proof">
          {showsRating && <HeroRating rating={app.rating} count={app.ratingCount} />}
          <span class="promise">No ads. No subscription. Ever.</span>
        </div>
      </div>
    </section>

    <section class="scene flies bleed" aria-labelledby="flies-title">
      <div class="scene-inner flies-grid">
        <div class="flies-text">
          <h2 id="flies-title" class="display scene-title">
            Get it right and the flag flies home.
          </h2>
          <p class="scene-lede">
            Every question is played on your own globe. Name the flag, pick the flag for a name or
            match the capital, and when you get it right the flag flies to its country and paints
            it. Turn the globe, zoom in, and watch your world fill with colour.
          </p>
          <p class="scene-lede">
            Nothing is lost: the first time you open 5.0, everything you already knew is painted
            onto your globe, and your points become your Explorer rank.
          </p>
          <div class="locate">
            <img
              src={shots.locate.src}
              srcset={shots.locate.srcset}
              sizes="(min-width: 1024px) clamp(180px, 10vw, 320px), 40vw"
              width={shots.locate.w}
              height={shots.locate.h}
              alt="Find Haiti on iPhone: Haiti's flag waves over the globe, waiting for a tap on the country"
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3>Find it on the globe</h3>
              <p>
                A new kind of question: spin the globe and tap a country you have already
                discovered, so you learn where each flag lives.
              </p>
            </div>
          </div>
        </div>
        <figure class="preview">
          <video
            class="preview-video"
            data-preview
            src={preview.src}
            poster={preview.poster.src}
            width="588"
            height="1200"
            muted
            loop
            playsinline
            preload="none"
            aria-label="Master of Flags 5.0 on iPhone: the globe turns to each country, its flag flies there and paints it"
          >
          </video>
          <figcaption>Master of Flags 5.0 on iPhone, from its App Store preview.</figcaption>
        </figure>
      </div>
    </section>

    <section id="play" class="atlas play bleed" aria-labelledby="play-title">
      <div class="atlas-inner play-grid">
        <div class="play-text">
          <p class="kicker">Play a round</p>
          <h2 id="play-title" class="display atlas-title">Wrong answers teach.</h2>
          <p>
            Flags and capitals across Europe, Asia, Africa, the Americas, Oceania and the whole
            world. Miss one and you see the right flag, its capital and what to look for. Here are
            five look-alikes to try, with the app’s own notes.
          </p>
          <p class="aside">All 250 countries, every question and every region are free.</p>
        </div>

        <div class="quiz" data-quiz>
          <script type="application/json" data-quiz-rounds set:html={JSON.stringify(rounds)} />
          <p class="quiz-count" data-quiz-count>Flag 1 of {rounds.length}</p>
          <p class="quiz-ask">
            <span data-quiz-prefix>Pick the flag of </span><strong data-quiz-name
              >{first.name}</strong
            ><span data-quiz-suffix></span>
          </p>
          <div class="quiz-options" role="group" aria-label="Four flags to choose from">
            {
              first.options.map((code, index) => (
                <button type="button" class="quiz-tile" data-code={code} disabled>
                  <span class="quiz-index" aria-hidden="true">
                    {index + 1}
                  </span>
                  <img
                    src={flag(code)}
                    alt={`Flag ${index + 1}`}
                    width="480"
                    height="320"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="quiz-label" />
                </button>
              ))
            }
          </div>
          <div class="quiz-result" data-quiz-result aria-live="polite"></div>
          <details class="quiz-reveal" data-quiz-static>
            <summary>Show the answer</summary>
            <p>
              <strong>{first.name}</strong> is flag {first.options.indexOf(first.answer) + 1}.
              Capital {first.capital}. {first.cue}
              {first.note}
            </p>
          </details>
          <div class="quiz-actions">
            <button type="button" class="brass-btn" data-quiz-next hidden>Next flag</button>
          </div>
        </div>
      </div>
    </section>

    <section class="feature" aria-labelledby="cards-title">
      <div class="feature-text">
        <p class="kicker kicker-ink">Cards</p>
        <h2 id="cards-title" class="display feature-title">250 cards, up to holographic.</h2>
        <p>
          Every country is a card with four stamps to earn, 1,000 in all. One stamp makes it Bronze,
          two Silver, three Gold, and all four turn it holographic, on the card and on the country’s
          rim on your globe.
        </p>
        <ul class="stamps">
          {
            stamps.map((s, i) => (
              <li>
                <strong>{s.name}</strong>
                <span>{s.body}</span>
                <em>{tiers[i]}</em>
              </li>
            ))
          }
        </ul>
        <p class="aside">
          The back of every card is the encyclopedia: the story behind the flag, what its colours
          and symbols mean, the country’s shape, neighbours, languages, currency and a short
          history. Free, and offline.
        </p>
      </div>
      <div class="phone-pair">
        <img
          src={shots.card.src}
          srcset={shots.card.srcset}
          sizes="(min-width: 768px) clamp(240px, 12vw, 420px), 42vw"
          width={shots.card.w}
          height={shots.card.h}
          alt="Japan's card on iPhone: holographic, with its Flag, Name, Capital and Place stamps, above the country's page"
          loading="lazy"
          decoding="async"
        />
        <img
          src={shots.cards.src}
          srcset={shots.cards.srcset}
          sizes="(min-width: 768px) clamp(240px, 12vw, 420px), 42vw"
          width={shots.cards.w}
          height={shots.cards.h}
          alt="Cards on iPhone: 123 of 250 countries collected, 332 of 1,000 stamps, and the list of countries"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <section class="feature feature-flip" aria-labelledby="expeditions-title">
      <div class="feature-text">
        <p class="kicker kicker-ink">Expeditions</p>
        <h2 id="expeditions-title" class="display feature-title">
          33 expeditions, three stars each.
        </h2>
        <p>
          Curated routes of eight to twelve countries with a theme, from Nordic Crosses and
          Tricolour Trouble to The Silk Road and Island Hopper. The camera flies the route; one star
          at 60 percent, two at 85, three for a clean run.
        </p>
        <ol class="ranks" aria-label="Explorer ranks, first to last">
          {ranks.map((r) => <li>{r}</li>)}
        </ol>
        <p class="aside">
          Your lifetime points set your Explorer rank. The first chapter of expeditions is free; the
          rest come with Pro.
        </p>
      </div>
      <div class="phone-pair">
        <img
          src={shots.expeditions.src}
          srcset={shots.expeditions.srcset}
          sizes="(min-width: 768px) clamp(240px, 12vw, 420px), 42vw"
          width={shots.expeditions.w}
          height={shots.expeditions.h}
          alt="Expeditions on iPhone: The Big Ten, Nordic Crosses, Tricolour Trouble and more, each with its stars"
          loading="lazy"
          decoding="async"
        />
        <img
          src={shots.you.src}
          srcset={shots.you.srcset}
          sizes="(min-width: 768px) clamp(240px, 12vw, 420px), 42vw"
          width={shots.you.w}
          height={shots.you.h}
          alt="You on iPhone: the Explorer rank Cartographer, countries, stamps and stars, and the region levels"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <section class="feature" aria-labelledby="daily-title">
      <div class="feature-text">
        <p class="kicker kicker-ink">Daily</p>
        <h2 id="daily-title" class="display feature-title">The same Daily for everyone.</h2>
        <p>
          Ten flags, once a day, the same set for every player, played on the globe and finished
          with a result you can share as a picture. Streak freezes cover a day you skip, and a
          48-hour repair window forgives a broken run.
        </p>
        <p class="aside">
          Game Center has weekly points, region leaderboards and achievements, all free.
        </p>
      </div>
      <img
        class="feature-phone"
        src={shots.daily.src}
        srcset={shots.daily.srcset}
        sizes="(min-width: 768px) clamp(300px, 15vw, 520px), 70vw"
        width={shots.daily.w}
        height={shots.daily.h}
        alt="Daily #103 on iPhone: pick the flag of Senegal from four flags, over the globe"
        loading="lazy"
        decoding="async"
      />
    </section>

    <section class="atlas drills bleed" aria-labelledby="drills-title">
      <div class="atlas-inner">
        <div class="drills-grid">
          <div>
            <p class="kicker">Master of Flags Pro</p>
            <h2 id="drills-title" class="display atlas-title">Make the world your own.</h2>
            <p>
              Pro opens every expedition, four Looks for your globe, Paper, Blueprint, Aurora and
              Gold, and a poster of your world to keep and share. It keeps everything it already
              had: Smart Review brings back the flags and capitals you miss on a spaced schedule,
              Similar Flags drills the look-alikes, and Hard Mode puts eight flags on the board.
            </p>
            <p class="aside">
              Plus full statistics, the Daily Archive and five streak freezes a month. One purchase,
              no subscription, and if you already own Pro, all of it is yours.
            </p>
          </div>
          <img
            class="drills-phone"
            src={shots.looks.src}
            srcset={shots.looks.srcset}
            sizes="(min-width: 1024px) clamp(260px, 13vw, 460px), 60vw"
            width={shots.looks.w}
            height={shots.looks.h}
            alt="Looks on iPhone: the globe in Aurora, with Night, Paper, Blueprint, Aurora and Gold to choose from"
            loading="lazy"
            decoding="async"
          />
        </div>
        <ul class="pairs" aria-label="Look-alike flags Similar Flags drills">
          {
            pairs.map((p) => (
              <li>
                <div class="pair-flags">
                  <figure>
                    <img
                      src={flag(p.a.code)}
                      alt={`Flag of ${p.a.name}`}
                      width="480"
                      height="320"
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption>{p.a.name}</figcaption>
                  </figure>
                  <figure>
                    <img
                      src={flag(p.b.code)}
                      alt={`Flag of ${p.b.name}`}
                      width="480"
                      height="320"
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption>{p.b.name}</figcaption>
                  </figure>
                </div>
                <p>{p.note}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="scene screens bleed" aria-labelledby="screens-title">
      <div class="scene-inner">
        <div class="screens-head">
          <h2 id="screens-title" class="display scene-title">A globe for the whole room.</h2>
          <p class="scene-lede">
            On Apple TV the Atlas fills the screen, and Couch Mode plays two to four players with
            one remote and no timers. iPad gives the globe room to breathe. Flash questions and your
            Daily streak live on Apple Watch, with widgets for the Home Screen and Lock Screen.
          </p>
        </div>
        <figure class="screens-tv">
          <img
            src={shots.tvQuestion.src}
            srcset={shots.tvQuestion.srcset}
            sizes="(min-width: 1280px) 76vw, 100vw"
            width={shots.tvQuestion.w}
            height={shots.tvQuestion.h}
            alt="Master of Flags on Apple TV: Nepal's flag beside the globe, with Kyrgyzstan, United Arab Emirates, Turkey and Nepal to choose from"
            loading="lazy"
            decoding="async"
          />
          <figcaption>The Atlas on Apple TV.</figcaption>
        </figure>
        <div class="screens-pair">
          <img
            src={shots.pad.src}
            srcset={shots.pad.srcset}
            sizes="(min-width: 1024px) 22vw, 45vw"
            width={shots.pad.w}
            height={shots.pad.h}
            alt="The Atlas on iPad: the painted globe with the Explorer rank, regions and Play"
            loading="lazy"
            decoding="async"
          />
          <figure class="screens-couch">
            <img
              src={shots.tvCouch.src}
              srcset={shots.tvCouch.srcset}
              sizes="(min-width: 1024px) 40vw, 100vw"
              width={shots.tvCouch.w}
              height={shots.tvCouch.h}
              alt="Couch Mode on Apple TV: Eero's turn to name Ireland, with the scoreboard for Maya, Eero and Sam"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Couch Mode on Apple TV.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    {
      c.pricing && (
        <section class="band" aria-labelledby="pricing-title">
          <h2 id="pricing-title" class="display band-title">
            Free to play. Pro is one purchase.
          </h2>
          <div class="plans">
            <div class="plan">
              <h3>
                {c.pricing.free.title}
                <span>{c.pricing.free.price}</span>
              </h3>
              <ul>
                {c.pricing.free.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="plan plan-pro">
              <h3>
                {c.pricing.premium.title}
                <span>{c.pricing.premium.price}</span>
              </h3>
              <ul>
                {c.pricing.premium.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
          <p class="fine">{c.pricing.footnote}</p>
          <p class="founders">
            Bought Master of Flags when it was a paid app? You are a founder: everything Pro
            unlocks, 5.0 included, is yours, free, forever, and unlocks by itself the first time you
            open the app. Thank you for seven years.
          </p>
        </section>
      )
    }

    <section class="band trust" aria-labelledby="trust-title">
      <h2 id="trust-title" class="display band-title">Your world stays yours.</h2>
      <p>
        No account, no analytics, no ads and no tracking. Your globe, streak and bookmarks stay on
        your device and can follow you to your other devices through your own iCloud account. The
        app holds an anonymous Midgar ID, and a Pro purchase or restore is recorded under it so it
        can be restored. The flags and the whole encyclopedia ship with the app and work offline.
        {
          privacyUrl && (
            <>
              {' '}
              <a href={privacyUrl}>Read the privacy policy</a>.
            </>
          )
        }
      </p>
    </section>

    <section class="band" aria-labelledby="faq-title">
      <div class="faq-layout">
        <h2 id="faq-title" class="display band-title">Questions.</h2>
        <div class="faq">
          <FaqAccordion faq={c.faq} accent={accent} />
        </div>
      </div>
    </section>

    <section class="closing bleed" aria-labelledby="closing-title">
      <img
        class="closing-art"
        src={heroArt.src}
        srcset={heroArt.srcset}
        sizes="100vw"
        alt=""
        loading="lazy"
        decoding="async"
        width={heroArt.w}
        height={heroArt.h}
      />
      <div class="scene-inner closing-inner">
        {
          app.iconLocal && (
            <AppIcon
              src={app.iconLocal}
              width={72}
              height={72}
              displayWidths={[64, 72]}
              class="hero-icon h-16 w-16 rounded-[1.1rem] object-cover sm:h-[4.5rem] sm:w-[4.5rem]"
            />
          )
        }
        <h2 id="closing-title" class="display scene-title">Your world is waiting.</h2>
        <p class="scene-lede">
          Free on the App Store for iPhone, iPad, Mac, Apple TV and Apple Watch.
        </p>
        <div class="hero-actions">
          <AppStoreBadge href={app.appStoreUrl} platform="ios" />
        </div>
        <ul class="meta">
          {versionLabel && <li>{versionLabel}</li>}
          <li>Requires {requires}</li>
