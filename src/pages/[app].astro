---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppStoreBadge from '@components/landing/AppStoreBadge.astro';
import StarRating from '@components/landing/StarRating.astro';
import ScreenshotShowcase from '@components/landing/ScreenshotShowcase.astro';
import FeatureGrid from '@components/landing/FeatureGrid.astro';
import FaqAccordion from '@components/landing/FaqAccordion.astro';
import DeviceFrame from '@components/landing/DeviceFrame.astro';
import PricingTable from '@components/landing/PricingTable.astro';
import WebbLive from '@components/landing/WebbLive.astro';
import { landingApps, DEVICE_LABELS, primaryDevice, type LandingApp } from '@data/landing';
import screenshotVariants from '@data/screenshot-variants.json';

export function getStaticPaths() {
  return landingApps.map((app) => ({ params: { app: app.slug }, props: { app } }));
}

const { app } = Astro.props as { app: LandingApp };
const c = app.content;
const accent = c.accentColor || app.primaryColor;
const isReview = app.status === 'review';
const isOpenSource = app.openSource === true;
/// An open-source app may also ship on the App Store (Tailscode), or only from
/// GitHub releases (Crucible, trackId 0) — a track id is what tells them apart,
/// and decides whether the store badge is worth showing next to the repo link.
const onAppStore = app.trackId > 0 && !isReview;
const showAppStore = !isOpenSource || onAppStore;
const githubUrl = app.githubUrl;
const releaseUrl = app.latestReleaseUrl ?? app.githubUrl;

const site = 'https://midgarcorp.cc';
const canonical = `${site}/${app.slug}/`;
// Bump OG_REV when card artwork changes so social scrapers refetch (the image
// path is otherwise stable and gets cached hard by unfurlers).
const OG_REV = '6';
const ogImage = `/og/${app.slug}.png?v=${OG_REV}`;

const subtitle = app.name.includes(':')
  ? app.name.split(':').slice(1).join(':').trim()
  : (app.category ?? '');

const platformForBadge =
  app.platforms.includes('Mac') && !app.platforms.includes('iPhone') ? 'mac' : 'ios';

const osMap: Record<string, string> = {
  iPhone: 'iOS',
  iPad: 'iOS',
  Mac: 'macOS',
  'Apple Watch': 'watchOS',
  'Apple TV': 'tvOS',
  'Vision Pro': 'visionOS',
  Linux: 'Linux',
};
const operatingSystem = [...new Set(app.platforms.map((p) => osMap[p]).filter(Boolean))].join(', ');

const hasScreenshots = Object.values(app.screenshots).some((shots) => shots.length > 0);
const heroDevice = primaryDevice(app);
const heroShot = heroDevice ? app.screenshots[heroDevice]?.[0] : undefined;
const bannerDevice = c.bannerDevice;
const bannerShot = bannerDevice ? app.screenshots[bannerDevice]?.[0] : undefined;
const bannerCaption = bannerDevice
  ? (c.screenshotCaptions?.[bannerDevice]?.[0] ?? bannerShot?.label)
  : undefined;
const bannerVariants = bannerShot
  ? ((screenshotVariants as Record<string, number[]>)[bannerShot.src] ?? [])
  : [];
const bannerSrcset =
  bannerShot && bannerVariants.length
    ? [
        ...bannerVariants.map(
          (wide) => `${bannerShot.src.replace(/\.webp$/, `@${wide}.webp`)} ${wide}w`
        ),
        `${bannerShot.src} ${bannerShot.w}w`,
      ].join(', ')
    : undefined;
const HERO_FRAME: Record<string, { class: string; heights: [number, number] }> = {
  iphone: { class: 'h-[420px] sm:h-[500px]', heights: [420, 500] },
  ipad: { class: 'h-[400px] sm:h-[470px]', heights: [400, 470] },
};
const heroFrame = HERO_FRAME[heroDevice] ?? {
  class: 'h-[230px] sm:h-[300px]',
  heights: [230, 300] as [number, number],
};
const heroHeightClass = heroFrame.class;

const priceNumeric = app.price === 'Free' ? '0' : app.price.replace('$', '');

const abs = (p?: string | null) => (p ? (p.startsWith('http') ? p : site + p) : undefined);

const privacyOverrides: Record<string, string> = {
  embr: 'https://embr.guitaripod.workers.dev/legal/privacy',
  solarbeam: 'https://midgarcorp.cc/solarbeam/privacy',
  tailscode: 'https://midgarcorp.cc/tailscode/privacy',
};
const privacyTenants: Record<string, string> = {
  dreameater: 'dreameater',
  pixiepocket: 'pixiepocket',
  psywave: 'psywave',
  doublekick: 'doublekick',
  psybeam: 'psybeam',
  appofthedead: 'appofthedead',
  payday: 'payday',
  helia: 'helia',
  flaccy: 'flaccy',
};
const privacyUrl =
  privacyOverrides[app.slug] ??
  (privacyTenants[app.slug]
    ? `https://mako.midgarcorp.cc/privacy/${privacyTenants[app.slug]}`
    : undefined);
const supportUrl = app.supportUrl ?? undefined;

const allShots = Object.values(app.screenshots)
  .flat()
  .map((s) => abs(s.src));

const downloadOffer = {
  '@type': 'Offer',
  name: `${app.shortName} download`,
  price: priceNumeric,
  priceCurrency: 'USD',
  url: app.appStoreUrl,
  availability: 'https://schema.org/InStock',
};

/// A free download with paid unlocks needs every tier in the graph, or the only
/// structured price Google sees is "0" for an app that can cost $49.99.
const premiumOffers = (c.pricing?.tiers ?? [])
  .filter((tier) => typeof tier.amount === 'number')
  .map((tier) => ({
    '@type': 'Offer',
    name: `${c.pricing!.premium.title} — ${tier.name}`,
    price: String(tier.amount),
    priceCurrency: 'USD',
    url: app.appStoreUrl,
    availability: 'https://schema.org/InStock',
    category: 'InAppPurchase',
    ...(tier.period
      ? { eligibleDuration: { '@type': 'QuantitativeValue', value: tier.period } }
      : {}),
  }));

const softwareApp: Record<string, unknown> = {
  '@type': 'SoftwareApplication',
  name: app.name,
  operatingSystem,
  applicationCategory: app.category,
  description: c.metaDescription,
  url: canonical,
  installUrl: app.appStoreUrl,
  image: abs(app.iconLocal),
  screenshot: allShots,
  offers: premiumOffers.length ? [downloadOffer, ...premiumOffers] : downloadOffer,
  author: { '@type': 'Organization', name: 'Midgar Oy', url: site },
  publisher: { '@type': 'Organization', name: 'Midgar Oy', url: site },
  ...(app.version ? { softwareVersion: app.version } : {}),
  ...(app.releaseDate ? { datePublished: app.releaseDate } : {}),
  ...(app.ratingCount > 0
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: app.rating,
          ratingCount: app.ratingCount,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
  ...(isOpenSource
    ? {
        isAccessibleForFree: true,
        license: 'https://www.gnu.org/licenses/gpl-3.0.html',
        codeRepository: githubUrl,
      }
    : {}),
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'Apps', item: `${site}/apps` },
    { '@type': 'ListItem', position: 3, name: app.shortName, item: canonical },
  ],
};

const faqPage = {
  '@type': 'FAQPage',
  mainEntity: c.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const jsonLd = { '@context': 'https://schema.org', '@graph': [softwareApp, breadcrumb, faqPage] };

// Structure the App Store description: ALL-CAPS short lines become subheadings.
const descBlocks = app.description
  .split(/\n+/)
  .map((l) => l.trim())
  .filter(Boolean)
  .map((line) => {
    const isHeading =
      line.length <= 42 &&
      /[A-Z]/.test(line) &&
      line === line.toUpperCase() &&
      !/[.!?]$/.test(line);
    return { line, isHeading };
  });

// A few sibling apps for internal linking.
const siblings = landingApps.filter((a) => a.slug !== app.slug).slice(0, 6);

const sectionPrompt = (cmd: string) => cmd;
---

<BaseLayout title={c.seoTitle} description={c.metaDescription} image={ogImage}>
  <div style={`--accent:${accent}`}>
    <!-- Breadcrumb -->
    <nav
      aria-label="Breadcrumb"
      class="hidden pt-8 text-xs text-paper-faint dark:text-term-faint sm:block"
    >
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/apps" class="hover:text-paper-green dark:hover:text-term-green">apps</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">{app.slug}</li>
      </ol>
    </nav>

    <!-- Hero -->
    <header
      class="flex flex-col gap-8 py-8 sm:py-14 lg:grid lg:grid-cols-[1.05fr_0.95fr] lg:grid-rows-[auto_1fr] lg:gap-x-12 lg:gap-y-7"
    >
      <div class="lg:col-start-1 lg:row-start-1">
        <p class="prompt-line mb-5 hidden sm:block">
          open /Applications/{app.shortName.replace(/ /g, '\\ ')}.app
        </p>

        <div class="mb-5 flex items-center gap-4">
          {
            app.iconLocal && (
              <img
                src={app.iconLocal}
                alt=""
                width="72"
                height="72"
                fetchpriority="high"
                class="hero-icon h-16 w-16 rounded-[1.1rem] border border-paper-border object-cover dark:border-term-border sm:h-[72px] sm:w-[72px]"
              />
            )
          }
          <div class="min-w-0">
            <p
              class="text-2xl font-bold tracking-tight text-paper-text dark:text-term-text sm:text-3xl"
            >
              {app.shortName}
            </p>
            {subtitle && <p class="text-sm text-paper-muted dark:text-term-muted">{subtitle}</p>}
          </div>
        </div>

        <h1
          class="mb-4 text-3xl font-bold leading-tight tracking-tight text-paper-text dark:text-term-text sm:text-4xl"
        >
          {c.heroHeadline}
        </h1>
        <p
          class="mb-6 max-w-xl text-base leading-relaxed text-paper-muted dark:text-term-muted sm:text-lg"
        >
          {c.heroSubhead}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-3">
          {
            showAppStore && (
              <AppStoreBadge
                href={app.appStoreUrl}
                platform={platformForBadge}
                comingSoon={isReview}
              />
            )
          }
          {
            isOpenSource && (
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="accent-btn inline-flex items-center gap-2 rounded-sm border px-4 py-2.5 text-sm font-semibold transition-colors"
              >
                <img src="/icons/github.svg" alt="" width="18" height="18" class="dark:invert" />
                View on GitHub
              </a>
            )
          }
          {
            hasScreenshots && (
              <a
                href="#screenshots"
                class="accent-btn inline-flex items-center gap-2 rounded-sm border px-4 py-2.5 text-sm font-semibold transition-colors"
              >
                See it in action ↓
              </a>
            )
          }
        </div>
      </div>

      <!-- hero screenshot -->
      {
        heroShot && (
          <div class="flex justify-center lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:items-center lg:justify-end">
            <div class={`device-glow ${heroHeightClass}`} style={`--accent:${accent}`}>
              <DeviceFrame
                device={heroDevice}
                src={heroShot.src}
                w={heroShot.w}
                h={heroShot.h}
                alt={`${app.shortName} on ${DEVICE_LABELS[heroDevice] ?? 'iPhone'}: ${c.screenshotCaptions?.[heroDevice]?.[0] ?? heroShot.label}`}
                eager={true}
                priority={true}
                heights={heroFrame.heights}
              />
            </div>
          </div>
        )
      }

      <div class="lg:col-start-1 lg:row-start-2">
        <!-- meta chips -->
        <div class="mb-7 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          {
            isOpenSource ? (
              <span class="inline-flex items-center gap-1.5 rounded-sm border border-paper-green/40 px-2 py-0.5 text-xs font-semibold text-paper-green dark:border-term-green/40 dark:text-term-green">
                Open source
              </span>
            ) : isReview ? (
              <span class="inline-flex items-center gap-1.5 rounded-sm border border-paper-amber/40 px-2 py-0.5 text-xs font-semibold text-paper-amber dark:border-term-amber/40 dark:text-term-amber">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-paper-amber dark:bg-term-amber" />
                In App Store review
              </span>
            ) : (
              <StarRating
                rating={app.rating}
                count={app.ratingCount}
                releaseDate={app.releaseDate}
              />
            )
          }
          <span class="font-semibold text-paper-amber dark:text-term-amber">
            {isOpenSource ? (app.license ?? 'Free') : app.price}
          </span>
          <span class="text-paper-faint dark:text-term-faint">{app.category}</span>
          <span class="flex flex-wrap gap-1.5">
            {
              app.platforms.map((p) => (
                <span class="rounded-sm border border-paper-border px-1.5 py-0.5 text-xs text-paper-faint dark:border-term-border dark:text-term-faint">
                  {p}
                </span>
              ))
            }
          </span>
        </div>

        <!-- highlights -->
        <ul class="grid gap-2 sm:grid-cols-1">
          {
            c.highlights.map((h) => (
              <li class="flex items-start gap-2 text-sm text-paper-text dark:text-term-text">
                <span class="accent-text mt-0.5 shrink-0" aria-hidden="true">
                  ▸
                </span>
                <span>{h}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    {
      bannerShot && (
        <figure class="mb-2 overflow-hidden rounded-xl border border-paper-border dark:border-term-border">
          <img
            src={bannerShot.src}
            srcset={bannerSrcset}
            width={bannerShot.w}
            height={bannerShot.h}
            loading="lazy"
            decoding="async"
            sizes="(min-width: 1152px) 1088px, 100vw"
            alt={`${app.shortName} — ${bannerCaption}`}
            class="block w-full"
          />
          <figcaption class="bg-paper-panel px-4 py-2.5 text-xs text-paper-muted dark:bg-term-panel dark:text-term-muted">
            {bannerCaption}
          </figcaption>
        </figure>
      )
    }

    {
      hasScreenshots && (
        <section
          id="screenshots"
          class="scroll-mt-20 border-t border-paper-border py-12 dark:border-term-border sm:py-16"
        >
          <p class="prompt-line mb-3">{sectionPrompt(`./${app.slug} --screenshots`)}</p>
          <h2 class="mb-8 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
            {app.shortName}
            <span class="accent-text">in action</span>
          </h2>
          <ScreenshotShowcase app={app} />
        </section>
      )
    }

    {
      c.lifestyle && c.lifestyle.length > 0 && (
        <section class="border-t border-paper-border py-12 dark:border-term-border sm:py-16">
          <p class="prompt-line mb-3">{sectionPrompt(`./${app.slug} --in-the-wild`)}</p>
          <h2 class="mb-8 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
            Out in <span class="accent-text">the world</span>
          </h2>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
            {c.lifestyle.map((shot) => (
              <figure class="overflow-hidden rounded-xl border border-paper-border dark:border-term-border">
                <img
                  src={shot.src}
                  alt={shot.caption}
                  loading="lazy"
                  decoding="async"
                  width="1280"
                  height="1589"
                  class="aspect-[4/5] w-full object-cover"
                />
                <figcaption class="px-3 py-2 text-xs text-paper-muted dark:text-term-muted">
                  {shot.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <!-- Features -->
    <section
      id="features"
      class="scroll-mt-20 border-t border-paper-border py-12 dark:border-term-border sm:py-16"
    >
      <p class="prompt-line mb-3">{sectionPrompt(`cat ${app.slug}/FEATURES.md`)}</p>
      <h2 class="mb-8 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
        What <span class="accent-text">{app.shortName}</span> does
      </h2>
      <FeatureGrid features={c.features} accent={accent} />
    </section>

    {
      c.pricing && (
        <section
          id="pricing"
          class="scroll-mt-20 border-t border-paper-border py-12 dark:border-term-border sm:py-16"
        >
          <p class="prompt-line mb-3">{sectionPrompt(`./${app.slug} --pricing`)}</p>
          <h2 class="mb-8 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
            {c.pricing.heading}
          </h2>
          <PricingTable pricing={c.pricing} accent={accent} />
        </section>
      )
    }

    {c.webbLive && <WebbLive accent={accent} />}

    <!-- How it works -->
    <section class="border-t border-paper-border py-12 dark:border-term-border sm:py-16">
      <p class="prompt-line mb-3">{sectionPrompt(`man ${app.slug}`)}</p>
      <h2 class="mb-8 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
        How <span class="accent-text">{app.shortName}</span> works
      </h2>
      <ol class="grid gap-5 sm:grid-cols-3">
        {
          c.howItWorks.map((step, i) => (
            <li class="term-frame relative flex flex-col gap-2 p-5">
              <span
                class="accent-text font-mono text-sm font-bold"
                aria-hidden="true"
              >{`0${i + 1}`}</span>
              <h3 class="text-base font-bold text-paper-text dark:text-term-text">{step.step}</h3>
              <p class="text-sm leading-relaxed text-paper-muted dark:text-term-muted">
                {step.body}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- About (full store description) -->
    <section
      class:list={[
        'border-t border-paper-border py-12 dark:border-term-border sm:py-16',
        { hidden: c.hideAbout },
      ]}
    >
      <p class="prompt-line mb-3">{sectionPrompt(`less ${app.slug}/README`)}</p>
      <h2 class="mb-6 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
        About {app.shortName}
      </h2>
      <div class="max-w-2xl space-y-3 font-sans">
        {
          descBlocks.map(({ line, isHeading }) =>
            isHeading ? (
              <h3 class="accent-text pt-3 text-xs font-bold uppercase tracking-[0.16em]">{line}</h3>
            ) : (
              <p class="text-sm leading-relaxed text-paper-muted dark:text-term-muted">{line}</p>
            )
          )
        }
      </div>
    </section>

    <!-- FAQ -->
    <section
      id="faq"
      class="scroll-mt-20 border-t border-paper-border py-12 dark:border-term-border sm:py-16"
    >
      <p class="prompt-line mb-3">{sectionPrompt(`./${app.slug} --faq`)}</p>
      <h2 class="mb-8 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
        Frequently asked <span class="accent-text">questions</span>
      </h2>
      <div class="max-w-3xl">
        <FaqAccordion faq={c.faq} accent={accent} />
      </div>
      {
        c.trustNote && (
          <p class="mt-10 max-w-3xl border-l-2 border-paper-border pl-4 text-xs leading-relaxed text-paper-muted dark:border-term-border dark:text-term-muted">
            {c.trustNote}
          </p>
        )
      }
    </section>

    <!-- Final CTA -->
    <section class="border-t border-paper-border py-12 dark:border-term-border sm:py-16">
      <div class="term-frame relative overflow-hidden p-6 sm:p-10" style={`--accent:${accent}`}>
        <span class="cta-spine absolute inset-y-0 left-0 w-1" aria-hidden="true"></span>
        <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-4">
            {
              app.iconLocal && (
                <img
                  src={app.iconLocal}
                  alt=""
                  width="64"
                  height="64"
                  loading="lazy"
                  class="h-14 w-14 rounded-[0.9rem] border border-paper-border object-cover dark:border-term-border"
                />
              )
            }
            <div>
              <h2 class="text-lg font-bold text-paper-text dark:text-term-text sm:text-xl">
                {c.ctaLine}
              </h2>
              <p class="mt-1 text-sm text-paper-muted dark:text-term-muted">{c.pricingNote}</p>
            </div>
          </div>
          <div class="flex shrink-0 flex-wrap items-center gap-3">
            {
              showAppStore && (
                <AppStoreBadge
                  href={app.appStoreUrl}
                  platform={platformForBadge}
                  comingSoon={isReview}
                />
              )
            }
            {
              isOpenSource && (
                <a
                  href={githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="accent-btn inline-flex items-center gap-2 rounded-sm border px-4 py-2.5 text-sm font-semibold transition-colors"
                >
                  <img src="/icons/github.svg" alt="" width="18" height="18" class="dark:invert" />
                  View on GitHub
                </a>
              )
            }
          </div>
        </div>

        <div
          class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-paper-border pt-5 text-xs text-paper-faint dark:border-term-border dark:text-term-faint"
        >
          {
            app.version && (
              <span>
                v{app.version}
                {app.minimumOsVersion
                  ? ` · requires ${operatingSystem} ${app.minimumOsVersion}+`
                  : ''}
              </span>
            )
          }
          {
            onAppStore && (
              <a
                href={app.appStoreUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-paper-green dark:hover:text-term-green"
              >
                App Store ↗
              </a>
            )
          }
          {
            isOpenSource && githubUrl && (
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-paper-green dark:hover:text-term-green"
              >
                GitHub ↗
              </a>
            )
          }
          {
            isOpenSource && releaseUrl && (
              <a
                href={releaseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-paper-green dark:hover:text-term-green"
              >
                Releases ↗
              </a>
            )
          }
          {
            supportUrl && (
              <a
                href={supportUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-paper-green dark:hover:text-term-green"
              >
                Support ↗
              </a>
            )
          }
          {
            privacyUrl && (
              <a
                href={privacyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-paper-green dark:hover:text-term-green"
              >
                Privacy ↗
              </a>
            )
          }
          <span>by {app.sellerName ?? 'Midgar Oy'}</span>
        </div>
      </div>
    </section>

    <!-- More apps -->
    <section class="border-t border-paper-border py-12 dark:border-term-border">
      <p class="prompt-line mb-5">ls ~/apps</p>
      <div class="flex flex-wrap gap-3">
        {
          siblings.map((s) => (
            <a
              href={`/${s.slug}/`}
              class="group inline-flex items-center gap-2.5 rounded-sm border border-paper-border px-3 py-2 text-sm transition-colors hover:border-paper-border2 dark:border-term-border dark:hover:border-term-border2"
            >
              {s.iconLocal && (
                <img
                  src={s.iconLocal}
                  alt=""
                  width="24"
                  height="24"
                  loading="lazy"
                  decoding="async"
                  class="h-6 w-6 rounded-md object-cover"
                />
              )}
              <span class="font-medium text-paper-muted group-hover:text-paper-green dark:text-term-muted dark:group-hover:text-term-green">
                {s.shortName}
              </span>
            </a>
          ))
        }
        <a
          href="/apps"
          class="inline-flex items-center gap-2 rounded-sm border border-paper-border px-3 py-2 text-sm font-medium text-paper-muted transition-colors hover:border-paper-border2 hover:text-paper-green dark:border-term-border dark:text-term-muted dark:hover:border-term-border2 dark:hover:text-term-green"
        >
          all apps →
        </a>
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

