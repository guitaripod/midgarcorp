    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .hero-icon {
    box-shadow: 0 14px 40px -12px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .accent-btn {
    color: color-mix(in srgb, var(--accent), #000 42%);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  :global(.dark) .accent-btn {
    color: color-mix(in srgb, var(--accent), #fff 24%);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .accent-btn:hover {
    background-color: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
  }
  .cta-spine {
    background-color: var(--accent);
    opacity: 0.7;
  }
</style>
