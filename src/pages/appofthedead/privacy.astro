---
import BaseLayout from '@layouts/BaseLayout.astro';

const accent = '#A855F7';
const seoTitle = 'App of the Dead Privacy Policy';
const metaDescription =
  'App of the Dead collects no personal data. No analytics, no ads, no tracking, no accounts. Your progress lives in a database on your device, and the Oracle runs entirely on your phone.';

const sections = [
  {
    title: 'No personal data is collected',
    body: 'App of the Dead has no accounts, no sign-up, and no analytics or advertising SDKs. The app’s privacy manifest declares zero collected data types and no tracking domains. We never see who you are or what you study.',
  },
  {
    title: 'Your progress stays on your device',
    body: 'Lessons completed, quiz answers, XP, streaks, achievements and Oracle conversations are stored in a database inside the app’s own sandbox on your iPhone. They are not uploaded to us, because there is no server of ours to upload them to.',
  },
  {
    title: 'The Oracle runs on your phone',
    body: 'Oracle conversations are generated by a language model that runs entirely on your device. What you ask the Oracle is never transmitted to us or to any third-party AI service. The model file itself is downloaded once from Hugging Face, which sees only an ordinary file request — not your questions.',
  },
  {
    title: 'Purchases',
    body: 'Purchases and subscriptions are processed by Apple. We use RevenueCat to verify what you have unlocked; it receives a randomly generated, anonymous identifier and your purchase receipt from Apple. Neither we nor RevenueCat receive your name, email, or payment details — Apple never shares those with developers.',
  },
  {
    title: 'Game Center',
    body: 'If you sign in to Game Center, achievements and leaderboard entries are handled by Apple under Apple’s privacy policy. Game Center is optional; declining it does not limit the learning content.',
  },
  {
    title: 'Children',
    body: 'The app is not directed at children under 13, collects no personal information from anyone, and contains no advertising, no user-to-user communication, and no external links to unmoderated content.',
  },
  {
    title: 'Your rights',
    body: 'Because nothing is collected, there is nothing for us to export, correct, or erase on your behalf. Deleting the app removes every record it kept, permanently and immediately.',
  },
];
---

<BaseLayout title={seoTitle} description={metaDescription}>
  <div style={`--accent:${accent}`}>
    <nav aria-label="Breadcrumb" class="pt-8 text-xs text-paper-faint dark:text-term-faint">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/appofthedead" class="hover:text-paper-green dark:hover:text-term-green">
            appofthedead
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">privacy</li>
      </ol>
    </nav>

    <header class="py-10 sm:py-14">
      <p class="prompt-line mb-5">cat appofthedead/PRIVACY.md</p>
      <h1
        class="mb-3 text-3xl font-bold tracking-tight text-paper-text dark:text-term-text sm:text-4xl"
      >
        App of the Dead Privacy Policy
      </h1>
      <p class="text-xs text-paper-faint dark:text-term-faint">Effective August 17, 2026</p>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-paper-muted dark:text-term-muted">
        The short version: <span class="font-semibold text-paper-text dark:text-term-text"
          >App of the Dead collects no personal data.</span
        > There are no accounts and no server of ours, so there is nothing for us to see, store, or share.
      </p>
    </header>

    <section class="border-t border-paper-border pb-12 pt-10 dark:border-term-border">
      <div class="grid max-w-3xl gap-5">
        {
          sections.map((s) => (
            <div class="term-frame p-5 sm:p-6">
              <h2 class="accent-text mb-2 text-xs font-bold uppercase tracking-[0.16em]">
                {s.title}
              </h2>
              <p class="text-sm leading-relaxed text-paper-muted dark:text-term-muted">{s.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="border-t border-paper-border py-10 dark:border-term-border">
      <div class="term-frame max-w-3xl p-5 sm:p-6">
        <h2 class="accent-text mb-2 text-xs font-bold uppercase tracking-[0.16em]">
          Questions &amp; changes
        </h2>
        <p class="text-sm leading-relaxed text-paper-muted dark:text-term-muted">
          Questions about this policy? Email
          <a
            href="mailto:guitaripod@gmail.com"
            class="text-paper-green underline decoration-dotted underline-offset-2 dark:text-term-green"
            >guitaripod@gmail.com</a
          >. Any changes to this policy will be posted on this page.
        </p>
      </div>
      <p class="mt-8 text-xs text-paper-faint dark:text-term-faint">
        <a href="/appofthedead/terms" class="hover:text-paper-green dark:hover:text-term-green"
          >terms of use →</a
        >
      </p>
      <p class="mt-2 text-xs text-paper-faint dark:text-term-faint">
        <a href="/appofthedead" class="hover:text-paper-green dark:hover:text-term-green"
          >← back to App of the Dead</a
        >
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .accent-text {
    color: color-mix(in srgb, var(--accent), #000 42%);
  }
  :global(.dark) .accent-text {
    color: var(--accent);
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 45%, transparent);
  }
</style>
