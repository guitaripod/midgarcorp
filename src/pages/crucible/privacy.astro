---
import BaseLayout from '@layouts/BaseLayout.astro';

const accent = '#F97316';
const seoTitle = 'Crucible Privacy Policy';
const metaDescription =
  'Crucible has no analytics, no ads, no tracking and no sign-up. It talks to plex.tv, the Plex server you choose and, if you opt in, Tailscale; Crucible Pro purchases are kept by Midgar with an anonymous Midgar ID.';

const sections = [
  {
    title: 'What Crucible is',
    body: 'Crucible is a Plex client for iPhone and Apple TV made by Midgar Oy. It runs on your device and talks to plex.tv, to sign you in and find your servers, and to the Plex Media Server you choose. If you are on a Tailscale network it may also ask the computers on that network which one is your server, and only if you opt in does it talk to api.tailscale.com.',
  },
  {
    title: 'What we collect',
    body: 'Only what Crucible Pro needs: an anonymous Midgar ID and the records of your Crucible Pro purchases, described under The anonymous Midgar ID and Purchases below. Nothing about your library, your viewing or your Plex account reaches us. There are no ads, no analytics and no tracking SDKs. Midgar may publish aggregate statistics built from anonymous counts, such as weekly active installs, which never identify a person; Crucible sends no usage counts, so it adds nothing to them.',
  },
  {
    title: 'Your Plex account',
    body: 'You sign in with Plex’s own sign-in flow. Your Plex token is stored in the Keychain on your device and sent only to plex.tv and to your own servers. Plex’s privacy policy applies to your Plex account.',
  },
  {
    title: 'Your Tailscale token (optional)',
    body: 'If a server cannot be found on your Tailscale network by name, you may give Crucible a Tailscale API access token so it can read your device list. The token is stored in the Keychain on your device, sent only to api.tailscale.com, and can be removed at any time in Settings, Server, Tailscale Search.',
  },
  {
    title: 'Your library and viewing history',
    body: 'Titles, artwork, watch history and the statistics built from it come from your Plex server and stay on your device. A Year in Review poster is drawn on your device and leaves it only if you share it.',
  },
  {
    title: 'The demo',
    body: 'The built-in demo runs a fictional library inside the app. It uses no network and no account, and leaving the demo forgets everything it stored.',
  },
  {
    title: 'Downloads',
    body: 'Offline downloads are saved on your iPhone and are not sent anywhere.',
  },
  {
    title: 'The anonymous Midgar ID',
    body: 'From version 2.4, the first time the app starts it asks Midgar’s server at api.midgarcorp.cc for an anonymous Midgar ID: a random identifier, and a random secret that proves the ID is yours. The server keeps the ID, a hash of the secret and the date it was created. The app keeps both in your iCloud Keychain, so the same ID follows you across your own devices and Midgar’s other apps. There is no name, email address, phone number, location or device name in it. On iPhone the app may ask Apple’s App Attest service to confirm that the request comes from a genuine copy of Crucible; we receive Apple’s attestation and nothing about you. You can have the ID and everything linked to it deleted by writing to support@midgarcorp.cc.',
  },
  {
    title: 'Purchases',
    body: 'Crucible Pro (lifetime or yearly) is sold through the App Store. Apple processes the payment; we never see your payment details or your Apple Account. Apple’s own notifications about Crucible Pro purchases (which product, the price, the dates, whether it renewed, lapsed or was refunded, the order identifiers and your App Store country) reach Midgar’s purchase ledger. From version 2.4, the app also sends the ledger the signed transaction record Apple has already issued, with your Midgar ID, so Crucible Pro is recognised on all your devices; the ledger keeps these records for as long as Apple’s financial records require. Version 2.4 contains no RevenueCat software. Earlier versions check and restore your purchase through RevenueCat (RevenueCat, Inc., United States), which receives a random app user ID and your purchase history for this app under its own privacy policy at https://www.revenuecat.com/privacy.',
  },
  {
    title: 'Diagnostics',
    body: 'A diagnostic log is kept on your device. It leaves your device only if you export and share it yourself.',
  },
  {
    title: 'Children',
    body: 'Crucible is not directed at children and does not knowingly collect information from anyone.',
  },
  {
    title: 'Changes and contact',
    body: 'If this policy changes, the new version appears here with its date. Questions go to https://github.com/guitaripod/Crucible/issues. Last updated 31 October 2026.',
  },
];
---

<BaseLayout title={seoTitle} description={metaDescription}>
  <div style={`--accent:${accent}`}>
    <nav aria-label="Breadcrumb" class="pt-8 text-xs text-paper-faint dark:text-term-faint">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/crucible" class="hover:text-paper-green dark:hover:text-term-green">
            crucible
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">privacy</li>
      </ol>
    </nav>

    <header class="py-10 sm:py-14">
      <p class="prompt-line mb-5">cat crucible/PRIVACY.md</p>
      <h1
        class="mb-3 text-3xl font-bold tracking-tight text-paper-text dark:text-term-text sm:text-4xl"
      >
        Crucible Privacy Policy
      </h1>
      <p class="text-xs text-paper-faint dark:text-term-faint">Effective October 31, 2026</p>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-paper-muted dark:text-term-muted">
        The short version: <span class="font-semibold text-paper-text dark:text-term-text"
          >Crucible has no sign-up and no tracking.</span
        > It talks to plex.tv and your Plex server, and Midgar keeps your Crucible Pro purchase with
        an anonymous ID.
      </p>
    </header>

    <section class="border-t border-paper-border pb-12 pt-10 dark:border-term-border">
      <div class="grid max-w-3xl gap-5">
        {
          sections.map((s) => (
            <div class="term-frame p-5 sm:p-6">
              <h2 class="accent-text mb-2 text-xs font-bold uppercase tracking-[0.16em]">
                {s.title}
              </h2>
              <p class="text-sm leading-relaxed text-paper-muted dark:text-term-muted">{s.body}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-xs text-paper-faint dark:text-term-faint">
        <a href="/crucible" class="hover:text-paper-green dark:hover:text-term-green"
          >← back to Crucible</a
        >
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .accent-text {
    color: color-mix(in srgb, var(--accent), #000 42%);
  }
  :global(.dark) .accent-text {
    color: color-mix(in srgb, var(--accent), #fff 24%);
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 45%, transparent);
  }
</style>
