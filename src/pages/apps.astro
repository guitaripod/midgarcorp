---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppCard from '@components/AppCard.astro';
import AppFlagship from '@components/AppFlagship.astro';
import AppReleaseLog from '@components/AppReleaseLog.astro';
import AppSpringboard from '@components/AppSpringboard.astro';
import PageSection from '@components/PageSection.astro';
import {
  APPS_NOW,
  RECENT_DAYS,
  appEntries,
  appHeroes,
  appReleases,
  appRest,
  appStats,
} from '@data/apps';
import {
  WEBSITE_ID,
  absoluteUrl,
  breadcrumbList,
  googleAppCategory,
  operatingSystems,
  organizationRef,
} from '@utils/structured-data';

const pageTitle = 'iPhone, iPad, Mac and Apple TV Apps | guitaripod';
const now = APPS_NOW;
const { storeCount, shippedRecently } = appStats;
const cards = appEntries;

const listed = (items: string[]): string =>
  items.length > 1 ? `${items.slice(0, -1).join(', ')} and ${items.at(-1)}` : items.join('');
const plural = (count: number, noun: string): string => `${count} ${noun}${count === 1 ? '' : 's'}`;

const applePlatforms = appStats.platforms.filter((platform) => platform !== 'Linux');
const freeCount = appEntries.filter((entry) => entry.app.price === 'Free').length;
const launches = appEntries
  .filter((entry) => entry.app.releaseDate)
  .sort((a, b) => (a.app.releaseDate ?? '').localeCompare(b.app.releaseDate ?? ''));
const firstYear = launches[0]?.app.releaseDate?.slice(0, 4);
const newest = launches.at(-1);
const monthYear = new Intl.DateTimeFormat('en-GB', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});

const readout = [
  {
    key: 'apps',
    value: `${storeCount} on the App Store${firstYear ? `, since ${firstYear}` : ''}`,
  },
  { key: 'commits', value: appStats.commits.toLocaleString('en-US') },
  {
    key: 'updated',
    value: `${plural(shippedRecently, 'app')} in the last ${RECENT_DAYS} days`,
    href: appReleases.length > 0 ? '#releases' : undefined,
  },
  ...(newest?.app.releaseDate
    ? [
        {
          key: 'newest',
          value: `${newest.app.displayName ?? newest.app.name}, ${monthYear.format(new Date(newest.app.releaseDate))}`,
          href: `#${newest.slug ?? newest.app.id}`,
        },
      ]
    : []),
  { key: 'runs on', value: appStats.platforms.join(', ') },
  {
    key: 'price',
    value:
      freeCount === appEntries.length
        ? `free to download, all ${freeCount}`
        : `${freeCount} free to download`,
  },
];

const ogDescription = `${storeCount} apps on the App Store for ${listed(applePlatforms)}, designed, built and shipped solo; ${shippedRecently} updated in the last ${RECENT_DAYS} days.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': 'https://midgarcorp.cc/apps/',
  name: pageTitle,
  description: ogDescription,
  url: 'https://midgarcorp.cc/apps/',
  isPartOf: { '@id': WEBSITE_ID },
  publisher: organizationRef,
  breadcrumb: breadcrumbList([{ name: 'Apps', path: '/apps/' }]),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: cards.length,
    itemListElement: cards.map(({ app, release, landingHref }, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: landingHref ? absoluteUrl(landingHref) : app.appStoreUrl,
      item: {
        '@type': 'SoftwareApplication',
        ...(landingHref ? { '@id': `${absoluteUrl(landingHref)}#app` } : {}),
        name: app.name,
        description: app.tagline,
        applicationCategory: googleAppCategory(app.category),
        operatingSystem: operatingSystems(app.platforms),
        softwareVersion: release?.version,
        offers: {
          '@type': 'Offer',
          price: app.price === 'Free' ? '0' : app.price.replace(/[^0-9.]/g, ''),
          priceCurrency: 'USD',
        },
        datePublished: app.releaseDate,
        dateModified: release?.date,
        url: landingHref ? absoluteUrl(landingHref) : app.appStoreUrl,
        sameAs: app.appStoreUrl,
        publisher: organizationRef,
      },
    })),
  },
};
---

<BaseLayout title={pageTitle} description={ogDescription} image="/og-apps-grid.png">
  <header class="apps-hero pt-12 sm:pt-16 mb-14 sm:mb-20">
    <div class="apps-hero__text">
      <p class="prompt-line mb-4">ls ~/apps --sort=work</p>
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 tracking-tight text-paper-text dark:text-term-text"
      >
        Apple Platform <span class="phosphor">Apps</span>
      </h1>
      <p
        class="text-base sm:text-lg text-paper-muted dark:text-term-muted max-w-2xl mb-6 leading-relaxed"
      >
        {storeCount} apps for {listed(applePlatforms)}, designed, built and shipped solo. Each one
        does one job properly, and none of them is finished: {plural(shippedRecently, 'app')} shipped
        an update in the last {RECENT_DAYS} days.
      </p>
      <dl class="readout">
        {
          readout.map((row) => (
            <div class="readout__row">
              <dt>{row.key}</dt>
              <dd>
                {row.href ? (
                  <a href={row.href} class="readout__link">
                    {row.value}
                  </a>
                ) : (
                  row.value
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <AppSpringboard entries={appEntries} platformCounts={appStats.platformCounts} now={now} />
  </header>

  {
    appHeroes.length > 0 && (
      <PageSection
        command={`ls ~/apps --sort=work | head -${appHeroes.length}`}
        title="Most worked on"
        blurb="Commits and releases decide the order, not stars or downloads. The rest follow further down, in the same order."
      >
        <div class="space-y-16 sm:space-y-24">
          {appHeroes.map((entry, index) => (
            <AppFlagship entry={entry} flip={index % 2 === 1} />
          ))}
        </div>
      </PageSection>
    )
  }

  {
    appReleases.length > 0 && (
      <PageSection
        id="releases"
        command="ls -lt ~/apps"
        title="Latest releases"
        blurb="Every app's current App Store version, newest first, with the first line of what changed."
        aside={`${plural(shippedRecently, 'app')} updated in ${RECENT_DAYS} days`}
      >
        <AppReleaseLog releases={appReleases} now={now} />
      </PageSection>
    )
  }

  <PageSection
    command="ls ~/apps --all"
    title="Everything else"
    blurb="Still ranked by the work behind each one. Every app has its own page with screenshots, pricing and an FAQ."
    aside={plural(appRest.length, 'app')}
  >
    <div class="apps-grid grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 lg:gap-8">
      {
        appRest.map((entry, index) => (
          <AppCard
            wide={appRest.length % 2 === 1 && index === appRest.length - 1}
            app={entry.app}
            landingHref={entry.landingHref}
            openSource={entry.openSource}
            githubUrl={entry.githubUrl}
            shots={entry.shots}
            device={entry.device}
            commits={entry.work?.commitCount}
            version={entry.version}
            updated={entry.release?.date}
            anchor={entry.slug ?? entry.app.id}
          />
        ))
      }
    </div>
  </PageSection>

  <section class="mt-12 sm:mt-16 mb-12">
    <div class="term-frame p-6 sm:p-8">
      <p class="prompt-line mb-4">make app CLIENT=you</p>
      <h2 class="text-xl sm:text-2xl font-bold mb-3 text-paper-text dark:text-term-text">
        Need an app built?
      </h2>
      <p
        class="text-sm sm:text-base text-paper-muted dark:text-term-muted mb-6 max-w-2xl leading-relaxed"
      >
        I take Apple-platform products from idea to App Store: Swift across iPhone, iPad, Mac and
        TV, with the backend and AI integration to match. The {storeCount} apps above went through the
        same pipeline.
      </p>
      <a
        href="/services/#book"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-sm font-bold hover:opacity-90 transition-opacity"
      >
        Get in touch →
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>

<style>
  .apps-hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .apps-hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 3.5rem;
    }
  }

  .readout {
    display: grid;
    gap: 0.35rem;
    font-size: 0.8125rem;
  }

  .readout__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
  }

  .readout dt {
    @apply text-paper-green dark:text-term-green;
  }

  .readout dd {
    @apply text-paper-text dark:text-term-text;
  }

  .readout__link {
    @apply underline decoration-dotted underline-offset-2 hover:text-paper-green dark:hover:text-term-green transition-colors;
  }
</style>
