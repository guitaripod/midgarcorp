---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppCard from '@components/AppCard.astro';
import AppFlagship from '@components/AppFlagship.astro';
import ShareBar from '@components/ShareBar.astro';
import StatCell from '@components/StatCell.astro';
import { appEntries, appHeroes, appRest, appStats } from '@data/apps';

const pageTitle = 'Apple Platform Apps | guitaripod';
const { storeCount } = appStats;
const cards = appEntries;

const leader = [...appEntries].sort(
  (a, b) => (b.work?.commitCount ?? 0) - (a.work?.commitCount ?? 0)
)[0];
const freeCount = appEntries.filter((entry) => entry.app.price === 'Free').length;
const platformShare = appStats.platforms
  .map((platform) => ({
    label: platform,
    count: appEntries.filter((entry) => entry.app.platforms.includes(platform)).length,
  }))
  .sort((a, b) => b.count - a.count)
  .map((entry) => ({ ...entry, fraction: entry.count / appEntries.length }));
const platformBars = [
  'bg-paper-green dark:bg-term-green',
  'bg-paper-amber dark:bg-term-amber',
  'bg-paper-greendim dark:bg-term-greendim',
  'bg-paper-border2 dark:bg-term-border2',
  'bg-paper-muted dark:bg-term-muted',
];
const platformItems = platformShare.map((entry, index) => ({
  ...entry,
  barClass: platformBars[index % platformBars.length],
}));

const ogDescription = `${storeCount} apps live on the App Store — iPhone, iPad, Mac, and Apple TV — plus open-source builds. ${appStats.commits.toLocaleString('en-US')} commits across ML-powered consumer products, developer tools, and education apps, designed and shipped solo.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: ogDescription,
  url: 'https://midgarcorp.cc/apps/',
  author: {
    '@type': 'Person',
    name: 'guitaripod',
    url: 'https://midgarcorp.cc',
  },
  hasPart: cards.map(({ app }) => ({
    '@type': 'SoftwareApplication',
    name: app.name,
    description: app.tagline,
    applicationCategory: app.category,
    operatingSystem: app.platforms.join(', '),
    offers: {
      '@type': 'Offer',
      price: app.price === 'Free' ? '0' : app.price.replace('$', ''),
      priceCurrency: 'USD',
    },
    datePublished: app.releaseDate,
    url: app.appStoreUrl,
  })),
};
---

<BaseLayout title={pageTitle} description={ogDescription} image="/og-apps-grid.png">
  <header class="pt-12 sm:pt-16 mb-8 sm:mb-10">
    <p class="prompt-line mb-4">ls ~/apps --sort=work</p>
    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 tracking-tight text-paper-text dark:text-term-text"
    >
      Apple Platform <span class="phosphor">Apps</span>
    </h1>
    <p
      class="text-base sm:text-lg text-paper-muted dark:text-term-muted max-w-3xl mb-3 leading-relaxed"
    >
      {storeCount} apps live on the App Store spanning iPhone, iPad, Mac, and Apple TV, plus open-source
      builds shipped from Linux. Each one solves a real problem — from on-device LLM tutoring to AI image
      generation to a 4K window on the cosmos.
    </p>
    <p class="text-sm sm:text-base text-paper-faint dark:text-term-faint max-w-2xl">
      Designed, built, and shipped solo after seven years of engineering at scale. Ordered by the
      work behind each app. Open source where it makes sense.
    </p>
  </header>

  <section class="mb-14 sm:mb-20">
    <div class="term-frame p-5 sm:p-6">
      <p class="prompt-line mb-5">apps --stats</p>
      <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-7">
        <StatCell label="apps_shipped" value={appEntries.length}>
          <p class="text-[11px] text-paper-muted dark:text-term-muted">
            <span class="text-paper-green dark:text-term-green">{storeCount}</span> on the App Store
          </p>
        </StatCell>
        <StatCell label="commits_across_apps" value={appStats.commits.toLocaleString('en-US')}>
          {
            leader?.work && (
              <p class="text-[11px] text-paper-muted dark:text-term-muted">
                most work:{' '}
                <a
                  href={leader.landingHref}
                  class="text-paper-text dark:text-term-text hover:text-paper-green dark:hover:text-term-green transition-colors underline decoration-dotted underline-offset-2"
                >
                  {leader.app.name}
                </a>
                <span class="text-paper-green dark:text-term-green">
                  {` ${leader.work.commitCount.toLocaleString('en-US')}`}
                </span>
              </p>
            )
          }
        </StatCell>
        <StatCell label="platforms" value={platformItems.length}>
          <ShareBar
            items={platformItems}
            summary={platformItems.map((p) => `${p.count} ${p.label}`).join(', ')}
          />
        </StatCell>
        <StatCell label="free_to_download" value={freeCount}>
          <p class="text-[11px] text-paper-muted dark:text-term-muted">
            no ads, no tracking in the apps that say so
          </p>
        </StatCell>
      </dl>
    </div>
  </section>

  {
    appHeroes.length > 0 && (
      <section class="mb-14 sm:mb-20" aria-labelledby="apps-featured">
        <h2 id="apps-featured" class="sr-only">
          Most worked-on apps
        </h2>
        <div class="space-y-16 sm:space-y-24">
          {appHeroes.map((entry, index) => (
            <AppFlagship entry={entry} flip={index % 2 === 1} eager={index === 0} />
          ))}
        </div>
      </section>
    )
  }

  <section>
    <div class="flex items-baseline justify-between gap-4 mb-6">
      <h2 class="prompt-line font-normal">ls ~/apps --all</h2>
      <span class="text-xs text-paper-muted dark:text-term-faint whitespace-nowrap">
        {appRest.length} more
      </span>
    </div>
    <div class="apps-grid grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 lg:gap-8">
      {
        appRest.map((entry) => (
          <AppCard
            app={entry.app}
            landingHref={entry.landingHref}
            openSource={entry.openSource}
            githubUrl={entry.githubUrl}
            shots={entry.shots}
            device={entry.device}
            commits={entry.work?.commitCount}
            version={entry.version}
          />
        ))
      }
    </div>
  </section>

  <section class="mt-12 sm:mt-16 mb-12">
    <div class="term-frame p-6 sm:p-8">
      <p class="prompt-line mb-4">make app CLIENT=you</p>
      <h2 class="text-xl sm:text-2xl font-bold mb-3 text-paper-text dark:text-term-text">
        Need an app built?
      </h2>
      <p
        class="text-sm sm:text-base text-paper-muted dark:text-term-muted mb-6 max-w-2xl leading-relaxed"
      >
        I take Apple-platform products from idea to App Store — Swift across iPhone, iPad, Mac, and
        TV, with the backend and AI integration to match. {storeCount} live apps prove the pipeline works.
      </p>
      <a
        href="/services#book"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-sm font-bold hover:opacity-90 transition-opacity"
      >
        Get in touch →
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .apps-grid > :global(*) {
      animation: fadeIn 0.5s ease-out forwards;
      opacity: 0;
    }

    .apps-grid > :global(*:nth-child(1)) {
      animation-delay: 0.05s;
    }
    .apps-grid > :global(*:nth-child(2)) {
      animation-delay: 0.1s;
    }
    .apps-grid > :global(*:nth-child(3)) {
      animation-delay: 0.15s;
    }
    .apps-grid > :global(*:nth-child(4)) {
      animation-delay: 0.2s;
    }
    .apps-grid > :global(*:nth-child(5)) {
      animation-delay: 0.25s;
    }
    .apps-grid > :global(*:nth-child(6)) {
      animation-delay: 0.3s;
    }
    .apps-grid > :global(*:nth-child(7)) {
      animation-delay: 0.35s;
    }
    .apps-grid > :global(*:nth-child(8)) {
      animation-delay: 0.4s;
    }
    .apps-grid > :global(*:nth-child(9)) {
      animation-delay: 0.45s;
    }
    .apps-grid > :global(*:nth-child(10)) {
      animation-delay: 0.5s;
    }
    .apps-grid > :global(*:nth-child(11)) {
      animation-delay: 0.55s;
    }
    .apps-grid > :global(*:nth-child(12)) {
      animation-delay: 0.6s;
    }
    .apps-grid > :global(*:nth-child(n + 13)) {
      animation-delay: 0.65s;
    }
  }
</style>
