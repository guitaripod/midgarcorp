---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppCard from '@components/AppCard.astro';
import appsData from '../data/apps.json';
import { landingApps } from '@data/landing';

const pageTitle = 'Apple Platform Apps | guitaripod';

const landingByTrack = new Map(landingApps.map((a) => [String(a.trackId), a]));
const trackIdFor = (appStoreUrl: string): string | undefined => appStoreUrl.match(/id(\d+)/)?.[1];
const landingHrefFor = (appStoreUrl: string): string | undefined => {
  const id = trackIdFor(appStoreUrl);
  const la = id ? landingByTrack.get(id) : undefined;
  return la ? `/${la.slug}` : undefined;
};

// Prefer the curated landing price (source of truth) over the auto-fetched
// iTunes price, which lags a few hours behind an App Store Connect price change.
const cardApp = (app: (typeof appsData.apps)[number]) => {
  const id = trackIdFor(app.appStoreUrl);
  const la = id ? landingByTrack.get(id) : undefined;
  return la ? { ...app, price: la.price } : app;
};

// App Store apps are tracked dynamically from iTunes (apps.json).
const storeApps = [...appsData.apps].sort(
  (a, b) => new Date(b.releaseDate).getTime() - new Date(a.releaseDate).getTime()
);
const storeCount = storeApps.length;

// Open-source apps come from the landing config so the grid stays dynamic:
// flag a landing app `openSource` and it appears here automatically.
const osCards = landingApps
  .filter((a) => a.openSource)
  .map((a) => ({
    app: {
      id: a.slug,
      name: a.shortName,
      tagline: a.content.heroHeadline,
      description: a.description,
      platforms: a.platforms,
      category: a.category ?? 'App',
      price: a.price,
      appStoreUrl: a.githubUrl ?? '',
      icon: a.iconLocal ?? a.icon ?? '',
      primaryColor: a.primaryColor,
      features: a.content.highlights ?? [],
      releaseDate: a.releaseDate,
    },
    landingHref: `/${a.slug}`,
    openSource: true,
    githubUrl: a.githubUrl,
  }));

const cards = [
  ...storeApps.map((app) => ({
    app: cardApp(app),
    landingHref: landingHrefFor(app.appStoreUrl),
    openSource: false,
    githubUrl: undefined as string | undefined,
  })),
  ...osCards,
].sort(
  (a, b) => new Date(b.app.releaseDate ?? 0).getTime() - new Date(a.app.releaseDate ?? 0).getTime()
);

const ogDescription = `${storeCount} apps live on the App Store — iPhone, iPad, Mac, and Apple TV — plus open-source builds. ML-powered consumer products, developer tools, and education apps, designed and shipped solo.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: ogDescription,
  url: 'https://midgarcorp.cc/apps/',
  author: {
    '@type': 'Person',
    name: 'guitaripod',
    url: 'https://midgarcorp.cc',
  },
  hasPart: cards.map(({ app }) => ({
    '@type': 'SoftwareApplication',
    name: app.name,
    description: app.tagline,
    applicationCategory: app.category,
    operatingSystem: app.platforms.join(', '),
    offers: {
      '@type': 'Offer',
      price: app.price === 'Free' ? '0' : app.price.replace('$', ''),
      priceCurrency: 'USD',
    },
    datePublished: app.releaseDate,
    url: app.appStoreUrl,
  })),
};
---

<BaseLayout title={pageTitle} description={ogDescription} image="/og-apps-grid.png">
  <header class="pt-12 sm:pt-16 mb-10 sm:mb-12">
    <p class="prompt-line mb-4">ls ~/apps --sort=released</p>
    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 tracking-tight text-paper-text dark:text-term-text"
    >
      Apple Platform <span class="phosphor">Apps</span>
    </h1>
    <p
      class="text-base sm:text-lg text-paper-muted dark:text-term-muted max-w-3xl mb-3 leading-relaxed"
    >
      {storeCount} apps live on the App Store spanning iPhone, iPad, Mac, and Apple TV, plus open-source
      builds shipped from Linux. Each one solves a real problem — from on-device LLM tutoring to AI image
      generation to a 4K window on the cosmos.
    </p>
    <p class="text-sm sm:text-base text-paper-faint dark:text-term-faint max-w-2xl">
      Designed, built, and shipped solo after six years of engineering at scale. Open source where
      it makes sense. Always shipping.
    </p>
  </header>

  <section>
    <div class="apps-grid grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 lg:gap-8">
      {
        cards.map((c) => (
          <AppCard
            app={c.app}
            landingHref={c.landingHref}
            openSource={c.openSource}
            githubUrl={c.githubUrl}
          />
        ))
      }
    </div>
  </section>

  <section class="mt-12 sm:mt-16 mb-12">
    <div class="term-frame p-6 sm:p-8">
      <p class="prompt-line mb-4">make app CLIENT=you</p>
      <h2 class="text-xl sm:text-2xl font-bold mb-3 text-paper-text dark:text-term-text">
        Need an app built?
      </h2>
      <p
        class="text-sm sm:text-base text-paper-muted dark:text-term-muted mb-6 max-w-2xl leading-relaxed"
      >
        I take Apple-platform products from idea to App Store — Swift across iPhone, iPad, Mac, and
        TV, with the backend and AI integration to match. {storeCount} live apps prove the pipeline works.
      </p>
      <a
        href="/services#book"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-sm font-bold hover:opacity-90 transition-opacity"
      >
        Get in touch →
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .apps-grid > :global(*) {
      animation: fadeIn 0.5s ease-out forwards;
      opacity: 0;
    }

    .apps-grid > :global(*:nth-child(1)) {
      animation-delay: 0.05s;
    }
    .apps-grid > :global(*:nth-child(2)) {
      animation-delay: 0.1s;
    }
    .apps-grid > :global(*:nth-child(3)) {
      animation-delay: 0.15s;
    }
    .apps-grid > :global(*:nth-child(4)) {
      animation-delay: 0.2s;
    }
    .apps-grid > :global(*:nth-child(5)) {
      animation-delay: 0.25s;
    }
    .apps-grid > :global(*:nth-child(6)) {
      animation-delay: 0.3s;
    }
    .apps-grid > :global(*:nth-child(7)) {
      animation-delay: 0.35s;
    }
    .apps-grid > :global(*:nth-child(8)) {
      animation-delay: 0.4s;
    }
    .apps-grid > :global(*:nth-child(9)) {
      animation-delay: 0.45s;
    }
    .apps-grid > :global(*:nth-child(10)) {
      animation-delay: 0.5s;
    }
    .apps-grid > :global(*:nth-child(11)) {
      animation-delay: 0.55s;
    }
    .apps-grid > :global(*:nth-child(12)) {
      animation-delay: 0.6s;
    }
    .apps-grid > :global(*:nth-child(n + 13)) {
      animation-delay: 0.65s;
    }
  }
</style>
