---
import BaseLayout from '@layouts/BaseLayout.astro';
import LinuxAppCard from '@components/LinuxAppCard.astro';
import LinuxFlagship from '@components/LinuxFlagship.astro';
import LinuxInstallAll from '@components/LinuxInstallAll.astro';
import LinuxShipLog from '@components/LinuxShipLog.astro';
import LinuxSection from '@components/LinuxSection.astro';
import LinuxStats from '@components/LinuxStats.astro';
import {
  LINUX_SHOWCASE,
  linuxApps,
  linuxBench,
  linuxFlagships,
  linuxStats,
  type LinuxForm,
} from '@data/linux';
import { FORM_NOUNS, FORM_ORDER, languageColor } from '../lib/linux-insights';

const pageTitle = 'Linux Apps & Tools | guitaripod';
const now = new Date();

const langList =
  linuxStats.languages.length > 1
    ? `${linuxStats.languages.slice(0, -1).join(', ')} and ${linuxStats.languages.at(-1)}`
    : linuxStats.languages.join('');

const ogDescription = `${linuxStats.appCount} Linux apps and command-line tools — ${linuxStats.releaseCount} releases shipped in ${langList}. GTK desktop apps, a Wayland daemon, and single-binary CLIs, installable via cargo, Homebrew, and the AUR.`;

const benchByRecency = [...linuxBench].sort(
  (a, b) =>
    (b.latestReleaseDate ?? '').localeCompare(a.latestReleaseDate ?? '') || a.id.localeCompare(b.id)
);

const benchForms = FORM_ORDER.map((form) => ({
  form,
  count: linuxBench.filter((app) => app.form === form).length,
})).filter((entry) => entry.count > 0);

const benchLanguages = linuxStats.languages
  .map((language) => ({
    language,
    count: linuxBench.filter((app) => app.language === language).length,
  }))
  .filter((entry) => entry.count > 0);

const sortOptions = [
  { value: 'recent', label: 'latest release' },
  { value: 'releases', label: 'most releases' },
  { value: 'stars', label: 'most stars' },
  { value: 'name', label: 'name' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: ogDescription,
  url: 'https://midgarcorp.cc/linux/',
  author: {
    '@type': 'Person',
    name: 'guitaripod',
    url: 'https://midgarcorp.cc',
  },
  hasPart: linuxApps.map((app) => ({
    '@type': 'SoftwareApplication',
    name: app.name,
    description: app.description,
    applicationCategory: app.group === 'desktop' ? 'DesktopApplication' : 'DeveloperApplication',
    operatingSystem: 'Linux',
    programmingLanguage: app.language,
    softwareVersion: app.latestVersion ?? undefined,
    screenshot: LINUX_SHOWCASE[app.id]
      ? `https://midgarcorp.cc${LINUX_SHOWCASE[app.id].shot.src}`
      : undefined,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    url: app.githubUrl,
  })),
};
---

<BaseLayout title={pageTitle} description={ogDescription} image="/og-linux.png">
  <header class="pt-12 sm:pt-16 mb-8 sm:mb-10">
    <p class="prompt-line mb-4">uname -o &amp;&amp; ls ~/linux</p>
    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 tracking-tight text-paper-text dark:text-term-text"
    >
      Linux <span class="phosphor">Apps</span> &amp; Tools
    </h1>
    <p
      class="text-base sm:text-lg text-paper-muted dark:text-term-muted max-w-3xl mb-3 leading-relaxed"
    >
      {linuxStats.appCount} open-source apps and command-line tools built for Linux, with {
        linuxStats.releaseCount
      } tagged releases across {langList}. Native GTK desktop apps, a Wayland color-temperature
      daemon, a system-tray toggle — and a deep bench of single-binary CLIs.
    </p>
    <p class="text-sm sm:text-base text-paper-muted dark:text-term-faint max-w-2xl">
      Every one is installable in a single command — <span
        class="text-paper-text dark:text-term-text">cargo</span
      >, <span class="text-paper-text dark:text-term-text">brew</span>, the <span
        class="text-paper-text dark:text-term-text">AUR</span
      >, or from source. All developed and released from Arch Linux.
    </p>
  </header>

  <section class="mb-14 sm:mb-20">
    <LinuxStats apps={linuxApps} now={now} />
  </section>

  {
    linuxFlagships.length > 0 && (
      <LinuxSection
        command="ls ~/linux/desktop"
        title="Desktop apps"
        blurb="Native GTK and KDE Plasma apps, shown running."
        aside={`${linuxFlagships.length} ${linuxFlagships.length === 1 ? 'app' : 'apps'}`}
      >
        <div class="space-y-16 sm:space-y-24">
          {linuxFlagships.map((app, index) => (
            <LinuxFlagship app={app} now={now} flip={index % 2 === 1} eager={index === 0} />
          ))}
        </div>
      </LinuxSection>
    )
  }

  <LinuxSection
    command="git tag --sort=-creatordate"
    title="Release log"
    blurb="Every tagged release across all tools, month by month. What shipped most recently is on top."
    aside={`${linuxStats.releaseCount} releases`}
  >
    <LinuxShipLog apps={linuxApps} now={now} />
  </LinuxSection>

  {
    benchByRecency.length > 0 && (
      <LinuxSection
        command="ls ~/linux/bin"
        title="The bench"
        blurb="Command-line tools, small desktop utilities and daemons. Filter by kind or language, sort by what shipped last."
        aside={`${benchByRecency.length} entries`}
      >
        <div data-bench>
          <div data-bench-controls hidden class="mb-6">
            <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
              <div
                class="flex flex-wrap items-center gap-1.5"
                role="group"
                aria-label="Filter by kind"
              >
                <span class="term-label mr-1">kind</span>
                <button
                  type="button"
                  class="chip"
                  data-filter-kind="form"
                  data-filter-value="all"
                  aria-pressed="true"
                >
                  all {benchByRecency.length}
                </button>
                {benchForms.map(({ form, count }) => (
                  <button
                    type="button"
                    class="chip"
                    data-filter-kind="form"
                    data-filter-value={form}
                    aria-pressed="false"
                  >
                    {FORM_NOUNS[form as LinuxForm]} {count}
                  </button>
                ))}
              </div>

              <div
                class="flex flex-wrap items-center gap-1.5"
                role="group"
                aria-label="Filter by language"
              >
                <span class="term-label mr-1">language</span>
                <button
                  type="button"
                  class="chip"
                  data-filter-kind="lang"
                  data-filter-value="all"
                  aria-pressed="true"
                >
                  all
                </button>
                {benchLanguages.map(({ language, count }) => (
                  <button
                    type="button"
                    class="chip"
                    data-filter-kind="lang"
                    data-filter-value={language}
                    aria-pressed="false"
                  >
                    <span
                      class="inline-block w-1.5 h-1.5 rounded-full mr-1.5 align-middle"
                      style={`background:${languageColor(language)}`}
                      aria-hidden="true"
                    />
                    {language} {count}
                  </button>
                ))}
              </div>

              <label class="inline-flex items-center gap-2 sm:ml-auto">
                <span class="term-label">sort</span>
                <select data-bench-sort class="sort-select">
                  {sortOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              </label>
            </div>
            <p
              data-bench-count
              aria-live="polite"
              class="mt-3 text-[11px] text-paper-muted dark:text-term-faint"
            >
              showing {benchByRecency.length} of {benchByRecency.length}
            </p>
          </div>

          <div
            data-bench-grid
            class="linux-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6"
          >
            {benchByRecency.map((app) => (
              <LinuxAppCard app={app} now={now} />
            ))}
          </div>
          <p
            data-bench-empty
            hidden
            class="term-frame p-6 text-sm text-paper-muted dark:text-term-muted"
          >
            Nothing matches both filters. Clear one of them.
          </p>
        </div>
      </LinuxSection>
    )
  }

  <LinuxSection
    command="install --all"
    title="Install the lot"
    blurb="One command per package manager covering every tool published there, built from each tool's own install line."
  >
    <LinuxInstallAll apps={linuxApps} />
  </LinuxSection>

  <section class="mt-12 sm:mt-16 mb-12">
    <div class="term-frame p-6 sm:p-8">
      <p class="prompt-line mb-4">git clone --recursive ~/linux</p>
      <h2 class="text-xl sm:text-2xl font-bold mb-3 text-paper-text dark:text-term-text">
        Built on Linux, for Linux.
      </h2>
      <p
        class="text-sm sm:text-base text-paper-muted dark:text-term-muted mb-6 max-w-2xl leading-relaxed"
      >
        Source, release binaries, and issue trackers for every tool live on GitHub. Same hands that
        ship {linuxStats.appCount} Linux tools also ship native Apple-platform apps — cross-platform
        by habit, not by framework.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="/opensource"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-sm font-bold hover:opacity-90 transition-opacity"
        >
          ./browse-all-open-source
        </a>
        <a
          href="https://github.com/guitaripod?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 border border-paper-border2 dark:border-term-border2 text-paper-text dark:text-term-text rounded-sm text-sm font-semibold hover:border-paper-green dark:hover:border-term-green hover:text-paper-green dark:hover:text-term-green transition-colors"
        >
          gh browse guitaripod ↗
        </a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>

<script>
  import { initLinuxBench } from '../lib/linux-bench';

  initLinuxBench();
</script>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .chip {
    @apply inline-flex items-center text-xs px-2.5 py-1 rounded-sm border border-paper-border dark:border-term-border text-paper-muted dark:text-term-muted bg-paper-panel dark:bg-term-panel transition-colors;
  }

  .chip:hover {
    @apply border-paper-border2 dark:border-term-border2 text-paper-text dark:text-term-text;
  }

  .chip[aria-pressed='true'] {
    @apply border-paper-green dark:border-term-green text-paper-green dark:text-term-green;
  }

  .chip:focus-visible,
  .sort-select:focus-visible {
    @apply outline outline-1 outline-paper-green dark:outline-term-green;
  }

  .sort-select {
    @apply text-xs px-2 py-1 rounded-sm border border-paper-border dark:border-term-border bg-paper-panel dark:bg-term-panel text-paper-text dark:text-term-text;
  }

  .linux-grid > :global([data-linux-card][hidden]) {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .linux-grid > :global(*) {
      animation: fadeIn 0.45s ease-out both;
    }
    .linux-grid > :global(*:nth-child(2)) {
      animation-delay: 0.04s;
    }
    .linux-grid > :global(*:nth-child(3)) {
      animation-delay: 0.08s;
    }
    .linux-grid > :global(*:nth-child(4)) {
      animation-delay: 0.12s;
    }
    .linux-grid > :global(*:nth-child(5)) {
      animation-delay: 0.16s;
    }
    .linux-grid > :global(*:nth-child(6)) {
      animation-delay: 0.2s;
    }
    .linux-grid > :global(*:nth-child(n + 7)) {
      animation-delay: 0.24s;
    }
  }
</style>
