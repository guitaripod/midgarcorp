    clip-path: inset(70% 0 14% 0);
    transform: translateX(0.05em);
  }
  .bw-grid {
    stroke: var(--bw-grid);
    stroke-width: 1;
  }
  .bw-tick {
    font-size: 11px;
    fill: currentColor;
    opacity: 0.6;
  }
  .bw-axis {
    font-size: 11px;
    fill: currentColor;
    opacity: 0.6;
  }
  .bw-better {
    font-size: 11px;
    fill: var(--bw-ink);
  }
  .bw-area {
    fill: color-mix(in srgb, var(--bw) 12%, transparent);
  }
  .bw-wall {
    stroke: var(--bw);
