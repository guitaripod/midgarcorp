  }
  :global(.dark) .glitch::before,
  :global(.dark) .glitch::after {
    mix-blend-mode: screen;
  }
  .glitch::before {
    color: var(--bw-cyan);
    clip-path: inset(18% 0 66% 0);
    transform: translateX(-0.04em);
  }
  .glitch::after {
