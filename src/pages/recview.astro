---
import BaseLayout from '@layouts/BaseLayout.astro';
import FeatureGrid from '@components/landing/FeatureGrid.astro';
import FaqAccordion from '@components/landing/FaqAccordion.astro';

const site = 'https://midgarcorp.cc';
const canonical = `${site}/recview`;
const ogImage = '/og/recview.png';
const accent = '#619EEB';

const seoTitle = 'recview — review a screen recording the second it ends';
const metaDescription =
  'A GTK4 review window that opens the moment a capture stops: scrub on the GPU, trim, crop, then export upload-ready H.264 or bin it. Built for gpu-screen-recorder on Linux.';

const githubUrl = 'https://github.com/guitaripod/recview';
const releasesUrl = 'https://github.com/guitaripod/recview/releases';
const version = '0.2.0';

const heroHighlights = [
  'Opens on its own when the recording stops',
  'Scrub rides keyframes, settles frame-exact on release',
  'Filmstrip + waveform timeline, selection loops as you refine it',
  'Exports land upload-ready — no HandBrake pass before posting',
];

const features = [
  {
    title: 'No window to go find',
    body: 'The companion rec script records a slurp-selected region or a whole monitor, and hands the file straight to recview when you stop. Nothing to open, nothing to name, nothing sitting in a folder you forget about.',
    glyph: '⏺',
  },
  {
    title: 'Scrub without waiting',
    body: 'Dragging the playhead seeks on keyframes so the picture keeps up with your hand; letting go settles on the exact frame. Playback is libmpv rendered into a GTK4 GLArea with hardware decoding, so 4K stays smooth instead of pinning a core.',
    glyph: '⇄',
  },
  {
    title: 'A timeline you can read',
    body: '40 filmstrip thumbnails and the audio waveform drawn under them, so a cut can follow the sound. Hovering pops a thumbnail and timecode. Drag the in/out handles and the selection loops sample-exactly inside mpv while you refine it.',
    glyph: '▤',
  },
  {
    title: 'Crop by dragging',
    body: 'Draw a rectangle over the video with rule-of-thirds guides, move it, or pull any corner. It maps back through the letterbox to even-numbered source pixels, because every encoder here is 4:2:0.',
    glyph: '⧉',
  },
  {
    title: 'Five ways out, all visible',
    body: 'Cut copies the selection losslessly. 9:16 renders a vertical 1080×1920. WebP makes an animated copy. ≤10 MB sizes itself for a chat box. Save re-encodes trim and crop over the original and trashes the old file. No menus — they are buttons on the surface.',
    glyph: '⇥',
  },
  {
    title: 'Upload-ready by default',
    body: 'Every MP4 preset writes H.264 High in limited-range yuv420p with AAC-LC stereo at 48 kHz and +faststart, fitted inside 4K without upscaling, and starting at timestamp zero. X accepts AV1, Opus or a late timeline and then silently fails to process it — so nothing here emits one.',
    glyph: '↑',
  },
];

const presets = [
  {
    label: 'Cut',
    detail: 'stream copy · -avoid_negative_ts make_zero · instant, keyframe-accurate in-point',
  },
  { label: '9:16', detail: 'NVENC H.264 · scale + centre crop to 1080×1920 · AAC-LC 160k' },
  { label: 'WebP', detail: 'libwebp_anim · 24 fps · 900 px wide · looping, silent' },
  {
    label: '≤10 MB',
    detail: 'NVENC H.264 CBR · bitrate solved from a 9.5 MiB budget · AAC-LC 96k',
  },
  {
    label: 'Save',
    detail: 'NVENC H.264 -cq 21 · fits inside 4K · replaces the original via trash',
  },
];

const faq = [
  {
    q: 'Do I need an NVIDIA GPU?',
    a: 'For three of the five exports, yes — Save, 9:16 and ≤10 MB encode with h264_nvenc and there is no software fallback. Cut is a stream copy and WebP goes through libwebp, so both run on any GPU. Playback uses mpv’s hwdec=auto-safe, which picks whatever your machine offers.',
  },
  {
    q: 'Does it work outside KDE and Wayland?',
    a: 'recview itself is a plain GTK4/libadwaita app and opens any file you point it at. The rec capture script is the Wayland-and-KDE part: slurp for the region picker, wl-copy for the clipboard, and kscreen-doctor to read your refresh rate (it falls back to 60fps when that is missing).',
  },
  {
    q: 'Do I need gpu-screen-recorder?',
    a: 'Only for rec. recview opens any video file — pass it a path, drop it on the desktop entry, or wire it into whatever recorder you already use.',
  },
  {
    q: 'Is ≤10 MB a guarantee?',
    a: 'It is a computed target, not an enforced ceiling: the bitrate is solved from a 9.5 MiB budget minus the audio, with a 300 kbps floor. Selections past roughly three and a half minutes hit that floor and come out larger.',
  },
  {
    q: 'Is Cut frame-exact?',
    a: 'No — it copies packets, so the in-point lands on the nearest preceding keyframe and the crop is ignored. That is the trade for an instant, generation-loss-free export. Use Save when the frame matters.',
  },
  {
    q: 'What happens to the original when I hit Save?',
    a: 'The re-encode is written first and only replaces the original after ffmpeg exits cleanly; the old file goes to the system trash. Where trashing is not supported it is kept as a -original sibling instead. Discard sends the whole recording to the trash and closes the window.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'recview',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Linux',
  description: metaDescription,
  url: canonical,
  downloadUrl: releasesUrl,
  softwareVersion: version,
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  author: {
    '@type': 'Person',
    name: 'guitaripod',
    url: site,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout title={seoTitle} description={metaDescription} image={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="py-8 sm:py-12">
    <header class="mb-12 sm:mb-16">
      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="prompt-line mb-4">rec --toggle</p>
          <h1
            class="mb-4 text-3xl font-bold tracking-tight text-paper-text dark:text-term-text sm:text-5xl"
          >
            <span class="text-paper-green dark:text-term-green">recview</span>
            <span
              class="mt-1 block text-xl font-normal text-paper-muted dark:text-term-muted sm:text-2xl"
            >
              review a screen recording the second it ends
            </span>
          </h1>
          <p class="mb-6 max-w-xl text-base text-paper-muted dark:text-term-muted sm:text-lg">
            Stop the capture and the clip is already on screen, decoded on the GPU. Scrub it, trim
            it, crop it, then keep it, export it, or send it to the trash — every action is a button
            you can see, and what comes out is ready to post.
          </p>
          <ul class="mb-8 grid max-w-xl gap-2 sm:grid-cols-2 lg:grid-cols-1">
            {
              heroHighlights.map((h) => (
                <li class="flex gap-2 text-sm text-paper-text dark:text-term-text">
                  <span class="text-paper-green dark:text-term-green" aria-hidden="true">
                    ▸
                  </span>
                  {h}
                </li>
              ))
            }
          </ul>
          <div class="flex flex-wrap gap-3">
            <a
              href={releasesUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-sm text-sm font-semibold border border-paper-green dark:border-term-green text-paper-green dark:text-term-green hover:bg-paper-green/10 dark:hover:bg-term-green/10 transition-colors"
            >
              Releases ↗
            </a>
            <a
              href={githubUrl}
              class="inline-flex items-center gap-2 px-4 py-2 rounded-sm text-sm font-semibold border border-paper-border2 dark:border-term-border2 text-paper-text dark:text-term-text hover:border-paper-green dark:hover:border-term-green transition-colors"
            >
              Source ↗
            </a>
            <a
              href="/linux"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-sm text-sm font-semibold text-paper-muted dark:text-term-muted hover:text-paper-green dark:hover:text-term-green transition-colors"
            >
              All Linux apps
            </a>
          </div>
        </div>

        <img
          src="/recview-window.png"
          width="1080"
          height="800"
          loading="eager"
          decoding="async"
          class="w-full max-w-2xl rounded-sm border border-paper-border dark:border-term-border lg:max-w-none"
          alt="The recview window: a video preview with a hover thumbnail, a filmstrip and waveform timeline with the trim selection highlighted, and a row of Discard, Cut, 9:16, WebP, ≤10 MB and Save buttons."
        />
      </div>
    </header>

    <section class="mb-12 sm:mb-16">
      <div class="term-frame p-5 sm:p-6 overflow-x-auto">
        <p class="prompt-line mb-3 text-xs sm:text-sm">install + first clip</p>
        <pre
          class="text-xs sm:text-sm leading-relaxed text-paper-text dark:text-term-text whitespace-pre-wrap"><code>cargo install recview                    # crates.io · or a binary from Releases
git clone https://github.com/guitaripod/recview
install -Dm755 recview/rec ~/.local/bin/rec   # the capture script

rec                                      # pick a region, Ctrl+C to stop
rec --toggle                             # bind this to a global shortcut
recview clip.mp4                          # or just open a file</code></pre>
      </div>
    </section>

    <section class="mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-bold mb-6 text-paper-text dark:text-term-text">
        Why recview
      </h2>
      <FeatureGrid features={features} accent={accent} />
    </section>

    <section class="mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-bold mb-4 text-paper-text dark:text-term-text">
        What each button does
      </h2>
      <div class="term-frame p-5 sm:p-6 text-sm text-paper-muted dark:text-term-muted space-y-2">
        {
          presets.map((p) => (
            <p>
              <span class="text-paper-text dark:text-term-text font-semibold">{p.label}:</span>{' '}
              {p.detail}
            </p>
          ))
        }
        <p class="pt-2">
          <span class="text-paper-text dark:text-term-text font-semibold">Every MP4:</span> H.264 High
          · yuv420p limited range · bt709 · AAC-LC 48 kHz stereo ·
          <code class="text-paper-green dark:text-term-green">+faststart</code>
        </p>
      </div>
    </section>

    <section class="mb-12 sm:mb-16">
      <h2 class="text-xl sm:text-2xl font-bold mb-4 text-paper-text dark:text-term-text">Keys</h2>
      <div class="term-frame p-5 sm:p-6 text-sm text-paper-muted dark:text-term-muted space-y-2">
        <p>
          <span class="text-paper-text dark:text-term-text font-semibold">Transport:</span> Space or
          K play · ←/→ one second · Shift+←/→ or , . one frame · J/L slower, faster
        </p>
        <p>
          <span class="text-paper-text dark:text-term-text font-semibold">Edit:</span> I / O trim to
          the playhead · C crop · R reset · M mute
        </p>
        <p>
          <span class="text-paper-text dark:text-term-text font-semibold">Out:</span> Ctrl+S or Enter
          save · P copy the frame as PNG · Ctrl+C copy the file · X or Delete discard
        </p>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-xl sm:text-2xl font-bold mb-6 text-paper-text dark:text-term-text">FAQ</h2>
      <FaqAccordion faq={faq} accent={accent} />
    </section>
  </div>
</BaseLayout>
