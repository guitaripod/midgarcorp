---
import BaseLayout from '@layouts/BaseLayout.astro';
import DeviceFrame from '@components/landing/DeviceFrame.astro';
import FeatureGrid from '@components/landing/FeatureGrid.astro';
import FaqAccordion from '@components/landing/FaqAccordion.astro';

const site = 'https://midgarcorp.cc';
const canonical = `${site}/unrager`;
const ogImage = '/og/unrager.png';
const accent = '#1D9BF0';

const seoTitle = 'unrager — a calm X on every screen';
const metaDescription =
  'A calm Twitter/X client with a local-LLM rage filter. Three faces — a Rust terminal TUI/CLI, a native iOS app, and a native macOS app — all talking to the same engine. Rage-bait is dropped before it reaches your eyes.';

const installCmd = 'curl -fsSL https://unrager.com/install.sh | bash';
const githubUrl = 'https://github.com/guitaripod/unrager';
const releasesUrl = 'https://github.com/guitaripod/unrager/releases';
const dmgUrl = 'https://github.com/guitaripod/unrager/releases/latest';

const heroHighlights = [
  'Local LLM drops rage-bait before you ever see it',
  'Three native faces, one Rust engine',
  'No API key, no cloud, no per-feed cost',
  'GPL-3.0 — your X session, your machine',
];

type Face = {
  id: string;
  glyph: string;
  name: string;
  blurb: string;
  meta: string;
  cta: { label: string; href: string }[];
  code?: { prompt: string; copy: string }[];
  note?: string;
};

const faces: Face[] = [
  {
    id: 'tui',
    glyph: '▟',
    name: 'Terminal — TUI & CLI',
    blurb:
      'A full ratatui client and a one-shot CLI in one Rust binary. Inline photos, video posters and GIF frames via the kitty graphics protocol; author-avatar chips on every row; Vim-mode composing everywhere.',
    meta: 'Rust · macOS, Linux, Windows · Ghostty / Kitty / WezTerm',
    cta: [
      { label: 'Releases ↗', href: releasesUrl },
      { label: 'Source ↗', href: githubUrl },
    ],
    code: [
      { prompt: 'curl -fsSL https://unrager.com/install.sh | bash', copy: installCmd },
      { prompt: 'cargo install unrager', copy: 'cargo install unrager' },
    ],
  },
  {
    id: 'ios',
    glyph: '◍',
    name: 'iOS — native app',
    blurb:
      'A thin UIKit client built for iOS 26 with Liquid Glass and buttery scrolling. It talks to your own `unrager serve` over Tailscale — the Rust engine does the X work, the app stays a fast native shell.',
    meta: 'Swift / UIKit · iOS 26 · Liquid Glass',
    cta: [{ label: 'How to install ↓', href: '#install-ios' }],
    note: 'Not on the App Store — the app uses your own X session. Install over Tailscale via a developer-signed build or an ad-hoc OTA link.',
  },
  {
    id: 'mac',
    glyph: '▣',
    name: 'macOS — native app',
    blurb:
      'A native AppKit app for macOS 26, sharing the iOS design language and Liquid Glass. Point it at your `unrager serve` instance on the Tailnet and read every feed from a real Mac window.',
    meta: 'Swift / AppKit · macOS 26 · Liquid Glass',
    cta: [{ label: 'Download .dmg ↗', href: dmgUrl }],
    note: 'Distributed as a notarized DMG, not on the Mac App Store. Download, drag to Applications, point it at your Tailnet.',
  },
];

const features = [
  {
    title: 'The rage filter',
    body: 'Every tweet is classified by a local Ollama model against your own rubric. Matches are physically removed — not collapsed, not greyed, gone. Verdicts cache to SQLite; edit the rubric and the cache invalidates.',
    glyph: '⊘',
  },
  {
    title: 'All your sources',
    body: 'For You, Following, lists, search, bookmarks, notifications, likes and any profile timeline. Free reads come straight from X’s own GraphQL endpoints — the same path the web client uses.',
    glyph: '❖',
  },
  {
    title: 'Threads & media',
    body: 'Split-pane reply chains with the focal tweet expanded and replies beneath. Photos, video posters and GIF frames render inline on the terminal and natively on iOS and macOS.',
    glyph: '◧',
  },
  {
    title: 'Profiles & briefs',
    body: 'Open any profile with header, follower counts and a large avatar. Ask the local LLM for a short, third-person brief of someone’s recent timeline — a dossier no other client has.',
    glyph: '◉',
  },
  {
    title: 'Compose & reply',
    body: 'Write and reply through the official X API v2 with your own registered client. Auto-likes on reply. Your identity, your rate limits — never a shared key.',
    glyph: '✎',
  },
  {
    title: 'Ask · Brief · Translate',
    body: 'One local model powers four hooks: Filter classifies, Translate rewrites foreign posts in English, Ask opens an inline chat about a post with thread context attached, and Brief profiles a timeline. Nothing leaves your machine.',
    glyph: '✶',
  },
  {
    title: 'Liquid Glass',
    body: 'The iOS and macOS apps adopt the iOS 26 / macOS 26 Liquid Glass material end to end — translucent chrome, depth and motion that feel native, not like a wrapped web view.',
    glyph: '◇',
  },
  {
    title: 'Smooth scrolling',
    body: 'Cell-image recycling and prefetch keep the native feeds gliding at 120 Hz, with avatars and media decoded off the main thread so the timeline never stutters.',
    glyph: '⇅',
  },
];

const iosShots = [
  { src: '/screenshots/unrager/ios-home.png', label: 'A calm Home feed' },
  { src: '/screenshots/unrager/ios-home-dark.png', label: 'Home in dark mode' },
  { src: '/screenshots/unrager/ios-thread.png', label: 'A thread with photos' },
  { src: '/screenshots/unrager/ios-profile.png', label: 'A profile timeline' },
  { src: '/screenshots/unrager/ios-ask.png', label: 'Ask the local LLM' },
];

const tuiShots = [
  {
    src: '/screenshots/unrager/tui-detail.png',
    label: 'Split-pane thread with inline media, rage filter ate 12',
  },
  {
    src: '/screenshots/unrager/tui-ask.png',
    label: 'Ask the local model while Vim composes underneath',
  },
  { src: '/screenshots/unrager/tui-brief.png', label: 'A streamed profile brief' },
  {
    src: '/screenshots/unrager/tui-notifications.png',
    label: 'Notifications with actor avatars',
  },
  { src: '/screenshots/unrager/tui-help.png', label: 'Every keybinding, one glyph at a time' },
];

const faq = [
  {
    q: 'Why isn’t it on the App Store?',
    a: 'unrager logs in with your own existing X session and reads from X’s own GraphQL endpoints, which is incompatible with App Store distribution policy. So the native apps are sideloaded: iOS via a developer-signed or ad-hoc OTA build, and macOS as a notarized DMG you download and drag to Applications. The terminal client installs with one curl command or `cargo install`.',
  },
  {
    q: 'How do the apps connect to my account?',
    a: 'You run `unrager serve` on a machine you control — a Mac, a Linux box, a home server. That Rust process does all the X work using your browser session and OAuth tokens. The iOS and macOS apps are thin native clients that reach the server over Tailscale, so your feeds are available anywhere without ever exposing the server to the public internet.',
  },
  {
    q: 'Is my data private?',
    a: 'Yes. Everything runs on hardware you own. The rage filter, translate, ask and brief all call a local Ollama model — no prompt, tweet or timeline ever leaves your machine. There is no unrager cloud, no analytics, and no shared API key. Reads use X’s own endpoints; writes go through the official X API v2 with a client you register yourself.',
  },
  {
    q: 'What exactly is the rage filter?',
    a: 'A local LLM classifier. You write a plain-language rubric of topics and tones you don’t want to see; for every incoming tweet, a local Ollama model returns HIDE or KEEP, and HIDE matches are removed from the feed entirely. Verdicts are cached in SQLite keyed by the tweet and a hash of your rubric, so editing the rubric re-evaluates automatically and nothing is reclassified twice. If Ollama is down, the filter quietly disables and you see an unfiltered feed.',
  },
  {
    q: 'Does it cost anything to read?',
    a: 'No. Reads go through the same GraphQL endpoints the X web client uses, authenticated with your existing browser session — no developer API key, no paid tier, no per-feed cost. Only posting and replying use the official X API v2, with your own registered client and your own rate limits.',
  },
  {
    q: 'Which platforms are supported?',
    a: 'The terminal TUI and CLI run on macOS, Linux and Windows. The native apps target iOS 26 and macOS 26. Inline terminal media needs a kitty-graphics terminal such as Ghostty, Kitty or WezTerm; elsewhere it falls back to glyph placeholders.',
  },
];

const allShots = [...iosShots, ...tuiShots].map((s) => site + s.src);

const softwareApp = {
  '@type': 'SoftwareApplication',
  name: 'unrager',
  operatingSystem: 'iOS, macOS, Linux, Windows',
  applicationCategory: 'SocialNetworkingApplication',
  description: metaDescription,
  url: canonical,
  downloadUrl: githubUrl,
  image: site + ogImage,
  screenshot: allShots,
  programmingLanguage: ['Rust', 'Swift'],
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  author: { '@type': 'Organization', name: 'Midgar Oy', url: site },
  publisher: { '@type': 'Organization', name: 'Midgar Oy', url: site },
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'unrager', item: canonical },
  ],
};

const faqPage = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const jsonLd = { '@context': 'https://schema.org', '@graph': [softwareApp, breadcrumb, faqPage] };
---

<BaseLayout title={seoTitle} description={metaDescription} image={ogImage}>
  <div style={`--accent:${accent}`}>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="pt-8 text-xs text-paper-faint dark:text-term-faint">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">unrager</li>
      </ol>
    </nav>

    <!-- Hero -->
    <header
      class="grid grid-cols-1 items-center gap-10 py-10 sm:py-14 lg:grid-cols-[1.08fr_0.92fr] lg:gap-12"
    >
      <div>
        <p class="prompt-line mb-5">./unrager</p>

        <h1
          class="wordmark mb-3 text-5xl font-bold tracking-tight text-paper-text dark:text-term-text sm:text-6xl"
        >
          unrager<span class="cursor-blink" aria-hidden="true"></span>
        </h1>
        <p
          class="mb-4 text-2xl font-bold leading-tight tracking-tight text-paper-text dark:text-term-text sm:text-3xl"
        >
          A calm X, <span class="accent-text">on every screen.</span>
        </p>
        <p
          class="mb-6 max-w-xl text-base leading-relaxed text-paper-muted dark:text-term-muted sm:text-lg"
        >
          A Twitter/X client with a local-LLM rage filter. Rage-bait is dropped before it ever
          reaches your eyes. One Rust engine, three native faces — a terminal TUI, an iOS app, and a
          macOS app.
        </p>

        <!-- platform chips -->
        <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <span class="font-semibold text-paper-amber dark:text-term-amber">GPL-3.0</span>
          <span class="text-paper-faint dark:text-term-faint">free &amp; open source</span>
          <span class="flex flex-wrap gap-1.5">
            {
              ['Terminal', 'iOS', 'macOS'].map((p) => (
                <span class="rounded-sm border border-paper-border px-1.5 py-0.5 text-xs text-paper-faint dark:border-term-border dark:text-term-faint">
                  {p}
                </span>
              ))
            }
          </span>
        </div>

        <!-- install command -->
        <div class="mb-6 max-w-xl">
          <div
            class="term-frame flex items-center justify-between gap-3 px-3 py-2.5 font-mono text-sm"
          >
            <code class="truncate text-paper-text dark:text-term-text">
              <span class="accent-text">$</span> curl -fsSL <span
                class="text-paper-green dark:text-term-green">unrager.com/install.sh</span
              > | bash
            </code>
            <button
              type="button"
              class="copy-cmd shrink-0 rounded-sm border border-paper-border px-2 py-1 text-xs text-paper-muted transition-colors hover:border-paper-border2 hover:text-paper-text dark:border-term-border dark:text-term-muted dark:hover:border-term-border2 dark:hover:text-term-text"
              data-copy={installCmd}
              aria-label="Copy install command"
            >
              <span class="copy-glyph">⧉</span>
            </button>
          </div>
          <p class="mt-2 text-xs text-paper-faint dark:text-term-faint">
            macOS &amp; Linux · or <code
              class="rounded-sm bg-paper-raised px-1 py-0.5 dark:bg-term-raised"
              >cargo install unrager</code
            >
          </p>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-sm bg-paper-green px-4 py-2.5 text-sm font-bold text-paper-bg transition-opacity hover:opacity-90 dark:bg-term-green dark:text-term-bg"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            View on GitHub
          </a>
          <a
            href="#screenshots"
            class="accent-btn inline-flex items-center gap-2 rounded-sm border px-4 py-2.5 text-sm font-semibold transition-colors"
          >
            See it in action ↓
          </a>
        </div>

        <!-- highlights -->
        <ul class="mt-7 grid gap-2">
          {
            heroHighlights.map((h) => (
              <li class="flex items-start gap-2 text-sm text-paper-text dark:text-term-text">
                <span class="accent-text mt-0.5 shrink-0" aria-hidden="true">
                  ▸
                </span>
                <span>{h}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- hero screenshot -->
      <div class="flex justify-center lg:justify-end">
        <div class="device-glow h-[460px] sm:h-[560px]" style={`--accent:${accent}`}>
          <DeviceFrame
            device="iphone"
            src="/screenshots/unrager/ios-home.png"
            w={1206}
            h={2622}
            alt="unrager on iPhone — a calm Home feed with the rage filter on"
            eager={true}
          />
        </div>
      </div>
    </header>

    <!-- The three faces -->
    <section
      id="install"
      class="scroll-mt-20 border-t border-paper-border py-12 dark:border-term-border sm:py-16"
    >
      <p class="prompt-line mb-3">ls unrager/faces</p>
      <h2 class="mb-2 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
        Three faces, <span class="accent-text">one engine</span>
      </h2>
      <p class="mb-8 max-w-2xl text-sm text-paper-muted dark:text-term-muted">
        Every face talks to the same Rust core. Pick the terminal, the phone, the Mac — or all three
        at once.
      </p>

      <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
        {
          faces.map((face) => (
            <article
              id={`install-${face.id}`}
              class="term-frame term-frame-hover scroll-mt-20 flex flex-col gap-4 p-6"
            >
              <div class="flex items-center gap-3">
                <span
                  class="face-glyph inline-flex h-10 w-10 items-center justify-center rounded-sm text-xl"
                  aria-hidden="true"
                >
                  {face.glyph}
                </span>
                <h3 class="text-base font-bold text-paper-text dark:text-term-text">{face.name}</h3>
              </div>
              <p class="text-sm leading-relaxed text-paper-muted dark:text-term-muted">
                {face.blurb}
              </p>
              <p class="text-xs text-paper-faint dark:text-term-faint">{face.meta}</p>

              {face.code && (
                <div class="flex flex-col gap-2">
                  {face.code.map((line) => (
                    <div class="flex items-center justify-between gap-2 rounded-sm border border-paper-border bg-paper-raised px-2.5 py-2 font-mono text-xs dark:border-term-border dark:bg-term-raised">
                      <code class="truncate text-paper-text dark:text-term-text">
                        <span class="accent-text">$</span> {line.prompt}
                      </code>
                      <button
                        type="button"
                        class="copy-cmd shrink-0 text-paper-muted transition-colors hover:text-paper-text dark:text-term-muted dark:hover:text-term-text"
                        data-copy={line.copy}
                        aria-label="Copy command"
                      >
                        <span class="copy-glyph">⧉</span>
                      </button>
                    </div>
                  ))}
                </div>
              )}

              {face.note && (
                <p class="rounded-sm border border-paper-border bg-paper-raised p-3 text-xs leading-relaxed text-paper-muted dark:border-term-border dark:bg-term-raised dark:text-term-muted">
                  {face.note}
                </p>
              )}

              <div class="mt-auto flex flex-wrap gap-3 pt-1">
                {face.cta.map((c) => (
                  <a
                    href={c.href}
                    {...(c.href.startsWith('http')
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                    class="accent-btn inline-flex items-center gap-1.5 rounded-sm border px-3 py-1.5 text-xs font-semibold transition-colors"
                  >
                    {c.label}
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Features -->
    <section
      id="features"
      class="scroll-mt-20 border-t border-paper-border py-12 dark:border-term-border sm:py-16"
    >
      <p class="prompt-line mb-3">cat unrager/FEATURES.md</p>
      <h2 class="mb-2 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
        What <span class="accent-text">unrager</span> does
      </h2>
      <p class="mb-8 max-w-2xl text-sm text-paper-muted dark:text-term-muted">
        A complete X client where the timeline is yours to shape — and the only model that ever sees
        your feed runs on your own machine.
      </p>
      <FeatureGrid features={features} accent={accent} />
    </section>

    <!-- Screenshots -->
    <section
      id="screenshots"
      class="scroll-mt-20 border-t border-paper-border py-12 dark:border-term-border sm:py-16"
    >
      <p class="prompt-line mb-3">./unrager --screenshots</p>
      <h2 class="mb-8 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
        unrager <span class="accent-text">in action</span>
      </h2>

      <!-- iOS -->
      <h3
        class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-paper-muted dark:text-term-muted"
      >
        On iPhone
      </h3>
      <ul
        class="no-scrollbar mb-12 flex h-[480px] snap-x snap-mandatory gap-5 overflow-x-auto pb-4 sm:h-[560px]"
      >
        {
          iosShots.map((shot, i) => (
            <li class="flex h-full shrink-0 snap-start flex-col items-center gap-3">
              <div class="h-[calc(100%-2rem)]" style={`--accent:${accent}`}>
                <div class="device-glow h-full">
                  <DeviceFrame
                    device="iphone"
                    src={shot.src}
                    w={1206}
                    h={2622}
                    alt={`unrager on iPhone — ${shot.label}`}
                    eager={i === 0}
                  />
                </div>
              </div>
              <p class="max-w-[16rem] text-center text-xs text-paper-muted dark:text-term-muted">
                {shot.label}
              </p>
            </li>
          ))
        }
      </ul>

      <!-- Terminal -->
      <h3
        class="mb-4 text-sm font-bold uppercase tracking-[0.16em] text-paper-muted dark:text-term-muted"
      >
        In the terminal
      </h3>
      <ul class="no-scrollbar flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4">
        {
          tuiShots.map((shot) => (
            <li class="flex w-[88vw] shrink-0 snap-start flex-col gap-3 sm:w-[640px]">
              <div class="device-glow term-frame overflow-hidden" style={`--accent:${accent}`}>
                <img
                  src={shot.src}
                  width={3600}
                  height={2120}
                  loading="lazy"
                  decoding="async"
                  alt={`unrager in the terminal — ${shot.label}`}
                  class="block h-auto w-full"
                />
              </div>
              <p class="text-center text-xs text-paper-muted dark:text-term-muted">{shot.label}</p>
            </li>
          ))
        }
      </ul>

      <p class="mt-2 text-center text-xs text-paper-faint dark:text-term-faint sm:hidden">
        swipe to see more →
      </p>
    </section>

    <!-- How it connects -->
    <section class="border-t border-paper-border py-12 dark:border-term-border sm:py-16">
      <p class="prompt-line mb-3">man unrager</p>
      <h2 class="mb-8 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
        How <span class="accent-text">unrager</span> connects
      </h2>
      <ol class="grid gap-5 sm:grid-cols-3">
        {
          [
            {
              step: 'Run the engine',
              body: 'Start `unrager serve` on a machine you own. It reads X over its own GraphQL endpoints using your browser session, and runs the rage filter through a local Ollama model.',
            },
            {
              step: 'Join the Tailnet',
              body: 'Put the server and your devices on the same Tailscale network. Your feeds are reachable anywhere, with nothing exposed to the public internet.',
            },
            {
              step: 'Pick a face',
              body: 'Open the terminal client, the iOS app, or the macOS app. Each is a thin native shell over the same engine, so the filtered feed looks identical everywhere.',
            },
          ].map((s, i) => (
            <li class="term-frame relative flex flex-col gap-2 p-5">
              <span
                class="accent-text font-mono text-sm font-bold"
                aria-hidden="true"
              >{`0${i + 1}`}</span>
              <h3 class="text-base font-bold text-paper-text dark:text-term-text">{s.step}</h3>
              <p class="text-sm leading-relaxed text-paper-muted dark:text-term-muted">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- FAQ -->
    <section
      id="faq"
      class="scroll-mt-20 border-t border-paper-border py-12 dark:border-term-border sm:py-16"
    >
      <p class="prompt-line mb-3">./unrager --faq</p>
      <h2 class="mb-8 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
        Frequently asked <span class="accent-text">questions</span>
      </h2>
      <div class="max-w-3xl">
