  <script is:inline>
    document.querySelectorAll('.copy-cmd').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy);
          const g = btn.querySelector('.copy-glyph');
          const prev = g.textContent;
          g.textContent = '✓';
          btn.classList.add('ok');
          setTimeout(() => {
            g.textContent = prev;
            btn.classList.remove('ok');
          }, 1200);
        } catch (_) {
          /* noop */
        }
      });
    });

    (async () => {
      const stat = document.getElementById('unrager-stat');
      const trigger = document.getElementById('unrager-stat-trigger');
      const pop = document.getElementById('unrager-downloads-popover');
      if (!stat || !trigger || !pop) return;
      const show = () => {
        pop.classList.add('visible', 'opacity-100', 'translate-y-0');
        pop.classList.remove('invisible', 'opacity-0', 'translate-y-1');
        trigger.setAttribute('aria-expanded', 'true');
      };
      const hide = () => {
        pop.classList.remove('visible', 'opacity-100', 'translate-y-0');
        pop.classList.add('invisible', 'opacity-0', 'translate-y-1');
        trigger.setAttribute('aria-expanded', 'false');
      };
      stat.addEventListener('mouseenter', show);
      stat.addEventListener('mouseleave', hide);
      trigger.addEventListener('focus', show);
      trigger.addEventListener('blur', hide);
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        pop.classList.contains('visible') ? hide() : show();
      });
      document.addEventListener('click', hide);

      try {
        const r = await fetch('https://unrager.com/api/downloads', {
          headers: { Accept: 'application/json' },
        });
        if (!r.ok) return;
        const d = await r.json();
        if (typeof d.total !== 'number' || d.total <= 0) return;
        const fmt = (n) => (typeof n === 'number' ? n.toLocaleString('en-US') : '—');
        document.getElementById('dl-crates').textContent = fmt(d.sources?.crates_io?.count);
        document.getElementById('dl-gh').textContent = fmt(d.sources?.github_releases?.count);
        const when = document.getElementById('dl-updated');
        if (when && d.updated_at) {
          const t = (Date.now() - new Date(d.updated_at).getTime()) / 1000;
          when.textContent =
            !isFinite(t) || t < 60
              ? 'just now'
              : t < 3600
                ? `${Math.round(t / 60)} min ago`
                : t < 86400
                  ? `${Math.round(t / 3600)} hr ago`
                  : `${Math.round(t / 86400)} day${Math.round(t / 86400) === 1 ? '' : 's'} ago`;
        }
        stat.hidden = false;

        const countEl = document.getElementById('install-count');
        const target = d.total;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          countEl.textContent = fmt(target);
        } else {
          countEl.textContent = '0';
          const duration = Math.min(1200, 400 + target * 2);
          const startT = performance.now();
          const ease = (t) => 1 - Math.pow(1 - t, 3);
          const tick = (now) => {
            const t = Math.min(1, (now - startT) / duration);
            countEl.textContent = fmt(Math.round(target * ease(t)));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      } catch (_) {
        /* noop */
      }
    })();
  </script>
