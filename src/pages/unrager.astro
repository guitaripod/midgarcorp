---
import BaseLayout from '@layouts/BaseLayout.astro';
import FeatureGrid from '@components/landing/FeatureGrid.astro';
import FaqAccordion from '@components/landing/FaqAccordion.astro';
import UnragerArchitecture from '@components/landing/UnragerArchitecture.astro';
import UnragerTimeline from '@components/landing/UnragerTimeline.astro';
import UnragerPopup from '@components/landing/UnragerPopup.astro';
import UnragerTerminal from '@components/landing/UnragerTerminal.astro';
import UnragerPhones from '@components/landing/UnragerPhones.astro';

const site = 'https://midgarcorp.cc';
const canonical = `${site}/unrager`;
const ogImage = '/og/unrager.png';
const accent = '#1D9BF0';

const seoTitle = 'unrager — keep x.com, lose the rage';
const metaDescription =
  'A browser extension that takes the rage-bait out of your x.com timeline, judged by a model on your own computer. Free, open source, and nothing leaves your machine.';

const installCmd = 'curl -fsSL https://unrager.com/install.sh | bash';
const modelCmd = 'ollama pull hf.co/guitaripod/unrager-4b:Q4_K_M';
const hfModelUrl = 'https://huggingface.co/guitaripod/unrager-4b';
const pirateModelUrl = 'https://pirateface.co/guitaripod/unrager-4b';
const modelStats = [
  {
    value: '1 in 31',
    label: 'good posts hidden',
    note: 'the Qwen3 4B it replaced hid 1 in 24, a 26B model 1 in 15',
  },
  {
    value: '3 in 4',
    label: 'rage posts caught',
    note: 'on 1,049 real posts, scored by hand; the Qwen3 4B caught 3 in 5',
  },
  { value: '2.7 GB', label: 'to download', note: 'Q4_K_M, 4.5 GB at Q8_0, runs on a laptop' },
];
const githubUrl = 'https://github.com/guitaripod/unrager';
const releasesUrl = 'https://github.com/guitaripod/unrager/releases';

const heroHighlights = [
  'Tested on 1,049 real posts: about 3 in 4 rage posts gone, about 1 good post in 31 hidden by mistake',
  'Every hidden post says which rule caught it, and one click brings it back',
  'A small 2.7 GB model, unrager-4b, on your own computer; bigger ones hide more of what you wanted',
  'No account, no cloud; your feed never leaves your machine',
];

type Step = {
  title: string;
  body: string;
  code?: { prompt: string; copy: string }[];
  list?: string[];
  note?: string;
};

const steps: Step[] = [
  {
    title: 'Run a model',
    body: 'Install Ollama from ollama.com, then pull the default model, unrager-4b. It’s 2.7 GB, made for this filter, and judges a post in a fraction of a second.',
    code: [{ prompt: modelCmd, copy: modelCmd }],
    note: 'Already running LM Studio, vLLM, llama.cpp or SGLang? Skip this: step 2 finds it and prints the lines to put in filter.toml.',
  },
  {
    title: 'Install unrager',
    body: 'One program for macOS and Linux. The script runs `unrager setup` for you: it checks that your model answers, starts unrager in the background so it comes back after a restart, and unpacks the extension.',
    code: [
      { prompt: installCmd, copy: installCmd },
      {
        prompt: 'cargo install unrager && unrager setup',
        copy: 'cargo install unrager && unrager setup',
      },
    ],
  },
  {
    title: 'Add the extension',
    body: 'In Chrome, Brave, Edge, Vivaldi or Arc:',
    list: [
      'Open `chrome://extensions`.',
      'Turn on Developer mode.',
      'Click Load unpacked and pick the folder `unrager setup` printed.',
    ],
    note: 'Then open x.com. Posts that match your rules never show up in For you and Following, and the unrager icon counts the ones it hid.',
  },
];

const features = [
  {
    title: 'Not interested, in one click',
    body: 'On For you, a frown next to X’s Grok button does what Not interested in this post does, without opening the menu. X gets the same feedback and shows you fewer posts like it.',
    glyph: '☹',
  },
  {
    title: 'Says why',
    body: 'Every hidden post names the rule it broke. Turn on Show hidden posts and they come back dimmed, each labelled “Hidden: war”, “Hidden: engagement farming”.',
    glyph: '⊘',
  },
  {
    title: 'You overrule it',
    body: 'Show this post brings one back for good; right-click any post on Home to hide it by hand. Your call outranks the model in every client and survives rule changes.',
    glyph: '✎',
  },
  {
    title: 'As strict as you like',
    body: 'Relaxed, Balanced or Strict, and a count of what each rule hid since you last changed them, so the rule that hides too much stands out.',
    glyph: '◐',
  },
  {
    title: 'Your posts stay',
    body: 'Your own posts, retweets of them and the conversations you replied in are never hidden. Profiles, threads and search are never filtered: you went looking.',
    glyph: '◉',
  },
  {
    title: 'Any local model',
    body: 'unrager-4b on Ollama by default, or anything with an OpenAI-compatible API: LM Studio, vLLM, llama.cpp, SGLang, llama-swap. unrager eval scores yours on about 200 made-up posts.',
    glyph: '⚙',
  },
  {
    title: 'Private by default',
    body: 'Posts go to unrager on localhost and to your model, nowhere else. No account, no telemetry, and the server refuses requests from web pages.',
    glyph: '◇',
  },
  {
    title: 'Fails open',
    body: 'If your model is off or slow, X works as usual: a new post shows after a couple of seconds, a failed check is never remembered, and the badge says what to fix.',
    glyph: '⇄',
  },
  {
    title: 'Measured, not guessed',
    body: 'Tested on 1,049 real posts from one feed, the default model takes out about three in four rage posts and hides about one good post in 31. A good post hidden counts as the worse mistake, because you never see it, and every change to the prompt is scored on both before it ships.',
    glyph: '≋',
  },
];

const phoneShots = [
  {
    src: '/unrager/iphone-home.webp',
    alt: 'The unrager iPhone app on For you: a hiking photo from Field Notes with a Norwegian flag by the name, and below it a post by Mira Koski marked Kit Wren reposted. The Notifications tab carries a small blue badge.',
    caption: 'For you, a country flag on every author and the whole post behind a repost.',
  },
  {
    src: '/unrager/iphone-hidden.webp',
    alt: 'A list titled Hidden posts: three posts, each headed by the rule that hid it (culture-war threads, outrage bait, engagement bait) with a Show button beside it.',
    caption: 'What the filter hid, each post under the rule that caught it. Show brings one back.',
  },
  {
    src: '/unrager/iphone-thread.webp',
    alt: 'A thread in the iPhone app: an illustration post with two options and, under it, replies nested under the replies they answer.',
    caption: 'Threads with replies under their parents, and who quoted a post.',
  },
  {
    src: '/unrager/iphone-profile.webp',
    alt: 'A profile in the iPhone app: a header image, the name Mira Koski with a verified badge, a bio with a tappable mention and link, location and join date, follower counts and a pinned post.',
    caption: 'Profiles with bio, location, join date and the pinned post, plus Mute and Block.',
  },
  {
    src: '/unrager/iphone-ask.webp',
    alt: 'A sheet titled Explain over a post, with an answer from the local model streaming in about why the sky is blue.',
    caption: 'Ask, Brief and Translate stream from your own model.',
  },
  {
    src: '/unrager/iphone-notifications.webp',
    alt: 'The Notifications tab: grouped likes, follows, replies and a mention, with the people behind each as stacked avatars.',
    caption: 'Notifications grouped by who did what, with a calm unread badge on the tab.',
  },
];

const phoneNotes = [
  {
    title: 'Hidden, not gone',
    body: 'Every post the filter hides is listed with the rule that caught it and a Show button. Your rules and strictness are editable on the phone too.',
  },
  {
    title: 'Your model on tap',
    body: 'Ask about a post, Brief an account, Translate a reply. The answer streams from the model on your computer, and you can stop it, retry it or read along.',
  },
  {
    title: 'A real X client',
    body: 'Threads, profiles, search, notifications, drafts, quotes, Mute and Block, and deleting your own posts. A repost shows the whole original, and links to x.com open in the app.',
  },
  {
    title: 'Made for iOS 26',
    body: 'Liquid Glass tabs, Dynamic Type up to the largest sizes, and every post a single VoiceOver stop with actions.',
  },
];

const phoneSteps = [
  {
    title: 'Start the server for the app',
    body: 'On the computer that runs unrager, signed in to x.com in your browser. It prints the address the app needs. Keep it on a private network such as Tailscale: unrager has no login of its own.',
    code: ['unrager setup --apps --bind 0.0.0.0:7777'],
  },
  {
    title: 'Build it and put it on your phone',
    body: 'On a Mac with Xcode 26, after `brew install xcodegen`, signed in to your Apple ID under Xcode > Settings > Accounts, with the phone plugged in, unlocked and trusted, and Developer Mode on. The script finds your phone and signing team, and asks for the address from step 1.',
    code: [
      'git clone https://github.com/guitaripod/unrager',
      'cd unrager/ios && ./scripts/install.sh',
    ],
  },
  {
    title: 'Trust it and open it',
    body: 'On the phone: Settings > General > VPN & Device Management > your Apple ID > Trust, then open Unrager and allow the local network. A free Apple ID’s build stops opening after 7 days; run the script again to renew it.',
  },
];

const faq = [
  {
    q: 'How accurate is it?',
    a: 'Good, not perfect. Tested on 1,049 real posts from one person’s feed, judged against their own rules, the default model took out about three in four rage posts and hid about one good post in 31. Nothing it hides is gone: turn on Show hidden posts to see each one with the rule that caught it, and one click brings it back for good.',
  },
  {
    q: 'Does anything leave my computer?',
    a: 'No. The extension hands posts to unrager on localhost, and unrager hands them to your model. There’s no account and no telemetry. The background server that setup installs never reads your X login and never talks to X, and it refuses requests from web pages, so a site you visit can’t use it.',
  },
  {
    q: 'What if my model is off, or slow?',
    a: 'X works as usual. unrager fails open: a new post waits a couple of seconds for its verdict and then shows anyway, a failed check is never remembered, and unrager asks again shortly. The toolbar badge shows ! while posts can’t be checked, and the popup says what to run.',
  },
  {
    q: 'Which models work?',
    a: 'The default is unrager-4b on Ollama, and it’s small on purpose: on 1,049 real posts it hid about one good post in 31, where a 26B model hid one in 15. It is 2.7 GB, loads in about two seconds and stays loaded. Any instruction-tuned model that can answer HIDE or KEEP will do, served by Ollama or anything that speaks the OpenAI chat API. unrager eval tells you how well yours filters.',
  },
  {
    q: 'What is unrager-4b?',
    a: 'Qwen3.5-4B fine-tuned for this filter on about 7,400 posts from one feed, labelled against unrager’s default rules by a 26B model and a second model that had to agree. On 1,049 real posts it hid about one good post in 31 and caught about three in four rage posts, where the Qwen3 4B it replaced hid one in 24 and caught three in five. It is Apache 2.0, and its weights, GGUFs and prompt are on Hugging Face and as a torrent on Pirate Face. It is tuned to the default rules; with rules of your own it still follows them, so check it with unrager eval.',
  },
  {
    q: 'Can the model run on a different computer?',
    a: 'Yes. Run unrager setup --bind 0.0.0.0:7777 on the machine with the GPU, then enter its address under Settings in the extension’s popup. Keep that to a private network such as Tailscale: unrager has no login of its own.',
  },
  {
    q: 'Which browsers and systems?',
    a: 'Chromium browsers (Chrome, Brave, Edge, Vivaldi, Arc) on macOS and Linux. Firefox, Safari and Windows aren’t supported yet.',
  },
  {
    q: 'Is there an iPhone app?',
    a: 'Yes, but you build it yourself, once. X’s own iPhone app can’t run extensions, so unrager has a native client that talks to unrager on your computer: the same filter, with every hidden post listed under its rule, plus Ask, Brief and Translate on your model. It uses your X session, so it isn’t on the App Store: on a Mac with Xcode, one script builds it with your own (free) Apple ID and installs it on your phone, and it reaches your computer over a private network such as Tailscale.',
  },
  {
    q: 'Where do the country flags in the iPhone app come from?',
    a: 'From X’s own About this account lookup, asked one author at a time. When X rate-limits it, put community_cache = true under [about] in config.toml and unrager asks the X-Posed community cache first, in one request for everyone on screen. That sends the handles you are looking at to a third-party service and nothing else, which is why it is off by default.',
  },
  {
    q: 'Why load it unpacked instead of from the Chrome Web Store?',
    a: 'It isn’t listed yet. Loading it unpacked takes three clicks once; after that, unrager update keeps it current and the toolbar icon shows ↑ until you reload it.',
  },
  {
    q: 'Does it filter replies, search and profiles too?',
    a: 'No, only your Home timeline, For you and Following. When you open a profile, a thread or a search, you went looking, so you see all of it.',
  },
  {
    q: 'Does it cost anything?',
    a: 'No. unrager is free and open source under the GPL-3.0, and it runs on hardware you own: no API key, no subscription, no per-post cost.',
  },
];

const softwareApp = {
  '@type': 'SoftwareApplication',
  name: 'unrager',
  operatingSystem: 'macOS, Linux',
  applicationCategory: 'BrowserApplication',
  description: metaDescription,
  url: canonical,
  downloadUrl: githubUrl,
  image: site + ogImage,
  programmingLanguage: ['Rust', 'JavaScript'],
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'Midgar Oy', url: site },
  publisher: { '@type': 'Organization', name: 'Midgar Oy', url: site },
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'unrager', item: canonical },
  ],
};

const faqPage = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const jsonLd = { '@context': 'https://schema.org', '@graph': [softwareApp, breadcrumb, faqPage] };

/** Renders `code` spans in copy that's otherwise plain text. */
const withCode = (text: string) =>
  text
    .split(/(`[^`]+`)/)
    .map((part) =>
      part.startsWith('`')
        ? `<code class="rounded-sm bg-paper-raised px-1 py-0.5 text-paper-text dark:bg-term-raised dark:text-term-text">${part.slice(1, -1)}</code>`
        : part
    )
    .join('');
---

<BaseLayout title={seoTitle} description={metaDescription} image={ogImage}>
  <div style={`--accent:${accent}`}>
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="pt-8 text-xs text-paper-faint dark:text-term-faint">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">unrager</li>
      </ol>
    </nav>

    <!-- Hero -->
    <header
      class="grid grid-cols-1 items-center gap-10 py-10 sm:py-14 lg:grid-cols-[1fr_1fr] lg:gap-12"
    >
      <div>
        <p class="prompt-line mb-5">./unrager</p>

        <h1
          class="wordmark mb-3 text-5xl font-bold tracking-tight text-paper-text dark:text-term-text sm:text-6xl"
        >
          unrager<span class="cursor-blink" aria-hidden="true"></span>
        </h1>
        <p
          class="mb-4 text-2xl font-bold leading-tight tracking-tight text-paper-text dark:text-term-text sm:text-3xl"
        >
          Keep x.com. <span class="accent-text">Lose the rage.</span>
        </p>
        <p
          class="mb-6 max-w-xl text-base leading-relaxed text-paper-muted dark:text-term-muted sm:text-lg"
        >
          A browser extension for the x.com you already use. A small model on your own computer
          reads each post before X shows it and hides the rage bait, the dunking and the doom. You
          can see what it hid and why, and one click brings a post back.
        </p>

        <!-- platform chips -->
        <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <span class="font-semibold text-paper-amber dark:text-term-amber">GPL-3.0</span>
          <span class="text-paper-faint dark:text-term-faint">free &amp; open source</span>
          <span class="flex flex-wrap gap-1.5">
            {
              ['Chrome', 'Brave', 'Edge', 'Vivaldi', 'Arc'].map((p) => (
                <span class="rounded-sm border border-paper-border px-1.5 py-0.5 text-xs text-paper-faint dark:border-term-border dark:text-term-faint">
                  {p}
                </span>
              ))
            }
          </span>
        </div>

        <!-- install command -->
        <div class="mb-6 max-w-xl">
          <div
            class="term-frame flex items-center justify-between gap-3 px-3 py-2.5 font-mono text-sm"
          >
            <code class="truncate text-paper-text dark:text-term-text">
              <span class="accent-text">$</span> curl -fsSL <span
                class="text-paper-green dark:text-term-green">unrager.com/install.sh</span
              > | bash
            </code>
            <button
              type="button"
              class="copy-cmd shrink-0 rounded-sm border border-paper-border px-2 py-1 text-xs text-paper-muted transition-colors hover:border-paper-border2 hover:text-paper-text dark:border-term-border dark:text-term-muted dark:hover:border-term-border2 dark:hover:text-term-text"
              data-copy={installCmd}
              aria-label="Copy install command"
            >
              <span class="copy-glyph">⧉</span>
            </button>
          </div>
          <p class="mt-2 text-xs text-paper-faint dark:text-term-faint">
            macOS &amp; Linux · then <a
              href="#install"
              class="underline decoration-dotted underline-offset-2 hover:text-paper-green dark:hover:text-term-green"
              >add the extension</a
            >, three clicks · <a
              href="#iphone"
              class="underline decoration-dotted underline-offset-2 hover:text-paper-green dark:hover:text-term-green"
              >iPhone app</a
            >
          </p>
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="#install"
            class="inline-flex items-center gap-2 rounded-sm bg-paper-green px-4 py-2.5 text-sm font-bold text-paper-bg transition-opacity hover:opacity-90 dark:bg-term-green dark:text-term-bg"
          >
            Install it ↓
          </a>
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="accent-btn inline-flex items-center gap-2 rounded-sm border px-4 py-2.5 text-sm font-semibold transition-colors"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
            Source on GitHub
          </a>
        </div>

        <!-- downloads counter — reuses unrager.com's CORS-enabled /api/downloads -->
        <div id="unrager-stat" class="relative mt-5 inline-block text-xs" hidden>
          <button
            type="button"
            id="unrager-stat-trigger"
            class="inline-flex cursor-help items-center gap-1.5 rounded-md px-2 py-1 text-paper-muted transition-colors hover:bg-paper-raised hover:text-paper-text dark:text-term-muted dark:hover:bg-term-raised dark:hover:text-term-text"
            aria-expanded="false"
            aria-controls="unrager-downloads-popover"
          >
            <strong id="install-count" class="accent-text font-semibold tabular-nums">—</strong>
            <span class="border-b border-dotted border-current opacity-90">downloads</span>
          </button>
          <div
            id="unrager-downloads-popover"
            role="tooltip"
            class="invisible absolute bottom-[calc(100%+12px)] left-0 z-20 w-max max-w-xs translate-y-1 rounded-lg border border-paper-border bg-paper-raised p-3.5 text-left opacity-0 shadow-2xl transition-all duration-150 dark:border-term-border dark:bg-term-raised"
          >
            <p class="accent-text mb-1.5 text-[0.62rem] font-bold uppercase tracking-[0.14em]">
              what this counts
            </p>
            <p class="text-[0.72rem] leading-relaxed text-paper-muted dark:text-term-muted">
              HTTP requests that fetched the binary, not unique people. Updating with <code
                class="rounded-sm bg-paper-bg px-1 text-paper-text dark:bg-term-bg dark:text-term-text"
                >unrager update</code
              > or re-running the install script counts again.
            </p>
            <div
              class="mt-2.5 flex flex-col gap-1 text-[0.72rem] text-paper-muted dark:text-term-muted"
            >
              <div class="flex items-center justify-between gap-8">
                <span>crates.io</span>
                <span id="dl-crates" class="tabular-nums text-paper-text dark:text-term-text"
                  >—</span
                >
              </div>
              <div class="flex items-center justify-between gap-8">
                <span>GitHub releases</span>
                <span id="dl-gh" class="tabular-nums text-paper-text dark:text-term-text">—</span>
              </div>
            </div>
            <div
              class="mt-2.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-t border-paper-border pt-2 text-[0.62rem] text-paper-faint dark:border-term-border dark:text-term-faint"
            >
              <span>tarballs only · SHA256SUMS excluded</span>
              <span>updated <span id="dl-updated">just now</span></span>
            </div>
          </div>
        </div>

        <!-- highlights -->
        <ul class="mt-7 grid gap-2">
          {
            heroHighlights.map((h) => (
              <li class="flex items-start gap-2 text-sm text-paper-text dark:text-term-text">
                <span class="accent-text mt-0.5 shrink-0" aria-hidden="true">
                  ▸
                </span>
                <span>{h}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- hero demo -->
      <div class="min-w-0">
        <UnragerTimeline />
      </div>
    </header>

    <!-- How it works -->
    <section
      id="how-it-works"
      class="scroll-mt-20 border-t border-paper-border py-12 dark:border-term-border sm:py-16"
    >
      <p class="prompt-line mb-3">./unrager --how-it-works</p>
      <h2 class="mb-2 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
        How <span class="accent-text">unrager</span> works
      </h2>
      <p class="mb-8 max-w-2xl text-sm text-paper-muted dark:text-term-muted">
        It only reads what X already sends your browser and never asks X for anything else. The
        judging happens on your computer, before the page shows the post.
      </p>
      <UnragerArchitecture accent={accent} />
    </section>

    <!-- Install -->
    <section
      id="install"
      class="scroll-mt-20 border-t border-paper-border py-12 dark:border-term-border sm:py-16"
    >
      <p class="prompt-line mb-3">./unrager --install</p>
      <h2 class="mb-2 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
