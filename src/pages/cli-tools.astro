---
import BaseLayout from '@layouts/BaseLayout.astro';
import CLIAppCard from '@components/CLIAppCard.astro';
import openSourceData from '../data/opensource.json';

const extraCLIIds = ['weavex'];
const cliTools = openSourceData.projects
  .filter((project) => project.category === 'CLI Tools' || extraCLIIds.includes(project.id))
  .sort((a, b) => {
    if (b.stars !== a.stars) return b.stars - a.stars;
    const dateA = a.updatedAt ? new Date(a.updatedAt).getTime() : 0;
    const dateB = b.updatedAt ? new Date(b.updatedAt).getTime() : 0;
    return dateB - dateA;
  });

const languages = [...new Set(cliTools.map((tool) => tool.language))];
const languageList =
  languages.length > 1
    ? `${languages.slice(0, -1).join(', ')} and ${languages[languages.length - 1]}`
    : languages.join('');

const pageTitle = 'CLI Tools | guitaripod';
const pageDescription = `Tools for the command line. Built with ${languageList}. Installable via Homebrew, cargo, and go install.`;

const whichLine = `which ${cliTools
  .slice(0, 4)
  .map((tool) => tool.name.toLowerCase())
  .join(' ')} ...`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: 'https://midgarcorp.cc/cli-tools/',
  author: {
    '@type': 'Person',
    name: 'guitaripod',
    url: 'https://midgarcorp.cc',
  },
  hasPart: cliTools.map((tool) => ({
    '@type': 'SoftwareApplication',
    name: tool.name,
    description: tool.description,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: tool.platforms.join(', '),
    programmingLanguage: tool.language,
    url: tool.githubUrl,
  })),
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="py-6 sm:py-8 lg:py-12">
    <header class="mb-8 sm:mb-12">
      <p class="prompt-line mb-4">{whichLine}</p>
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4 tracking-tight text-paper-text dark:text-term-text"
      >
        CLI Tools
      </h1>
      <p class="text-base sm:text-lg text-paper-muted dark:text-term-muted max-w-2xl mb-6">
        Tools for the command line. Built with
        {
          languages.map((language, index) => (
            <>
              <span class="text-paper-text dark:text-term-text font-semibold">{language}</span>
              {index < languages.length - 2 ? ', ' : index === languages.length - 2 ? ' and ' : ''}
            </>
          ))
        }. Installable via Homebrew, cargo, and go install.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="https://github.com/guitaripod?tab=repositories&q=cli"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 border border-paper-border2 dark:border-term-border2 text-paper-text dark:text-term-text rounded-sm text-sm font-semibold hover:border-paper-green dark:hover:border-term-green hover:text-paper-green dark:hover:text-term-green transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          View on GitHub
        </a>
      </div>
    </header>

    <section>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {cliTools.map((tool) => <CLIAppCard project={tool} />)}
      </div>
    </section>

    <section class="mt-12 sm:mt-16">
      <div class="term-frame p-6 sm:p-8">
        <p class="prompt-line mb-4">git clone --recursive ~/bin</p>
        <h2 class="text-xl sm:text-2xl font-bold mb-3 text-paper-text dark:text-term-text">
          Every tool is open source.
        </h2>
        <p class="text-sm sm:text-base text-paper-muted dark:text-term-muted mb-6 max-w-2xl">
          Source, releases, and install instructions for all {cliTools.length} tools — plus the rest
          of {openSourceData.projects.length} open-source projects — live on GitHub.
        </p>
        <a
          href="https://github.com/guitaripod?tab=repositories&q=cli"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-sm font-bold hover:opacity-90 transition-opacity"
        >
          ./explore-all-cli-projects
        </a>
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</BaseLayout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .grid > * {
    animation: fadeIn 0.45s ease-out both;
  }

  .grid > *:nth-child(1) {
    animation-delay: 0.05s;
  }
  .grid > *:nth-child(2) {
    animation-delay: 0.1s;
  }
  .grid > *:nth-child(3) {
    animation-delay: 0.15s;
  }
  .grid > *:nth-child(4) {
    animation-delay: 0.2s;
  }
  .grid > *:nth-child(5) {
    animation-delay: 0.25s;
  }
  .grid > *:nth-child(6) {
    animation-delay: 0.3s;
  }
  .grid > *:nth-child(7) {
    animation-delay: 0.35s;
  }
  .grid > *:nth-child(8) {
    animation-delay: 0.4s;
  }
  .grid > *:nth-child(9) {
    animation-delay: 0.45s;
  }
  .grid > *:nth-child(10) {
    animation-delay: 0.5s;
  }
  .grid > *:nth-child(11) {
    animation-delay: 0.55s;
  }
  .grid > *:nth-child(12) {
    animation-delay: 0.6s;
  }
  .grid > *:nth-child(n + 13) {
    animation-delay: 0.65s;
  }

  @media (prefers-reduced-motion: reduce) {
    .grid > * {
      animation: none;
    }
  }
</style>
