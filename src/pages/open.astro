---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageSection from '@components/PageSection.astro';
import AppIcon from '@components/landing/AppIcon.astro';
import AppCountCard from '@components/open/AppCountCard.astro';
import BigStat from '@components/open/BigStat.astro';
import CountTrail from '@components/open/CountTrail.astro';
import MetricCard from '@components/open/MetricCard.astro';
import SourceTag from '@components/open/SourceTag.astro';
import ThresholdChart from '@components/open/ThresholdChart.astro';
import Value from '@components/open/Value.astro';
import githubActivity from '@data/github-activity.json';
import {
  apple,
  events,
  kidsApp,
  KIT_SIGNALS,
  landingFor,
  metrics,
  NO_USAGE_COUNTS,
  openAppFor,
  preview,
  SITE_REPO,
  sample,
  stats,
  activityApps,
  statsUrl,
  storeApps,
} from '@data/open';
import {
  describeSeries,
  formatMonth,
  formatStamp,
  formatWeek,
  isNumber,
  isOpenPeriod,
  seriesOf,
  formatCell,
  formatEur,
  moneyOf,
} from '../lib/open-stats.mjs';
import {
  describeMoney,
  sumMoney,
  daysSince,
  firstPublished,
  formatDay,
  indexFrom,
  latestFinished,
  monthName,
  platformsOf,
  rankApps,
  shipCadence,
  trimLeading,
  statsExcerpt,
  weekRange,
} from '../lib/open-page.mjs';

const pageTitle = 'Midgar in the open | guitaripod';
const pageDescription =
  "A year of Midgar's apps in public: Apple's downloads and sales, Midgar's own counts and its purchase ledger, small numbers held back, code open.";

const now = Date.now();
const minCount = stats.rules.min_count;
const generatedAt = stats.generated_at;
const weeks = stats.portfolio.weeks;
const months = stats.portfolio.months;
const week = latestFinished(weeks, 'week', generatedAt);
const month = latestFinished(months, 'month', generatedAt);
const firstWeek = firstPublished(weeks, ['wau', 'new_installs']);
const cadence = shipCadence(storeApps, now);
const platforms = platformsOf(storeApps);
const contributionsYear = githubActivity.totals?.contributionsYear ?? null;
const appleWeeks = trimLeading(apple?.weeks ?? []);
const appleMonths = trimLeading(apple?.months ?? []);
const eraIndex = indexFrom(appleWeeks, firstWeek);
const era = eraIndex > 0 ? { from: eraIndex, label: "Midgar's own counts begin" } : undefined;
const money = moneyOf(apple);
const moneyLine = money ? `Earned means ${money.basis}, so it is approximate (≈).` : '';

interface YearTile {
  key: 'proceeds_eur' | 'downloads' | 'countries_downloaded' | 'purchases' | 'countries_purchased';
  label: string;
  caption: string;
  lead: boolean;
  money?: boolean;
}

const countTiles: YearTile[] = [
  {
    key: 'downloads',
    label: 'First-time downloads',
    caption: 'Every app, every storefront, redownloads not included.',
    lead: !money,
  },
  {
    key: 'countries_downloaded',
    label: 'Countries reached',
    caption: 'Storefronts with at least one download.',
    lead: false,
  },
  {
    key: 'purchases',
    label: 'Paid purchases',
    caption: money
      ? `Paid downloads, in-app purchases and renewals, from ${formatCell(apple?.totals.countries_purchased ?? null)} countries.`
      : 'Paid downloads, in-app purchases and renewals.',
    lead: false,
  },
];
const yearTiles: YearTile[] = money
  ? [
      {
        key: 'proceeds_eur',
        label: 'Earned',
        caption: "After Apple's commission and taxes, in euros.",
        lead: true,
        money: true,
      },
      ...countTiles,
    ]
  : [
      ...countTiles,
      {
        key: 'countries_purchased',
        label: 'Countries that bought',
        caption: 'Storefronts with at least one paid purchase.',
        lead: false,
      },
    ];

const appleCards = [
  {
    field: 'downloads',
    title: 'First-time downloads',
    blurb: 'Downloads by people who never had the app, as Apple reports them.',
  },
  {
    field: 'redownloads',
    title: 'Redownloads',
    blurb: 'People installing an app again on a device they own.',
  },
  {
    field: 'purchases',
    title: 'Paid purchases',
    blurb: 'Paid downloads, in-app purchases and subscription renewals.',
  },
  {
    field: 'active_subscriptions',
    title: 'Active subscriptions',
    blurb: 'Paid subscriptions running at the end of the month.',
  },
];

const appleColumns = [
  ...(money ? [{ field: 'proceeds_eur', label: 'Earned ≈', money: true }] : []),
  { field: 'downloads', label: 'Downloads', money: false },
  { field: 'redownloads', label: 'Redownloads', money: false },
  { field: 'purchases', label: 'Paid purchases', money: false },
  { field: 'active_subscriptions', label: 'Subscriptions', money: false },
];

const sources = [
  ...(apple
    ? [
        {
          source: 'apple' as const,
          title: "Apple's reports",
          text: money
            ? `Downloads, paid purchases, subscriptions and what they earned, from App Store Connect's daily reports, for every app since ${formatDay(apple.first_day)}. A day behind, as Apple publishes them.`
            : `Downloads, paid purchases and subscriptions from App Store Connect's daily reports, for every app since ${formatDay(apple.first_day)}. A day behind, as Apple publishes them.`,
        },
      ]
    : []),
  {
    source: 'midgar' as const,
    title: "Midgar's own counts",
    text: firstWeek
      ? `Installs that open an app, counted on the device with no identifier. Exact, and only from app versions released since ${monthName(firstWeek)}.`
      : 'Installs that open an app, counted on the device with no identifier, from app versions that send usage counts.',
  },
  {
    source: 'ledger' as const,
    title: 'The purchase ledger',
    text: 'Every purchase and subscription as Apple notifies Midgar of it, the moment it happens, from the day the ledger began.',
  },
];

const publicTitle = (id: string, fallback: string) =>
  stats.metrics.find((metric) => metric.id === id)?.title ?? fallback;

const heroTiles = [
  {
    field: 'wau',
    label: publicTitle('wau', 'Weekly active installs'),
    caption: 'Installs that opened an app that week.',
    lead: true,
    mark: 'midgar' as const,
  },
  {
    field: 'new_installs',
    label: publicTitle('new_installs', 'New installs'),
    caption: 'Installs seen in the week they were installed.',
    lead: false,
    mark: 'midgar' as const,
  },
  {
    field: 'purchases',
    label: publicTitle('purchases', 'Purchases'),
    caption: 'First and one-time purchases. Renewals are not counted.',
    lead: false,
    mark: 'ledger' as const,
  },
  {
    field: 'active_subscriptions',
    label: publicTitle('active_subscriptions', 'Active subscriptions'),
    caption: 'Paid-up subscriptions, from the purchase ledger.',
    lead: false,
    mark: 'ledger' as const,
  },
];

const monthTiles = [
  { field: 'mau', label: publicTitle('mau', 'Monthly active installs'), mark: 'midgar' as const },
  { field: 'purchases', label: publicTitle('purchases', 'Purchases'), mark: 'ledger' as const },
  {
    field: 'ai_requests',
    label: publicTitle('ai_requests', 'AI requests'),
    mark: 'midgar' as const,
  },
  {
    field: 'active_subscriptions',
    label: publicTitle('active_subscriptions', 'Subscriptions'),
    mark: 'ledger' as const,
  },
];

const weeklyCards = [
  {
    field: 'wau',
    title: publicTitle('wau', 'Weekly active installs'),
    blurb: 'Installs that opened an app during the week.',
  },
  {
    field: 'new_installs',
    title: publicTitle('new_installs', 'New installs'),
    blurb: 'Installs first seen that week.',
  },
  {
    field: 'purchases',
    title: publicTitle('purchases', 'Purchases'),
    blurb: 'Purchases recorded that week, across every app.',
  },
  {
    field: 'ai_requests',
    title: publicTitle('ai_requests', 'AI requests'),
    blurb: 'AI chat requests answered that week.',
  },
];

const weeklyColumns = [
  { field: 'wau', label: 'Active installs' },
  { field: 'new_installs', label: 'New installs' },
  { field: 'purchases', label: 'Purchases' },
  { field: 'refunds', label: 'Refunds' },
  { field: 'ai_requests', label: 'AI requests' },
  { field: 'active_subscriptions', label: 'Subscriptions' },
];

const monthlyColumns = [
  { field: 'mau', label: 'Active installs' },
  { field: 'purchases', label: 'Purchases' },
  { field: 'refunds', label: 'Refunds' },
  { field: 'ai_requests', label: 'AI requests' },
  { field: 'active_subscriptions', label: 'Subscriptions' },
];

const numbersOf = (rows: { [key: string]: unknown }[], field: string) =>
  rows.map((row) => row[field]).filter((cell): cell is number => isNumber(cell));

const cardSlugs = rankApps(
  [...activityApps, ...NO_USAGE_COUNTS].filter(
    (slug, index, list) => list.indexOf(slug) === index && landingFor(slug)?.status === 'live'
  ),
  apple?.apps ?? {},
  stats.apps
);

const activeTop = Math.max(
  minCount,
  ...cardSlugs.flatMap((slug) => numbersOf(stats.apps[slug]?.weeks ?? [], 'wau'))
);
const downloadsTop = Math.max(
  minCount,
  ...cardSlugs.flatMap((slug) => numbersOf(apple?.apps[slug]?.weeks ?? [], 'downloads'))
);

const quietNote = (slug: string) =>
  slug === kidsApp.slug
    ? "Sends no usage counts: it is in Apple's Kids Category."
    : NO_USAGE_COUNTS.includes(slug)
      ? 'Sends no usage counts.'
      : undefined;

const appCards = cardSlugs.map((slug) => {
  const lifestream = stats.apps[slug]?.weeks ?? [];
  const landing = landingFor(slug);
  const lastRow = lifestream.at(-1);
  return {
    app: openAppFor(slug),
    weeks: lifestream,
    downloads: apple ? (apple.apps[slug]?.weeks ?? []) : null,
    platforms: landing?.platforms ?? [],
    version: landing?.version,
    releasedDaysAgo: daysSince(landing?.currentVersionReleaseDate, now),
    open: lastRow !== undefined && isOpenPeriod(lastRow.period, 'week', generatedAt),
    quiet: quietNote(slug),
    earned: money ? (apple?.apps[slug]?.proceeds_eur ?? 0) : undefined,
    earnedRecent: money ? (sumMoney(apple?.apps[slug]?.weeks ?? []) ?? 0) : undefined,
  };
});

const familyApps = [
  ...[...activityApps, ...NO_USAGE_COUNTS].map((slug) => landingFor(slug)),
  ...storeApps,
]
  .filter((app): app is NonNullable<typeof app> => app !== undefined && app.status === 'live')
  .filter((app, index, list) => list.findIndex((other) => other.slug === app.slug) === index);

const principles = [
  ['Counts, not people.', 'An install reports that it was active, never whose.'],
  [
    'No identifier leaves a device.',
    'No user, device or Midgar ID rides along, and no IP address is kept.',
  ],
  [
    `Anything under ${minCount} shows as <${minCount},`,
    'so no figure points at a handful of people.',
  ],
  ['The code is open.', 'Every event is declared in one public registry.'],
  ...(money
    ? [
        [
          'Money is published as totals.',
          'Earnings show as sums per week, month and app, never purchase by purchase. Euros are not held back, so a week with one sale shows what it earned.',
        ],
      ]
    : []),
];

const activeEvent = events.find((event) => event.name === 'app.active');
const carryFields = [
  { name: 'app', example: 'flaccy' },
  { name: 'platform', example: 'iOS' },
  { name: 'app version', example: '1.16.1' },
  ...(activeEvent?.cohort ? [{ name: 'install week', example: '2026-10-26' }] : []),
  ...(activeEvent?.props ?? []).map((prop) => ({
    name: prop.name,
    example: prop.values.includes('week') ? 'week' : (prop.values[0] ?? '…'),
  })),
];

const codeLinks = [
  { href: KIT_SIGNALS, label: 'MidgarKit Signals', blurb: 'what an app sends, on the device' },
  {
    href: `${SITE_REPO}/blob/master/src/generated/signals-catalog.json`,
    label: 'signals-catalog.json',
    blurb: 'every event and allowed value',
  },
  {
    href: `${SITE_REPO}/blob/master/src/generated/metrics-catalog.json`,
    label: 'metrics-catalog.json',
    blurb: 'every metric and its formula',
  },
  { href: statsUrl, label: 'public stats JSON', blurb: 'the numbers on this page' },
];

const excerpt = statsExcerpt(stats, 2);
const proof = [
  {
    value: cadence.total,
    label: 'apps live on the App Store',
    note: `${platforms.length} platforms: ${platforms.join(', ')}`,
  },
  {
    value: cadence.updated7,
    label: 'shipped an update in the last 7 days',
    note: `${cadence.updated30} of ${cadence.total} in the last 30 days`,
  },
  {
    value: events.length,
    label: 'kinds of count, declared in public',
    note: 'An app can send nothing that is not in the registry.',
  },
  ...(contributionsYear
    ? [
        {
          value: contributionsYear,
          label: 'GitHub contributions in 12 months',
          note: 'Public and private work, counted by GitHub.',
        },
      ]
    : []),
];

const tableWrap =
  'term-frame relative overflow-x-auto focus-visible:outline focus-visible:outline-2 focus-visible:outline-paper-green dark:focus-visible:outline-term-green';
const headCell = 'px-3 py-2 text-xs font-normal text-paper-muted dark:text-term-muted';
const rowRule = 'border-t border-paper-border dark:border-term-border';
const chip =
  'inline-block rounded-sm border border-paper-border dark:border-term-border px-1.5 py-0.5 text-[11px] leading-none text-paper-muted dark:text-term-muted';
const link =
  'text-paper-green dark:text-term-green underline decoration-dotted underline-offset-2 hover:opacity-80';
---

<BaseLayout title={pageTitle} description={pageDescription} width="wide">
  <header class="open-hero pt-10 sm:pt-14 mb-14 sm:mb-20">
    {
      preview && (
        <aside
          role="note"
          class="term-frame mb-8 sm:mb-10 inline-flex items-center gap-3 !border-l-2 !border-l-paper-amber dark:!border-l-term-amber px-4 py-3 text-sm"
        >
          <span class="term-label flex items-center gap-2 !text-paper-amber dark:!text-term-amber">
            <span
              aria-hidden="true"
              class="h-1.5 w-1.5 rounded-full bg-paper-amber dark:bg-term-amber motion-safe:animate-pulse"
            />
            wip
          </span>
          <span class="text-paper-text dark:text-term-text">This page is a work in progress.</span>
        </aside>
      )
    }
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-5">
      <p class="prompt-line">curl -s api.midgarcorp.cc/v1/ops/public/stats</p>
      <p class="open-live text-xs text-paper-muted dark:text-term-muted">
        <span class="open-live__dot" aria-hidden="true"></span>
        <span class="text-paper-green dark:text-term-green font-bold tracking-[0.16em]"
          >LIVE DATA</span
        >
        <span aria-hidden="true">·</span>
        updated <time datetime={generatedAt} data-ago>{formatStamp(generatedAt)}</time>
      </p>
    </div>
    <h1
      class="text-4xl sm:text-5xl lg:text-7xl font-bold tracking-tight text-paper-text dark:text-term-text"
    >
      Midgar, <span class="phosphor">in the open</span>
    </h1>
    <p
      class="mt-5 text-base sm:text-lg text-paper-muted dark:text-term-muted max-w-3xl leading-relaxed"
    >
      {
        apple
          ? money
            ? `A year of Midgar's ${cadence.total} apps in public: every download, sale and euro Apple reports, and what Midgar's own counts and purchase ledger see, published as it is. Small counts stay private.`
            : `A year of Midgar's ${cadence.total} apps in public: every download and sale Apple reports, and what Midgar's own counts and purchase ledger see, published as it is. Small numbers stay private.`
          : `How many people use Midgar's ${cadence.total} apps, counted without identifiers and published as it is, straight from the same numbers Midgar runs on. Small numbers stay private.`
      }
    </p>
    <ul class="open-family" aria-label="Midgar's apps">
      {
        familyApps.map((app) => (
          <li>
            <a href={`/${app.slug}/`} aria-label={app.shortName} title={app.shortName}>
              {app.iconLocal && (
                <AppIcon
                  src={app.iconLocal}
                  width={44}
                  height={44}
                  displayWidths={[44]}
                  class="open-family__icon"
                />
              )}
            </a>
          </li>
        ))
      }
    </ul>

    {
      sample && (
        <div
          role="note"
          class="term-frame mt-8 !border-paper-amber dark:!border-term-amber p-4 text-sm text-paper-text dark:text-term-text"
        >
          <p class="term-label mb-1 !text-paper-amber dark:!text-term-amber">sample numbers</p>
          <p>{stats.rules.note}</p>
        </div>
      )
    }

    {
      apple && (
        <section
          class="open-board open-board--year term-frame mt-8 sm:mt-10"
          aria-labelledby="year-title"
        >
          <div class="open-board__head">
            <h2 id="year-title" class="term-label">
              A year on the App Store
              <span class="open-board__range">
                {formatDay(apple.first_day)} – {formatDay(apple.through)}
              </span>
            </h2>
            <SourceTag source="apple" />
          </div>
          <dl class="open-board__tiles">
            {yearTiles.map((tile) => (
              <BigStat
                label={tile.label}
                cell={apple.totals[tile.key]}
                money={tile.money}
                caption={tile.caption}
                minCount={minCount}
                lead={tile.lead}
                mark={tile.money ? 'money' : 'apple'}
              />
            ))}
          </dl>
          <div class:list={['open-year', { 'open-year--twin': money }]}>
            {money && (
              <div class="open-year__chart">
                <p class="open-year__title">
                  <span class="open-year__key open-year__key--money" aria-hidden="true" />
                  Earned, week by week
                  <span class="open-year__span">≈ euros, never held back</span>
                </p>
                <ThresholdChart
                  cells={seriesOf(appleWeeks, 'proceeds_eur')}
                  periods={appleWeeks.map((row) => row.period)}
                  minCount={minCount}
                  size="tall"
                  tone="money"
                  money
                  era={era}
                  label={describeMoney('Earned per week', appleWeeks, 'proceeds_eur')}
                />
              </div>
            )}
            <div class="open-year__chart">
              <p class="open-year__title">
                <span class="open-year__key open-year__key--apple" aria-hidden="true" />
                First-time downloads, week by week
                <span class="open-year__span">
                  {appleWeeks.length} finished weeks, from the week of{' '}
                  {formatWeek(appleWeeks[0]?.period ?? apple.first_day)}
                </span>
              </p>
              <ThresholdChart
                cells={seriesOf(appleWeeks, 'downloads')}
                periods={appleWeeks.map((row) => row.period)}
                minCount={minCount}
                size="tall"
                tone="apple"
                era={era}
                label={describeSeries('First-time downloads', appleWeeks, 'downloads')}
              />
            </div>
            {(era || money) && (
              <div class="open-year__notes">
                {money && <p class="open-year__note open-year__note--money">{moneyLine}</p>}
                {era && (
                  <p class="open-year__note">
                    <span class="open-year__era" aria-hidden="true" /> The shaded weeks are the ones
                    Midgar also counts itself, exactly and without identifiers, below.
                  </p>
                )}
              </div>
            )}
          </div>
        </section>
      )
    }

    <section class="open-board term-frame mt-6" aria-labelledby="board-title">
      <div class="open-board__head">
        <h2 id="board-title" class="term-label">
          Latest full week, counted by Midgar
          {week && <span class="open-board__range">{weekRange(week.period)}</span>}
        </h2>
        <p class="open-board__tags">
          <SourceTag source="midgar" />
          <SourceTag source="ledger" />
        </p>
      </div>
      {
        week ? (
          <dl class="open-board__tiles">
            {heroTiles.map((tile) => (
              <BigStat
                label={tile.label}
                cell={week[tile.field]}
                caption={tile.caption}
                minCount={minCount}
                lead={tile.lead}
                mark={tile.mark}
              />
            ))}
          </dl>
        ) : (
          <p class="p-5 text-sm text-paper-muted dark:text-term-muted">No finished week yet.</p>
        )
      }
      {
        month && (
          <div class="open-board__month">
            <p class="term-label">{monthName(month.period)}</p>
            <dl class="open-board__month-tiles">
              {monthTiles.map((tile) => (
                <BigStat
                  label={tile.label}
                  cell={month[tile.field]}
                  caption=""
                  minCount={minCount}
                  size="small"
                  mark={tile.mark}
                />
              ))}
            </dl>
          </div>
        )
      }
    </section>

    <ul class="open-sources mt-6" aria-label="Where each number comes from">
      {
        sources.map((entry) => (
          <li class="open-sources__item">
            <SourceTag source={entry.source} />
            <p class="open-sources__title">{entry.title}</p>
            <p class="open-sources__text">{entry.text}</p>
          </li>
        ))
      }
    </ul>

    <dl class="open-proof mt-6">
      {
        proof.map((cell) => (
          <div class="open-proof__cell">
            <dt class="open-proof__label">{cell.label}</dt>
            <dd class="open-proof__value">{cell.value.toLocaleString('en-US')}</dd>
            <dd class="open-proof__note">{cell.note}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="open-rules">
      {
        principles.map(([lead, rest]) => (
          <li class="open-rules__item">
            <span aria-hidden="true" class="open-rules__mark">
              &gt;
            </span>
            <span>
              <strong class="font-bold text-paper-text dark:text-term-text">{lead}</strong> {rest}
            </span>
          </li>
        ))
      }
    </ul>
  </header>

  {
    apple && (
      <PageSection
        id="apple"
        command="open stats --source apple --months"
        title="Month by month, as Apple reports it"
        blurb={`Every finished month since ${monthName(appleMonths[0]?.period ?? apple.first_day)}, from App Store Connect's sales and subscription reports, across every app.${appleMonths[0]?.period.slice(0, 7) === apple.first_day.slice(0, 7) ? ` The reports begin on ${formatDay(apple.first_day)}, so that first month is partial.` : ''} A hatched bar is a month under the publish line.`}
      >
        {money && (
          <div class="mb-5">
            <MetricCard
              title="Earned, month by month"
              blurb={`${moneyLine} Refunds count against the month Apple reports them in.`}
              rows={appleMonths}
              field="proceeds_eur"
              generatedAt={generatedAt}
              minCount={minCount}
              grain="month"
              tone="money"
              money
            />
          </div>
        )}
        <div class="open-grid open-grid--metrics">
          {appleCards.map((card) => (
            <MetricCard
              title={card.title}
              blurb={card.blurb}
              rows={appleMonths}
              field={card.field}
              generatedAt={generatedAt}
              minCount={minCount}
              grain="month"
              tone="apple"
            />
          ))}
        </div>
        <details class="mt-6">
          <summary class="term-label cursor-pointer select-none hover:text-paper-green dark:hover:text-term-green transition-colors">
            Apple's weeks and months as a table
          </summary>
          <div
            class={`${tableWrap} mt-3`}
            role="region"
            aria-label="Apple's monthly numbers"
            tabindex="0"
          >
            <table class="w-full min-w-[34rem] text-sm">
              <caption class="sr-only">
                Apple-reported numbers for each month since {formatDay(apple.first_day)}
              </caption>
              <thead>
                <tr>
                  <th scope="col" class={`${headCell} text-left`}>
                    Month
                  </th>
