---
import BaseLayout from '@layouts/BaseLayout.astro';
import CardGrid from '@components/CardGrid.astro';
import PageSection from '@components/PageSection.astro';
import AppIcon from '@components/landing/AppIcon.astro';
import MetricCard from '@components/open/MetricCard.astro';
import Spark from '@components/open/Spark.astro';
import Value from '@components/open/Value.astro';
import {
  events,
  kidsApp,
  KIT_SIGNALS,
  metrics,
  openAppFor,
  SITE_REPO,
  sample,
  stats,
  activityApps,
  statsUrl,
} from '@data/open';
import {
  describeSeries,
  formatMonth,
  formatStamp,
  formatWeek,
  isOpenPeriod,
  seriesOf,
} from '../lib/open-stats.mjs';

const pageTitle = 'Midgar in the open | guitaripod';
const pageDescription =
  "How many people use Midgar's apps, published as it is: weekly active installs, purchases and AI requests with small numbers hidden, what the apps count and the code behind it.";

const minCount = stats.rules.min_count;
const generatedAt = stats.generated_at;
const weeks = stats.portfolio.weeks;
const months = stats.portfolio.months;

const publicTitle = (id: string, fallback: string) =>
  stats.metrics.find((metric) => metric.id === id)?.title ?? fallback;

const weeklyCards = [
  {
    field: 'wau',
    title: publicTitle('wau', 'Weekly active installs'),
    blurb: 'Installs that opened an app during the week.',
  },
  {
    field: 'new_installs',
    title: publicTitle('new_installs', 'New installs'),
    blurb: 'Installs first seen that week.',
  },
  {
    field: 'purchases',
    title: publicTitle('purchases', 'Purchases'),
    blurb: 'Purchases recorded that week.',
  },
  {
    field: 'ai_requests',
    title: publicTitle('ai_requests', 'AI requests'),
    blurb: 'AI chat requests answered that week.',
  },
];

const weeklyColumns = [
  { field: 'wau', label: 'Active installs' },
  { field: 'new_installs', label: 'New installs' },
  { field: 'purchases', label: 'Purchases' },
  { field: 'refunds', label: 'Refunds' },
  { field: 'ai_requests', label: 'AI requests' },
  { field: 'active_subscriptions', label: 'Subscriptions' },
];

const monthlyColumns = [
  { field: 'mau', label: 'Active installs' },
  { field: 'purchases', label: 'Purchases' },
  { field: 'refunds', label: 'Refunds' },
  { field: 'ai_requests', label: 'AI requests' },
  { field: 'active_subscriptions', label: 'Subscriptions' },
];

const appRows = activityApps.map((slug) => {
  const series = stats.apps[slug];
  const lastRow = series.weeks.at(-1);
  return {
    app: openAppFor(slug),
    series,
    lastRow,
    open: lastRow !== undefined && isOpenPeriod(lastRow.period, 'week', generatedAt),
  };
});

const principles = [
  ['Counts, not people.', 'An install reports that it was active, never whose.'],
  [
    'No identifier leaves a device.',
    'No user, device or Midgar ID rides along, and no IP address is kept.',
  ],
  [
    `Anything under ${minCount} shows as <${minCount},`,
    'so no figure points at a handful of people.',
  ],
  ['The code is open.', 'Every event is declared in one public registry.'],
];

const codeLinks = [
  { href: KIT_SIGNALS, label: 'MidgarKit Signals', blurb: 'what an app sends, on the device' },
  {
    href: `${SITE_REPO}/blob/master/src/generated/signals-catalog.json`,
    label: 'signals-catalog.json',
    blurb: 'every event and allowed value',
  },
  {
    href: `${SITE_REPO}/blob/master/src/generated/metrics-catalog.json`,
    label: 'metrics-catalog.json',
    blurb: 'every metric and its formula',
  },
  { href: statsUrl, label: 'public stats JSON', blurb: 'the numbers on this page' },
];

const tableWrap =
  'term-frame relative overflow-x-auto focus-visible:outline focus-visible:outline-2 focus-visible:outline-paper-green dark:focus-visible:outline-term-green';
const headCell = 'px-3 py-2 text-xs font-normal text-paper-muted dark:text-term-muted';
const rowRule = 'border-t border-paper-border dark:border-term-border';
const chip =
  'inline-block rounded-sm border border-paper-border dark:border-term-border px-1.5 py-0.5 text-[11px] leading-none text-paper-muted dark:text-term-muted';
const link =
  'text-paper-green dark:text-term-green underline decoration-dotted underline-offset-2 hover:opacity-80';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <header class="pt-10 sm:pt-14 mb-8 sm:mb-10">
    <p class="prompt-line mb-4">curl -s api.midgarcorp.cc/v1/ops/public/stats</p>
    <h1
      class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4 text-paper-text dark:text-term-text"
    >
      Midgar, <span class="phosphor">in the open</span>
    </h1>
    <p class="text-base sm:text-lg text-paper-muted dark:text-term-muted max-w-3xl leading-relaxed">
      How many people use Midgar's apps, published as it is.
    </p>
    <ul class="mt-4 max-w-3xl space-y-1 text-sm text-paper-muted dark:text-term-muted">
      {
        principles.map(([lead, rest]) => (
          <li>
            <span aria-hidden="true" class="text-paper-green dark:text-term-green">
              &gt;
            </span>{' '}
            <strong class="font-bold text-paper-text dark:text-term-text">{lead}</strong> {rest}
          </li>
        ))
      }
    </ul>
    <p class="mt-4 text-xs text-paper-muted dark:text-term-muted">
      Updated <time datetime={generatedAt}>{formatStamp(generatedAt)}</time> · weeks start on Monday,
      UTC
    </p>
  </header>

  {
    sample && (
      <div
        role="note"
        class="term-frame mb-10 !border-paper-amber dark:!border-term-amber p-4 text-sm text-paper-text dark:text-term-text"
      >
        <p class="term-label mb-1 !text-paper-amber dark:!text-term-amber">sample numbers</p>
        <p>{stats.rules.note}</p>
      </div>
    )
  }

  <PageSection
    id="portfolio"
    command="open stats --weeks 12"
    title="All apps"
    blurb={`The last ${weeks.length} weeks, newest on the right. A dashed end means the week is still running. Active and new installs count only app versions that send usage counts, which most apps begin with their next release; purchases and AI requests cover every app.`}
  >
    {
      weeks.length > 0 ? (
        <>
          <CardGrid md={2} lg={2}>
            {weeklyCards.map((card) => (
              <MetricCard
                title={card.title}
                blurb={card.blurb}
                rows={weeks}
                field={card.field}
                generatedAt={generatedAt}
                minCount={minCount}
              />
            ))}
          </CardGrid>
          <details class="mt-6">
            <summary class="term-label cursor-pointer select-none hover:text-paper-green dark:hover:text-term-green transition-colors">
              every week and month as a table
            </summary>
            <div class={`${tableWrap} mt-3`} role="region" aria-label="Weekly numbers" tabindex="0">
              <table class="w-full min-w-[40rem] text-sm">
                <caption class="sr-only">
                  Portfolio numbers for each of the last {weeks.length} weeks
                </caption>
                <thead>
                  <tr>
                    <th scope="col" class={`${headCell} text-left`}>
                      Week of
                    </th>
                    {weeklyColumns.map((column) => (
                      <th scope="col" class={`${headCell} text-right`}>
                        {column.label}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {[...weeks].reverse().map((row) => (
                    <tr class={rowRule}>
                      <th
                        scope="row"
                        class="whitespace-nowrap px-3 py-2 text-left font-normal text-paper-text dark:text-term-text"
                      >
                        {formatWeek(row.period)}
                        {isOpenPeriod(row.period, 'week', generatedAt) && (
                          <span class="ml-1 text-xs text-paper-muted dark:text-term-muted">
                            so far
                          </span>
                        )}
                      </th>
                      {weeklyColumns.map((column) => (
                        <td class="px-3 py-2 text-right">
                          <Value cell={row[column.field]} minCount={minCount} />
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {months.length > 0 && (
              <div
                class={`${tableWrap} mt-4`}
                role="region"
                aria-label="Monthly numbers"
                tabindex="0"
              >
                <table class="w-full min-w-[34rem] text-sm">
                  <caption class="sr-only">
                    Portfolio numbers for each of the last {months.length} months
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col" class={`${headCell} text-left`}>
                        Month
                      </th>
                      {monthlyColumns.map((column) => (
                        <th scope="col" class={`${headCell} text-right`}>
                          {column.label}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {[...months].reverse().map((row) => (
                      <tr class={rowRule}>
                        <th
                          scope="row"
                          class="whitespace-nowrap px-3 py-2 text-left font-normal text-paper-text dark:text-term-text"
                        >
                          {formatMonth(row.period)}
                          {isOpenPeriod(row.period, 'month', generatedAt) && (
                            <span class="ml-1 text-xs text-paper-muted dark:text-term-muted">
                              so far
                            </span>
                          )}
                        </th>
                        {monthlyColumns.map((column) => (
                          <td class="px-3 py-2 text-right">
                            <Value cell={row[column.field]} minCount={minCount} />
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </details>
        </>
      ) : (
        <p class="term-frame p-4 text-sm text-paper-muted dark:text-term-muted">
          No weekly numbers yet.
        </p>
      )
    }
  </PageSection>

  <PageSection
    id="apps"
    command="open stats --by app"
    title="Each app"
    blurb="Weekly active installs per app, the busiest first."
  >
    {
      appRows.length > 0 ? (
        <div
          class={tableWrap}
          role="region"
          aria-label="Weekly active installs per app"
          tabindex="0"
        >
          <table class="w-full text-sm">
            <caption class="sr-only">
              Weekly active installs of each app over the last 12 weeks
            </caption>
            <thead>
              <tr>
                <th scope="col" class={`${headCell} text-left`}>
                  App
                </th>
                <th scope="col" class={`${headCell} text-left hidden sm:table-cell`}>
                  Last 12 weeks
                </th>
                <th scope="col" class={`${headCell} text-right`}>
                  Latest week
                </th>
              </tr>
            </thead>
            <tbody>
              {appRows.map(({ app, series, lastRow, open }) => (
                <tr class={rowRule} id={`app-${app.slug}`}>
                  <th scope="row" class="px-3 py-2 text-left font-normal">
                    <span class="flex items-center gap-3">
                      {app.icon && (
                        <AppIcon
                          src={app.icon}
                          width={28}
                          height={28}
                          displayWidths={[28]}
                          class="h-7 w-7 shrink-0 rounded-[0.45rem] border border-paper-border object-cover dark:border-term-border"
                        />
                      )}
                      {app.href ? (
                        <a
                          href={app.href}
                          class="text-paper-text dark:text-term-text hover:text-paper-green dark:hover:text-term-green transition-colors"
                        >
                          {app.name}
                        </a>
                      ) : (
                        <span class="text-paper-text dark:text-term-text">{app.name}</span>
                      )}
                    </span>
                  </th>
                  <td class="px-3 py-2 hidden sm:table-cell w-1/3">
                    <Spark
                      cells={seriesOf(series.weeks, 'wau')}
                      label={describeSeries('Weekly active installs', series.weeks, 'wau')}
                      open={open}
                    />
                  </td>
                  <td class="px-3 py-2 text-right text-base font-bold">
                    <Value cell={lastRow?.wau} minCount={minCount} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="term-frame p-4 text-sm text-paper-muted dark:text-term-muted">
          No app has reported counts yet.
        </p>
      )
    }
  </PageSection>

  <PageSection
    id="measure"
    command="cat registry/signals.yaml"
    title="What is counted"
    blurb={`The apps can send ${events.length} kinds of count and nothing else. Each carries only the app, the platform, the app version and, for some, the week the app was installed. The server keeps daily totals, never a log of what an install did, and the country read at Cloudflare's edge stays in identifier-free data points for 90 days.`}
  >
    <p class="mb-4 max-w-2xl text-sm text-paper-muted dark:text-term-muted">
      {kidsApp.name} sends no usage counts: it is in Apple's Kids Category. Crucible sends none either.
      Read Master of Flags'
      <a href="/legal/master-of-flags/privacy/" class={link}>privacy policy</a>.
    </p>
    <details class="mb-3">
      <summary
        class="term-label cursor-pointer select-none hover:text-paper-green dark:hover:text-term-green transition-colors"
      >
        the {events.length} counts the apps can send
      </summary>
      <dl class="term-frame mt-3 divide-y divide-paper-border dark:divide-term-border">
        {
          events.map((event) => (
            <div class="px-4 py-3" id={`event-${event.name}`}>
              <dt>
                <code class="text-sm font-bold text-paper-text dark:text-term-text">
                  {event.name}
                </code>
                {event.reserved && <span class={`${chip} ml-2`}>not sent yet</span>}
              </dt>
              <dd class="mt-1 text-sm text-paper-muted dark:text-term-muted">{event.purpose}</dd>
            </div>
          ))
        }
      </dl>
    </details>
    <details>
      <summary
        class="term-label cursor-pointer select-none hover:text-paper-green dark:hover:text-term-green transition-colors"
      >
        how each number is defined
      </summary>
      <dl class="term-frame mt-3 divide-y divide-paper-border dark:divide-term-border">
        {
          metrics.map((metric) => (
            <div class="px-4 py-3" id={`metric-${metric.id}`}>
              <dt class="text-sm font-bold text-paper-text dark:text-term-text">{metric.title}</dt>
              <dd class="mt-1 text-sm text-paper-muted dark:text-term-muted">
                {metric.purpose} {metric.caveat}
              </dd>
            </div>
          ))
        }
      </dl>
    </details>
  </PageSection>

  <PageSection
    id="code"
    command="git clone github.com/guitaripod/midgarkit"
    title="Check it yourself"
    blurb="The counting is open source."
  >
    <ul class="space-y-1 text-sm">
      {
        codeLinks.map((entry) => (
          <li>
            <a href={entry.href} target="_blank" rel="noopener noreferrer" class={link}>
              {entry.label} ↗
            </a>{' '}
            <span class="text-paper-muted dark:text-term-muted">{entry.blurb}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-4 max-w-2xl text-xs text-paper-muted dark:text-term-muted">
      Something looks wrong or unclear? Write to
      <a href="mailto:support@midgarcorp.cc" class={link}>support@midgarcorp.cc</a>.
    </p>
  </PageSection>
</BaseLayout>
