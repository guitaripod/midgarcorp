---
import BaseLayout from '@layouts/BaseLayout.astro';
import AppStoreBadge from '@components/landing/AppStoreBadge.astro';
import FaqAccordion from '@components/landing/FaqAccordion.astro';
import AppIcon from '@components/landing/AppIcon.astro';
import HeroRating from '@components/landing/HeroRating.astro';
import { landingApps, screenshotUrl, type LandingApp } from '@data/landing';
import screenshotVariants from '@data/screenshot-variants.json';
import webbLive from '@data/webb-live.json';
import { duoCombo } from '@data/duo';
import { siblingApps } from '@utils/sibling-apps';
import { appPageJsonLd } from '@utils/structured-data';
import { markdownPath } from '@utils/llms';
import { privacyUrlFor, supportPath } from '../../utils/app-links';
import {
  daysInSpace,
  upcomingVisits,
  utcStamp,
  visitLength,
  type WebbLiveData,
} from '../../lib/webb-live';

export const prerender = true;

const app = landingApps.find((a) => a.slug === 'solarbeam') as LandingApp;
const c = app.content;
const accent = c.accentColor || app.primaryColor;

const OG_REV = '13';
const ogImage = `/og/solarbeam.png?v=${OG_REV}`;

const variants = screenshotVariants as Record<string, number[]>;

/// A figure of the page: a capture of Solar Beam 6.0's demo mode, device-framed by the frames CLI
/// where the device has a bezel, with the widths the variants script wrote beside it.
const figure = (name: string, w: number, h: number) => {
  const src = `/screenshots/solarbeam/web-${name}.webp`;
  const srcset = [
    ...(variants[src] ?? []).map(
      (wide) => `${screenshotUrl(src.replace(/\.webp$/, `@${wide}.webp`))} ${wide}w`
    ),
    `${screenshotUrl(src)} ${w}w`,
  ].join(', ');
  return { src: screenshotUrl(src), srcset, w, h };
};
const phone = (name: string) => figure(`phone-${name}`, 735, 1500);
const pad = (name: string) => figure(`ipad-${name}`, 1150, 1500);
const mac = (name: string) => figure(`mac-${name}`, 1770, 1150);
const screen = (name: string) => figure(name, 2400, 1350);

const heroArt = figure('hero-planetarium', 2880, 1020);
const planetarium = { phone: phone('planetarium'), inside: phone('planetarium-inside') };
const surround = figure('vision-surround', 2000, 1125);
const gallery = { pad: pad('webb-gallery') };
const today = phone('apod');
const status = phone('webb-status');
const asteroids = mac('asteroids');
const ambient = screen('tv-ambient');
const macPlanetarium = mac('planetarium');

/// The ten spheres of the Planetarium with the textures the app wraps them in, placed on three
/// orbits of the drawing: `ring` picks the orbit and `angle` the place on it, in degrees from
/// the right, clockwise, so spheres in the lower half sit in front of the sun.
const spheres = [
  { id: 'firstlight', name: 'First Light', group: 'Webb', ring: 0, angle: 200, glow: '#ffd48a' },
  { id: 'nebulae', name: 'Nebulae', group: 'Webb', ring: 0, angle: 330, glow: '#f0a6ff' },
  { id: 'galaxies', name: 'Galaxies', group: 'Webb', ring: 0, angle: 95, glow: '#b8c8ff' },
  { id: 'starbirth', name: 'Star Birth', group: 'Webb', ring: 1, angle: 160, glow: '#ff9fc4' },
  {
    id: 'solarsystem',
    name: 'Our Solar System',
    group: 'Webb',
    ring: 1,
    angle: 285,
    glow: '#ffd27a',
  },
  {
    id: 'pictureofthemonth',
    name: 'Picture of the Month',
    group: 'Webb',
    ring: 1,
    angle: 40,
    glow: '#9ee7ff',
  },
  { id: 'hubble', name: 'Hubble Classics', group: 'NASA', ring: 2, angle: 215, glow: '#c9b8ff' },
  { id: 'apollo', name: 'Apollo', group: 'NASA', ring: 2, angle: 260, glow: '#e6e6e6' },
  { id: 'mars', name: 'Mars', group: 'NASA', ring: 2, angle: 345, glow: '#ffb08a' },
  { id: 'saturn', name: 'Saturn & Cassini', group: 'NASA', ring: 2, angle: 120, glow: '#f1dfb0' },
];
const ORBITS = [
  { rx: 21, ry: 15 },
  { rx: 33, ry: 24 },
  { rx: 45, ry: 33 },
];
/// Where a sphere sits in the drawing, in percent of its box, and how large it is: spheres nearer
/// the viewer (lower on the ellipse) are drawn larger and above the sun.
const placed = spheres.map((s) => {
  const orbit = ORBITS[s.ring];
  const rad = (s.angle * Math.PI) / 180;
  const depth = Math.sin(rad);
  return {
    ...s,
    x: 50 + orbit.rx * Math.cos(rad),
    y: 50 + orbit.ry * Math.sin(rad),
    size: 7.2 + s.ring * 0.9 + depth * 1.6,
    front: depth > 0,
  };
});
const webbSpheres = spheres.filter((s) => s.group === 'Webb');
const nasaSpheres = spheres.filter((s) => s.group === 'NASA');

/// What a sphere costs, from the App Store listing and the in-app purchase catalogue.
const spherePrices = [
  { name: 'One sphere', price: '$4.99', note: 'Picture of the Month is $6.99' },
  { name: 'Webb Collection', price: '$19.99', note: 'all six Webb spheres' },
  { name: 'NASA Collection', price: '$14.99', note: 'all four NASA spheres' },
  { name: 'Complete Planetarium', price: '$39.99', note: 'every sphere released through 2027' },
];

const live = webbLive as WebbLiveData;
const now = Date.now();
const visits = upcomingVisits(live, now, 6);
const mission = live.status;
const launchIso = mission?.launchIso ?? '';
const missionStats = mission
  ? [
      {
        value: daysInSpace(mission.launchIso, now).toLocaleString('en-US'),
        label: 'days in space',
        days: true,
      },
      { value: '1.5M km', label: 'from Earth, around Lagrange Point 2' },
      {
        value: `${mission.mirrorDiameterM} m`,
        label: `primary mirror, ${mission.mirrorSegments} segments`,
      },
      {
        value: `+${Math.round(mission.warmSideC)} / ${Math.round(mission.coolSideC)} °C`,
        label: 'sunshield, sun side to shaded side',
      },
    ]
  : [];

const versionLabel = app.version ? `Version ${app.version}` : null;
const requires = 'iOS 18, macOS 15, tvOS 18 or visionOS 26';
const privacyUrl = privacyUrlFor(app.slug);
const duo = duoCombo('solarbeam');

const showsRating = app.ratingCount >= 5;
const jsonLd = appPageJsonLd(app, { ratingShown: showsRating });
const siblings = siblingApps(landingApps, 'solarbeam');
---

<BaseLayout
  title={c.seoTitle}
  description={c.metaDescription}
  image={ogImage}
  markdown={markdownPath(app.slug)}
  appStoreId={app.trackId > 0 ? app.trackId : undefined}
>
  <div class="sb" style={`--accent:${accent}`}>
    <nav
      aria-label="Breadcrumb"
      class="hidden pt-8 text-xs text-paper-faint dark:text-term-faint sm:block"
    >
      <ol class="flex flex-wrap items-center gap-1.5 font-mono">
        <li><a href="/" class="hover:text-paper-green dark:hover:text-term-green">home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/apps/" class="hover:text-paper-green dark:hover:text-term-green">apps</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-paper-muted dark:text-term-muted" aria-current="page">solarbeam</li>
      </ol>
    </nav>

    <section class="hero bleed" aria-labelledby="app-name">
      <img
        class="hero-art"
        src={heroArt.src}
        srcset={heroArt.srcset}
        sizes="100vw"
        width={heroArt.w}
        height={heroArt.h}
        alt=""
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="hero-app">
          {
            app.iconLocal && (
              <AppIcon
                src={app.iconLocal}
                width={56}
                height={56}
                displayWidths={[48, 56]}
                priority
                class="hero-icon h-12 w-12 rounded-[0.9rem] object-cover sm:h-14 sm:w-14"
              />
            )
          }
          <h1 id="app-name">Solar Beam</h1>
          <span>James Webb Images</span>
        </div>
        <p class="display hero-title">The sky <em>Webb</em> sees.</p>
        <p class="hero-sub">
          Every great image from the James Webb Space Telescope with the story behind it, a
          Planetarium of Webb and NASA pictures to fly through, NASA’s picture of the day every
          morning and the asteroids passing Earth this week. Free on iPhone, iPad, Mac, Apple TV and
          Vision Pro.
        </p>
        <div class="hero-actions">
          <AppStoreBadge href={app.appStoreUrl} platform="ios" />
          <a href="#planetarium" class="ghost-btn">Fly through the Planetarium</a>
        </div>
        {
          showsRating && (
            <p class="hero-rating-row">
              <HeroRating rating={app.rating} count={app.ratingCount} />
            </p>
          )
        }
        <p class="hero-note">
          <span class="readout">New in 6.0</span>
          The Planetarium on Apple TV: ten spheres of pictures around a sun, drawn live in Metal.
        </p>
      </div>
    </section>

    <section id="planetarium" class="scene planetarium bleed" aria-labelledby="planetarium-title">
      <div class="scene-inner">
        <div class="planetarium-head">
          <div>
            <p class="kicker">The Planetarium</p>
            <h2 id="planetarium-title" class="display scene-title">Ten spheres around a sun.</h2>
          </div>
          <p class="scene-lede">
            Spheres of Webb and NASA pictures orbit a sun, drawn live in Metal with HDR light. Tap
            one to fly to it. Unlock it and it ignites star by star as its pictures arrive. Each is
            yours once, shared with your family and kept offline on every Apple device you use.
          </p>
        </div>

        <div class="orrery" aria-hidden="true">
          {
            ORBITS.map((o) => (
              <span class="orbit" style={`width:${o.rx * 2}%;height:${o.ry * 2}%`} />
            ))
          }
          <span class="sun"></span>
          {
            placed.map((s) => (
              <span
                class:list={['sphere', { front: s.front }]}
                style={`--x:${s.x.toFixed(2)}%;--y:${s.y.toFixed(2)}%;--size:${s.size.toFixed(2)}%;--glow:${s.glow};--tex:url('/screenshots/solarbeam/spheres/${s.id}.webp');--spin:${70 + s.ring * 25}s`}
              >
                <span class="sphere-label">{s.name}</span>
              </span>
            ))
          }
        </div>

        <div class="catalog">
          <div>
            <h3>Webb</h3>
            <ul>{webbSpheres.map((s) => <li>{s.name}</li>)}</ul>
          </div>
          <div>
            <h3>NASA</h3>
            <ul>{nasaSpheres.map((s) => <li>{s.name}</li>)}</ul>
          </div>
          <p class="catalog-note">
            Picture of the Month keeps growing. With Premium, Your Sky keeps every picture you open
            on your device and shines at the center. The Planetarium needs iOS, iPadOS, macOS, tvOS
            or visionOS 26.4 or later.
          </p>
        </div>
      </div>
    </section>

    <section class="scene inside bleed" aria-labelledby="inside-title">
      <div class="scene-inner inside-grid">
        <div class="inside-text">
          <h2 id="inside-title" class="display scene-title">Then fly inside.</h2>
          <p class="scene-lede">
            Step into a sphere and its pictures hang all around you, Webb’s at their real places in
            the sky. Tilt your iPhone to look around. On Apple Vision Pro the Planetarium surrounds
            you.
          </p>
          <div class="inside-phones">
            <img
              src={planetarium.phone.src}
              srcset={planetarium.phone.srcset}
              sizes="(min-width: 1024px) clamp(200px, 11vw, 360px), 40vw"
              width={planetarium.phone.w}
              height={planetarium.phone.h}
              alt="The Planetarium on iPhone: spheres on their orbits around the sun, with Tap a sphere at the bottom"
              loading="lazy"
              decoding="async"
            />
            <img
              src={planetarium.inside.src}
              srcset={planetarium.inside.srcset}
              sizes="(min-width: 1024px) clamp(200px, 11vw, 360px), 40vw"
              width={planetarium.inside.w}
              height={planetarium.inside.h}
              alt="Inside the Nebulae sphere on iPhone: sixty pictures hang around the viewer against a violet nebula"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <figure class="inside-vision">
          <img
            src={surround.src}
            srcset={surround.srcset}
            sizes="(min-width: 1024px) 55vw, 100vw"
            width={surround.w}
            height={surround.h}
            alt="Inside the Galaxies sphere on Apple Vision Pro: pictures float around the viewer against the Milky Way"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Inside Galaxies, on Apple Vision Pro.</figcaption>
        </figure>
      </div>
    </section>

    <section class="feature feature-wide" aria-labelledby="gallery-title">
      <div class="feature-text">
        <h2 id="gallery-title" class="display feature-title">Every picture, with its story.</h2>
        <p>
          A curated gallery of Webb’s most breathtaking images from the ESA/Webb archive: the Cosmic
          Cliffs, the Pillars of Creation, Webb’s first deep field and hundreds more, each with its
          real caption, credit, distance and sky position. Browse Nebulae, Galaxies, Star Birth, Our
          Solar System or Deep &amp; Distant, or search for any target.
        </p>
        <figure class="label-card">
          <figcaption class="label-title">NIRCam Image of the “Cosmic Cliffs” in Carina</figcaption>
          <dl>
            <div><dt>Object</dt><dd>Carina Nebula · NGC 3324</dd></div>
            <div><dt>Instrument</dt><dd>NIRCam</dd></div>
            <div><dt>Distance</dt><dd>7,600 light-years</dd></div>
            <div><dt>Sky position</dt><dd>RA 159.213° · Dec −58.620°</dd></div>
            <div><dt>Released</dt><dd>2022</dd></div>
            <div><dt>Image</dt><dd>NASA, ESA, CSA, and STScI · CC BY 4.0</dd></div>
          </dl>
        </figure>
        <p class="aside">
          The first 24 images are free. Premium opens the whole gallery and saves any image as a 4K
          wallpaper or a full-resolution download.
        </p>
      </div>
      <img
        class="feature-pad"
        src={gallery.pad.src}
        srcset={gallery.pad.srcset}
        sizes="(min-width: 1024px) 40vw, (min-width: 768px) 55vw, 100vw"
        width={gallery.pad.w}
        height={gallery.pad.h}
        alt="The Nebulae collection on iPad: a grid of Webb images, each with its title, instrument and distance"
        loading="lazy"
        decoding="async"
      />
    </section>

    <section class="feature feature-flip" aria-labelledby="today-title">
      <div class="feature-text">
        <p class="readout readout-day">Picture of the Day · every morning</p>
        <h2 id="today-title" class="display feature-title">A new picture every morning.</h2>
        <p>
          NASA’s Astronomy Picture of the Day, with AI-generated facts that make every image make
          sense, and On This Day: the picture from today’s date one, two, five, ten and up to thirty
          years ago. It sits on your Home Screen and Lock Screen as a widget, free.
        </p>
        <p class="aside">
          Free: today’s picture and the past week, and one AI-generated fact set to try. Premium
          opens the archive back to 1995, unlimited AI facts and Webb Daily, a new Webb image on
          your Home Screen every day.
        </p>
      </div>
      <img
        class="feature-phone"
        src={today.src}
        srcset={today.srcset}
        sizes="(min-width: 768px) clamp(300px, 15vw, 520px), 70vw"
        width={today.w}
        height={today.h}
        alt="Picture of the Day on iPhone: Webb’s Rho Ophiuchi, with On This Day pictures from one and two years ago below"
        loading="lazy"
        decoding="async"
      />
    </section>

    <section id="where-is-webb" class="scene mission bleed" aria-labelledby="mission-title">
      <div class="scene-inner mission-grid">
        <div class="mission-text">
          <p class="kicker">Where Is Webb</p>
          <h2 id="mission-title" class="display scene-title">Where Webb is, right now.</h2>
          <p class="scene-lede">
            A dashboard for the telescope itself: days in space, its orbit around Lagrange Point 2,
            1.5 million km from Earth, and the temperatures of its sunny and shaded sides.
          </p>
          {
            missionStats.length > 0 && (
              <dl class="mission-stats" data-webb-live>
                {missionStats.map((s) => (
                  <div>
                    <dt>
                      <span data-webb-days={s.days ? '' : undefined}>{s.value}</span>
                    </dt>
                    <dd>{s.label}</dd>
                  </div>
                ))}
              </dl>
            )
          }
          {
            visits.length > 0 && (
              <div class="log" data-webb-log>
                <h3>On Webb’s observing plan this week</h3>
                <ol>
                  {visits.map((v) => (
                    <li class="visit" data-start={v.start} data-seconds={v.seconds}>
                      <time datetime={v.start}>{utcStamp(v.start)} UTC</time>
                      <span class="visit-target">
                        <span class="visit-now" hidden>
                          on target now
                        </span>
                        {v.target}
                      </span>
                      <span class="visit-meta">
                        {v.instrument} · {visitLength(v.seconds)}
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            )
          }
          <p class="mission-note">
            The observing plan comes from the{' '}
            <a
              href={live.schedule?.sourceUrl ??
                'https://www.stsci.edu/jwst/science-execution/observing-schedules'}
              target="_blank"
              rel="noopener noreferrer">Space Telescope Science Institute</a
            >, refreshed every day this page is built; times are UTC. The sunshield temperatures are
            NASA’s commissioning readings, which it no longer updates.
          </p>
        </div>
        <img
          class="mission-phone"
          src={status.src}
          srcset={status.srcset}
          sizes="(min-width: 1024px) clamp(260px, 15vw, 480px), 60vw"
          width={status.w}
          height={status.h}
          alt="Webb Status on iPhone: Science operations, 1,780 days in space, 50 °C on the sun side, −236 °C shielded, and every instrument’s temperature"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <section class="feature feature-wide feature-flip" aria-labelledby="asteroids-title">
      <div class="feature-text">
        <h2 id="asteroids-title" class="display feature-title">The asteroids passing Earth.</h2>
        <p>
          Every close approach of the last four weeks, nearest first, with size, speed and distance
          in lunar distances, and charts that sort the dangerous from the safe. Ask Siri for the
          closest asteroid, or keep the Asteroids widget on your Home Screen or Lock Screen.
        </p>
        <p class="aside">Always free, never gated.</p>
      </div>
      <img
        class="feature-mac"
        src={asteroids.src}
        srcset={asteroids.srcset}
        sizes="(min-width: 1024px) 50vw, 100vw"
        width={asteroids.w}
        height={asteroids.h}
        alt="Asteroids on a MacBook Air: the threat tracker, dangerous versus safe, near misses, impact size and every close approach in a table"
        loading="lazy"
        decoding="async"
      />
    </section>

    <section class="scene screens bleed" aria-labelledby="screens-title">
      <div class="scene-inner">
        <div class="screens-head">
          <h2 id="screens-title" class="display scene-title">Deep space on any screen.</h2>
          <p class="scene-lede">
            Ambient Mode drifts through the gallery on iPhone, iPad, Mac and Apple TV. On the Mac,
            Solar Beam can live in the menu bar, and on Vision Pro, Spatial Scenes turn a picture
            into a scene with real depth.
          </p>
        </div>
        <figure class="screens-tv">
          <img
            src={ambient.src}
            srcset={ambient.srcset}
            sizes="(min-width: 1280px) 76vw, 100vw"
            width={ambient.w}
            height={ambient.h}
            alt="Ambient Mode on Apple TV: Webb’s picture of young stars at every stage of formation, edge to edge"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Ambient Mode on Apple TV.</figcaption>
        </figure>
        <figure class="screens-mac">
          <img
            src={macPlanetarium.src}
            srcset={macPlanetarium.srcset}
            sizes="(min-width: 1024px) 45vw, 100vw"
            width={macPlanetarium.w}
            height={macPlanetarium.h}
            alt="The Planetarium on a MacBook Air"
            loading="lazy"
            decoding="async"
          />
          <figcaption>The Planetarium on Mac.</figcaption>
        </figure>
        {
          duo && (
            <figure class="duo">
              <img
                src={duo.src}
                srcset={duo.srcset}
                sizes="(min-width: 1024px) min(40vw, 960px), 100vw"
                width={duo.w}
                height={duo.h}
                alt="Solar Beam on iPhone Duo: the outer display in front of the open inner display"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                Both displays of iPhone Duo: the outer display in front, the open inner display
                behind.
              </figcaption>
            </figure>
          )
        }
      </div>
    </section>

    {
      c.pricing && (
        <section class="band" aria-labelledby="pricing-title">
          <h2 id="pricing-title" class="display band-title">
            Free to look up. Premium to go further.
          </h2>
          <div class="plans">
            <div class="plan">
              <h3>
                {c.pricing.free.title}
                <span>{c.pricing.free.price}</span>
              </h3>
              <ul>
                {c.pricing.free.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="plan plan-pro">
              <h3>{c.pricing.premium.title}</h3>
              <p class="tiers">
                {c.pricing.tiers.map((tier) => (
                  <span>
                    <strong>{tier.price}</strong> {tier.name.toLowerCase()}
                    {tier.note && <small>{tier.note}</small>}
                  </span>
                ))}
              </p>
              <ul>
                {c.pricing.premium.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="plan plan-spheres">
              <h3>Planetarium spheres</h3>
              <p class="tiers">
                {spherePrices.map((tier) => (
                  <span>
                    <strong>{tier.price}</strong> {tier.name.toLowerCase()}
                    <small>{tier.note}</small>
                  </span>
                ))}
              </p>
              <p class="plan-note">
                One-time purchases, separate from Premium, and 20% less for Premium members. Each
                sphere is yours once, shared with your family and kept offline on every Apple device
                you use.
              </p>
            </div>
          </div>
          <p class="fine">
            Subscriptions renew automatically until cancelled in your App Store account; the
            lifetime unlock and the spheres never renew. Premium works with Family Sharing and
            unlocks on iPhone, iPad, Mac, Apple TV and Vision Pro. Prices are in US dollars; the App
            Store shows your local price before you buy.
          </p>
        </section>
      )
    }

    <section class="band trust" aria-labelledby="trust-title">
      <h2 id="trust-title" class="display band-title">Straight from the source.</h2>
      <p>
        The pictures and the data come from NASA, ESA, CSA and STScI: the Astronomy Picture of the
        Day, the ESA/Webb archive under CC BY 4.0 with its credit on every image, and NASA’s
        near-Earth object feed. There is no account, no ads and no third-party tracking. Solar Beam
        keeps your purchase history so Premium and your spheres follow you between devices, and
        counts first opens each day, week and month without an identifier; I publish those totals on <a
          href="/open/">midgarcorp.cc/open</a
        >.
        {
          privacyUrl && (
            <>
              {' '}
              <a href={privacyUrl}>Read the privacy policy</a>.
            </>
          )
        }
      </p>
    </section>

    <section class="band" aria-labelledby="faq-title">
      <div class="faq-layout">
        <h2 id="faq-title" class="display band-title">Questions.</h2>
        <div class="faq">
          <FaqAccordion faq={c.faq} accent={accent} />
        </div>
      </div>
