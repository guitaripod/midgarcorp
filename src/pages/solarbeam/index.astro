<script is:inline define:vars={{ launchIso }}>
  (function () {
    const days = document.querySelector('[data-webb-days]');
    const launch = launchIso ? Date.parse(launchIso) : NaN;
    const visits = Array.from(document.querySelectorAll('[data-webb-log] .visit'));
    function tick() {
      const now = Date.now();
      if (days && !Number.isNaN(launch)) {
        days.textContent = Math.floor((now - launch) / 86400000).toLocaleString('en-US');
      }
      for (const row of visits) {
        const start = Date.parse(row.dataset.start);
        const end = start + Number(row.dataset.seconds) * 1000;
        const current = now >= start && now < end;
        row.classList.toggle('is-now', current);
        row.classList.toggle('is-past', now >= end);
        const badge = row.querySelector('.visit-now');
        if (badge) badge.hidden = !current;
      }
    }
    tick();
    setInterval(tick, 60000);
  })();
</script>

