---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  tags?: string[];
}

const { title, description, image, article, publishedTime, tags } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      article={article}
      publishedTime={publishedTime}
      tags={tags}
    />
  </head>
  <body
    class="min-h-screen bg-paper-bg dark:bg-term-bg text-paper-text dark:text-term-text font-mono antialiased"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:border focus:border-paper-green focus:bg-paper-bg focus:px-3 focus:py-2 focus:text-sm focus:text-paper-green dark:focus:border-term-green dark:focus:bg-term-bg dark:focus:text-term-green"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <slot />
    </main>
    <Footer />
    <div class="crt-overlay" aria-hidden="true"></div>
  </body>
</html>
