---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';
import { landingSlugs } from '@data/landing';
import { searchKind, searchTitle } from '@utils/search';

export interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  tags?: string[];
  searchable?: boolean;
}

const { title, description, image, article, publishedTime, tags, searchable = true } = Astro.props;

const kind = searchKind(Astro.url.pathname, landingSlugs);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      article={article}
      publishedTime={publishedTime}
      tags={tags}
    />
  </head>
  <body class="min-h-screen text-paper-text dark:text-term-text font-mono antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:border focus:border-paper-green focus:bg-paper-bg focus:px-3 focus:py-2 focus:text-sm focus:text-paper-green dark:focus:border-term-green dark:focus:bg-term-bg dark:focus:text-term-green"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="main"
      class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8"
      data-pagefind-body={searchable ? '' : undefined}
      data-pagefind-meta={searchable
        ? 'title[data-search-title], description[data-search-description], kind[data-search-kind]'
        : undefined}
      data-pagefind-filter={searchable ? 'kind[data-search-kind]' : undefined}
      data-search-title={searchTitle(title)}
      data-search-description={description}
      data-search-kind={kind}
    >
      <slot />
    </main>
    <Footer />
    <div class="crt-overlay" aria-hidden="true"></div>
  </body>
</html>
