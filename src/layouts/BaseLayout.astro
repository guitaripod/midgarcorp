---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';
import { landingSlugs } from '@data/landing';
import { searchKind, searchTitle } from '@utils/search';

export interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  searchable?: boolean;
  width?: 'standard' | 'wide';
  noindex?: boolean;
  markdown?: string;
  appStoreId?: number;
}

const {
  title,
  description,
  image,
  article,
  publishedTime,
  modifiedTime,
  tags,
  searchable = true,
  width = 'standard',
  noindex = false,
  markdown,
  appStoreId,
} = Astro.props;

const kind = searchKind(Astro.url.pathname, landingSlugs);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      article={article}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      noindex={noindex}
      markdown={markdown}
      appStoreId={appStoreId}
    />
  </head>
  <body
    class="min-h-screen text-paper-text dark:text-term-text font-mono antialiased"
    data-shell={width}
  >
    <!--email_off-->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:border focus:border-paper-green focus:bg-paper-bg focus:px-3 focus:py-2 focus:text-sm focus:text-paper-green dark:focus:border-term-green dark:focus:bg-term-bg dark:focus:text-term-green"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="main"
      class="shell"
      data-pagefind-body={searchable ? '' : undefined}
      data-pagefind-meta={searchable
        ? 'title[data-search-title], description[data-search-description], kind[data-search-kind]'
        : undefined}
      data-pagefind-filter={searchable ? 'kind[data-search-kind]' : undefined}
      data-search-title={searchTitle(title)}
      data-search-description={description}
      data-search-kind={kind}
    >
      <slot />
    </main>
    <Footer />
    <div class="crt-overlay" aria-hidden="true"></div>
    <!--/email_off-->
  </body>
</html>
