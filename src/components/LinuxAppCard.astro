---
import type { LinuxApp } from '@data/linux';

export interface Props {
  app: LinuxApp;
}

const { app } = Astro.props;

const languageAccents: Record<string, string> = {
  Rust: '#CE422B',
  Go: '#00ADD8',
  'C++': '#F34B7D',
};
const accent = languageAccents[app.language] ?? '#7d8590';

const formGlyphs: Record<string, string> = {
  cli: '[cli]',
  tui: '[tui]',
  gui: '[app]',
  daemon: '[svc]',
};
const glyph = formGlyphs[app.form] ?? '[bin]';

const targetUrl = app.homepageUrl ?? app.githubUrl;
const releaseStamp = app.latestReleaseDate ? app.latestReleaseDate.slice(0, 7) : null;
const altChannels = app.install.all.slice(1);
---

<article class="linux-card group h-full term-frame term-frame-hover overflow-hidden flex flex-col">
  <div class="p-4 sm:p-5 flex flex-col flex-1">
    <div class="flex items-start justify-between gap-3 mb-2">
      <div class="flex items-baseline gap-2 min-w-0">
        <span class="text-xs text-paper-muted dark:text-term-faint flex-shrink-0">{glyph}</span>
        <h3
          class="text-base sm:text-lg font-bold text-paper-text dark:text-term-text group-hover:text-paper-green dark:group-hover:text-term-green transition-colors truncate"
        >
          <a href={targetUrl} target="_blank" rel="noopener noreferrer">{app.name}</a>
        </h3>
      </div>
      <div class="flex items-baseline gap-2.5 flex-shrink-0 text-xs">
        {
          app.latestVersion && (
            <span class="text-paper-green dark:text-term-green font-semibold whitespace-nowrap">
              v{app.latestVersion}
            </span>
          )
        }
        {
          app.stars > 0 && (
            <span class="text-paper-amber dark:text-term-amber whitespace-nowrap">
              ★ {app.stars}
            </span>
          )
        }
      </div>
    </div>

    <div
      class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-3 text-xs text-paper-muted dark:text-term-faint"
    >
      <span class="inline-flex items-center gap-1.5">
        <span
          class="inline-block w-2 h-2 rounded-full"
          style={`background-color: ${accent}`}
          aria-hidden="true"></span>
        {app.language}
      </span>
      <span class="text-paper-faint dark:text-term-faint">·</span>
      <span class="text-paper-muted dark:text-term-muted">{app.formLabel}</span>
      {
        app.releaseCount > 0 && (
          <>
            <span class="text-paper-faint dark:text-term-faint">·</span>
            <span class="text-paper-muted dark:text-term-muted">
              {app.releaseCount} {app.releaseCount === 1 ? 'release' : 'releases'}
            </span>
          </>
        )
      }
    </div>

    <p class="text-sm text-paper-muted dark:text-term-muted leading-relaxed line-clamp-2 mb-4">
      {app.description}
    </p>

    <div class="mt-auto">
      <div class="rounded-sm overflow-hidden border border-term-border bg-term-bg">
        <div
          class="flex items-center justify-between gap-2 px-3 py-1.5 bg-term-panel border-b border-term-border"
        >
          <span class="text-xs text-term-faint">install · {app.install.primary.label}</span>
          <button
            type="button"
            class="copy-btn text-xs text-term-faint hover:text-term-green transition-colors"
            data-copy={app.install.primary.command}
            aria-label={`Copy install command for ${app.name}`}
          >
            copy
          </button>
        </div>
        <div class="p-3 text-xs">
          <p class="text-term-text break-all">
            <span class="text-term-green select-none">$ </span>{app.install.primary.command}
          </p>
        </div>
      </div>

      {
        (altChannels.length > 0 || app.note) && (
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-2 text-xs">
            {app.note && <span class="text-paper-amber dark:text-term-amber">⚠ {app.note}</span>}
            {altChannels.length > 0 && (
              <>
                {app.note && <span class="text-paper-faint dark:text-term-faint">·</span>}
                <span class="text-paper-faint dark:text-term-faint">also:</span>
                {altChannels.map((channel) => (
                  <span class="text-paper-muted dark:text-term-muted">{channel.label}</span>
                ))}
              </>
            )}
          </div>
        )
      }

      <div
        class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-3 pt-3 border-t border-paper-border dark:border-term-border text-xs"
      >
        <a
          href={app.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors"
        >
          source ↗
        </a>
        {
          app.homepageUrl && (
            <a
              href={app.homepageUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors"
            >
              docs ↗
            </a>
          )
        }
        <a
          href={app.latestReleaseUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors"
        >
          releases{releaseStamp ? ` · ${releaseStamp}` : ''} ↗
        </a>
        {
          app.hasLinuxBinary && app.linuxBinaryUrl && (
            <a
              href={app.linuxBinaryUrl}
              rel="noopener noreferrer"
              class="text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors"
            >
              download x86_64 ↓
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<script>
  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest('.copy-btn');
    if (!(button instanceof HTMLButtonElement)) return;
    const command = button.dataset.copy;
    if (!command) return;
    try {
      await navigator.clipboard.writeText(command);
      const original = button.textContent;
      button.textContent = 'copied ✓';
      button.classList.add('text-term-green');
      window.setTimeout(() => {
        button.textContent = original;
        button.classList.remove('text-term-green');
      }, 1400);
    } catch {
      /* clipboard unavailable — no-op */
    }
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
