---
import type { LinuxApp } from '@data/linux';
import {
  FORM_GLYPHS,
  FRESHNESS_STYLE,
  ageLabel,
  freshness,
  languageColor,
} from '../lib/linux-insights';
import LinuxInstall from './LinuxInstall.astro';
import LinuxWeight from './LinuxWeight.astro';

export interface Props {
  app: LinuxApp;
  now?: Date;
}

const { app, now = new Date() } = Astro.props;

const accent = languageColor(app.language);
const status = freshness(app.latestReleaseDate, now);
const style = FRESHNESS_STYLE[status];
const targetUrl = app.homepageUrl ?? app.githubUrl;
const releaseStamp = app.latestReleaseDate ? app.latestReleaseDate.slice(0, 7) : null;
const linkClass =
  'text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors';
---

<article
  id={app.id}
  class="linux-card scroll-mt-24 group h-full term-frame term-frame-hover overflow-hidden flex flex-col relative"
>
  <span
    class="absolute inset-x-0 top-0 h-0.5 opacity-70 group-hover:opacity-100 transition-opacity"
    style={`background:${accent}`}
    aria-hidden="true"></span>
  <div class="p-4 sm:p-5 flex flex-col flex-1">
    <div class="flex items-start justify-between gap-3 mb-2">
      <div class="flex items-baseline gap-2 min-w-0">
        <span class="text-xs text-paper-muted dark:text-term-faint flex-shrink-0"
          >{FORM_GLYPHS[app.form]}</span
        >
        <h3
          class="text-base sm:text-lg font-bold text-paper-text dark:text-term-text group-hover:text-paper-green dark:group-hover:text-term-green transition-colors truncate"
        >
          <a href={targetUrl} target="_blank" rel="noopener noreferrer">{app.name}</a>
        </h3>
      </div>
      <div class="flex items-baseline gap-2.5 flex-shrink-0 text-xs">
        {
          app.latestVersion && (
            <span class="text-paper-green dark:text-term-green font-semibold whitespace-nowrap">
              v{app.latestVersion}
            </span>
          )
        }
        {
          app.stars > 0 && (
            <span class="text-paper-amber dark:text-term-amber whitespace-nowrap">
              ★ {app.stars}
            </span>
          )
        }
      </div>
    </div>

    <div
      class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-3 text-xs text-paper-muted dark:text-term-faint"
    >
      <span class="inline-flex items-center gap-1.5">
        <span
          class="inline-block w-2 h-2 rounded-full"
          style={`background-color: ${accent}`}
          aria-hidden="true"></span>
        {app.language}
      </span>
      <span class="text-paper-faint dark:text-term-faint">·</span>
      <span class="text-paper-muted dark:text-term-muted">{app.formLabel}</span>
      <span class="text-paper-faint dark:text-term-faint">·</span>
      <span class="inline-flex items-center gap-1.5" title={style.title}>
        <span class={`inline-block w-1.5 h-1.5 rounded-full ${style.dot}`} aria-hidden="true"
        ></span>
        <span class={style.text}>{ageLabel(app.latestReleaseDate, now)}</span>
      </span>
    </div>

    <p class="text-sm text-paper-muted dark:text-term-muted leading-relaxed line-clamp-2 mb-4">
      {app.description}
    </p>

    <div class="mb-4">
      <LinuxWeight app={app} />
    </div>

    <div class="mt-auto">
      <LinuxInstall name={app.name} channels={app.install.all} />

      {
        app.note && (
          <p class="mt-2 text-xs text-paper-muted dark:text-term-muted">
            <span class="text-paper-amber dark:text-term-amber" aria-hidden="true">
              ◆
            </span>
            {app.note}
          </p>
        )
      }

      <div
        class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-3 pt-3 border-t border-paper-border dark:border-term-border text-xs"
      >
        <a href={app.githubUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
          source ↗
        </a>
        {
          app.homepageUrl && (
            <a href={app.homepageUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
              docs ↗
            </a>
          )
        }
        <a href={app.latestReleaseUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
          releases{releaseStamp ? ` · ${releaseStamp}` : ''} ↗
        </a>
        {
          app.hasLinuxBinary && app.linuxBinaryUrl && (
            <a href={app.linuxBinaryUrl} rel="noopener noreferrer" class={linkClass}>
              download x86_64 ↓
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
