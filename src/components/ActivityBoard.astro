---
import { renderActivityBoard, type ActivitySnapshot, type PagePaths } from '../lib/activity-board';
import snapshotData from '../data/github-activity.json';
import { landingSlugs } from '@data/landing';

const snapshot = snapshotData as ActivitySnapshot;
const pages: PagePaths = Object.fromEntries(landingSlugs.map((slug) => [slug, `/${slug}/`]));
const html = renderActivityBoard(snapshot, new Date(), pages);
const embeddedPages = JSON.stringify(pages);
const embedded = JSON.stringify(snapshot).replace(/</g, '\\u003c');
---

<div id="activity-board" set:html={html} />
<script type="application/json" id="activity-snapshot" set:html={embedded} />
<script type="application/json" id="activity-pages" set:html={embeddedPages} />

<script>
  import {
    renderActivityBoard,
    type ActivitySnapshot,
    type PagePaths,
  } from '../lib/activity-board';

  const REFRESH_MS = 5 * 60 * 1000;

  function initActivityBoard() {
    const root = document.getElementById('activity-board');
    const raw = document.getElementById('activity-snapshot')?.textContent;
    if (!root || !raw || root.dataset.live) return;
    root.dataset.live = 'true';

    const pages: PagePaths = JSON.parse(
      document.getElementById('activity-pages')?.textContent ?? '{}'
    );

    const paint = (data: ActivitySnapshot) => {
      root.innerHTML = renderActivityBoard(data, new Date(), pages);
    };

    paint(JSON.parse(raw));

    const refresh = async () => {
      try {
        const response = await fetch('/api/activity.json', {
          signal: AbortSignal.timeout(15000),
        });
        if (!response.ok) return;
        const data = (await response.json()) as ActivitySnapshot & { error?: string };
        if (data.error || !Array.isArray(data.repos)) return;
        paint(data);
      } catch {
        // The build-time snapshot stays on screen when the live feed is unavailable.
      }
    };

    refresh();
    setInterval(() => {
      if (!document.hidden) refresh();
    }, REFRESH_MS);
  }

  initActivityBoard();
  document.addEventListener('astro:after-swap', initActivityBoard);
</script>
