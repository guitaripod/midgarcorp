---
import { LINUX_SHOWCASE, shotSrcset, type LinuxApp, linuxMax } from '@data/linux';
import {
  FORM_GLYPHS,
  FRESHNESS_STYLE,
  ageLabel,
  freshness,
  languageColor,
} from '../lib/linux-insights';
import LinuxInstall from './LinuxInstall.astro';
import WorkWeight from './WorkWeight.astro';

export interface Props {
  app: LinuxApp;
  now: Date;
  flip?: boolean;
  eager?: boolean;
}

const { app, now, flip = false, eager = false } = Astro.props;
const showcase = LINUX_SHOWCASE[app.id];
const status = freshness(app.latestReleaseDate, now);
const style = FRESHNESS_STYLE[status];
const releaseStamp = app.latestReleaseDate ? app.latestReleaseDate.slice(0, 10) : null;
const targetUrl = app.homepageUrl ?? app.githubUrl;
const linkClass =
  'text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors';
---

<article
  id={app.id}
  class="flagship group grid scroll-mt-24 lg:grid-cols-12 gap-6 lg:gap-10 items-center"
  style={`--accent: ${showcase.accent}`}
>
  <div class:list={['lg:col-span-7', flip && 'lg:order-2']}>
    <figure class="flagship-shot">
      <img
        src={showcase.shot.src}
        srcset={shotSrcset(showcase.shot)}
        sizes="(min-width: 1024px) 640px, 100vw"
        alt={showcase.shot.alt}
        width={showcase.shot.w}
        height={showcase.shot.h}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        class="block w-full h-auto"
      />
    </figure>
    {
      showcase.more.length > 0 && (
        <div class="grid grid-cols-2 gap-3 sm:gap-4 mt-3 sm:mt-4">
          {showcase.more.map((shot) => (
            <figure class="flagship-shot flagship-thumb">
              <img
                src={shot.src}
                srcset={shotSrcset(shot)}
                sizes="(min-width: 1024px) 310px, 50vw"
                alt={shot.alt}
                width={shot.w}
                height={shot.h}
                loading="lazy"
                decoding="async"
                class="block w-full h-auto"
              />
            </figure>
          ))}
        </div>
      )
    }
  </div>

  <div class:list={['lg:col-span-5 min-w-0', flip && 'lg:order-1']}>
    <p class="text-xs text-paper-muted dark:text-term-faint mb-2">
      {FORM_GLYPHS[app.form]} · {app.formLabel}
    </p>
    <h3 class="text-2xl sm:text-3xl font-bold tracking-tight mb-3">
      <a
        href={targetUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-paper-text dark:text-term-text hover:text-paper-green dark:hover:text-term-green transition-colors"
      >
        {app.name}
      </a>
    </h3>

    <div
      class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mb-4 text-xs text-paper-muted dark:text-term-muted"
    >
      {
        app.latestVersion && (
          <span class="px-1.5 py-0.5 rounded-sm border border-paper-green dark:border-term-green text-paper-green dark:text-term-green font-semibold">
            v{app.latestVersion}
          </span>
        )
      }
      <span class="inline-flex items-center gap-1.5" title={style.title}>
        <span class={`w-1.5 h-1.5 rounded-full ${style.dot}`} aria-hidden="true"></span>
        <span class={style.text}>updated {ageLabel(app.latestReleaseDate, now)}</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span
          class="w-2 h-2 rounded-full"
          style={`background:${languageColor(app.language)}`}
          aria-hidden="true"></span>
        {app.language}
      </span>
      {
        app.stars > 0 && (
          <span class="text-paper-amber dark:text-term-amber whitespace-nowrap">★ {app.stars}</span>
        )
      }
    </div>

    <p class="text-sm sm:text-base text-paper-muted dark:text-term-muted leading-relaxed mb-4">
      {showcase.blurb}
    </p>

    <div class="mb-4">
      <WorkWeight
        commits={app.commitCount}
        releases={app.releaseCount}
        maxCommits={linuxMax.commits}
        maxReleases={linuxMax.releases}
      />
    </div>

    {
      app.note && (
        <p class="mb-4 text-xs">
          <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-sm border border-paper-border2 dark:border-term-border2 text-paper-text dark:text-term-text">
            <span class="text-paper-amber dark:text-term-amber" aria-hidden="true">
              ◆
            </span>
            {app.note}
          </span>
        </p>
      )
    }

    <LinuxInstall name={app.name} channels={app.install.all} large />

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-4 text-sm">
      {
        app.hasLinuxBinary && app.linuxBinaryUrl && (
          <a
            href={app.linuxBinaryUrl}
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-sm font-bold hover:opacity-90 transition-opacity"
          >
            download x86_64 ↓
          </a>
        )
      }
      <a href={app.githubUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
        source ↗
      </a>
      {
        app.homepageUrl && (
          <a href={app.homepageUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
            docs ↗
          </a>
        )
      }
      <a href={app.latestReleaseUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
        releases{releaseStamp ? ` · ${releaseStamp}` : ''} ↗
      </a>
    </div>
  </div>
</article>

<style>
  .flagship-shot {
    position: relative;
    isolation: isolate;
    margin: 0;
    border-radius: 0.5rem;
    overflow: visible;
  }

  .flagship-shot::before {
    content: '';
    position: absolute;
    inset: 8% 4% -6%;
    z-index: -1;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.16;
    filter: blur(48px);
    transition: opacity 0.4s;
  }

  :global(.dark) .flagship-shot::before {
    opacity: 0.28;
  }

  .flagship:hover .flagship-shot::before {
    opacity: 0.3;
  }

  :global(.dark) .flagship:hover .flagship-shot::before {
    opacity: 0.42;
  }

  .flagship-shot img {
    border-radius: 0.5rem;
    border: 1px solid rgba(128, 128, 128, 0.28);
    box-shadow: 0 18px 44px -22px rgba(0, 0, 0, 0.55);
    background: #0d1117;
  }

  .flagship-thumb::before {
    inset: 12% 8% -4%;
    filter: blur(28px);
  }

  .flagship-thumb img {
    border-radius: 0.375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .flagship-shot::before {
      transition: none;
    }
  }
</style>
