---
export interface Props {
  project: {
    id: string;
    name: string;
    description: string;
    language: string;
    platforms: string[];
    stars: number;
    githubUrl: string;
    category: string;
    highlights: string[];
    releaseCount?: number;
    commitCount?: number;
    homepageUrl?: string;
  };
}

const { project } = Astro.props;

const languageColors: Record<string, string> = {
  Go: '#00ADD8',
  Swift: '#FA7343',
  Rust: '#CE422B',
  TypeScript: '#3178C6',
  Python: '#3572A5',
  Astro: '#FF5D01',
  Lua: '#5B5BD6',
  'C++': '#F34B7D',
};

const categoryGlyphs: Record<string, string> = {
  'AI & Agents': '[ai]',
  'CLI Tools': '[cli]',
  'Swift Packages': '[pkg]',
  Apps: '[app]',
  'SDKs & Libraries': '[sdk]',
};

const glyph = categoryGlyphs[project.category] ?? '[src]';
const languageColor = languageColors[project.language] ?? '#9198a1';
const releaseCount = project.releaseCount ?? 0;
---

<article class="group term-frame term-frame-hover p-4 sm:p-5 flex flex-col">
  <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="block flex-1">
    <div class="flex items-baseline justify-between gap-3 mb-2">
      <div class="flex items-baseline gap-2 min-w-0">
        <span class="text-xs text-paper-faint dark:text-term-faint flex-shrink-0">{glyph}</span>
        <h3
          class="text-sm sm:text-base font-semibold text-paper-text dark:text-term-text group-hover:text-paper-green dark:group-hover:text-term-green transition-colors truncate"
        >
          {project.name}
        </h3>
      </div>
      <div class="flex items-baseline gap-3 flex-shrink-0 text-xs">
        {
          project.stars > 0 && (
            <span class="text-paper-amber dark:text-term-amber">★ {project.stars}</span>
          )
        }
        {
          releaseCount > 0 && (
            <span class="text-paper-muted dark:text-term-muted">r{releaseCount}</span>
          )
        }
      </div>
    </div>

    <p
      class="text-xs sm:text-sm text-paper-muted dark:text-term-muted leading-relaxed line-clamp-2"
    >
      {project.description}
    </p>
  </a>

  <div
    class="flex items-center justify-between gap-3 mt-3 pt-3 border-t border-paper-border dark:border-term-border text-xs"
  >
    <span class="flex items-center gap-1.5 text-paper-faint dark:text-term-faint">
      <span
        class="w-2 h-2 rounded-full flex-shrink-0"
        style={`background-color: ${languageColor}`}
        aria-hidden="true"></span>
      {project.language}
    </span>
    {
      project.homepageUrl && (
        <a
          href={project.homepageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-paper-greendim dark:text-term-greendim hover:text-paper-green dark:hover:text-term-green transition-colors"
        >
          docs ↗
        </a>
      )
    }
  </div>
</article>
