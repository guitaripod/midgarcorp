---

---

<button
  id="search-button"
  type="button"
  class="p-2 rounded-sm text-paper-muted dark:text-term-muted hover:text-paper-green dark:hover:text-term-green hover:bg-paper-panel dark:hover:bg-term-panel transition-colors"
  aria-label="Search (Cmd+K)"
  title="Search (⌘K)"
>
  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
  </svg>
</button>

<div id="search-modal" class="hidden fixed inset-0 z-50 overflow-y-auto">
  <div class="flex min-h-screen items-start justify-center p-4 pt-[12vh]">
    <div class="fixed inset-0 bg-black bg-opacity-75 transition-opacity" aria-hidden="true"></div>

    <div
      class="relative w-full max-w-2xl bg-paper-bg dark:bg-term-panel border border-paper-border dark:border-term-border rounded-sm shadow-2xl"
    >
      <div
        class="flex items-center gap-2 px-4 py-2 border-b border-paper-border dark:border-term-border text-xs text-paper-muted dark:text-term-muted"
      >
        <span class="text-paper-green dark:text-term-green">$</span>
        <span>grep -r "..." ~/midgar</span>
        <span class="ml-auto">esc to close</span>
      </div>
      <div class="p-4">
        <div id="search"></div>
      </div>
    </div>
  </div>
</div>

<script>
  function initSearch() {
    const searchButton = document.getElementById('search-button');
    const searchModal = document.getElementById('search-modal');

    if (!searchButton || !searchModal) return;

    let pagefindLoading = false;
    let lastFocused = null;

    const focusSearchInput = (attempt = 0) => {
      const input = searchModal.querySelector('.pagefind-ui__search-input');
      if (input) {
        input.focus();
      } else if (attempt < 30) {
        setTimeout(() => focusSearchInput(attempt + 1), 100);
      }
    };

    const openModal = () => {
      lastFocused = document.activeElement;
      searchModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      if (!window.PagefindUI && !pagefindLoading) {
        pagefindLoading = true;
        const script = document.createElement('script');
        script.src = '/pagefind/pagefind-ui.js';
        script.onload = () => {
          new window.PagefindUI({
            element: '#search',
            showSubResults: true,
            showImages: false,
            resetStyles: false,
          });
          focusSearchInput();
        };
        document.head.appendChild(script);

        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(link);
      } else {
        focusSearchInput();
      }
    };

    const closeModal = () => {
      searchModal.classList.add('hidden');
      document.body.style.overflow = '';
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
    };

    searchButton.addEventListener('click', openModal);

    searchModal.addEventListener('click', (e) => {
      if (e.target === searchModal || e.target.classList.contains('bg-opacity-75')) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !searchModal.classList.contains('hidden')) {
        closeModal();
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (searchModal.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initSearch);
  document.addEventListener('astro:after-swap', initSearch);
</script>
