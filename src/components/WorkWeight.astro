---
import { barFraction } from '../lib/work';

export interface Props {
  commits: number;
  releases?: number;
  maxCommits: number;
  maxReleases?: number;
}

const { commits, releases, maxCommits, maxReleases = 1 } = Astro.props;

const rows = [
  {
    label: 'commits',
    value: commits,
    fill: barFraction(commits, maxCommits),
    bar: 'bg-paper-green dark:bg-term-green',
  },
  ...(releases === undefined
    ? []
    : [
        {
          label: 'releases',
          value: releases,
          fill: barFraction(releases, maxReleases),
          bar: 'bg-paper-amber dark:bg-term-amber',
        },
      ]),
];
---

<dl class:list={['grid gap-x-4', rows.length > 1 ? 'grid-cols-2' : 'grid-cols-1']}>
  {
    rows.map((row) => (
      <div>
        <div class="flex items-baseline justify-between text-[11px] leading-none mb-1.5">
          <dt class="text-paper-muted dark:text-term-faint">{row.label}</dt>
          <dd class="font-semibold text-paper-text dark:text-term-text tabular-nums">
            {row.value}
          </dd>
        </div>
        <div class="h-1 rounded-sm overflow-hidden bg-paper-raised dark:bg-term-raised">
          <div class={`h-full rounded-sm ${row.bar}`} style={`width:${row.fill * 100}%`} />
        </div>
      </div>
    ))
  }
</dl>
