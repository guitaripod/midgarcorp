---
export interface Props {
  accent: string;
  iconSrc?: string;
}

const { accent, iconSrc = '/unrager-icon.png' } = Astro.props;
---

<figure class="arch" style={`--accent:${accent}`} aria-labelledby="arch-caption">
  <div
    class="term-frame relative overflow-hidden p-5 sm:p-8"
    role="img"
    aria-label="How unrager works: chaotic, rage-baity tweets are pulled from X using your own browser session, passed through a local rage filter powered by Ollama running on your Mac, and the resulting calm feed is served over a private Tailscale tunnel to the terminal, iOS, and macOS clients."
  >
    <span class="arch-spine" aria-hidden="true"></span>

    <div class="arch-flow">
      <!-- STAGE 1 — X (source) -->
      <div class="arch-stage" data-stage="source">
        <p class="arch-kicker">source</p>
        <div class="arch-node arch-node--x">
          <div class="arch-node-head">
            <span class="arch-glyph arch-glyph--x" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path>
              </svg>
            </span>
            <div>
              <p class="arch-node-title">X (Twitter)</p>
              <p class="arch-node-sub">the firehose</p>
            </div>
          </div>
          <ul class="arch-stream arch-stream--noisy" aria-hidden="true">
            <li class="t t-rage"><span></span><span></span><span></span></li>
            <li class="t t-rage"><span></span><span></span></li>
            <li class="t t-bait"><span></span><span></span><span></span></li>
            <li class="t t-rage"><span></span><span></span></li>
            <li class="t t-bait"><span></span></li>
          </ul>
          <p class="arch-node-note">rage-bait, dunks, outrage</p>
        </div>
      </div>

      <!-- LINK 1 -->
      <div class="arch-link" data-link="1">
        <span class="arch-link-label">cookies → GraphQL</span>
        <svg class="arch-arrow" viewBox="0 0 120 24" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="arch-g-in" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.15"></stop>
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.7"></stop>
            </linearGradient>
          </defs>
          <line class="arch-arrow-track" x1="2" y1="12" x2="106" y2="12" stroke="url(#arch-g-in)"
          ></line>
          <path class="arch-arrow-head" d="M104 6 L116 12 L104 18" fill="none"></path>
          <circle class="arch-dot arch-dot--rage d1" cx="0" cy="12" r="3"></circle>
          <circle class="arch-dot arch-dot--rage d2" cx="0" cy="12" r="3"></circle>
        </svg>
        <span class="arch-link-foot">no API key · free reads</span>
      </div>

      <!-- STAGE 2 — the rage filter / unrager serve (CENTERPIECE) -->
      <div class="arch-stage arch-stage--core" data-stage="core">
        <p class="arch-kicker arch-kicker--accent">the rage filter · on your Mac</p>
        <div class="arch-node arch-node--core">
          <span class="arch-mac" aria-hidden="true">⌘ unrager serve</span>
          <div class="arch-core-ring">
            <img
              src={iconSrc}
              width="96"
              height="96"
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              class="arch-core-icon"
            />
            <span class="arch-core-glow" aria-hidden="true"></span>
          </div>
          <p class="arch-node-title arch-node-title--core">Rust engine</p>
          <p class="arch-node-sub">fetch · classify · serve</p>
          <div class="arch-chip arch-chip--ollama">
            <span class="arch-chip-dot" aria-hidden="true"></span>
            <span>Ollama · local LLM</span>
          </div>
          <p class="arch-node-note arch-node-note--core">
            every tweet → <b>HIDE / KEEP</b><br />Ask · Brief · Translate
          </p>
        </div>
      </div>

      <!-- LINK 2 -->
      <div class="arch-link" data-link="2">
        <span class="arch-link-label">/api + SSE</span>
        <svg class="arch-arrow" viewBox="0 0 120 24" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="arch-g-out" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.7"></stop>
              <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.85"></stop>
            </linearGradient>
          </defs>
          <line class="arch-arrow-track" x1="2" y1="12" x2="106" y2="12" stroke="url(#arch-g-out)"
          ></line>
          <path class="arch-arrow-head arch-arrow-head--calm" d="M104 6 L116 12 L104 18" fill="none"
          ></path>
          <circle class="arch-dot arch-dot--calm d1" cx="0" cy="12" r="3"></circle>
          <circle class="arch-dot arch-dot--calm d2" cx="0" cy="12" r="3"></circle>
          <circle class="arch-dot arch-dot--calm d3" cx="0" cy="12" r="3"></circle>
        </svg>
        <span class="arch-link-foot arch-link-foot--ts">
          <span class="arch-ts-glyph" aria-hidden="true">⛓</span> over Tailscale
        </span>
      </div>

      <!-- STAGE 3 — clients -->
      <div class="arch-stage arch-stage--clients" data-stage="clients">
        <p class="arch-kicker">your devices · the calm feed</p>
        <div class="arch-clients">
          <div class="arch-node arch-node--client">
            <span class="arch-client-glyph" aria-hidden="true">▟</span>
            <p class="arch-client-name">Terminal</p>
            <p class="arch-client-sub">TUI / CLI</p>
            <ul class="arch-stream arch-stream--calm" aria-hidden="true">
              <li class="t t-calm"><span></span><span></span></li>
              <li class="t t-calm"><span></span></li>
              <li class="t t-calm"><span></span><span></span></li>
            </ul>
          </div>
          <div class="arch-node arch-node--client">
            <span class="arch-client-glyph" aria-hidden="true">◍</span>
            <p class="arch-client-name">iPhone</p>
            <p class="arch-client-sub">UIKit</p>
            <ul class="arch-stream arch-stream--calm" aria-hidden="true">
              <li class="t t-calm"><span></span><span></span></li>
              <li class="t t-calm"><span></span></li>
              <li class="t t-calm"><span></span><span></span></li>
            </ul>
          </div>
          <div class="arch-node arch-node--client">
            <span class="arch-client-glyph" aria-hidden="true">▣</span>
            <p class="arch-client-name">Mac</p>
            <p class="arch-client-sub">AppKit</p>
            <ul class="arch-stream arch-stream--calm" aria-hidden="true">
              <li class="t t-calm"><span></span><span></span></li>
              <li class="t t-calm"><span></span></li>
              <li class="t t-calm"><span></span><span></span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <figcaption id="arch-caption" class="arch-caption">
    Chaotic tweets are pulled from X with your own session, sifted through a local rage filter on
    your Mac, and the calm feed is served over your private Tailnet to every device.
  </figcaption>
</figure>

<style>
  .arch {
    margin: 0;
  }

  .arch-spine {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 3px;
    background: var(--accent);
    opacity: 0.55;
  }

  .arch-flow {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    align-items: stretch;
  }

  /* desktop: horizontal flow */
  @media (min-width: 900px) {
    .arch-flow {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.15fr) auto minmax(0, 1.6fr);
      gap: 0.75rem;
      align-items: center;
    }
  }

  .arch-stage {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .arch-kicker {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: theme('colors.paper.faint');
    margin: 0;
  }
  :global(.dark) .arch-kicker {
    color: theme('colors.term.faint');
  }
  .arch-kicker--accent {
    color: color-mix(in srgb, var(--accent), #000 30%);
    font-weight: 700;
  }
  :global(.dark) .arch-kicker--accent {
    color: var(--accent);
    text-shadow: 0 0 8px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .arch-node {
    border: 1px solid theme('colors.paper.border');
    background: theme('colors.paper.raised');
    border-radius: 2px;
    padding: 0.85rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }
  :global(.dark) .arch-node {
    border-color: theme('colors.term.border');
    background: theme('colors.term.raised');
  }

  .arch-node-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .arch-node-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    color: theme('colors.paper.text');
    line-height: 1.1;
  }
  :global(.dark) .arch-node-title {
    color: theme('colors.term.text');
  }
  .arch-node-sub {
    margin: 0;
    font-size: 0.7rem;
    color: theme('colors.paper.muted');
  }
  :global(.dark) .arch-node-sub {
    color: theme('colors.term.muted');
  }
  .arch-node-note {
    margin: 0;
    font-size: 0.68rem;
    line-height: 1.35;
    color: theme('colors.paper.faint');
  }
  :global(.dark) .arch-node-note {
    color: theme('colors.term.faint');
  }

  .arch-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 2px;
    flex: none;
  }
  .arch-glyph--x {
    color: theme('colors.paper.text');
    background: color-mix(in srgb, theme('colors.paper.text') 8%, transparent);
    border: 1px solid theme('colors.paper.border2');
  }
  .arch-glyph--x svg {
    width: 1rem;
    height: 1rem;
  }
  :global(.dark) .arch-glyph--x {
    color: theme('colors.term.text');
    background: color-mix(in srgb, theme('colors.term.text') 10%, transparent);
    border-color: theme('colors.term.border2');
  }

  /* mini tweet streams */
  .arch-stream {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
    width: 100%;
    overflow: hidden;
  }
  .arch-stream .t {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    min-width: 0;
  }
  .arch-stream .t span {
    height: 0.42rem;
    border-radius: 1px;
    flex: 1;
  }
  .arch-stream .t span:first-child {
    flex: none;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
  }
  .t-rage span {
    background: color-mix(in srgb, theme('colors.paper.red') 70%, transparent);
  }
  .t-bait span {
    background: color-mix(in srgb, theme('colors.paper.amber') 65%, transparent);
  }
  :global(.dark) .t-rage span {
    background: color-mix(in srgb, theme('colors.term.red') 75%, transparent);
  }
  :global(.dark) .t-bait span {
    background: color-mix(in srgb, theme('colors.term.amber') 70%, transparent);
  }
  .t-calm span {
    background: color-mix(in srgb, var(--accent) 60%, transparent);
  }

  /* links / arrows */
  .arch-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    padding: 0.35rem 0;
    min-width: 0;
  }
  .arch-link-label {
    font-size: 0.66rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--accent), #000 28%);
    white-space: nowrap;
  }
  :global(.dark) .arch-link-label {
    color: var(--accent);
  }
  .arch-link-foot {
    font-size: 0.6rem;
    color: theme('colors.paper.faint');
    white-space: nowrap;
  }
  :global(.dark) .arch-link-foot {
    color: theme('colors.term.faint');
  }
  .arch-link-foot--ts {
    color: color-mix(in srgb, var(--accent), #000 24%);
    font-weight: 600;
  }
  :global(.dark) .arch-link-foot--ts {
    color: var(--accent);
  }
  .arch-ts-glyph {
    font-size: 0.7rem;
  }

  .arch-arrow {
    width: 100%;
    height: 22px;
    overflow: visible;
  }
  /* mobile: arrows point down */
  @media (max-width: 899.98px) {
    .arch-link {
      flex-direction: row;
      gap: 0.5rem;
      padding: 0.15rem 0;
    }
    .arch-arrow {
      width: 56px;
      height: 26px;
      transform: rotate(90deg);
      flex: none;
    }
  }

  .arch-arrow-track {
    stroke-width: 2;
    stroke-dasharray: 4 4;
  }
  .arch-arrow-head {
    stroke: color-mix(in srgb, var(--accent) 80%, transparent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .arch-arrow-head--calm {
    stroke: var(--accent);
  }

  .arch-dot {
    opacity: 0;
  }
  .arch-dot--rage {
    fill: theme('colors.paper.red');
  }
  :global(.dark) .arch-dot--rage {
    fill: theme('colors.term.red');
  }
  .arch-dot--calm {
    fill: var(--accent);
  }

  @keyframes arch-flow-dot {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      transform: translateX(112px);
      opacity: 0;
    }
  }
  .arch-dot.d1 {
    animation: arch-flow-dot 2.4s linear infinite;
  }
  .arch-dot.d2 {
    animation: arch-flow-dot 2.4s linear infinite 0.8s;
  }
  .arch-dot.d3 {
    animation: arch-flow-dot 2.4s linear infinite 1.6s;
  }

  /* core node */
  .arch-stage--core .arch-node--core {
    align-items: center;
    text-align: center;
    gap: 0.4rem;
    border-color: color-mix(in srgb, var(--accent) 45%, theme('colors.paper.border'));
    background: color-mix(in srgb, var(--accent) 6%, theme('colors.paper.panel'));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  :global(.dark) .arch-stage--core .arch-node--core {
    border-color: color-mix(in srgb, var(--accent) 55%, theme('colors.term.border'));
    background: color-mix(in srgb, var(--accent) 8%, theme('colors.term.panel'));
    box-shadow:
      0 0 24px color-mix(in srgb, var(--accent) 22%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--accent) 26%, transparent);
  }

  .arch-mac {
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: theme('colors.paper.muted');
    background: theme('colors.paper.raised');
    border: 1px solid theme('colors.paper.border');
    border-radius: 2px;
    padding: 0.1rem 0.4rem;
  }
  :global(.dark) .arch-mac {
    color: theme('colors.term.muted');
    background: theme('colors.term.raised');
    border-color: theme('colors.term.border');
  }

  .arch-core-ring {
    position: relative;
    width: 76px;
    height: 76px;
    display: grid;
    place-items: center;
  }
  .arch-core-icon {
    width: 72px;
    height: 72px;
    border-radius: 12px;
    position: relative;
    z-index: 1;
  }
  .arch-core-glow {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 40%, transparent),
      transparent 68%
    );
    z-index: 0;
    animation: arch-pulse 3.4s ease-in-out infinite;
  }
  @keyframes arch-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.94);
    }
    50% {
      opacity: 0.95;
      transform: scale(1.06);
    }
  }

  .arch-node-title--core {
    margin-top: 0.1rem;
  }
  .arch-node-note--core {
    color: theme('colors.paper.muted');
  }
  :global(.dark) .arch-node-note--core {
    color: theme('colors.term.muted');
  }
  .arch-node-note--core b {
    color: color-mix(in srgb, var(--accent), #000 26%);
    font-weight: 700;
  }
  :global(.dark) .arch-node-note--core b {
    color: var(--accent);
  }

  .arch-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.66rem;
    font-weight: 600;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
    color: color-mix(in srgb, var(--accent), #000 26%);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
  }
  :global(.dark) .arch-chip {
    color: var(--accent);
  }
  .arch-chip-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: theme('colors.paper.greendim');
    box-shadow: 0 0 0 0 color-mix(in srgb, theme('colors.paper.greendim') 60%, transparent);
    animation: arch-blink 1.8s ease-in-out infinite;
  }
  :global(.dark) .arch-chip-dot {
    background: theme('colors.term.green');
  }
  @keyframes arch-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  /* clients */
  .arch-clients {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  @media (max-width: 479.98px) {
    .arch-clients {
      grid-template-columns: 1fr;
    }
    .arch-node--client {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      text-align: left;
      gap: 0.1rem 0.55rem;
    }
    .arch-node--client .arch-client-glyph {
      order: 0;
    }
    .arch-node--client .arch-client-name {
      order: 1;
    }
    .arch-node--client .arch-client-sub {
      order: 2;
    }
    .arch-node--client .arch-stream--calm {
      order: 3;
      flex-basis: 100%;
      margin-top: 0.15rem;
    }
  }
  .arch-node--client {
    align-items: center;
    text-align: center;
    gap: 0.3rem;
    padding: 0.7rem 0.45rem;
    min-width: 0;
    border-color: color-mix(in srgb, var(--accent) 28%, theme('colors.paper.border'));
  }
  :global(.dark) .arch-node--client {
    border-color: color-mix(in srgb, var(--accent) 30%, theme('colors.term.border'));
  }
  .arch-client-glyph {
    font-size: 1.15rem;
    line-height: 1;
    color: color-mix(in srgb, var(--accent), #000 26%);
  }
  :global(.dark) .arch-client-glyph {
    color: var(--accent);
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .arch-client-name {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    color: theme('colors.paper.text');
  }
  :global(.dark) .arch-client-name {
    color: theme('colors.term.text');
  }
  .arch-client-sub {
    margin: 0;
    font-size: 0.62rem;
    color: theme('colors.paper.faint');
  }
  :global(.dark) .arch-client-sub {
    color: theme('colors.term.faint');
  }
  .arch-stream--calm {
    width: 100%;
    margin-top: 0.2rem;
    gap: 0.22rem;
  }

  .arch-caption {
    margin-top: 0.9rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: theme('colors.paper.muted');
    max-width: 56rem;
  }
  :global(.dark) .arch-caption {
    color: theme('colors.term.muted');
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-dot,
    .arch-core-glow,
    .arch-chip-dot {
      animation: none !important;
    }
    .arch-dot {
      opacity: 0.85;
    }
    .arch-dot.d1 {
      transform: translateX(38px);
    }
    .arch-dot.d2 {
      transform: translateX(74px);
    }
    .arch-dot.d3 {
      transform: translateX(56px);
    }
  }
</style>
