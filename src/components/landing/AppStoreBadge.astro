---
export interface Props {
  href: string;
  platform?: 'ios' | 'mac' | 'tv';
  comingSoon?: boolean;
  class?: string;
}

const { href, platform = 'ios', comingSoon = false, class: className = '' } = Astro.props;

const bottomLine = platform === 'mac' ? 'Mac App Store' : 'App Store';
const topLine = comingSoon ? 'Coming soon to the' : 'Download on the';
const label = comingSoon ? `Coming soon to the ${bottomLine}` : `Download on the ${bottomLine}`;

const Wrapper = comingSoon ? 'span' : 'a';
const wrapperProps = comingSoon
  ? {
      class: `inline-flex items-center opacity-90 grayscale-[0.25] cursor-default ${className}`,
      title: 'In App Store review — available very soon',
      'aria-label': label,
    }
  : {
      href,
      target: '_blank',
      rel: 'noopener noreferrer',
      class: `inline-flex items-center transition-transform hover:scale-[1.03] focus-visible:scale-[1.03] ${className}`,
      'aria-label': label,
    };
---

<Wrapper {...wrapperProps}>
  <svg
    viewBox="0 0 162 54"
    role="img"
    aria-label={label}
    class="h-12 w-auto"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect x="1" y="1" width="160" height="52" rx="11" fill="#000" stroke="#A6A6A6" stroke-width="1"
    ></rect>
    <g transform="translate(20 14.5)" fill="#fff">
      <path
        d="M14.27 13.04c-.02-2.43 1.99-3.6 2.08-3.66-1.13-1.66-2.9-1.89-3.53-1.91-1.5-.15-2.93.88-3.69.88-.76 0-1.94-.86-3.19-.84-1.64.02-3.15.95-4 2.42-1.71 2.97-.44 7.36 1.22 9.77.81 1.18 1.78 2.5 3.05 2.46 1.22-.05 1.69-.79 3.17-.79 1.48 0 1.9.79 3.19.76 1.32-.02 2.15-1.2 2.96-2.39.94-1.37 1.33-2.7 1.35-2.77-.03-.01-2.59-.99-2.61-3.94zM11.84 5.88c.67-.82 1.13-1.95 1-3.09-.97.04-2.16.65-2.86 1.46-.62.72-1.17 1.89-1.02 2.99 1.09.08 2.2-.55 2.88-1.36z"
      ></path>
    </g>
    <text
      x="46"
      y="20"
      fill="#fff"
      font-family="system-ui, -apple-system, Helvetica, Arial, sans-serif"
      font-size="9"
      letter-spacing="0.2">{topLine}</text
    >
    <text
      x="45"
      y="40"
      fill="#fff"
      font-family="system-ui, -apple-system, Helvetica, Arial, sans-serif"
      font-size="20"
      font-weight="600"
      letter-spacing="-0.3">{bottomLine}</text
    >
  </svg>
</Wrapper>
