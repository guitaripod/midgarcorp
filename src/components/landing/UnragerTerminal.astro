---
/**
 * The unrager terminal client, drawn in HTML: the Following timeline with
 * twelve posts filtered out. Every account and post here is made up.
 */
const rows = [
  {
    handle: 'mira_bakes',
    hue: 'gold',
    ago: '2m',
    stats: '↳ 4  ♥ 38  ◉ 1.2K',
    text: "Day 3 of the new sourdough starter. It smells like green apples, which I'm told is good news.",
  },
  {
    handle: 'kestrel_dev',
    hue: 'foam',
    ago: '16m',
    stats: '↳ 11  ♥ 205  ◉ 8.4K',
    text: 'Shipped v2 of my tiny CLI. Startup went from 180 ms to 9 ms by deleting one dependency.',
  },
  {
    handle: 'harborlight',
    hue: 'iris',
    ago: '23m',
    media: '▶',
    stats: '↳ 2  ♥ 91  ◉ 3.1K',
    text: 'Morning ferry. The fog was sitting right on the water and nobody said a word.',
  },
  {
    handle: 'ada_plots',
    hue: 'love',
    ago: '41m',
    stats: '↳ 7  ♥ 132  ◉ 5.6K',
    text: 'The new paper on sparse attention is unusually readable. My notes are in the thread.',
  },
  {
    handle: 'tomas_climbs',
    hue: 'leaf',
    ago: '58m',
    image: '▣',
    stats: '↳ 3  ♥ 64  ◉ 2.2K',
    text: "Finally sent the route I've been falling off since April. Hands shredded, heart full.",
  },
  {
    handle: 'priya_maps',
    hue: 'rose',
    ago: '1h',
    stats: '↳ 9  ♥ 310  ◉ 12K',
    text: 'Made a map of every bench in my neighborhood. There are 212. I have sat on 40.',
  },
];
---

<figure
  class="utm"
  aria-label="The unrager terminal client: the Following timeline, with twelve posts filtered out"
>
  <div class="utm-bar" aria-hidden="true">
    <span class="utm-lights"><i></i><i></i><i></i></span>
    <span class="utm-title">unrager</span>
  </div>
  <div class="utm-screen" aria-hidden="true">
    <p class="utm-top">
      <span class="utm-brand">unrager</span> home: Following <span class="utm-filter">−12</span>
      <span class="utm-mode">◇</span>
      <span class="utm-notes">2n</span>
    </p>
    <div class="utm-pane">
      <span class="utm-pane-title">home: Following</span>
      {
        rows.map((r, i) => (
          <div class={i === 0 ? 'utm-row is-selected' : 'utm-row'}>
            <p class="utm-meta">
              <b class={`h-${r.hue}`}>@{r.handle}</b> <span class="utm-check">✓</span>
              <span class="utm-dim">·</span> {r.ago}
              {r.media && <span class="utm-media">{r.media}</span>}
              {r.image && <span class="utm-image">{r.image}</span>}
              <span class="utm-stats">{r.stats}</span>
            </p>
            <p class="utm-text">{r.text}</p>
          </div>
        ))
      }
    </div>
    <p class="utm-status">
      <span class="utm-normal">NORMAL</span> 1/58 <span class="utm-dim">? for help</span><span
        class="utm-clock"><b>9:41 AM</b> · Sat, Sep 27</span
      >
    </p>
  </div>
</figure>

<style>
  .utm {
    --t-bg: #1a1a26;
    --t-ink: #d9d7e8;
    --t-dim: #8a879e;
    --t-blue: #1d9bf0;
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #2b2a3a;
    box-shadow: 0 30px 70px -40px rgba(7, 54, 66, 0.5);
    background: var(--t-bg);
    color: var(--t-ink);
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: clamp(10px, 0.3vw + 7.5px, 12.5px);
    line-height: 1.45;
  }
  .utm p {
    margin: 0;
  }
  .utm-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 12px;
    background: #13131c;
    border-bottom: 1px solid #2b2a3a;
  }
  .utm-lights {
    display: flex;
    gap: 6px;
  }
  .utm-lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #3a3950;
  }
  .utm-title {
    flex: 1;
    margin-right: 44px;
    text-align: center;
    color: var(--t-dim);
    font-size: 12px;
  }
  .utm-screen {
    padding: 10px 12px 8px;
  }
  .utm-top {
    white-space: nowrap;
    overflow: hidden;
  }
  .utm-brand {
    padding: 0 6px;
    background: var(--t-blue);
    color: #0b1220;
    font-weight: 700;
  }
  .utm-filter {
    color: #3dd6a0;
    font-weight: 700;
  }
  .utm-mode {
    color: var(--t-blue);
  }
  .utm-notes {
    color: #c4a7e7;
    font-weight: 700;
  }
  .utm-pane {
    position: relative;
    margin-top: 8px;
    padding: 10px 10px 4px;
    border: 1px solid var(--t-blue);
    border-radius: 3px;
  }
  .utm-pane-title {
    position: absolute;
    top: -0.75em;
    left: 8px;
    padding: 0 4px;
    background: var(--t-bg);
    color: var(--t-blue);
  }
  .utm-row {
    padding: 3px 8px 7px;
    border-left: 3px solid transparent;
  }
  .utm-row.is-selected {
    border-left-color: var(--t-blue);
    background: #232233;
  }
  .utm-meta {
    display: flex;
    gap: 0.6ch;
    white-space: nowrap;
    overflow: hidden;
  }
  .utm-check {
    color: var(--t-blue);
  }
  .utm-dim {
    color: var(--t-dim);
  }
  .utm-media {
    color: #eb6f92;
  }
  .utm-image {
    color: var(--t-blue);
  }
  .utm-stats {
    margin-left: 2ch;
    color: var(--t-dim);
    white-space: pre;
  }
  .utm-text {
    color: #b9b6cc;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .h-gold {
    color: #f6c177;
  }
  .h-foam {
    color: #9ccfd8;
  }
  .h-iris {
    color: #c4a7e7;
  }
  .h-love {
    color: #eb6f92;
  }
  .h-leaf {
    color: #a3d977;
  }
  .h-rose {
    color: #ebbcba;
  }
  .utm-status {
    display: flex;
    gap: 1.5ch;
    align-items: baseline;
    margin-top: 8px !important;
    white-space: nowrap;
    overflow: hidden;
  }
  .utm-normal {
    padding: 0 6px;
    background: #f6c177;
    color: #1a1a26;
    font-weight: 700;
  }
  .utm-clock {
    margin-left: auto;
    color: var(--t-dim);
  }
  .utm-clock b {
    color: #9ccfd8;
  }
</style>
