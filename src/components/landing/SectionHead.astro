---
export interface Props {
  prompt: string;
  title: string;
}

const { prompt, title } = Astro.props;
const hasLede = Astro.slots.has('default');
---

<p class="prompt-line mb-2">{prompt}</p>
<h2
  class:list={[
    'text-2xl font-bold tracking-tight text-paper-text dark:text-term-text',
    hasLede ? 'mb-3' : 'mb-6',
  ]}
>
  {title}
</h2>
{
  hasLede && (
    <p class="mb-6 max-w-2xl text-sm leading-relaxed text-paper-muted dark:text-term-muted">
      <slot />
    </p>
  )
}
