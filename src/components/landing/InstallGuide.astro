---
import type { Install } from '@data/landing';

export interface Props {
  install: Install;
  prompt: string;
  accent: string;
}

const { install, prompt, accent } = Astro.props;

const withCode = (text: string) =>
  text
    .split(/(`[^`]+`)/)
    .map((part) =>
      part.startsWith('`')
        ? `<code class="rounded-sm bg-paper-raised px-1 py-0.5 text-paper-text dark:bg-term-raised dark:text-term-text">${part.slice(1, -1)}</code>`
        : part
    )
    .join('');
---

<section
  id="install"
  class="scroll-mt-20 border-t border-paper-border py-12 dark:border-term-border sm:py-16"
  style={`--accent:${accent}`}
>
  <p class="prompt-line mb-3">{prompt}</p>
  <h2 class="mb-2 text-xl font-bold text-paper-text dark:text-term-text sm:text-2xl">
    {install.title}
    <span class="accent-text">{install.time}</span>
  </h2>
  <p class="mb-6 max-w-2xl text-sm text-paper-muted dark:text-term-muted">
    {install.intro}
  </p>
  <ol class="flex max-w-5xl flex-col gap-4">
    {
      install.steps.map((step, i) => (
        <li class="term-frame grid grid-cols-1 gap-4 p-5 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-center lg:gap-8">
          <div class="flex min-w-0 flex-col gap-2">
            <div class="flex items-center gap-3">
              <span
                class="accent-text inline-flex h-8 w-8 items-center justify-center rounded-sm border border-paper-border font-mono text-base font-bold dark:border-term-border"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <h3 class="text-sm font-bold text-paper-text dark:text-term-text">{step.title}</h3>
            </div>
            <p
              class="text-xs leading-relaxed text-paper-muted dark:text-term-muted sm:text-sm"
              set:html={withCode(step.body)}
            />
            {step.note && (
              <p
                class="text-xs leading-relaxed text-paper-faint dark:text-term-faint"
                set:html={withCode(step.note)}
              />
            )}
          </div>
          {step.code && (
            <div class="flex min-w-0 flex-col gap-2">
              {step.code.map((line) => (
                <div class="flex min-w-0 items-center justify-between gap-3 rounded-md border border-paper-border bg-paper-raised px-3 py-2.5 font-mono text-xs dark:border-term-border dark:bg-term-raised sm:text-[0.8rem]">
                  <code
                    class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap text-paper-text dark:text-term-text"
                    tabindex="0"
                  >
                    <span class="accent-text">$</span> {line}
                  </code>
                  <button
                    type="button"
                    class="copy-cmd shrink-0 rounded-sm border border-paper-border px-2 py-1 text-xs text-paper-muted transition-colors hover:border-paper-border2 hover:text-paper-text dark:border-term-border dark:text-term-muted dark:hover:border-term-border2 dark:hover:text-term-text"
                    data-copy={line}
                    aria-label="Copy command"
                  >
                    <span class="copy-glyph">⧉</span>
                  </button>
                </div>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ol>
  {
    install.guideUrl && (
      <p class="mt-4 text-xs leading-relaxed text-paper-faint dark:text-term-faint">
        The{' '}
        <a
          href={install.guideUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="accent-text underline decoration-dotted underline-offset-2"
        >
          step-by-step guide
        </a>{' '}
        covers every prompt, Linux and Windows setup, and what each error means.
      </p>
    )
  }
</section>

<style>
  .accent-text {
    color: color-mix(in srgb, var(--accent), #000 42%);
  }
  :global(.dark) .accent-text {
    color: color-mix(in srgb, var(--accent), #fff 24%);
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 45%, transparent);
  }
</style>
