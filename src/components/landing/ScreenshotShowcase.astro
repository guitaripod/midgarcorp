---
import DeviceFrame from './DeviceFrame.astro';
import { DEVICE_LABELS, deviceKeys, type LandingApp } from '@data/landing';

export interface Props {
  app: LandingApp;
}

const { app } = Astro.props;
const devices = deviceKeys(app);
const multi = devices.length > 1;
const name = `gallery-${app.slug}`;

const heightClass: Record<string, string> = {
  iphone: 'h-[440px] sm:h-[540px]',
  ipad: 'h-[400px] sm:h-[500px]',
  mac: 'h-[260px] sm:h-[340px]',
  tv: 'h-[240px] sm:h-[320px]',
};

const captionFor = (device: string, i: number) =>
  app.content.screenshotCaptions?.[device]?.[i] ?? app.screenshots[device][i].label;

const gallery = Object.fromEntries(
  devices.map((d) => [
    d,
    app.screenshots[d].map((shot, i) => ({ src: shot.src, caption: captionFor(d, i) })),
  ])
);
---

<section
  aria-label={`${app.shortName} screenshots`}
  class="screenshot-showcase"
  style={`--accent:${app.content.accentColor}`}
>
  {
    multi && (
      <div class="mb-6 flex flex-wrap gap-2" role="tablist" aria-label="Choose a device">
        {devices.map((d, i) => (
          <>
            <input
              type="radio"
              name={name}
              id={`${name}-${d}`}
              class="peer/tab sr-only"
              checked={i === 0}
            />
            <label
              for={`${name}-${d}`}
              data-device={d}
              class="device-tab cursor-pointer select-none rounded-sm border border-paper-border px-3 py-1.5 text-xs font-medium text-paper-muted transition-colors hover:border-paper-border2 dark:border-term-border dark:text-term-muted dark:hover:border-term-border2"
            >
              {DEVICE_LABELS[d] ?? d}
            </label>
          </>
        ))}
      </div>
    )
  }

  <div class="device-panels">
    {
      devices.map((device, di) => (
        <div data-panel={device} class:list={['device-panel', { hidden: di !== 0 }]}>
          <ul
            class={`no-scrollbar flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4 ${heightClass[device] ?? 'h-[440px]'}`}
          >
            {app.screenshots[device].map((shot, i) => (
              <li class="flex h-full shrink-0 snap-start flex-col items-center gap-3">
                <button
                  type="button"
                  class="shot-btn group relative block h-[calc(100%-2rem)] cursor-zoom-in appearance-none border-0 bg-transparent p-0"
                  data-device={device}
                  data-index={i}
                  aria-label={`View ${captionFor(device, i)} full size`}
                >
                  <div class="device-glow h-full">
                    <DeviceFrame
                      device={device}
                      src={shot.src}
                      w={shot.w}
                      h={shot.h}
                      alt={`${app.shortName} — ${captionFor(device, i)}`}
                      eager={di === 0 && i === 0}
                    />
                  </div>
                  <span class="shot-zoom" aria-hidden="true">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M15 3h6v6" />
                      <path d="M9 21H3v-6" />
                      <path d="M21 3l-7 7" />
                      <path d="M3 21l7-7" />
                    </svg>
                  </span>
                </button>
                <p class="max-w-[16rem] text-center text-xs text-paper-muted dark:text-term-muted">
                  {captionFor(device, i)}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <p class="mt-1 text-center text-xs text-paper-faint dark:text-term-faint">
    <span class="sm:hidden">tap a screen to enlarge · swipe to see more →</span>
    <span class="hidden sm:inline">click a screen to enlarge</span>
  </p>

  <dialog class="lightbox" aria-label={`${app.shortName} screenshot viewer`}>
    <button type="button" class="lb-control lb-close" aria-label="Close viewer">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    <button type="button" class="lb-control lb-nav lb-prev" aria-label="Previous screenshot">
      <svg
        width="26"
        height="26"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </button>
    <figure class="lb-figure">
      <img class="lb-img" alt="" />
      <figcaption class="lb-caption"></figcaption>
    </figure>
    <button type="button" class="lb-control lb-nav lb-next" aria-label="Next screenshot">
      <svg
        width="26"
        height="26"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </button>
    <div class="lb-counter" aria-live="polite"></div>
  </dialog>
</section>

<style>
  .device-glow {
    filter: drop-shadow(0 24px 48px color-mix(in srgb, var(--accent) 22%, transparent));
  }

  .shot-btn {
    border-radius: 1.5rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .shot-btn:hover,
  .shot-btn:focus-visible {
    transform: translateY(-4px);
  }
  .shot-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  .shot-zoom {
    position: absolute;
    right: 0.625rem;
    bottom: 0.625rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    color: #fff;
    background: color-mix(in srgb, var(--accent) 78%, black 10%);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.32);
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    pointer-events: none;
  }
  .shot-btn:hover .shot-zoom,
  .shot-btn:focus-visible .shot-zoom {
    opacity: 1;
    transform: scale(1);
  }
  @media (hover: none) {
    .shot-zoom {
      opacity: 1;
      transform: scale(1);
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: rgba(8, 10, 14, 0.82);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .lightbox[open] .lb-figure {
    animation: lb-pop 0.22s ease;
  }
  @keyframes lb-pop {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .lb-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    max-width: 92vw;
  }
  .lb-img {
    width: auto;
    height: auto;
    max-width: 92vw;
    max-height: 82vh;
    border-radius: 1.25rem;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6);
    background: rgba(255, 255, 255, 0.04);
  }
  .lb-caption {
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.875rem;
    text-align: center;
    max-width: 28rem;
  }

  .lb-control {
    position: fixed;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 9999px;
    cursor: pointer;
    transition:
      background 0.15s ease,
      transform 0.15s ease;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .lb-control:hover {
    background: color-mix(in srgb, var(--accent) 70%, black 8%);
  }
  .lb-control:active {
    transform: scale(0.92);
  }
  .lb-close {
    top: max(1rem, env(safe-area-inset-top));
    right: max(1rem, env(safe-area-inset-right));
    width: 2.75rem;
    height: 2.75rem;
  }
  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 3rem;
    height: 3rem;
  }
  .lb-nav:active {
    transform: translateY(-50%) scale(0.92);
  }
  .lb-prev {
    left: clamp(0.5rem, 2vw, 2rem);
  }
  .lb-next {
    right: clamp(0.5rem, 2vw, 2rem);
  }
  .lb-nav[hidden] {
    display: none;
  }
  .lb-counter {
    position: fixed;
    bottom: max(1rem, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .shot-btn,
    .shot-zoom,
    .lightbox[open] .lb-figure {
      transition: none;
      animation: none;
    }
  }
</style>

<script is:inline define:vars={{ name, devices, gallery }}>
  (function () {
    const root = document.currentScript.closest('.screenshot-showcase');
    if (!root) return;

    const radios = devices.map((d) => root.querySelector('#' + name + '-' + d));
    const panels = devices.map((d) => root.querySelector('[data-panel="' + d + '"]'));
    const labels = devices.map((d) => root.querySelector('label[data-device="' + d + '"]'));
    function sync() {
      radios.forEach((r, i) => {
        const on = r && r.checked;
        if (panels[i]) panels[i].classList.toggle('hidden', !on);
        if (labels[i]) {
          labels[i].classList.toggle('border-paper-green', on);
          labels[i].classList.toggle('text-paper-green', on);
          labels[i].classList.toggle('dark:border-term-green', on);
          labels[i].classList.toggle('dark:text-term-green', on);
        }
      });
    }
    radios.forEach((r) => r && r.addEventListener('change', sync));
    sync();

    const dialog = root.querySelector('.lightbox');
    if (!dialog || typeof dialog.showModal !== 'function') return;
    const img = dialog.querySelector('.lb-img');
    const caption = dialog.querySelector('.lb-caption');
    const counter = dialog.querySelector('.lb-counter');
    const prevBtn = dialog.querySelector('.lb-prev');
    const nextBtn = dialog.querySelector('.lb-next');
    const closeBtn = dialog.querySelector('.lb-close');
    let device = devices[0];
    let index = 0;

    function shots() {
      return gallery[device] || [];
    }
    function render() {
      const items = shots();
      const shot = items[index];
      if (!shot) return;
      img.src = shot.src;
      img.alt = shot.caption || '';
      caption.textContent = shot.caption || '';
      counter.textContent = index + 1 + ' / ' + items.length;
      const many = items.length > 1;
      prevBtn.hidden = !many;
      nextBtn.hidden = !many;
    }
    function step(delta) {
      const n = shots().length;
      if (!n) return;
      index = (index + delta + n) % n;
      render();
    }
    function open(d, i) {
      device = d;
      index = i;
      render();
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    }

    root.querySelectorAll('.shot-btn').forEach((btn) => {
      btn.addEventListener('click', () =>
        open(btn.dataset.device, parseInt(btn.dataset.index, 10))
      );
    });
    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));
    closeBtn.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        step(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        step(1);
      }
    });

    let sx = 0;
    let sy = 0;
    dialog.addEventListener(
      'touchstart',
      (e) => {
        const t = e.changedTouches[0];
        sx = t.clientX;
        sy = t.clientY;
      },
      { passive: true }
    );
    dialog.addEventListener(
      'touchend',
      (e) => {
        const t = e.changedTouches[0];
        const dx = t.clientX - sx;
        const dy = t.clientY - sy;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
      },
      { passive: true }
    );
  })();
</script>
