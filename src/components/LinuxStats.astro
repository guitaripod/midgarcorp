---
import type { LinuxApp, LinuxForm } from '@data/linux';
import {
  FORM_NOUNS,
  formShare,
  languageColor,
  languageShare,
  monthlyTotals,
  releasesSince,
} from '../lib/linux-insights';
import ShareBar from './ShareBar.astro';
import StatCell from './StatCell.astro';

export interface Props {
  apps: LinuxApp[];
  now: Date;
}

const { apps, now } = Astro.props;

const formBars: Record<string, string> = {
  gui: 'bg-paper-green dark:bg-term-green',
  daemon: 'bg-paper-amber dark:bg-term-amber',
  tui: 'bg-paper-greendim dark:bg-term-greendim',
  cli: 'bg-paper-border2 dark:bg-term-border2',
};

const forms = formShare(apps).map((form) => ({
  label: FORM_NOUNS[form.key as LinuxForm],
  count: form.count,
  fraction: form.fraction,
  barClass: formBars[form.key],
}));
const languages = languageShare(apps).map((language) => ({
  label: language.key,
  count: language.count,
  fraction: language.fraction,
  color: languageColor(language.key),
}));
const releaseCount = apps.reduce((sum, app) => sum + app.releaseCount, 0);
const recentReleases = releasesSince(apps, 90, now);
const months = monthlyTotals(apps, 12, now);
const peak = Math.max(1, ...months.map((month) => month.count));
const commitCount = apps.reduce((sum, app) => sum + app.commitCount, 0);
const commitLeader = [...apps].sort((a, b) => b.commitCount - a.commitCount)[0];

const BAR_W = 8;
const BAR_GAP = 3;
const BAR_H = 28;
const sparkWidth = months.length * (BAR_W + BAR_GAP) - BAR_GAP;
const bars = months.map((month, index) => ({
  x: index * (BAR_W + BAR_GAP),
  height: month.count === 0 ? 2 : Math.max(4, Math.round((month.count / peak) * BAR_H)),
  label: `${month.key} · ${month.count} ${month.count === 1 ? 'release' : 'releases'}`,
}));
---

<div class="term-frame p-5 sm:p-6">
  <p class="prompt-line mb-5">linux --stats</p>
  <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-7">
    <StatCell label="apps_and_tools" value={apps.length}>
      <ShareBar items={forms} summary={forms.map((f) => `${f.count} ${f.label}`).join(', ')} />
    </StatCell>

    <StatCell label="releases_shipped" value={releaseCount}>
      <svg
        viewBox={`0 0 ${sparkWidth} ${BAR_H}`}
        class="block w-full max-w-[11rem] h-7 text-paper-green dark:text-term-green"
        role="img"
        aria-label="Releases per month over the last 12 months"
      >
        {
          bars.map((bar) => (
            <rect
              x={bar.x}
              y={BAR_H - bar.height}
              width={BAR_W}
              height={bar.height}
              rx="1.5"
              fill="currentColor"
              opacity={bar.height <= 2 ? 0.25 : 1}
            >
              <title>{bar.label}</title>
            </rect>
          ))
        }
      </svg>
      <p class="mt-2 text-[11px] text-paper-muted dark:text-term-muted">
        <span class="text-paper-amber dark:text-term-amber">{recentReleases}</span> in the last 90 days
      </p>
    </StatCell>

    <StatCell label="commits_on_linux" value={commitCount}>
      {
        commitLeader && commitLeader.commitCount > 0 && (
          <p class="text-[11px] text-paper-muted dark:text-term-muted">
            most work:{' '}
            <a
              href={`#${commitLeader.id}`}
              class="text-paper-text dark:text-term-text hover:text-paper-green dark:hover:text-term-green transition-colors underline decoration-dotted underline-offset-2"
            >
              {commitLeader.name}
            </a>
            <span class="text-paper-green dark:text-term-green">
              {` ${commitLeader.commitCount}`}
            </span>
          </p>
        )
      }
    </StatCell>

    <StatCell label="languages" value={languages.length}>
      <ShareBar
        items={languages}
        summary={languages.map((l) => `${l.count} ${l.label}`).join(', ')}
      />
    </StatCell>
  </dl>
</div>
