---
import careerData from '../data/career.json';

const industryAccents: Record<string, string> = {
  'ai-health': 'text-paper-green dark:text-term-green',
  cybersec: 'text-paper-red dark:text-term-red',
  'wearable-health': 'text-paper-greendim dark:text-term-greendim',
  consulting: 'text-paper-amber dark:text-term-amber',
  'creator-economy': 'text-paper-muted dark:text-term-muted',
};

const { summary, entries } = careerData;
---

<section class="career-timeline" aria-label="Career timeline">
  <div class="career-stats term-frame">
    <div class="career-stat">
      <span class="career-stat-value">{summary.yearsActive}</span>
      <span class="career-stat-label">years shipping</span>
    </div>
    <div class="career-stat-divider" aria-hidden="true"></div>
    <div class="career-stat">
      <span class="career-stat-value">{summary.totalCommits}</span>
      <span class="career-stat-label">production commits</span>
    </div>
    <div class="career-stat-divider" aria-hidden="true"></div>
    <div class="career-stat">
      <span class="career-stat-value">{summary.totalLocLabel}</span>
      <span class="career-stat-label">lines shipped</span>
    </div>
    <div class="career-stat-divider" aria-hidden="true"></div>
    <div class="career-stat">
      <span class="career-stat-value">{summary.industries}</span>
      <span class="career-stat-label">industries</span>
    </div>
  </div>

  <ol class="career-list" role="list">
    {
      entries.map((entry, index) => {
        const accent = industryAccents[entry.industry] || industryAccents.consulting;
        const isFirst = index === 0;
        const isLast = index === entries.length - 1;
        return (
          <li
            class="career-entry group"
            data-timeline-entry
            data-open="false"
            data-first={isFirst ? 'true' : 'false'}
            data-last={isLast ? 'true' : 'false'}
          >
            <div class="career-gutter" aria-hidden="true">
              <span class="career-node">{entry.current && <span class="career-node-pulse" />}</span>
            </div>
            <div class="career-card term-frame term-frame-hover">
              <button
                type="button"
                class="career-trigger"
                aria-expanded="false"
                aria-controls={`career-detail-${entry.id}`}
                data-timeline-toggle
              >
                <div class="career-header">
                  <div class="career-meta">
                    <span class={`career-pill ${accent}`}>{entry.industryLabel}</span>
                    {entry.current && (
                      <span class="career-status">
                        <span class="career-status-dot" />
                        Current
                      </span>
                    )}
                    <span class="career-date">{entry.dateRange}</span>
                  </div>
                  <svg
                    class="career-chevron"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M6 8l4 4 4-4"
                    />
                  </svg>
                </div>

                <h3 class="career-headline">{entry.headline}</h3>
                <p class="career-role">{entry.role}</p>
                <p class="career-hook">{entry.hook}</p>

                <div class="career-stack-preview">
                  {entry.stack.slice(0, 5).map((tech) => (
                    <span class="career-chip">{tech}</span>
                  ))}
                  {entry.stack.length > 5 && (
                    <span class="career-chip career-chip-more">+{entry.stack.length - 5}</span>
                  )}
                </div>
              </button>

              <div
                id={`career-detail-${entry.id}`}
                class="career-detail"
                role="region"
                aria-label={`${entry.role} details`}
              >
                <div class="career-detail-inner">
                  <div class="career-detail-divider" aria-hidden="true" />

                  <div class="career-section">
                    <h4 class="career-section-title">impact</h4>
                    <ul class="career-impact-list">
                      {entry.impact.map((point) => (
                        <li class="career-impact-item">
                          <span class="career-bullet" aria-hidden="true">
                            ▸
                          </span>
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="career-section">
                    <h4 class="career-section-title">systems owned</h4>
                    <div class="career-systems">
                      {entry.systems.map((system) => (
                        <span class="career-system-chip">{system}</span>
                      ))}
                    </div>
                  </div>

                  <div class="career-section">
                    <h4 class="career-section-title">stack</h4>
                    <div class="career-stack-full">
                      {entry.stack.map((tech) => (
                        <span class="career-chip">{tech}</span>
                      ))}
                    </div>
                  </div>

                  <p class="career-receipt" aria-label="Engagement totals">
                    {entry.receipt}
                  </p>
                </div>
              </div>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .career-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    padding: 1.25rem 1rem;
    margin-bottom: 2rem;
  }

  .career-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.1;
  }
  .career-stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: theme('colors.paper.text');
    letter-spacing: -0.02em;
  }
  :global(.dark) .career-stat-value {
    color: theme('colors.term.text');
  }
  .career-stat-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: theme('colors.paper.muted');
    margin-top: 0.2rem;
  }
  :global(.dark) .career-stat-label {
    color: theme('colors.term.muted');
  }

  .career-stat-divider {
    width: 1px;
    height: 1.75rem;
    background: theme('colors.paper.border');
  }
  :global(.dark) .career-stat-divider {
    background: theme('colors.term.border');
  }

  .career-list {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .career-entry {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .career-entry {
      grid-template-columns: 3.5rem 1fr;
      gap: 1.5rem;
      padding-bottom: 2rem;
    }
  }
  .career-entry[data-last='true'] {
    padding-bottom: 0;
  }

  .career-gutter {
    position: relative;
    width: 100%;
  }
  .career-gutter::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: -1.5rem;
    width: 2px;
    transform: translateX(-50%);
    background: theme('colors.paper.border');
  }
  :global(.dark) .career-gutter::before {
    background: theme('colors.term.border');
  }
  @media (min-width: 768px) {
    .career-gutter::before {
      bottom: -2rem;
    }
  }
  .career-entry[data-last='true'] .career-gutter::before {
    bottom: calc(100% - 2.5rem);
  }
  .career-entry[data-first='true'] .career-gutter::before {
    top: 1.4rem;
  }

  .career-node {
    position: absolute;
    left: 50%;
    top: 1.25rem;
    width: 0.875rem;
    height: 0.875rem;
    transform: translateX(-50%);
    border-radius: 9999px;
    background: theme('colors.paper.green');
    box-shadow: 0 0 0 3px theme('colors.paper.bg');
    z-index: 1;
  }
  :global(.dark) .career-node {
    background: theme('colors.term.green');
    box-shadow: 0 0 0 3px theme('colors.term.bg');
  }
  @media (min-width: 768px) {
    .career-node {
      width: 1rem;
      height: 1rem;
    }
  }

  .career-node-pulse {
    position: absolute;
    inset: -0.25rem;
    border-radius: 9999px;
    background: theme('colors.paper.green');
    opacity: 0.5;
    animation: career-pulse 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    pointer-events: none;
  }
  :global(.dark) .career-node-pulse {
    background: theme('colors.term.green');
  }
  @keyframes career-pulse {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    70% {
      transform: scale(2.4);
      opacity: 0;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .career-node-pulse {
      animation: none;
    }
  }

  .career-card {
    position: relative;
    overflow: hidden;
  }

  .career-trigger {
    display: block;
    width: 100%;
    padding: 1rem 1.125rem;
    text-align: left;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }
  @media (min-width: 768px) {
    .career-trigger {
      padding: 1.25rem 1.5rem;
    }
  }
  .career-trigger:focus-visible {
    outline: 2px solid theme('colors.paper.green');
    outline-offset: -2px;
    border-radius: 0.125rem;
  }
  :global(.dark) .career-trigger:focus-visible {
    outline-color: theme('colors.term.green');
  }

  .career-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .career-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .career-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: 0.125rem;
    border: 1px solid theme('colors.paper.border2');
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  :global(.dark) .career-pill {
    border-color: theme('colors.term.border2');
  }

  .career-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    border-radius: 0.125rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: theme('colors.paper.greendim');
    box-shadow: inset 0 0 0 1px theme('colors.paper.greendim');
  }
  :global(.dark) .career-status {
    color: theme('colors.term.green');
    box-shadow: inset 0 0 0 1px theme('colors.term.green');
  }
  .career-status-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: theme('colors.paper.green');
    animation: career-status-blink 2.4s ease-in-out infinite;
  }
  :global(.dark) .career-status-dot {
    background: theme('colors.term.green');
  }
  @keyframes career-status-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .career-status-dot {
      animation: none;
    }
  }

  .career-date {
    font-size: 0.75rem;
    color: theme('colors.paper.amber');
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  :global(.dark) .career-date {
    color: theme('colors.term.amber');
  }

  .career-chevron {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    color: theme('colors.paper.faint');
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    margin-top: 0.125rem;
  }
  :global(.dark) .career-chevron {
    color: theme('colors.term.faint');
  }
  [data-open='true'] .career-chevron {
    transform: rotate(180deg);
    color: theme('colors.paper.text');
  }
  :global(.dark) [data-open='true'] .career-chevron {
    color: theme('colors.term.text');
  }

  .career-headline {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0.1rem 0 0.15rem;
    color: theme('colors.paper.text');
  }
  :global(.dark) .career-headline {
    color: theme('colors.term.text');
  }
  @media (min-width: 768px) {
    .career-headline {
      font-size: 1.175rem;
    }
  }

  .career-role {
    font-size: 0.8125rem;
    font-weight: 500;
    color: theme('colors.paper.muted');
    margin: 0 0 0.55rem;
  }
  :global(.dark) .career-role {
    color: theme('colors.term.muted');
  }

  .career-hook {
    font-size: 0.875rem;
    line-height: 1.55;
    color: theme('colors.paper.muted');
    margin: 0 0 0.875rem;
  }
  :global(.dark) .career-hook {
    color: theme('colors.term.muted');
  }

  .career-stack-preview {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .career-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: 0.125rem;
    font-size: 0.7rem;
    font-weight: 500;
    background: theme('colors.paper.raised');
    color: theme('colors.paper.muted');
    white-space: nowrap;
  }
  :global(.dark) .career-chip {
    background: theme('colors.term.raised');
    color: theme('colors.term.muted');
  }
  .career-chip-more {
    background: transparent;
    color: theme('colors.paper.faint');
  }
  :global(.dark) .career-chip-more {
    background: transparent;
    color: theme('colors.term.faint');
  }

  .career-detail {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .career-entry[data-open='true'] .career-detail {
    grid-template-rows: 1fr;
  }
  .career-detail-inner {
    overflow: hidden;
    min-height: 0;
  }

  /* Fallback for browsers without grid-row animation support */
  @supports not (transition: grid-template-rows 0.4s ease) {
    .career-detail {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .career-entry[data-open='true'] .career-detail {
      max-height: 3000px;
    }
  }

  .career-detail-divider {
    height: 1px;
    background: theme('colors.paper.border');
    margin: 0 1.125rem;
  }
  :global(.dark) .career-detail-divider {
    background: theme('colors.term.border');
  }
  @media (min-width: 768px) {
    .career-detail-divider {
      margin: 0 1.5rem;
    }
  }

  .career-section {
    padding: 1rem 1.125rem 0;
  }
  @media (min-width: 768px) {
    .career-section {
      padding: 1.25rem 1.5rem 0;
    }
  }

  .career-section-title {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: theme('colors.paper.muted');
    margin: 0 0 0.65rem;
  }
  :global(.dark) .career-section-title {
    color: theme('colors.term.muted');
  }
  .career-section-title::before {
    content: '── ';
    color: theme('colors.paper.border2');
  }
  :global(.dark) .career-section-title::before {
    color: theme('colors.term.border2');
  }

  .career-impact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .career-impact-item {
    display: grid;
    grid-template-columns: 0.75rem 1fr;
    gap: 0.65rem;
    align-items: start;
    font-size: 0.875rem;
    line-height: 1.55;
    color: theme('colors.paper.text');
  }
  :global(.dark) .career-impact-item {
    color: theme('colors.term.text');
  }
  .career-bullet {
    color: theme('colors.paper.greendim');
    font-size: 0.75rem;
    line-height: 1.8;
  }
  :global(.dark) .career-bullet {
    color: theme('colors.term.greendim');
  }

  .career-systems {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .career-system-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: 0.125rem;
    border: 1px solid theme('colors.paper.border');
    font-size: 0.72rem;
    font-weight: 500;
    color: theme('colors.paper.greendim');
  }
  :global(.dark) .career-system-chip {
    border-color: theme('colors.term.border');
    color: theme('colors.term.greendim');
  }

  .career-stack-full {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .career-receipt {
    font-size: 0.75rem;
    color: theme('colors.paper.amber');
    padding: 1rem 1.125rem 1.125rem;
    margin: 0.25rem 0 0;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
  }
  :global(.dark) .career-receipt {
    color: theme('colors.term.amber');
  }
  @media (min-width: 768px) {
    .career-receipt {
      padding: 1.25rem 1.5rem 1.5rem;
    }
  }
</style>

<script>
  function initCareerTimeline() {
    const entries = document.querySelectorAll<HTMLElement>('[data-timeline-entry]');
    entries.forEach((entry) => {
      const trigger = entry.querySelector<HTMLButtonElement>('[data-timeline-toggle]');
      if (!trigger) return;
      trigger.addEventListener('click', () => {
        const isOpen = entry.dataset.open === 'true';
        const next = !isOpen;
        entry.dataset.open = String(next);
        trigger.setAttribute('aria-expanded', String(next));
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCareerTimeline);
  } else {
    initCareerTimeline();
  }
</script>
