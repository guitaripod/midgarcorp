---
export interface Props {
  project: {
    id: string;
    name: string;
    description: string;
    language: string;
    platforms: string[];
    stars: number;
    githubUrl: string;
    docsUrl?: string;
    homepageUrl?: string;
    category: string;
    highlights: string[];
    topics?: string[];
    commitCount?: number;
    releaseCount?: number;
    updatedAt?: string;
    createdAt?: string;
  };
}

const { project } = Astro.props;

const registryHosts = ['crates.io', 'www.npmjs.com', 'pypi.org', 'pkg.go.dev'];
const isRegistryUrl = (url: string) => {
  try {
    return registryHosts.includes(new URL(url).hostname);
  } catch {
    return true;
  }
};
const preferredHomepage =
  project.homepageUrl && !isRegistryUrl(project.homepageUrl) ? project.homepageUrl : undefined;
const targetUrl = preferredHomepage || project.docsUrl || project.githubUrl;

const languageAccents: Record<string, string> = {
  Go: '#00ADD8',
  Swift: '#FA7343',
  Rust: '#CE422B',
  Python: '#3776AB',
  TypeScript: '#3178C6',
  JavaScript: '#F7DF1E',
  Shell: '#89E051',
};

const languageAccent = languageAccents[project.language] || '#7d8590';

const getInstallCommand = (name: string, language: string) => {
  const lowerName = name.toLowerCase();
  if (lowerName === 'flyr') return 'cargo install flyr-cli';
  if (lowerName === 'unrager') return 'cargo install unrager';
  if (lowerName === 'songlink-cli') return 'brew install guitaripod/songlink-cli/songlink-cli';
  if (lowerName === 'pomme') return 'go install github.com/guitaripod/Pomme@latest';
  if (lowerName === 'imago') return 'cargo install --git https://github.com/guitaripod/imago';
  if (lowerName === 'apod-cli') return 'brew install guitaripod/tap/apod-cli';
  if (lowerName === 'image-collage') return 'cargo install image-collage';
  if (lowerName === 'gh-export') return 'cargo install gh-export';
  if (lowerName === 'songlink-cli-rust')
    return 'cargo install --git https://github.com/guitaripod/songlink-cli-rust';
  if (lowerName === 'btop-ios' || lowerName === 'anvil' || lowerName === 'crucible')
    return `git clone https://github.com/guitaripod/${lowerName}`;
  if (language === 'Go') return `go install github.com/guitaripod/${lowerName}@latest`;
  if (language === 'Rust') return `cargo install --git https://github.com/guitaripod/${lowerName}`;
  if (language === 'Swift') return 'swift build -c release';
  return `git clone https://github.com/guitaripod/${lowerName}`;
};

const getTerminalDemo = (name: string) => {
  const lowerName = name.toLowerCase();
  if (lowerName === 'imago') {
    return [
      'imago get https://instagram.com/natgeo/',
      'page 1  +12 new  ~0 skip',
      'done  natgeo  +412 new',
    ];
  }
  if (lowerName === 'flyr') {
    return [
      'flyr MAD NRT --date 2026-07-14',
      'searching google flights...',
      '1. IB  MAD→NRT  13h55m  €612',
      '2. AF  MAD→CDG→NRT  16h20m  €548',
    ];
  }
  if (lowerName === 'unrager') {
    return [
      'unrager',
      'rage filter: local llm [active]',
      'hidden: 42 posts · shown: 18 calm posts',
      'timeline ready',
    ];
  }
  if (lowerName === 'songlink-cli') {
    return [
      'songlink https://spotify.link/4cOdK2w',
      'resolving universal link...',
      'https://song.link/s/4cOdK2wDCqOpJuMs',
      'copied to clipboard',
    ];
  }
  if (lowerName === 'pomme') {
    return [
      'pomme sales',
      'fetching app store connect...',
      'units: 1,284 · proceeds: $2,431.07',
      'top market: US (38%)',
    ];
  }
  if (lowerName === 'apod-cli') {
    return [
      'apod-cli today',
      'fetching astronomy picture of the day...',
      'title: Pillars of Creation',
      'opening in browser...',
    ];
  }
  if (lowerName === 'speedrun-cli') {
    return [
      'speedrun-cli game "Super Mario 64"',
      'loading leaderboards...',
      '1. cheese  6:41.000',
      '2. Simply  6:45.200',
    ];
  }
  if (lowerName === 'image-collage') {
    return [
      'image-collage a.png b.png c.png d.png',
      'building 2x2 grid...',
      'wrote collage.png (2048x2048)',
      'exit 0',
    ];
  }
  if (lowerName === 'songlink-cli-rust') {
    return [
      'songlink https://music.apple.com/track/123',
      'generating song.link...',
      'copied to clipboard in 84ms',
      'exit 0',
    ];
  }
  if (lowerName === 'reposort') {
    return [
      'reposort ~/Dev',
      'scanning 57 repositories...',
      'go: 14 · rust: 12 · swift: 23',
      'sorted into language dirs',
    ];
  }
  if (lowerName === 'btop-ios') {
    return [
      'git clone github.com/guitaripod/btop-ios',
      'cloning into btop-ios...',
      'open btop-ios.xcodeproj && run on device',
    ];
  }
  if (lowerName === 'gh-export') {
    return [
      'gh-export guitaripod/flyr',
      'exporting repository...',
      'files: 127 · size: 2.3 MB',
      'saved to flyr/',
    ];
  }
  if (lowerName === 'anvil' || lowerName === 'crucible') {
    return [
      `git clone github.com/guitaripod/${lowerName}`,
      `cloning into ${lowerName}...`,
      'open in Xcode && build',
    ];
  }
  return [`${lowerName} --help`, `usage: ${lowerName} [command] [flags]`, 'exit 0'];
};

const terminalDemo = getTerminalDemo(project.name);
const installCmd = getInstallCommand(project.name, project.language);
---

<article class="cli-card group h-full term-frame term-frame-hover overflow-hidden">
  <a href={targetUrl} target="_blank" rel="noopener noreferrer" class="block h-full">
    <div class="p-4 pb-3">
      <div class="flex items-start justify-between gap-3 mb-2">
        <h3
          class="text-lg font-bold text-paper-text dark:text-term-text group-hover:text-paper-green dark:group-hover:text-term-green transition-colors"
        >
          {project.name}
        </h3>
        {
          project.stars > 0 && (
            <span class="shrink-0 text-xs text-paper-amber dark:text-term-amber whitespace-nowrap">
              ★ {project.stars}
            </span>
          )
        }
      </div>

      <div class="flex items-center gap-2 mb-3 text-xs text-paper-faint dark:text-term-faint">
        <span
          class="inline-block w-2 h-2 rounded-full"
          style={`background-color: ${languageAccent}`}
          aria-hidden="true"></span>
        <span>{project.language}</span>
      </div>

      <p class="text-sm text-paper-muted dark:text-term-muted mb-1 line-clamp-2">
        {project.description}
      </p>
    </div>

    <div class="mx-4 mb-3 rounded-sm overflow-hidden border border-term-border bg-term-bg">
      <div class="flex items-center gap-2 px-3 py-1.5 bg-term-panel border-b border-term-border">
        <div class="flex gap-1.5" aria-hidden="true">
          <span class="w-2 h-2 rounded-full bg-term-red opacity-80"></span>
          <span class="w-2 h-2 rounded-full bg-term-amber opacity-80"></span>
          <span class="w-2 h-2 rounded-full bg-term-green opacity-80"></span>
        </div>
        <span class="text-xs text-term-faint ml-1">{project.name} — tty</span>
      </div>

      <div class="p-3 text-xs space-y-2">
        <div>
          <p class="text-term-faint">┌─ install</p>
          <p class="text-term-text break-all">
            <span class="text-term-green">$</span>
            {installCmd}
          </p>
        </div>

        <div>
          <p class="text-term-faint">└─ run</p>
          <p class="text-term-text break-all">
            <span class="text-term-green">$</span>
            {terminalDemo[0]}
          </p>
          {terminalDemo.slice(1, 3).map((line) => <p class="text-term-muted ml-3">{line}</p>)}
        </div>
      </div>
    </div>

    <div class="px-4 pb-3">
      <div
        class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-paper-faint dark:text-term-faint"
      >
        <span>runs on:</span>
        {
          project.platforms.map((platform, index) => (
            <>
              <span class="text-paper-muted dark:text-term-muted">{platform}</span>
              {index < project.platforms.length - 1 && (
                <span class="text-paper-faint dark:text-term-faint">·</span>
              )}
            </>
          ))
        }
      </div>
    </div>
  </a>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
  }

  article > a {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  article > a > div:nth-child(2) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
