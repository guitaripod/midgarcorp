---
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);

const navItems = [
  { href: '/services', label: 'services' },
  { href: '/apps', label: 'apps' },
  { href: '/linux', label: 'linux' },
  { href: '/cli-tools', label: 'cli' },
  { href: '/opensource', label: 'oss' },
  { href: '/archive', label: 'blog' },
  { href: '/tags', label: 'tags' },
  { href: '/links', label: 'links' },
];

const isItemActive = (href: string) => href !== '/' && currentPath.startsWith(href.slice(1));
---

<header
  class="sticky top-0 z-40 w-full backdrop-blur-md bg-paper-bg/85 dark:bg-term-bg/85 border-b border-paper-border dark:border-term-border"
>
  <nav class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between gap-3">
      <a
        href="/"
        class="flex items-baseline gap-0 text-sm sm:text-base font-semibold whitespace-nowrap text-paper-text dark:text-term-text hover:text-paper-green dark:hover:text-term-green transition-colors"
      >
        <span class="text-paper-green dark:text-term-green">guitaripod@midgar</span><span
          class="text-paper-muted dark:text-term-muted">:</span
        ><span class="text-paper-amber dark:text-term-amber">~</span><span
          class="text-paper-muted dark:text-term-muted">$</span
        >
      </a>

      <div class="flex items-center gap-1 sm:gap-2">
        <ul class="hidden lg:flex items-center gap-4 lg:gap-5">
          {
            navItems.map((item) => {
              const isActive = isItemActive(item.href);
              return (
                <li>
                  <a
                    href={item.href}
                    class={`text-sm transition-colors hover:text-paper-green dark:hover:text-term-green ${
                      isActive
                        ? 'text-paper-green dark:text-term-green'
                        : 'text-paper-muted dark:text-term-muted'
                    }`}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    <span aria-hidden="true" class={isActive ? '' : 'opacity-0'}>
                      ▸
                    </span>
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>

        <Search />
        <ThemeToggle />

        <div class="lg:hidden">
          <input type="checkbox" id="mobile-menu-toggle" class="hidden" />
          <label
            for="mobile-menu-toggle"
            class="cursor-pointer p-2 block text-paper-muted dark:text-term-muted hover:text-paper-green dark:hover:text-term-green"
            aria-label="Toggle menu"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </label>

          <div
            class="mobile-menu hidden absolute left-0 right-0 top-14 border-b border-paper-border dark:border-term-border bg-paper-bg dark:bg-term-bg"
          >
            <ul class="px-4 py-3 space-y-1">
              {
                navItems.map((item) => {
                  const isActive = isItemActive(item.href);
                  return (
                    <li>
                      <a
                        href={item.href}
                        class={`block px-3 py-2 text-sm rounded-sm ${
                          isActive
                            ? 'text-paper-green dark:text-term-green bg-paper-panel dark:bg-term-panel'
                            : 'text-paper-muted dark:text-term-muted hover:bg-paper-panel dark:hover:bg-term-panel'
                        }`}
                      >
                        <span class="text-paper-green dark:text-term-green">
                          {isActive ? '▸ ' : '  '}
                        </span>
                        ./{item.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  #mobile-menu-toggle:checked ~ .mobile-menu {
    display: block;
  }
</style>
