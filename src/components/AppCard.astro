---
import { cleanAppStoreDescription } from '@utils/app-description';

export interface Props {
  app: {
    id: string;
    name: string;
    tagline: string;
    description: string;
    platforms: string[];
    category: string;
    price: string;
    appStoreUrl: string;
    icon: string;
    primaryColor: string;
    features: string[];
    releaseDate?: string;
  };
  landingHref?: string;
}

const { app, landingHref } = Astro.props;
const description = cleanAppStoreDescription(app.description);
const releaseStamp = app.releaseDate ? app.releaseDate.slice(0, 7) : null;
---

<article class="app-card group relative term-frame term-frame-hover overflow-hidden flex flex-col">
  <span
    class="absolute inset-y-0 left-0 w-0.5 opacity-60"
    style={`background-color: ${app.primaryColor}`}
    aria-hidden="true"></span>

  <div class="flex flex-col flex-1 p-4 sm:p-6">
    <div class="flex items-start gap-3 sm:gap-4">
      <img
        src={app.icon}
        alt={`${app.name} icon`}
        class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg border border-paper-border dark:border-term-border flex-shrink-0"
        loading="lazy"
      />

      <div class="flex-1 min-w-0">
        <h3
          class="text-base sm:text-lg font-bold text-paper-text dark:text-term-text group-hover:text-paper-green dark:group-hover:text-term-green transition-colors mb-1 truncate"
        >
          {
            landingHref ? (
              <a href={landingHref} class="after:absolute after:inset-0 after:content-['']">
                {app.name}
              </a>
            ) : (
              app.name
            )
          }
        </h3>
        <p class="text-xs sm:text-sm text-paper-muted dark:text-term-muted mb-2 line-clamp-2">
          {app.tagline}
        </p>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
          <span class="text-paper-greendim dark:text-term-greendim">[{app.category}]</span>
          <span class="font-semibold text-paper-amber dark:text-term-amber">{app.price}</span>
          {
            releaseStamp && (
              <span class="text-paper-faint dark:text-term-faint hidden sm:inline">
                released {releaseStamp}
              </span>
            )
          }
        </div>
      </div>
    </div>

    <p
      class="mt-3 sm:mt-4 text-xs sm:text-sm text-paper-muted dark:text-term-muted leading-relaxed line-clamp-3 font-sans"
    >
      {description}
    </p>

    <div class="mt-3 sm:mt-4">
      <h4 class="term-label mb-1.5 sm:mb-2">features</h4>
      <ul class="space-y-0.5 sm:space-y-1">
        {
          app.features.slice(0, 3).map((feature) => (
            <li class="flex items-start gap-2 text-xs sm:text-sm text-paper-text dark:text-term-text">
              <span
                class="text-paper-greendim dark:text-term-greendim flex-shrink-0"
                aria-hidden="true"
              >
                ▸
              </span>
              <span class="line-clamp-1">{feature}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-auto pt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="flex flex-wrap gap-2">
        {
          app.platforms.map((platform) => (
            <span class="px-1.5 py-0.5 text-xs text-paper-faint dark:text-term-faint border border-paper-border dark:border-term-border rounded-sm">
              {platform}
            </span>
          ))
        }
      </div>

      <a
        href={app.appStoreUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="relative z-10 inline-flex items-center justify-center gap-2 px-3 sm:px-4 py-2 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg rounded-sm text-xs sm:text-sm font-bold hover:opacity-90 transition-opacity w-full sm:w-auto"
      >
        open in app store ↗
      </a>
    </div>
  </div>
</article>

<style>
  .app-card {
    container-type: inline-size;
  }

  @container (max-width: 400px) {
    .app-card img {
      width: 56px;
      height: 56px;
    }
  }
</style>
