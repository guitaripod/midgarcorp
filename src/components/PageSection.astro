---
export interface Props {
  command: string;
  title: string;
  blurb: string;
  aside?: string;
  id?: string;
}

const { command, title, blurb, aside, id } = Astro.props;
---

<section id={id} class="mb-14 sm:mb-20 scroll-mt-20">
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4 mb-2">
    <p class="prompt-line">{command}</p>
    {
      aside && (
        <span class="text-xs text-paper-muted dark:text-term-faint sm:whitespace-nowrap">
          {aside}
        </span>
      )
    }
  </div>
  <h2 class="text-xl sm:text-2xl font-bold text-paper-text dark:text-term-text mb-1">{title}</h2>
  <p class="text-sm text-paper-muted dark:text-term-muted mb-6 sm:mb-8 max-w-2xl">{blurb}</p>
  <slot />
</section>
