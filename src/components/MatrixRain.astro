---

---

<canvas id="matrix-rain" class="matrix-rain" aria-hidden="true"></canvas>

<style>
  .matrix-rain {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.14;
    -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent);
    mask-image: linear-gradient(to bottom, black 60%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.dark) .matrix-rain {
      display: block;
    }
  }
</style>

<script>
  function initMatrixRain() {
    const canvas = document.getElementById('matrix-rain') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.running) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reducedMotion.matches) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    canvas.dataset.running = 'true';

    const glyphs = 'アィウェオカキクケコサシスセソタチツテトナニヌネノ0123456789$#@*+-<>/\\|=';
    const fontSize = 14;
    let columns = 0;
    let drops: number[] = [];

    const resize = () => {
      const rect = canvas.parentElement?.getBoundingClientRect();
      if (!rect) return;
      canvas.width = rect.width;
      canvas.height = rect.height;
      columns = Math.floor(canvas.width / fontSize);
      drops = Array.from({ length: columns }, () => Math.floor(Math.random() * -40));
    };

    resize();
    window.addEventListener('resize', resize);

    let last = 0;
    const frameInterval = 1000 / 18;

    const draw = (now: number) => {
      if (!canvas.isConnected) return;
      requestAnimationFrame(draw);
      if (document.hidden || now - last < frameInterval) return;
      last = now;
      if (!document.documentElement.classList.contains('dark')) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        return;
      }

      ctx.fillStyle = 'rgba(13, 17, 23, 0.12)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.font = `${fontSize}px JetBrains Mono, monospace`;

      for (let i = 0; i < drops.length; i++) {
        const y = drops[i] * fontSize;
        if (y > 0) {
          const glyph = glyphs[Math.floor(Math.random() * glyphs.length)];
          ctx.fillStyle = Math.random() > 0.96 ? '#a0ffc0' : '#33ff66';
          ctx.fillText(glyph, i * fontSize, y);
        }
        if (y > canvas.height && Math.random() > 0.975) {
          drops[i] = Math.floor(Math.random() * -20);
        }
        drops[i]++;
      }
    };

    requestAnimationFrame(draw);
  }

  document.addEventListener('DOMContentLoaded', initMatrixRain);
  document.addEventListener('astro:after-swap', initMatrixRain);
</script>
