---
import { formatCell, isHidden, isNumber } from '../../lib/open-stats.mjs';
import type { Cell } from '@data/open';

export interface Props {
  label: string;
  cell: Cell | undefined;
  caption: string;
  minCount: number;
  lead?: boolean;
  size?: 'hero' | 'small';
}

const { label, cell = null, caption, minCount, lead = false, size = 'hero' } = Astro.props;
---

<div class:list={['bs', `bs--${size}`, { 'bs--lead': lead }]}>
  <dt class="bs-label">{label}</dt>
  <dd class="bs-value">
    {
      isNumber(cell) ? (
        <span class="bs-number">{formatCell(cell)}</span>
      ) : isHidden(cell) ? (
        <span class="bs-number bs-number--hidden">
          {cell}
          <span class="sr-only"> (hidden: fewer than {minCount})</span>
        </span>
      ) : (
        <span class="bs-number bs-number--none">
          <span aria-hidden="true">–</span>
          <span class="sr-only">not yet</span>
        </span>
      )
    }
  </dd>
  <dd class="bs-caption">
    {isHidden(cell) ? `Under the publish line, so held back. ${caption}` : caption}
  </dd>
</div>

<style>
  .bs {
    --bs-text: theme('colors.paper.text');
    --bs-muted: theme('colors.paper.muted');
    --bs-lead: theme('colors.paper.green');
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  :global(.dark) .bs {
    --bs-text: theme('colors.term.text');
    --bs-muted: theme('colors.term.muted');
    --bs-lead: theme('colors.term.green');
  }

  .bs-label {
    order: 1;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bs-muted);
  }

  .bs-value {
    order: 2;
    margin: 0.35rem 0 0;
  }

  .bs-caption {
    order: 3;
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--bs-muted);
  }

  .bs-number {
    display: block;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--bs-text);
  }

  .bs--hero .bs-number {
    font-size: clamp(2.6rem, 1.6rem + 3.6vw, 4.5rem);
  }

  .bs--small .bs-number {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .bs--lead .bs-number {
    color: var(--bs-lead);
  }

  :global(.dark) .bs--lead .bs-number {
    text-shadow: 0 0 18px rgba(51, 255, 102, 0.35);
  }

  .bs-number--hidden,
  .bs-number--none {
    color: var(--bs-muted);
    opacity: 0.75;
  }
</style>
