---
import {
  describeSeries,
  formatMonth,
  formatWeek,
  isHidden,
  isOpenPeriod,
  isNumber,
  latestOf,
  seriesOf,
} from '../../lib/open-stats.mjs';
import type { Row } from '@data/open';
import Spark from './Spark.astro';

export interface Props {
  title: string;
  blurb: string;
  rows: Row[];
  field: string;
  generatedAt: string;
  minCount: number;
  grain?: 'week' | 'month';
  wide?: boolean;
}

const {
  title,
  blurb,
  rows,
  field,
  generatedAt,
  minCount,
  grain = 'week',
  wide = false,
} = Astro.props;
const cells = seriesOf(rows, field);
const latest = latestOf(rows, field);
const open = latest !== null && isOpenPeriod(latest.period, grain, generatedAt);
const when = latest
  ? `${grain === 'month' ? formatMonth(latest.period) : `week of ${formatWeek(latest.period)}`}${open ? ', so far' : ''}`
  : 'no data yet';
const hiddenAll = latest !== null && !cells.some(isNumber);
const label = describeSeries(title, rows, field, grain === 'month' ? 'months' : 'weeks');
---

<article class:list={['term-frame p-4 sm:p-5 flex flex-col', { 'card-grid__wide': wide }]}>
  <h3 class="term-label">{title}</h3>
  <p class="mt-2 flex flex-wrap items-baseline gap-x-2">
    {
      latest && isNumber(latest.cell) ? (
        <span class="text-3xl font-bold tracking-tight tabular-nums text-paper-text dark:text-term-text">
          {latest.cell.toLocaleString('en-US')}
        </span>
      ) : latest && isHidden(latest.cell) ? (
        <span class="text-3xl font-bold tracking-tight tabular-nums text-paper-muted dark:text-term-muted">
          {latest.cell}
          <span class="sr-only"> (hidden: fewer than {minCount})</span>
        </span>
      ) : (
        <span class="text-3xl font-bold tracking-tight text-paper-faint dark:text-term-faint">
          –<span class="sr-only">not yet</span>
        </span>
      )
    }
    <span class="text-xs text-paper-muted dark:text-term-muted">{when}</span>
  </p>
  <div class="mt-4">
    <Spark cells={cells} label={label} open={open} />
  </div>
  <p class="mt-3 text-xs text-paper-muted dark:text-term-muted">
    {hiddenAll ? `Every ${grain} is under ${minCount}, so none is shown. ${blurb}` : blurb}
  </p>
</article>
