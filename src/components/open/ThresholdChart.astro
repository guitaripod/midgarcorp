---
import { thresholdBars } from '../../lib/open-page.mjs';
import { formatCell, formatEur, formatMonth, formatWeek } from '../../lib/open-stats.mjs';
import type { Cell } from '@data/open';

export interface Era {
  from: number;
  label: string;
}

export interface Props {
  cells: Cell[];
  periods: string[];
  minCount: number;
  label: string;
  open?: boolean;
  size?: 'compact' | 'normal' | 'tall';
  top?: number;
  tone?: 'midgar' | 'apple' | 'money';
  grain?: 'week' | 'month';
  era?: Era;
  money?: boolean;
}

const {
  cells,
  periods,
  minCount,
  label,
  open = false,
  size = 'normal',
  top,
  tone = 'midgar',
  grain = 'week',
  era,
  money = false,
} = Astro.props;
const compact = size === 'compact';
const LABEL_ALL_MAX = 16;
const chart = money
  ? thresholdBars(cells, { minCount: 0, height: 100, floorMin: 0, top, minBar: 1 })
  : thresholdBars(cells, { minCount, height: 100, floorMin: compact ? 16 : 8, top });
const show = (value: Cell) => (money ? formatEur(value) : formatCell(value));
const values = chart.bars.filter((bar) => bar.kind === 'value');
const lastValue = values.at(-1);
const peak = values.reduce<(typeof values)[number] | undefined>(
  (best, bar) => (best && Number(best.value) >= Number(bar.value) ? best : bar),
  undefined
);
const LABEL_CLEARANCE = 14;
const dense = cells.length > LABEL_ALL_MAX;
const labelled = (index: number) =>
  !compact &&
  (index === lastValue?.index ||
    index === peak?.index ||
    (!dense && chart.bars[index].h >= chart.band + LABEL_CLEARANCE));
const lastIndex = cells.length - 1;
const periodLabel = (period: string) =>
  grain === 'month' ? formatMonth(period) : formatWeek(period);
const first = periods[0];
const last = periods[lastIndex];
const eraStart = era && era.from >= 0 && era.from < cells.length ? era.from : null;
---

<figure
  class:list={['oc', `oc--${size}`, `oc--${tone}`, { 'oc--dense': dense }]}
  role="img"
  aria-label={label}
>
  <div class="oc-plot" aria-hidden="true">
    <div class="oc-bars" style={`--oc-count:${cells.length}`}>
      {
        eraStart !== null && era && (
          <div class="oc-era" style={`left:calc(${(eraStart / cells.length) * 100}% - 1px)`}>
            {!compact && <span class="oc-era__label">{era.label}</span>}
          </div>
        )
      }
      {
        !money && (
          <div class="oc-line" style={`bottom:${chart.band}%`}>
            {!compact && <span class="oc-line__label">publish line · {minCount}</span>}
          </div>
        )
      }
      {
        chart.bars.map((bar) => (
          <span
            class:list={[
              'oc-bar',
              `oc-bar--${bar.kind}`,
              {
                'oc-bar--latest': lastValue !== undefined && bar.index === lastValue.index,
                'oc-bar--open': open && bar.index === lastIndex,
                'oc-bar--era': eraStart !== null && bar.index >= eraStart,
              },
            ]}
            style={`height:${bar.h}%`}
          >
            {bar.kind === 'value' && labelled(bar.index) && (
              <span class="oc-bar__value">{show(bar.value)}</span>
            )}
          </span>
        ))
      }
    </div>
  </div>
  {
    !compact && first && last && (
      <figcaption class="oc-axis" aria-hidden="true">
        <span>{periodLabel(first)}</span>
        <span>
          {grain === 'month' ? '' : 'week of '}
          {periodLabel(last)}
          {dense && lastValue?.index === lastIndex && ` · ${show(lastValue.value)}`}
        </span>
      </figcaption>
    )
  }
</figure>

<style>
  .oc {
    --oc-ink: theme('colors.paper.green');
    --oc-ink-soft: theme('colors.paper.greendim');
    --oc-era: theme('colors.paper.green');
    --oc-hatch: theme('colors.paper.border2');
    --oc-line: theme('colors.paper.amber');
    --oc-text: theme('colors.paper.muted');
    --oc-height: 9.5rem;
    margin: 0;
    container: oc / inline-size;
  }

  :global(.dark) .oc {
    --oc-ink: theme('colors.term.green');
    --oc-ink-soft: theme('colors.term.greendim');
    --oc-era: theme('colors.term.green');
    --oc-hatch: theme('colors.term.border2');
    --oc-line: theme('colors.term.amber');
    --oc-text: theme('colors.term.muted');
  }

  .oc--apple {
    --oc-ink: theme('colors.paper.text');
    --oc-ink-soft: theme('colors.paper.muted');
  }

  :global(.dark) .oc--apple {
    --oc-ink: theme('colors.term.text');
    --oc-ink-soft: theme('colors.term.muted');
  }

  .oc--money {
    --oc-ink: theme('colors.paper.amber');
    --oc-ink-soft: color-mix(in srgb, theme('colors.paper.amber') 55%, transparent);
  }

  :global(.dark) .oc--money {
    --oc-ink: theme('colors.term.amber');
    --oc-ink-soft: color-mix(in srgb, theme('colors.term.amber') 55%, transparent);
  }

  .oc--money .oc-bar--era.oc-bar--value {
    background: var(--oc-ink);
    opacity: 1;
  }

  :global(.dark) .oc--money .oc-bar--latest {
    box-shadow: 0 0 12px rgba(255, 176, 0, 0.3);
  }

  .oc--compact {
    --oc-height: 2.75rem;
  }

  .oc--tall {
    --oc-height: clamp(10rem, 6rem + 12vw, 15rem);
  }

  .oc-plot {
    position: relative;
    height: var(--oc-height);
  }

  .oc-bars {
    position: absolute;
    inset: 1.1rem 0 0 0;
    display: grid;
    grid-template-columns: repeat(var(--oc-count), minmax(0, 1fr));
    gap: clamp(2px, 1.2cqi, 6px);
    align-items: end;
  }

  .oc--dense .oc-bars {
    gap: clamp(1px, 0.35cqi, 3px);
  }

  .oc--compact .oc-bars {
    inset: 0;
    gap: 2px;
  }

  .oc--tall .oc-bars {
    inset: 1.6rem 0 0 0;
  }

  .oc-bar {
    position: relative;
    z-index: 1;
    display: block;
    min-height: 0;
    border-radius: 1px 1px 0 0;
  }

  .oc-bar--value {
    background: var(--oc-ink-soft);
    opacity: 0.85;
  }

  .oc-bar--latest {
    background: var(--oc-ink);
    opacity: 1;
  }

  :global(.dark) .oc--midgar .oc-bar--latest {
    box-shadow: 0 0 12px rgba(51, 255, 102, 0.35);
  }

  .oc--apple .oc-bar--era.oc-bar--value {
    background: var(--oc-ink);
    opacity: 1;
  }

  .oc-bar--open {
    background: transparent;
    outline: 1px dashed var(--oc-ink);
    outline-offset: -1px;
  }

  .oc-bar--hidden {
    background-image: repeating-linear-gradient(
      135deg,
      var(--oc-hatch) 0 1.5px,
      transparent 1.5px 5px
    );
    box-shadow: inset 0 1px 0 var(--oc-hatch);
  }

  .oc-bar--none {
    height: 1px !important;
    background: var(--oc-hatch);
    opacity: 0.4;
  }

  .oc-bar__value {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    padding-bottom: 0.15rem;
    font-size: 0.6875rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--oc-text);
    white-space: nowrap;
  }

  .oc-bar:nth-last-child(-n + 2) .oc-bar__value {
    left: auto;
    right: 0;
    transform: none;
  }

  .oc-bar--latest .oc-bar__value {
    color: var(--oc-ink);
    font-weight: 700;
  }

  .oc-line {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px dashed var(--oc-line);
    opacity: 0.8;
    z-index: 2;
    pointer-events: none;
  }

  .oc--compact .oc-line {
    opacity: 0.55;
  }

  .oc-line__label {
    position: absolute;
    left: 0;
    bottom: 0.2rem;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--oc-line);
    white-space: nowrap;
  }

  .oc-era {
    position: absolute;
    top: -1.1rem;
    bottom: 0;
    right: -2px;
    z-index: 0;
    border-left: 1px dashed var(--oc-era);
    background: color-mix(in srgb, var(--oc-era) 9%, transparent);
    pointer-events: none;
  }

  .oc--compact .oc-era {
    top: 0;
  }

  .oc-era__label {
    position: absolute;
    top: 0;
    right: calc(100% + 0.4rem);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--oc-era);
    white-space: nowrap;
    text-align: right;
  }

  @container oc (max-width: 40rem) {
    .oc-era__label {
      display: none;
    }
  }

  @container oc (max-width: 48rem) {
    .oc--dense .oc-bar__value {
      display: none;
    }
  }

  .oc-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.4rem;
    font-size: 0.6875rem;
    color: var(--oc-text);
  }
</style>
