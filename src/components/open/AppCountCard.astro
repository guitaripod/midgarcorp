---
import AppIcon from '@components/landing/AppIcon.astro';
import ThresholdChart from './ThresholdChart.astro';
import Value from './Value.astro';
import { describeSeries, formatWeek, latestOf, seriesOf } from '../../lib/open-stats.mjs';
import { agoLabel } from '../../lib/open-page.mjs';
import type { OpenApp, Row } from '@data/open';

export interface Props {
  app: OpenApp;
  weeks: Row[];
  downloads: Row[] | null;
  platforms: string[];
  version?: string;
  releasedDaysAgo: number | null;
  minCount: number;
  activeTop: number;
  downloadsTop: number;
  open: boolean;
  quiet?: string;
}

const {
  app,
  weeks,
  downloads,
  platforms,
  version,
  releasedDaysAgo,
  minCount,
  activeTop,
  downloadsTop,
  open,
  quiet,
} = Astro.props;
const active = latestOf(weeks, 'wau');
const fetched = downloads ? latestOf(downloads, 'downloads') : null;
const weekOf = (period: string | undefined) => (period ? `week of ${formatWeek(period)}` : '');
---

<article
  class="acc term-frame term-frame-hover"
  id={quiet ? `quiet-${app.slug}` : `app-${app.slug}`}
>
  <header class="acc-head">
    {
      app.icon && (
        <AppIcon src={app.icon} width={44} height={44} displayWidths={[44]} class="acc-icon" />
      )
    }
    <div class="acc-title">
      {
        app.href ? (
          <a href={app.href} class="acc-name">
            {app.name}
          </a>
        ) : (
          <span class="acc-name">{app.name}</span>
        )
      }
      <p class="acc-meta">{platforms.join(' · ')}</p>
    </div>
  </header>

  <div class:list={['acc-cols', { 'acc-cols--one': !downloads }]}>
    {
      downloads && (
        <section class="acc-col acc-col--apple">
          <p class="acc-label">
            <span class="acc-mark acc-mark--apple" aria-hidden="true" />
            downloads
          </p>
          <p class="acc-number">
            <Value cell={fetched?.cell ?? null} minCount={minCount} />
          </p>
          <p class="acc-when">{weekOf(fetched?.period)}</p>
          <ThresholdChart
            cells={seriesOf(downloads, 'downloads')}
            periods={downloads.map((row) => row.period)}
            minCount={minCount}
            top={downloadsTop}
            size="compact"
            tone="apple"
            label={describeSeries(`${app.name} first-time downloads`, downloads, 'downloads')}
          />
        </section>
      )
    }
    <section class="acc-col acc-col--midgar">
      <p class="acc-label">
        <span class="acc-mark acc-mark--midgar" aria-hidden="true"></span>
        weekly active
      </p>
      {
        quiet ? (
          <p class="acc-quiet">{quiet}</p>
        ) : (
          <>
            <p class="acc-number">
              <Value cell={active?.cell ?? null} minCount={minCount} />
            </p>
            <p class="acc-when">{weekOf(active?.period)}</p>
            <ThresholdChart
              cells={seriesOf(weeks, 'wau')}
              periods={weeks.map((row) => row.period)}
              minCount={minCount}
              top={activeTop}
              open={open}
              size="compact"
              label={describeSeries(`${app.name} weekly active installs`, weeks, 'wau')}
            />
          </>
        )
      }
    </section>
  </div>

  <footer class="acc-foot">
    <span>{version ? `version ${version}` : ''}</span>
    <span>updated {agoLabel(releasedDaysAgo)}</span>
  </footer>
</article>

<style>
  .acc {
    --acc-text: theme('colors.paper.text');
    --acc-muted: theme('colors.paper.muted');
    --acc-green: theme('colors.paper.green');
    --acc-border: theme('colors.paper.border');
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem 1.1rem 0.85rem;
    min-width: 0;
  }

  :global(.dark) .acc {
    --acc-text: theme('colors.term.text');
    --acc-muted: theme('colors.term.muted');
    --acc-green: theme('colors.term.green');
    --acc-border: theme('colors.term.border');
  }

  .acc-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .acc :global(.acc-icon) {
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: 0.65rem;
    border: 1px solid var(--acc-border);
    object-fit: cover;
  }

  .acc-title {
    flex: 1;
    min-width: 0;
  }

  .acc-name {
    display: block;
    font-weight: 700;
    color: var(--acc-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  a.acc-name:hover {
    color: var(--acc-green);
  }

  .acc-meta {
    margin-top: 0.15rem;
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--acc-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .acc-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .acc-cols--one {
    grid-template-columns: minmax(0, 1fr);
  }

  .acc-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .acc-col--midgar {
    padding-left: 1.1rem;
    border-left: 1px dashed var(--acc-border);
  }

  .acc-cols--one .acc-col--midgar {
    padding-left: 0;
    border-left: 0;
  }

  .acc-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--acc-muted);
  }

  .acc-mark {
    width: 0.4rem;
    height: 0.4rem;
    flex: none;
  }

  .acc-mark--apple {
    background: var(--acc-text);
    transform: rotate(45deg);
  }

  .acc-mark--midgar {
    background: var(--acc-green);
    border-radius: 999px;
  }

  .acc-number {
    margin-top: 0.35rem;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--acc-text);
  }

  .acc-when {
    margin: 0.2rem 0 0.6rem;
    font-size: 0.625rem;
    color: var(--acc-muted);
  }

  .acc-quiet {
    margin-top: 0.4rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--acc-muted);
  }

  .acc-foot {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--acc-border);
    font-size: 0.6875rem;
    color: var(--acc-muted);
  }
</style>
