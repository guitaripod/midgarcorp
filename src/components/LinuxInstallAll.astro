---
import type { LinuxApp } from '@data/linux';
import { channelBundles } from '../lib/linux-insights';
import LinuxInstall from './LinuxInstall.astro';

export interface Props {
  apps: LinuxApp[];
}

const { apps } = Astro.props;
const bundles = channelBundles(apps);
const channels = bundles.map((bundle) => ({
  channel: bundle.channel,
  label: bundle.title,
  command: bundle.command,
}));
---

{
  bundles.length > 0 && (
    <div class="grid lg:grid-cols-12 gap-6 lg:gap-10 items-start">
      <div class="lg:col-span-7 min-w-0">
        <LinuxInstall name="every Linux tool" channels={channels} large />
      </div>
      <ul class="lg:col-span-5 space-y-3 text-sm">
        {bundles.map((bundle) => (
          <li>
            <p class="text-paper-text dark:text-term-text font-semibold">
              {bundle.title}
              <span class="font-normal text-paper-muted dark:text-term-muted">
                {` · ${bundle.apps.length} ${bundle.apps.length === 1 ? 'tool' : 'tools'}`}
              </span>
            </p>
            <p class="text-xs text-paper-muted dark:text-term-muted leading-relaxed">
              {bundle.apps.join(', ')}
            </p>
          </li>
        ))}
      </ul>
    </div>
  )
}
