---
export interface Props {
  username: string;
  showArtwork?: boolean;
  size?: 'normal' | 'large';
}

const { username, showArtwork = true, size = 'normal' } = Astro.props;
---

<div id="lastfm-now-playing" class="space-y-3">
  <div id="lfm-hero" class="flex items-center gap-3">
    <div
      id="lfm-art"
      class="w-12 h-12 flex-shrink-0 bg-paper-raised dark:bg-term-raised rounded-sm overflow-hidden animate-pulse"
    >
    </div>
    <div class="flex-1 min-w-0 space-y-1.5">
      <div class="h-3 w-3/4 bg-paper-raised dark:bg-term-raised rounded-sm animate-pulse"></div>
      <div class="h-3 w-1/2 bg-paper-raised dark:bg-term-raised rounded-sm animate-pulse"></div>
      <div class="h-3 w-1/3 bg-paper-raised dark:bg-term-raised rounded-sm animate-pulse"></div>
    </div>
  </div>

  <div id="lfm-stats" class="hidden grid grid-cols-3 gap-2">
    <div
      class="bg-paper-raised dark:bg-term-raised rounded-sm px-2 py-1.5 text-center"
      id="lfm-stat-scrobbles"
    >
    </div>
    <div
      class="bg-paper-raised dark:bg-term-raised rounded-sm px-2 py-1.5 text-center"
      id="lfm-stat-week"
    >
    </div>
    <div
      class="bg-paper-raised dark:bg-term-raised rounded-sm px-2 py-1.5 text-center"
      id="lfm-stat-artist"
    >
    </div>
  </div>

  <div id="lfm-grid" class="hidden grid grid-cols-1 md:grid-cols-2 gap-x-6">
    <div id="lfm-artists">
      <p
        class="text-[10px] font-medium text-paper-muted dark:text-term-muted uppercase tracking-wide mb-1.5"
      >
        Top artists this week
      </p>
    </div>
    <div id="lfm-recent">
      <p
        class="text-[10px] font-medium text-paper-muted dark:text-term-muted uppercase tracking-wide mb-1.5"
      >
        Recently played
      </p>
    </div>
  </div>
</div>

<script define:vars={{ username, showArtwork, size }}>
  const esc = (value) =>
    String(value ?? '').replace(
      /[&<>"']/g,
      (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]
    );

  const statCell = (value, label, title) => `
    <div class="text-sm font-bold text-paper-text dark:text-term-text truncate" title="${esc(title ?? value)}">${value}</div>
    <div class="text-[9px] text-paper-faint dark:text-term-faint uppercase tracking-wide">${label}</div>`;

  const progressBar = (pct) => `
    <div class="h-1 mt-1 bg-paper-raised dark:bg-term-raised rounded-sm overflow-hidden">
      <div class="h-full bg-paper-red dark:bg-term-red rounded-sm" style="width: ${Math.max(4, Math.min(100, pct))}%"></div>
    </div>`;

  async function fetchNowPlaying() {
    try {
      const response = await fetch(`/api/lastfm.json?username=${username}`);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const data = await response.json();

      if (data.error) throw new Error(data.error);
      if (!data.recenttracks?.track) throw new Error('No tracks');

      const tracks = Array.isArray(data.recenttracks.track)
        ? data.recenttracks.track
        : [data.recenttracks.track];
      const current = tracks.find((t) => t['@attr']?.nowplaying === 'true') || tracks[0];
      const isNowPlaying = current === tracks[0] && current['@attr']?.nowplaying === 'true';

      const art = document.getElementById('lfm-art');
      if (showArtwork && art) {
        const image = (current.image || []).find(
          (i) => i.size === 'extralarge' || i.size === 'large'
        );
        if (image?.['#text']) {
          art.innerHTML = `<img src="${esc(image['#text'])}" alt="" class="w-12 h-12 object-cover" onerror="this.style.display='none'" />`;
        } else {
          art.innerHTML = `<svg class="w-6 h-6 text-paper-faint dark:text-term-faint m-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>`;
        }
        art.classList.remove('animate-pulse');
      }

      const hero = document.getElementById('lfm-hero');
      if (hero) {
        const date = current.date ? new Date(current.date.uts * 1000) : null;
        const ago = date ? getTimeAgo(date) : '';
        hero.innerHTML = `
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 ${isNowPlaying ? 'text-paper-red dark:text-term-red animate-pulse' : 'text-paper-faint dark:text-term-faint'} flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
              </svg>
              <span class="text-[11px] ${isNowPlaying ? 'text-paper-red dark:text-term-red font-medium' : 'text-paper-faint dark:text-term-faint'}">
                ${isNowPlaying ? 'Now playing' : `Last played · ${ago}`}
              </span>
            </div>
            <div class="text-sm font-medium text-paper-text dark:text-term-text truncate mt-0.5">${esc(current.name)}</div>
            <div class="text-xs text-paper-muted dark:text-term-muted truncate">
              ${esc(current.artist?.['#text'] || 'Unknown artist')}${current.album?.['#text'] ? ` · ${esc(current.album['#text'])}` : ''}
            </div>
          </div>`;
      }

      const statsEl = document.getElementById('lfm-stats');
      if (statsEl && data.user) {
        const playcount = data.user.playcount
          ? parseInt(data.user.playcount).toLocaleString()
          : '0';
        const weeklyPlays = (data.topartists?.artist || []).reduce(
          (sum, a) => sum + (parseInt(a.playcount, 10) || 0),
          0
        );
        const topArtist = (data.topartists?.artist || [])[0]?.name || '—';
        document.getElementById('lfm-stat-scrobbles').innerHTML = statCell(playcount, 'scrobbles');
        document.getElementById('lfm-stat-week').innerHTML = statCell(
          weeklyPlays.toLocaleString(),
          'this week',
          'Scrobbles from top artists, 7 days'
        );
        document.getElementById('lfm-stat-artist').innerHTML = statCell(
          topArtist,
          'top artist',
          (data.topartists?.artist || [])[0]
            ? `${topArtist} — ${data.topartists.artist[0].playcount} plays this week`
            : ''
        );
        statsEl.classList.remove('hidden');
      }

      const grid = document.getElementById('lfm-grid');
      if (grid && size === 'large') {
        const artists = (data.topartists?.artist || []).slice(0, 5);
        const maxPlays = Math.max(...artists.map((a) => parseInt(a.playcount, 10) || 0), 1);
        if (artists.length > 0) {
          document.getElementById('lfm-artists').innerHTML = `
            <p class="text-[10px] font-medium text-paper-muted dark:text-term-muted uppercase tracking-wide mb-1.5">Top artists this week</p>
            ${artists
              .map(
                (a, i) => `
                <div class="flex items-center gap-2 py-1">
                  <span class="w-4 text-[10px] text-paper-faint dark:text-term-faint flex-shrink-0 text-right">${i + 1}</span>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-baseline justify-between gap-2">
                      <div class="text-[11px] font-medium text-paper-text dark:text-term-text truncate">${esc(a.name)}</div>
                      <div class="text-[10px] text-paper-faint dark:text-term-faint flex-shrink-0">${a.playcount}</div>
                    </div>
                    ${progressBar((parseInt(a.playcount, 10) / maxPlays) * 100)}
                  </div>
                </div>`
              )
              .join('')}`;
        }

        const recent = tracks.slice(isNowPlaying ? 1 : 0, isNowPlaying ? 5 : 4);
        if (recent.length > 0) {
          document.getElementById('lfm-recent').innerHTML = `
            <p class="text-[10px] font-medium text-paper-muted dark:text-term-muted uppercase tracking-wide mb-1.5">Recently played</p>
            ${recent
              .map((t) => {
                const date = t.date ? new Date(t.date.uts * 1000) : null;
                const ago = date ? getTimeAgo(date) : '';
                return `
                <div class="flex items-center gap-2 py-1">
                  <div class="flex-1 min-w-0">
                    <div class="text-[11px] font-medium text-paper-text dark:text-term-text truncate">${esc(t.name)}</div>
                    <div class="text-[10px] text-paper-faint dark:text-term-faint truncate">${esc(t.artist?.['#text'] || '')} · ${ago}</div>
                  </div>
                </div>`;
              })
              .join('')}`;
        }

        grid.classList.remove('hidden');
      }
    } catch (error) {
      console.error('[Last.fm]', error);
      const hero = document.getElementById('lfm-hero');
      if (hero) {
        hero.innerHTML = `
          <div class="w-12 h-12 flex-shrink-0 bg-paper-raised dark:bg-term-raised rounded-sm flex items-center justify-center">
            <svg class="w-6 h-6 text-paper-faint dark:text-term-faint" fill="currentColor" viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-xs text-paper-faint dark:text-term-faint">Unable to load track info</div>
          </div>`;
      }
    }
  }

  function getTimeAgo(date) {
    const seconds = Math.floor((new Date() - date) / 1000);
    const intervals = {
      year: 31536000,
      month: 2592000,
      week: 604800,
      day: 86400,
      hour: 3600,
      minute: 60,
    };
    for (const [name, secs] of Object.entries(intervals)) {
      const interval = Math.floor(seconds / secs);
      if (interval >= 1) return interval === 1 ? `1 ${name} ago` : `${interval} ${name}s ago`;
    }
    return 'just now';
  }

  function init() {
    if (!document.getElementById('lfm-hero')) {
      setTimeout(init, 100);
      return;
    }
    fetchNowPlaying();
    setInterval(fetchNowPlaying, 30000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    requestAnimationFrame(init);
  }
</script>
