---
import CryptoWallet from './CryptoWallet.astro';

const currentYear = new Date().getFullYear();
const buildDate = new Date().toISOString().slice(0, 10);

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);

const windows = [
  { href: '/', label: 'home' },
  { href: '/services', label: 'services' },
  { href: '/apps', label: 'apps' },
  { href: '/cli-tools', label: 'cli' },
  { href: '/opensource', label: 'oss' },
  { href: '/archive', label: 'blog' },
];

const isWindowActive = (href: string) =>
  href === '/' ? currentPath === '' : currentPath.startsWith(href.slice(1));

const tipJarPrefixes = ['blog', 'archive', 'links', 'tags'];
const showTipJar = tipJarPrefixes.some((prefix) => currentPath.startsWith(prefix));
---

<footer class="mt-20">
  <nav
    aria-label="Footer"
    class="border-t border-paper-border dark:border-term-border bg-paper-panel dark:bg-term-panel"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-2">
      <div
        class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-xs text-paper-muted dark:text-term-muted [&_a]:inline-flex [&_a]:min-h-[24px] [&_a]:items-center"
      >
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 min-w-0">
          <span
            class="px-1.5 py-0.5 bg-paper-green dark:bg-term-green text-paper-bg dark:text-term-bg font-semibold"
            title="tmux session: midgar">midgar</span
          >
          {
            windows.map((window, index) => {
              const isActive = isWindowActive(window.href);
              return (
                <a
                  href={window.href}
                  class={`transition-colors hover:text-paper-green dark:hover:text-term-green ${
                    isActive ? 'text-paper-green dark:text-term-green font-semibold' : ''
                  }`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {`${index}:${window.label}${isActive ? '*' : ''}`}
                </a>
              );
            })
          }
        </div>
        <div class="flex items-center gap-3">
          <a
            href="/rss.xml"
            class="hover:text-paper-green dark:hover:text-term-green transition-colors"
            aria-label="RSS Feed">rss</a
          >
          <a
            href="https://github.com/guitaripod"
            class="hover:text-paper-green dark:hover:text-term-green transition-colors"
            aria-label="GitHub"
            rel="noopener noreferrer"
            target="_blank">github</a
          >
          <a
            href="/services#book"
            class="hover:text-paper-green dark:hover:text-term-green transition-colors">contact</a
          >
          <span class="hidden sm:inline" title="last deploy">{buildDate}</span>
        </div>
      </div>
    </div>
  </nav>

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="text-xs text-paper-faint dark:text-term-faint">
        © {currentYear} Midgar Corp · exit 0
      </p>

      {
        showTipJar && (
          <div class="flex flex-wrap items-center justify-center gap-3">
            <span class="text-xs text-paper-faint dark:text-term-faint mr-1">support:</span>
            <CryptoWallet currency="ETH" address="0x9035F5D947Ef36478679f89Fe44a9041d3837e98" />
            <CryptoWallet currency="BTC" address="bc1qsjzwcmyn9jk4fc32dr406hgc008mv30c9u4z6n" />
            <CryptoWallet currency="DOGE" address="DH2r7M3pNwX5JG65v6p1PndkAQpCBMyGx2" />
          </div>
        )
      }
    </div>
  </div>
</footer>
